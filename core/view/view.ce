(** The frame: from a state to an array of commands for sdl. Everything here is pure and knows no window. The look of the state gives
    the theme and the widths of the proportional fonts; cell is the size of one character of the code font. *)
use src/rope
use src/ui
use core/color
use core/lists
use core/panes
use core/run
use core/text
use std/text as str
use std/list
use std/dict
use std/math
use std/value

(** The width of the line numbers and the space around them, before the first column of text. *)
Gutter = 62

(** Pixels added under the height of the code font to space the lines: JetBrains Mono at 13 is 18 high, and the 19 of ui.Code reads less tight. *)
LineGap = 1

(* The marks of a check: red for an error, amber for a warning, and a quieter tone of each for their words. *)
ErrorColor = 0xE5534B     (** The red of an error: the line under its span, and the number of its line. *)
WarningColor = 0xD29922   (** The amber of a warning: the line under its span, and the number of its line. *)
errorWords = 0xB8615E
warningWords = 0xA88A45

modeHeight = 24
promptHeight = 22

(** The state of the editor with its buffers, before any key: the first buffer is current, there is no pending key, no prompt, no run and no window yet.
    The editor adds its own fields: clip, the clipboard when there is no window; chorded, right after a key with Ctrl or Alt, the text of the event to ignore,
    or true for any text; chain, true while the last command was C-k; dragging, true while the mouse selects; pressed, the place of a mouse press until the mouse leaves
    the zone around it; wheel, the lines that the wheel moved and the screen hasn't yet; ending, true when the editor must stop; title; waited, the seconds since
    the last pending key; hints, the keys that can follow the pending ones once shown; and chords, the keys of the command that runs. Config is the function
    that gives the keys and the settings, which the program sets: with none, no key runs. Home is the folder of Cemacs, "." until the program says. Panes is
    the tree of the panes, see panes.ce, and Pane the one being edited, which shows the current buffer.
    Under --watch the code changes and the state stays, so a session can hold a state from before a field was added here. A field added after that
    is read only through a match with a default, which is how Cesia tests for a field: reading one that isn't there panics, with all the unsaved text.

      Start([], ui.Look(ui.Dark, (w, f) -> 8, 19), {Width: 8, Height: 19}, 800, 600).Current --> 1 *)
Start(buffers, look, cell, width, height) = {Buffers: buffers, Current: 1, Pending: "", Prompt: missing, Message: "", Run: missing, Window: missing, Width: width, Height: height, Cell: cell, Look: look,
  Clip: "", Chorded: false, Chain: false, Dragging: false, Pressed: missing, Wheel: 0.0, Ending: false, Title: "", Config: missing, Home: ".", Second: false,
  Panes: panes.One(1), Pane: 1, Waited: 0.0, Hints: [], Chords: ""}

(** Is the output of a program shown below the panes? Once a program ran, until C-c c h hides it. *)
ShowsOutput(state) = not value.IsMissing(state.Run) and state.Run.Shown

defn BreaksOf(state)
  (** The breakpoints, each a Path and a Line, which stay while no program runs. A state from before this field has none. *)
  match state
    {Breaks: b} -> b
    else -> []
  end
end

(* The color of a breakpoint in the gutter. *)
breakColor = 0xE06C75

defn marksOf(b, state)
  (** What a run puts on the lines of a buffer: the lines of its breakpoints, the line where the program stopped, and the run, for the answers of the evals. *)
  if value.IsMissing(b.Path)
    return {Breaks: [], Stopped: missing, Run: missing}
  end
  r = state.Run
  lines = list.Map(x -> x.Line, list.Filter(x -> run.Same(x.Path, b.Path), BreaksOf(state)))
  {Breaks: lines, Stopped: if value.IsMissing(r) missing else run.StoppedAt(b.Path, r) end, Run: r}
end

defn Layout(width, height, cell, showingOutput)
  (** The rectangles of the screen {Area, Code, Output, Mode, Prompt}, and rows and columns, the lines and the characters that fit in code. Area is where the
      panes go, above the output and the prompt line, and code and mode are those of one pane that fills it. With showing_output false, output is empty.
      No size goes below zero, so a tiny window still has a layout.

        Layout(800, 600, {Width: 8, Height: 19}, false).Output.Height --> 0 *)
  whole = {X: 0, Y: 0, Width: width, Height: height}
  prompt = ui.Bottom(promptHeight, whole)
  outputHeight = if showingOutput list.Max(0, math.Div(prompt.Rest.Height - modeHeight, 3)) else 0 end
  output = ui.Bottom(outputHeight, prompt.Rest)
  one = PaneLayout(output.Rest, cell)
  {Area: output.Rest, Code: one.Code, Output: output.Part, Mode: one.Mode, Prompt: prompt.Part, Rows: one.Rows, Columns: one.Columns}
end

defn PaneLayout(rect, cell)
  (** The rectangles of a pane in rect, {Code, Mode} with its mode line at the bottom, and the rows and the columns that fit in its code.

        PaneLayout({X: 0, Y: 0, Width: 800, Height: 289}, {Width: 8, Height: 19}).Rows --> 13 *)
  mode = ui.Bottom(modeHeight, rect)
  code = mode.Rest
  {Code: code, Mode: mode.Part, Rows: list.Max(0, math.Div(code.Height - 8, cell.Height)), Columns: list.Max(0, math.Div(code.Width - Gutter - 8, cell.Width))}
end

(** The layout of each pane of a state, in the order of the panes, in the area of lay. *)
paneLayoutsIn(lay, state) = list.Map(r -> PaneLayout(r, state.Cell), panes.Rects(lay.Area, panes.Tree(state)))

(** The layout of each pane of a state, as PaneLayout gives it, in the order of the panes. *)
PaneLayouts(state) = paneLayoutsIn(Layout(state.Width, state.Height, state.Cell, ShowsOutput(state)), state)

(** The place of a buffer on the screen, which a pane keeps while another one is edited: the cursor, the mark and where it came from, the top and the left of
    the screen, and free. *)
ViewOf(b) = {Cursor: b.Cursor, Mark: b.Mark, Origin: b.Origin, Top: b.Top, Left: b.Left, Free: b.Free}

defn WithView(v, b)
  (** The buffer at the place v, brought inside its text, which may have changed in another pane, or the buffer as it is for a v that is missing. *)
  if value.IsMissing(v)
    return b
  end
  out = text.Place(v.Cursor.Line, v.Cursor.Column, b)
  out.Mark = v.Mark
  out.Origin = v.Origin
  out.Top = list.Min(list.Max(1, v.Top), rope.LineCount(b.Rope))
  out.Left = list.Max(0, v.Left)
  out.Free = v.Free
  out
end

defn shownIn(j, state)
  (** The buffer as pane j of a state shows it: the current buffer for the pane being edited, else the buffer of the pane at the place it keeps. *)
  if j == panes.Active(state)
    state.Buffers[state.Current]
  else
    leaf = panes.At(j, panes.Tree(state))
    WithView(leaf.View, state.Buffers[list.Min(leaf.Buffer, value.Len(state.Buffers))])
  end
end

(** The name of a buffer: the name of its list, the last part of its path, or untitled. *)
bufferName(b) = if lists.IsList(b) lists.Of(b).Name else if value.IsMissing(b.Path) "untitled" else list.Last(str.Split("/", b.Path)) end

(** The name of a buffer, as the mode line and the title of the window show it.

      BufferName(text.Of("", "src/a.ce")) --> "a.ce" *)
BufferName(b) = bufferName(b)

(** The label of the mode line: the name, and a star if the text isn't saved. *)
label(b) = if text.IsModified(b) "$(bufferName(b)) *" else bufferName(b) end

defn Follow(rows, columns, b)
  (** A buffer whose top and left keep the cursor on the screen of rows lines and columns characters, whose colors are known up to the last line on the screen,
      but for a list, and whose Screen keeps the tokens of the lines on the screen for the view, and for the next frame.
      It is the only place that moves the screen: view only reads. A buffer that is free, after the wheel, keeps its top and left: the cursor may be off the screen.

        Follow(2, 10, {Rope: rope.Of("a\nb\nc"), Cursor: {Line: 3, Column: 0}, Top: 1, Left: 0, Free: false, Colors: color.BlankColors()}).Top --> 2 *)
  line = b.Cursor.Line
  column = b.Cursor.Column
  seenRows = list.Max(1, rows)
  seenColumns = list.Max(1, columns)
  top = if b.Free
    b.Top
  else if line < b.Top
    line
  else if line >= b.Top + seenRows
    line - seenRows + 1
  else
    b.Top
  end
  left = if b.Free
    b.Left
  else if column < b.Left
    column
  else if column >= b.Left + seenColumns
    column - seenColumns + 1
  else
    b.Left
  end
  lastLine = list.Min(rope.LineCount(b.Rope), top + seenRows)
  out = b
  out.Top = top
  out.Left = left
  (* A list draws its rows with their own parts, so its colors would be read for nothing: the rows of a growing output change at each tick. *)
  out.Colors = if lists.IsList(b) b.Colors else coloredTo(lastLine, b) end
  out.Screen = if lists.IsList(b) dict.Dict() else screenOf(top, list.Min(rope.LineCount(b.Rope), top + seenRows - 1), left + seenColumns, b, out.Colors) end
  out
end

defn screenOf(first, last, width, b, colors)
  (** The tokens of the lines from first to last, kept by the text of each line: {Width, State, Tokens}, the tokens of the line cut to width characters
      from the state at its start. A line whose text, width and state are the same as at the frame before keeps its tokens, as Elm's Html.Lazy keeps a
      view whose arguments are the same: a typed key reads the colors of one line, a scrolled line those of the line that comes in. *)
  kept = keptRows(b)
  out = dict.Dict()
  if last < first
    return out
  end
  fulls = screenLines(first, last, b)
  for k in 1..value.Len(fulls)
    out = dict.Put(fulls[k], tokensOf(fulls[k], width, startOf(first + k - 1, colors), kept), out)
  end
  out
end

(** The rows that follow kept for a buffer, or none for a state from before this field. *)
keptRows(b) = match b
  {Screen: rows} -> rows
  else -> dict.Dict()
end

(** The lines from first to last of a buffer, without their line ends, read with one slice of the rope. *)
screenLines(first, last, b) = str.Split("\n", rope.Slice(rope.LineStart(first, b.Rope), rope.LineEnd(last, b.Rope), b.Rope))

(** The first width characters of a line, as the screen shows them: sdl has no clipping, and the tail would not be seen. *)
cutTo(width, full) = if value.Len(full) > width str.Join("", list.Take(width, str.Chars(full))) else full end

defn tokensOf(full, width, state, kept)
  (** The row of a line of this text, cut to width characters, from this state: the one kept if it was made for the same, else read now. *)
  old = dict.Get(full, kept)
  if not value.IsMissing(old) and old.Width == width and old.State == state
    old
  else
    {Width: width, State: state, Tokens: color.Tokens(cutTo(width, full), state).Tokens}
  end
end

defn coloredTo(line, b)
  (** The colors of a buffer known down to line. The lines after the last one known are read 100,000 at a time, each batch one slice of the rope cut
      at its line ends: reading each line alone goes down the tree for each, 13 us a line, where a slice costs 0.3 us a line. *)
  colors = b.Colors
  have = colors.Known
  while have < line
    upTo = list.Min(line, have + 100000)
    lines = str.Split("\n", rope.Slice(rope.LineStart(have, b.Rope), rope.LineEnd(upTo - 1, b.Rope), b.Rope))
    first = have
    colors = color.ColoredTo(upTo, n -> lines[n - first + 1], colors)
    have = upTo
  end
  colors
end

defn FollowState(state)
  (** The state with the screen of each pane kept on its cursor, as follow does: the current buffer for the pane being edited, and the place that each other
      pane keeps. The colors of a buffer are known down to the last line that any pane shows. *)
  layouts = paneLayoutsIn(Layout(state.Width, state.Height, state.Cell, ShowsOutput(state)), state)
  active = panes.Active(state)
  tree = panes.Tree(state)
  s = state
  for j in 1..value.Len(layouts)
    if j != active
      leaf = panes.At(j, tree)
      k = list.Min(leaf.Buffer, value.Len(s.Buffers))
      f = Follow(layouts[j].Rows, layouts[j].Columns, WithView(leaf.View, s.Buffers[k]))
      s.Buffers[k].Colors = f.Colors
      s.Buffers[k].Screen = f.Screen
      tree = panes.WithLeaf(j, {Buffer: k, View: ViewOf(f)}, tree)
    end
  end
  one = layouts[active]
  s.Buffers[state.Current] = Follow(one.Rows, one.Columns, s.Buffers[state.Current])
  s.Panes = tree
  s
end

(** A text command in the font code, or in the font of the theme if none. *)
textCommand(x, y, words, paint) = {Kind: "text", X: x, Y: y, Text: words, Color: paint}
inside(font, x, y, words, paint) = {Kind: "text", X: x, Y: y, Text: words, Color: paint, Font: font}
rectCommand(x, y, w, h, paint) = {Kind: "rect", X: x, Y: y, Width: list.Max(0, w), Height: list.Max(0, h), Color: paint}
box(x, y, w, h, paint, radius) = {Kind: "box", X: x, Y: y, Width: list.Max(0, w), Height: list.Max(0, h), Color: paint, Radius: radius}

defn visible(tokens, left)
  (** The tokens [role, text] of a line that are in the columns from left on, as [role, text, column], cutting the first one that straddles left. *)
  out = []
  column = 0
  for token in tokens
    size = value.Len(token[2])
    if column + size > left
      skipped = list.Max(0, left - column)
      words = if skipped > 0 str.Join("", list.Skip(skipped, str.Chars(token[2]))) else token[2] end
      out = list.Append([token[1], words, column + skipped], out)
    end
    column = column + size
  end
  out
end

defn rowTokens(parts, words)
  (** The tokens of a row of a list: its parts, cut to the length of words, which is the line cut to the screen; a row with none is one plain text. *)
  if value.IsMissing(parts)
    return [[color.Plain, words]]
  end
  out = []
  left = value.Len(words)
  for part in parts
    if left > 0
      cs = str.Chars(part[2])
      taken = if value.Len(cs) > left str.Join("", list.Take(left, cs)) else part[2] end
      out = list.Append([part[1], taken], out)
      left = left - value.Len(cs)
    end
  end
  out
end

(** The state at the start of line n, or the first one if the colors don't reach it yet. *)
startOf(n, colors) = if n <= colors.Known color.StartOf(n, colors) else color.FirstState end

(** The marks of line n of a buffer, the errors first. *)
marksAt(n, b) = list.Concat([m for m in text.MarksOf(b) if m.Line == n and m.Severity == "error"], [m for m in text.MarksOf(b) if m.Line == n and m.Severity != "error"])

isError(m) = m.Severity == "error"
markColor(m) = if isError(m) ErrorColor else WarningColor end
markWords(m) = if isError(m) errorWords else warningWords end

defn line(b, n, full, y, columns, rect, look)
  (** The commands of line n of a buffer, whose text is full: its number, then one text per token, or one plain text for the row of a list. The line is cut to
      the columns on the screen before it is read; its tokens are the ones follow kept for this text, width and state, if it kept them. *)
  th = look.Theme
  cw = look.Width("M", "code")
  width = b.Left + columns
  tokens = if lists.IsList(b) rowTokens(lists.PartsAt(n, b), cutTo(width, full)) else tokensOf(full, width, startOf(n, b.Colors), keptRows(b)).Tokens end
  x0 = rect.X + Gutter
  here = marksAt(n, b)
  numbered = inside("code", rect.X + Gutter - 16 - value.Len("$n") * cw, y, "$n", if value.Len(here) > 0 markColor(here[1]) else th.Faint end)
  out = [numbered]
  for token in visible(tokens, b.Left)
    out = list.Append(inside("code", x0 + (token[3] - b.Left) * cw, y, token[2], th.Syntax[token[1]]), out)
  end
  out
end

(* The space between the top of the code area and its first line. *)
inset = 4

(** The y of the row of the code area (0 is the first one) and the x of a column of the screen, in pixels. Drawing and the mouse both use them. *)
rowY(row, rect, cell) = rect.Y + inset + row * cell.Height
columnX(column, rect, cell) = rect.X + Gutter + column * cell.Width

defn floorDiv(a, b)
  (** The division of two whole numbers rounded down, also when the first is negative. *)
  if a >= 0
    math.Div(a, b)
  else
    0 - math.Div(b - 1 - a, b)
  end
end

defn cellAt(x, y, rect, cell)
  (** The row and the column of the screen under a point, rounding the column to the nearest edge between two characters. They may be
      outside the text, even negative. *)
  dy = y - rect.Y - inset
  dx = x - rect.X - Gutter + math.Div(cell.Width, 2)
  {Row: floorDiv(dy, cell.Height), Column: floorDiv(dx, cell.Width)}
end

defn LayoutOf(state)
  (** The layout of a state: the one of its window, with the output pane if a program runs, and the code, the mode line, the rows and the columns of the pane
      being edited.

        LayoutOf(Start([], ui.Look(ui.Dark, (w, f) -> 8, 19), {Width: 8, Height: 19}, 800, 600)).Rows --> 28 *)
  lay = Layout(state.Width, state.Height, state.Cell, ShowsOutput(state))
  layouts = paneLayoutsIn(lay, state)
  one = layouts[list.Min(panes.Active(state), value.Len(layouts))]
  lay.Code = one.Code
  lay.Mode = one.Mode
  lay.Rows = one.Rows
  lay.Columns = one.Columns
  lay
end

(** The pane under a point, its code or its mode line, or 0 out of the panes.

      PaneAt(10, 10, Start([], ui.Look(ui.Dark, (w, f) -> 8, 19), {Width: 8, Height: 19}, 800, 600)) --> 1 *)
PaneAt(x, y, state) = panes.IndexAt(x, y, panes.Rects(Layout(state.Width, state.Height, state.Cell, ShowsOutput(state)).Area, panes.Tree(state)))

defn IsInCode(x, y, state)
  (** Is a point inside the code area?

        IsInCode(10, 100, Start([], ui.Look(ui.Dark, (w, f) -> 8, 19), {Width: 8, Height: 19}, 800, 600)) --> true *)
  r = LayoutOf(state).Code
  x >= r.X and x < r.X + r.Width and y >= r.Y and y < r.Y + r.Height
end

defn PositionAt(x, y, state)
  (** The position {Line, Column} of the current buffer under a point, brought inside the text. The point can be anywhere: in a drag past the edge of the
      code, the screen then follows it.

        PositionAt(0, 0, Start([text.Of("ab", missing)], ui.Look(ui.Dark, (w, f) -> 8, 19), {Width: 8, Height: 19}, 800, 600)).Line --> 1 *)
  lay = LayoutOf(state)
  b = state.Buffers[state.Current]
  at = cellAt(x, y, lay.Code, state.Cell)
  text.Place(b.Top + at.Row, b.Left + at.Column, b).Cursor
end

defn ClickAt(x, y, state)
  (** The position {Line, Column} of the current buffer under a click in the code area, which doesn't move the screen: in the gutter it is on the first
      column shown, past the last column on that one, and in the margins above and under the rows on the nearest row.

        ClickAt(0, 37, Start([text.Of("ab", missing)], ui.Look(ui.Dark, (w, f) -> 8, 19), {Width: 8, Height: 19}, 800, 600)).Column --> 0 *)
  lay = LayoutOf(state)
  b = state.Buffers[state.Current]
  at = cellAt(x, y, lay.Code, state.Cell)
  text.Place(b.Top + list.Max(0, list.Min(at.Row, lay.Rows - 1)), b.Left + list.Max(0, list.Min(at.Column, lay.Columns - 1)), b).Cursor
end

defn selection(b, first, last, lay, look)
  (** The selection of a buffer on the lines from first to last: one rectangle per line, from the mark to the cursor. A line that the selection
      crosses is filled one character past its end, to show that its line end is selected. *)
  ends = text.Selection(b)
  if value.IsMissing(ends)
    return []
  end
  rect = lay.Code
  cell = lay.Cell
  out = []
  for n in list.Max(first, ends.First.Line)..list.Min(last, ends.Last.Line)
    from = if n == ends.First.Line ends.First.Column else 0 end
    to = if n == ends.Last.Line ends.Last.Column else text.LineWidth(n, b) + 1 end
    a = list.Max(from, b.Left)
    z = list.Min(to, b.Left + lay.Columns)
    if z > a
      out = list.Append(rectCommand(columnX(a - b.Left, rect, cell), rowY(n - b.Top, rect, cell), (z - a) * cell.Width, cell.Height, look.Theme.Fill), out)
    end
  end
  out
end

defn code(b, lay, look, focused, marks)
  (** The code area of a buffer in a pane: the band of the current line, the lines on the screen and the cursor bar. Only the pane being edited, focused, has
      the band and a bright bar. Marks are those of a run: a dot in the gutter for a breakpoint, a band of color on the line where the program stopped,
      and the value of an eval at the end of its line, in grey and not in the file. *)
  th = look.Theme
  cell = lay.Cell
  rect = lay.Code
  out = [box(rect.X, rect.Y, rect.Width, rect.Height, th.Code, 0)]
  first = b.Top
  last = list.Min(rope.LineCount(b.Rope), b.Top + lay.Rows - 1)
  lineY(n) = rowY(n - b.Top, rect, cell)
  here = b.Cursor.Line
  if focused and here >= first and here <= last
    out = list.Append(box(rect.X + 4, lineY(here), rect.Width - 8, cell.Height, th.Hover, 4), out)
  end
  stopped = marks.Stopped
  if not value.IsMissing(stopped) and stopped >= first and stopped <= last
    out = list.Append(box(rect.X + 4, lineY(stopped), rect.Width - 8, cell.Height, th.Picked, 4), out)
  end
  out = list.Concat(out, selection(b, first, last, lay, look))
  fulls = if last < first [] else screenLines(first, last, b) end
  for n in first..last
    out = list.Concat(out, line(b, n, fulls[n - first + 1], lineY(n), lay.Columns, rect, look))
    if not value.IsMissing(list.IndexOf(n, marks.Breaks))
      out = list.Append(box(rect.X + 6, lineY(n) + math.Div(cell.Height, 2) - 4, 8, 8, breakColor, 4), out)
    end
    out = list.Concat(out, answer(b, n, marks.Run, lineY(n), lay.Columns, rect, cell, th))
  end
  out = list.Concat(out, marked(b, first, last, lay, look))
  if here >= first and here <= last and b.Cursor.Column >= b.Left and b.Cursor.Column - b.Left < lay.Columns
    out = list.Append(rectCommand(columnX(b.Cursor.Column - b.Left, rect, cell), lineY(here), 2, cell.Height, if focused th.Bright else th.Faint end), out)
  end
  out
end

defn marked(b, first, last, lay, look)
  (** The marks of the lines on the screen: a line of two pixels under each span, and after the end of the line, two spaces after it, the words of its first
      mark, cut at the edge, with (+2) when the line has two more. No row is added: a full line keeps only the underline and the color of its number. *)
  cell = lay.Cell
  rect = lay.Code
  out = []
  for n in first..last
    here = marksAt(n, b)
    if value.Len(here) > 0
      y = rowY(n - b.Top, rect, cell)
      for m in here
        from = list.Max(m.Column, b.Left)
        to = list.Min(list.Max(m.End, m.Column + 1), b.Left + lay.Columns)
        if to > from
          out = list.Append(rectCommand(columnX(from - b.Left, rect, cell), y + cell.Height - 2, (to - from) * cell.Width, 2, markColor(m)), out)
        end
      end
      at = text.LineWidth(n, b) - b.Left + 2
      room = lay.Columns - list.Max(0, at)
      words = if value.Len(here) > 1 "$(here[1].Message) (+$(value.Len(here) - 1))" else here[1].Message end
      if room > 3
        cut = if value.Len(words) > room str.Join("", list.Take(room, str.Chars(words))) else words end
        out = list.Append(inside("code", columnX(list.Max(0, at), rect, cell), y, cut, markWords(here[1])), out)
      end
    end
  end
  out
end

defn MarkCount(b)
  (** The words of the marks of a buffer for its mode line, as "2 errors, 1 warning", or "" with none. *)
  marks = text.MarksOf(b)
  errors = value.Len([m for m in marks if isError(m)])
  warnings = value.Len(marks) - errors
  counted(k, word) = if k == 1 "1 $word" else "$k $(word)s" end
  parts = list.Concat(if errors > 0 [counted(errors, "error")] else [] end, if warnings > 0 [counted(warnings, "warning")] else [] end)
  str.Join(", ", parts)
end

defn mode(b, lay, look, focused)
  (** The mode line of a pane: the name of the buffer, the position of the cursor, and the language. The one of the pane being edited, focused, is lighter. *)
  th = look.Theme
  rect = lay.Mode
  y = rect.Y + math.Div(rect.Height - look.Height, 2)
  position = "$(b.Cursor.Line):$(b.Cursor.Column)"
  language = if lists.IsList(b) "List" else "Cesia" end
  right = rect.X + rect.Width - 12
  count = MarkCount(b)
  shown = [rectCommand(rect.X, rect.Y, rect.Width, rect.Height, if focused th.Header else th.Panel end), textCommand(rect.X + 12, y, label(b), if focused th.Ink else th.Muted end),
    textCommand(right - look.Width(language, "body"), y, language, th.Muted),
    textCommand(right - look.Width(language, "body") - 24 - look.Width(position, "body"), y, position, th.Muted)]
  if count == ""
    shown
  else
    errors = value.Len([m for m in text.MarksOf(b) if isError(m)]) > 0
    list.Append(textCommand(right - look.Width(language, "body") - 48 - look.Width(position, "body") - look.Width(count, "body"), y, count, if errors ErrorColor else WarningColor end), shown)
  end
end

defn prompt(state, lay, look)
  (** The prompt line: the question and the answer being typed, or else the last message, or else in a list its filter. *)
  th = look.Theme
  rect = lay.Prompt
  y = rect.Y + math.Div(rect.Height - look.Height, 2)
  b = state.Buffers[state.Current]
  filtering = value.IsMissing(state.Prompt) and state.Message == "" and lists.IsList(b)
  (* With nothing else to say, the line tells the mark under the cursor, or else the first one of its line, with its hint. *)
  here = if value.IsMissing(state.Prompt) and state.Message == "" and not filtering underCursor(b) else [] end
  words = if not value.IsMissing(state.Prompt) "$(state.Prompt.Label)$(state.Prompt.Answer)" else if filtering "$(lists.LabelOf(lists.Of(b)))$(lists.Of(b).Filter)" else if value.Len(here) > 0 markText(here[1]) else state.Message end
  bar = if value.IsMissing(state.Prompt) and not filtering [] else [rectCommand(rect.X + 12 + look.Width(words, "body"), y, 2, look.Height, th.Bright)] end
  list.Concat([rectCommand(rect.X, rect.Y, rect.Width, rect.Height, th.Panel), textCommand(rect.X + 12, y, words, if value.Len(here) > 0 markColor(here[1]) else th.Ink end)], bar)
end

defn underCursor(b)
  (** The marks for the prompt line: those under the cursor, from the start of their span to just after it, or else those of the cursor's line, the errors
      first. A span takes at least one character. *)
  marks = marksAt(b.Cursor.Line, b)
  c = b.Cursor.Column
  under = [m for m in marks if m.Column <= c and c <= list.Max(m.End, m.Column + 1)]
  if value.Len(under) == 0 marks else under end
end

(** The words of a mark on the prompt line: its message, then its hint. *)
markText(m) = if value.IsMissing(m.Hint) m.Message else "$(m.Message)  $(m.Hint)" end

defn hints(state, lay, look)
  (** The band above the prompt line, while keys wait for the next one and their hints are there: each chord that can follow, and the command it runs or the
      group it opens, in columns read from the top down. *)
  shown = match state
    {Hints: rows} -> if state.Pending == "" [] else rows end
    else -> []
  end
  if value.Len(shown) == 0
    return []
  end
  th = look.Theme
  keyWidth = list.Reduce((w, h) -> list.Max(w, look.Width(h.Key, "code")), 0, shown)
  column = keyWidth + 12 + list.Reduce((w, h) -> list.Max(w, look.Width(h.Name, "body")), 0, shown) + 40
  columns = list.Max(1, math.Div(lay.Prompt.Width - 24, column))
  rows = math.Div(value.Len(shown) + columns - 1, columns)
  line = look.Height + 6
  height = rows * line + 12
  top = lay.Prompt.Y - height
  out = [rectCommand(lay.Prompt.X, top, lay.Prompt.Width, height, th.Panel), rectCommand(lay.Prompt.X, top, lay.Prompt.Width, 1, th.Line)]
  for k in 1..value.Len(shown)
    h = shown[k]
    x = lay.Prompt.X + 12 + math.Div(k - 1, rows) * column
    y = top + 6 + math.Mod(k - 1, rows) * line + 3
    out = list.Concat(out, [inside("code", x, y, h.Key, th.Syntax[color.Keyword]), textCommand(x + keyWidth + 12, y, h.Name, if h.Group th.Accent else th.Ink end)])
  end
  out
end

defn answer(b, n, r, y, columns, rect, cell, th)
  (** The value of the eval asked from line n, two cells after its end, when the line ends on the screen. *)
  if value.IsMissing(r)
    return []
  end
  shown = run.ValueAt(b.Path, n, r)
  at = value.Len(str.Chars(rope.Line(n, b.Rope))) + 2 - b.Left
  if value.IsMissing(shown) or at < 0 or at >= columns
    []
  else
    room = columns - at - 2
    words = str.Join("", list.Take(list.Max(0, room), str.Chars(str.Replace("\n", " ", "= $shown"))))
    [textCommand(columnX(at, rect, cell), y, words, th.Faint)]
  end
end

defn outputLines(r)
  (** What the output pane lists: at a stop, the variables of the innermost frame, then the errors of a fix that didn't load, last so that they show;
      else the output of the program, its last line too. *)
  if not value.IsMissing(r.Stop)
    error = if r.Stop.Error == "" [] else [r.Stop.Error] end
    list.Concat(list.Concat(error, list.Map(v -> "$(v.Name) = $(v.Value)", r.Stop.Vars)), run.FixOf(r))
  else
    run.Lines(r)
  end
end

defn output(state, lay, look)
  (** The output pane, when there is room for it: its title and the status of the program. *)
  th = look.Theme
  rect = lay.Output
  if rect.Height == 0 or not ShowsOutput(state)
    []
  else
    y = rect.Y + 4
    r = state.Run
    title = if value.IsMissing(r.Stop) "Output" else "Variables" end
    out = [rectCommand(rect.X, rect.Y, rect.Width, rect.Height, th.Well), rectCommand(rect.X, rect.Y, rect.Width, 1, th.Line), inside("strong", rect.X + 12, y, title, th.Ink),
      textCommand(rect.X + 24 + look.Width(title, "strong"), y, r.Status, th.Muted)]
    rows = list.Max(0, math.Div(rect.Height - 28, lay.Cell.Height))
    columns = list.Max(0, math.Div(rect.Width - 24, lay.Cell.Width))
    shown = outputLines(r)
    last = list.Skip(list.Max(0, value.Len(shown) - rows), shown)
    for k in 1..value.Len(last)
      out = list.Append(inside("code", rect.X + 12, y + 24 + (k - 1) * lay.Cell.Height, str.Join("", list.Take(columns, str.Chars(last[k]))), th.Ink), out)
    end
    out
  end
end

defn View(state)
  (** The frame of a state: an array of commands for sdl. Only the lines on the screen are read, so a large file costs no more than a small one.
      The screen of each pane (top, left and colors) is what follow gave it. A line on the left of a pane parts it from the one beside it. *)
  look = state.Look
  lay = Layout(state.Width, state.Height, state.Cell, ShowsOutput(state))
  layouts = paneLayoutsIn(lay, state)
  active = panes.Active(state)
  drawn = []
  for j in 1..value.Len(layouts)
    one = layouts[j]
    one.Cell = state.Cell
    b = shownIn(j, state)
    drawn = list.Concat(drawn, list.Concat(code(b, one, look, j == active, marksOf(b, state)), mode(b, one, look, j == active)))
    if one.Code.X > lay.Area.X
      drawn = list.Append(rectCommand(one.Code.X, one.Code.Y, 1, one.Code.Height + one.Mode.Height, look.Theme.Line), drawn)
    end
  end
  outLay = lay
  outLay.Cell = state.Cell
  list.Flatten([[{Kind: "clear", Color: look.Theme.Ground}], drawn, output(state, outLay, look), hints(state, lay, look), prompt(state, lay, look)])
end
