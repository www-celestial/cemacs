(** Tests of view.ce and text.Of: run with cesia test . *)
use core/color
use core/text
use core/view
use src/rope
use src/history
use core/panes
use src/ui
use std/text as str
use std/list
use std/dict
use std/gen
use std/test
use std/value

cell = {Width: 8, Height: 19}
look = ui.Look(ui.Dark, (words, font) -> value.Len(words) * 8, 19)

stateOf(buffers, width, height) = view.Start(buffers, look, cell, width, height)

manyLines(count) = str.Join("\n", list.Map(n -> "word", list.Range(1, count)))   (** A text of count lines, each one "word". *)

textsOf(commands) = list.Map(c -> c.Text, list.Filter(c -> c.Kind == "text", commands))

isOnlyVisibleLines() = isOnlyVisible(stateOf([text.Of(manyLines(20000), "a.ce")], 800, 600))

defn isOnlyVisible(state)
  layout = view.Layout(state.Width, state.Height, state.Cell, false)
  b = view.Follow(layout.Rows, layout.Columns, 0, state.Buffers[1])
  s = state
  s.Buffers = [b]
  shown = value.Len(list.Filter(t -> t == "word", textsOf(view.View(s))))
  shown > 0 and shown <= layout.Rows
end

defn isLongLineFollows()
  b = text.Of(str.Join("", list.Map(n -> "x", list.Range(1, 600))), "a.ce")
  b.Cursor = {Line: 1, Column: 500}
  f = view.Follow(10, 80, 0, b)
  f.Left <= 500 and 500 < f.Left + 80
end

defn isFollowScrollsDown()
  b = text.Of(manyLines(100), "a.ce")
  b.Cursor = {Line: 50, Column: 0}
  f = view.Follow(10, 80, 0, b)
  f.Top <= 50 and 50 < f.Top + 10 and f.Colors.Known >= 50
end

defn isFollowSkipsColorsOfList()
  (** A list draws its rows with their parts: following its cursor reads no color, as the rows of an output change at each tick. *)
  b = text.Of(manyLines(100), missing)
  b.List = {Name: "Output"}
  b.Cursor = {Line: 50, Column: 0}
  f = view.Follow(10, 80, 0, b)
  f.Top <= 50 and 50 < f.Top + 10 and f.Colors.Known == b.Colors.Known
end

defn isFollowKeepsTop()
  b = text.Of(manyLines(100), "a.ce")
  b.Cursor = {Line: 3, Column: 2}
  f = view.Follow(10, 80, 0, b)
  f.Top == 1 and f.Left == 0
end

defn isTinyWindow()
  s = stateOf([text.Of("a\nb", "a.ce")], 10, 10)
  lay = view.Layout(s.Width, s.Height, s.Cell, false)
  s.Buffers = [view.Follow(lay.Rows, lay.Columns, 0, s.Buffers[1])]
  value.IsArray(view.View(s))
end

defn isNoTabs()
  (** No tabs: the code starts at the top of the window, and the name of a buffer that isn't current is nowhere on the screen. The mode line names the current one. *)
  a = text.Of("a", "/x/a.ce")
  b = text.Of("b", "/x/b.ce")
  b.Version = 3
  commands = view.View(stateOf([a, b], 800, 600))
  shown = textsOf(commands)
  "a.ce" in shown and not ("b.ce" in shown) and not ("b.ce *" in shown) and value.Len(list.Filter(c -> c.Kind == "box" and c.Width == 7, commands)) == 0
end
isCodeAtTop() = view.Layout(800, 600, cell, false).Code.Y == 0 and view.Layout(800, 600, cell, false).Rows == 28

isNoOutputPane() = view.Layout(800, 600, cell, false).Output.Height == 0
isOutputPane() = view.Layout(800, 600, cell, true).Output.Height > 0
isRowsFit() = view.Layout(800, 600, cell, false).Rows * 19 <= view.Layout(800, 600, cell, false).Code.Height
defn isOfFields()
  b = text.Of("a", "a.ce")
  value.IsMissing(b.Mark) and value.IsMissing(b.Disk) and b.Version == 0 and b.Saved == 0 and b.Top == 1 and b.Left == 0 and b.Path == "a.ce" and b.Colors.Known == 1 and b.Cursor.Line == 1 and b.Cursor.Column == 0 and history.CanUndo(b.History) == false
end
isOfRope() = rope.Text(text.Of("ab\ncd", "a.ce").Rope) == "ab\ncd"

defn shownFrom(words, left)
  (** The commands of a one-buffer window 102 pixels wide, so that 4 columns of code fit, showing words from column left. *)
  b = text.Of(words, "a.ce")
  b.Left = left
  view.View(stateOf([b], 102, 600))
end

(** Is this command a text of the code area? The mode line and the prompt are not: the window is 600 high, and the first line is at 4. *)
inCode(c) = c.Kind == "text" and c.Y < 100

(** The texts in the code area, the line number first. *)
codeTexts(commands) = list.Map(c -> c.Text, list.Filter(c -> inCode(c), commands))

isFourColumns() = view.Layout(102, 600, cell, false).Columns == 4
isCutToColumns() = value.Equal(codeTexts(shownFrom("abcdefghij", 3)), ["1", "defg"])

defn isCutX()
  first = list.Filter(c -> inCode(c) and c.Text == "defg", shownFrom("abcdefghij", 3))[1]
  first.X == view.Gutter
end

defn isTokenStraddlingLeft()
  commands = list.Filter(c -> inCode(c) and c.Text != "1", shownFrom("defn x", 2))
  value.Equal(list.Map(c -> c.Text, commands), ["fn", " x"]) and commands[2].X == view.Gutter + 16 and commands[1].Color == ui.Dark.Syntax[color.Keyword]
end

isLineShorterThanLeft() = value.Equal(codeTexts(shownFrom("ab", 5)), ["1"])
isMultibyteCutLikeAscii() = value.Equal(list.Map(t -> value.Len(t), codeTexts(shownFrom("ééééé", 2))), list.Map(t -> value.Len(t), codeTexts(shownFrom("eeeee", 2))))
isMultibyteText() = value.Equal(codeTexts(shownFrom("ééééé", 2)), ["1", "ééé"])

defn isEmptyFile()
  s = stateOf([text.Of("", "a.ce")], 800, 600)
  lay = view.Layout(s.Width, s.Height, s.Cell, false)
  s.Buffers = [view.Follow(lay.Rows, lay.Columns, 0, s.Buffers[1])]
  value.IsArray(view.View(s)) and s.Buffers[1].Top == 1
end

defn isCursorOnLastLine()
  b = text.Of(manyLines(3), "a.ce")
  b.Cursor = {Line: 3, Column: 0}
  s = stateOf([b], 800, 600)
  lay = view.Layout(s.Width, s.Height, s.Cell, false)
  s.Buffers = [view.Follow(lay.Rows, lay.Columns, 0, b)]
  bars = list.Filter(c -> c.Kind == "rect" and c.Width == 2, view.View(s))
  value.Len(bars) == 1 and value.Len(list.Filter(t -> t == "word", textsOf(view.View(s)))) == 3
end

defn isFollowWithoutRows()
  b = text.Of(manyLines(10), "a.ce")
  b.Cursor = {Line: 5, Column: 3}
  f = view.Follow(0, 0, 0, b)
  f.Top <= 5 and f.Left <= 3
end

defn isCursorBarInsideColumns()
  b = text.Of("abcd", "a.ce")
  b.Cursor = {Line: 1, Column: 4}
  s = stateOf([b], 102, 600)
  s.Buffers = [view.Follow(4, 4, 0, b)]
  bars = list.Filter(c -> c.Kind == "rect" and c.Width == 2, view.View(s))
  value.Len(bars) == 1 and bars[1].X < 102
end

(** The rectangles of the theme fill color: the selection. *)
fills(commands) = list.Filter(c -> c.Kind == "rect" and c.Color == ui.Dark.Fill, commands)

defn selectedState(words, mark, cursor)
  b = text.Of(words, "a.ce")
  b.Mark = mark
  b.Cursor = cursor
  stateOf([b], 800, 600)
end

defn isSelectionOneLine()
  s = selectedState("abcdef", {Line: 1, Column: 1}, {Line: 1, Column: 4})
  f = fills(view.View(s))
  value.Len(f) == 1 and f[1].X == view.Gutter + 8 and f[1].Width == 24 and f[1].Height == 19
end

defn isSelectionBackwards()
  s = selectedState("abcdef", {Line: 1, Column: 4}, {Line: 1, Column: 1})
  f = fills(view.View(s))
  value.Len(f) == 1 and f[1].X == view.Gutter + 8 and f[1].Width == 24
end

defn isSelectionLines()
  s = selectedState("abc\ndef\nghi", {Line: 1, Column: 2}, {Line: 3, Column: 1})
  f = fills(view.View(s))
  value.Len(f) == 3 and f[1].Width == 16 and f[2].Width == 32 and f[3].Width == 8 and f[2].Y == f[1].Y + 19
end

isNoSelectionNoFill() = value.Len(fills(view.View(selectedState("abc", missing, {Line: 1, Column: 1})))) == 0
isEmptySelectionNoFill() = value.Len(fills(view.View(selectedState("abc", {Line: 1, Column: 1}, {Line: 1, Column: 1})))) == 0

defn isSelectionUnderText()
  commands = view.View(selectedState("abc", {Line: 1, Column: 0}, {Line: 1, Column: 2}))
  firstFill = list.IndexOf(fills(commands)[1], commands)
  firstText = list.IndexOf(list.Filter(c -> c.Kind == "text" and c.Text == "abc", commands)[1], commands)
  firstFill < firstText
end

defn isSelectionCutToScreen()
  b = text.Of("abcdefghij", "a.ce")
  b.Mark = {Line: 1, Column: 0}
  b.Cursor = {Line: 1, Column: 10}
  b.Left = 3
  f = fills(view.View(stateOf([b], 102, 600)))
  value.Len(f) == 1 and f[1].X == view.Gutter and f[1].Width == 32
end

defn isPromptDrawn()
  s = stateOf([text.Of("a", "a.ce")], 800, 600)
  s.Prompt = {Label: "Find file: ", Answer: "a.ce", Done: (a, t) -> t, Choice: false}
  commands = view.View(s)
  bars = list.Filter(c -> c.Kind == "rect" and c.Width == 2 and c.Y > 500, commands)
  "Find file: a.ce" in textsOf(commands) and value.Len(bars) == 1 and bars[1].X == 12 + value.Len("Find file: a.ce") * 8
end

defn isMessageDrawn()
  s = stateOf([text.Of("a", "a.ce")], 800, 600)
  s.Message = "Saved a.ce"
  commands = view.View(s)
  "Saved a.ce" in textsOf(commands) and value.Len(list.Filter(c -> c.Kind == "rect" and c.Width == 2 and c.Y > 500, commands)) == 0
end

defn isPositionAt()
  s = stateOf([text.Of("abcd\nefgh", "a.ce")], 800, 600)
  p = view.PositionAt(view.Gutter + 17, 4 + 19 + 3, s)
  p == {Line: 2, Column: 2}
end

isPositionClamped() = view.PositionAt(790, 590, stateOf([text.Of("abcd\nefgh", "a.ce")], 800, 600)) == {Line: 2, Column: 4}
isPositionBeforeText() = view.PositionAt(0, 0, stateOf([text.Of("abcd\nefgh", "a.ce")], 800, 600)) == {Line: 1, Column: 0}

defn isPositionWithScroll()
  b = text.Of(manyLines(50), "a.ce")
  b.Top = 10
  b.Left = 0
  view.PositionAt(view.Gutter, 4, stateOf([b], 800, 600)).Line == 10
end

defn isPositionOnCursorBar()
  b = text.Of("abcdef", "a.ce")
  b.Cursor = {Line: 1, Column: 3}
  s = stateOf([b], 800, 600)
  bar = list.Filter(c -> c.Kind == "rect" and c.Width == 2 and c.Y < 100, view.View(s))[1]
  view.PositionAt(bar.X + 1, bar.Y + 1, s).Column == 3
end

defn isInCode()
  s = stateOf([text.Of("a", "x.ce")], 800, 600)
  view.IsInCode(10, 100, s) and view.IsInCode(10, 10, s) and not view.IsInCode(10, 560, s) and not view.IsInCode(10, 590, s)
end

defn isFollowKeepsMarginBelow()
  (** Going down, the screen moves while 3 lines are still under the cursor: on line 8 of a screen of 10 rows, lines 9 to 11 must show. *)
  b = hundredAt(8)
  f = view.Follow(10, 80, 3, b)
  f.Top == 2 and view.Follow(10, 80, 3, hundredAt(7)).Top == 1
end

defn isFollowKeepsMarginAbove()
  (** Going up, the screen moves while 3 lines are still above the cursor. *)
  b = hundredAt(52)
  b.Top = 50
  view.Follow(10, 80, 3, b).Top == 49
end

defn isFollowMarginAtFileEdges()
  (** The cursor goes to the first and the last line, where the file has no line to keep. *)
  last = hundredAt(100)
  last.Top = 91
  view.Follow(10, 80, 3, hundredAt(1)).Top == 1 and view.Follow(10, 80, 3, hundredAt(2)).Top == 1 and view.Follow(10, 80, 3, last).Top == 91
end

defn isFollowMouseKeepsTop()
  (** The cursor that the mouse put on the last row keeps the screen: no margin until a key. *)
  b = hundredAt(10)
  b.Hold = "mouse"
  view.Follow(10, 80, 3, b).Top == 1
end

defn isFollowWheelHolds()
  (** A screen that the wheel holds stays, the cursor away from it. *)
  b = hundredAt(1)
  b.Top = 50
  b.Hold = "wheel"
  view.Follow(10, 80, 3, b).Top == 50
end

isFollowMarginOfSmallScreen() = view.Follow(3, 80, 3, hundredAt(3)).Top == 2   (** A screen of 3 rows keeps one line around the cursor. *)

defn isFollowMarginPastBlock()
  (** Under a block of 20 rows, the cursor's line comes in 3 rows over the bottom, the screen starting inside the block: its lower part shows. *)
  b = text.WithBlocks([blockAt(9, 20, "result")], text.Of(manyLines(100), "a.ce"))
  b.Cursor = {Line: 10, Column: 0}
  f = view.Follow(10, 80, 3, b)
  f.Top == 9 and f.Skip == 15 and view.RowOf(10, f, view.Under(f)) == 6
end

defn isFollowBlockAboveKeepsCursorStill()
  (** A block of 15 rows two lines under the cursor moves nothing while the cursor is far from the bottom: the margin counts rows. *)
  b = text.WithBlocks([blockAt(7, 15, "result")], text.Of(manyLines(100), "a.ce"))
  b.Cursor = {Line: 5, Column: 0}
  view.Follow(28, 80, 3, b).Top == 1
end

defn isWheelInsideTallBlockHolds()
  (** Inside a block of 40 rows on a screen of 10, no line can take the cursor: the screen holds, the cursor where it was, until a key. *)
  b = text.WithBlocks([blockAt(5, 40, "result")], text.Of(manyLines(100), "a.ce"))
  w = view.Wheeled(10, 3, view.Scrolled(15, b))
  w.Hold == "wheel" and w.Cursor.Line == 1 and w.Top == 5 and w.Skip == 11 and view.Follow(10, 80, 3, w).Skip == 11
end

defn isWheelNotchInBlockMovesRows()
  (** A notch of 3 rows inside a block of 20 rows moves the screen 3 rows into it, never past the whole block at once. *)
  b = text.WithBlocks([blockAt(2, 20, "result")], text.Of(manyLines(100), "a.ce"))
  one = view.Scrolled(3, b)
  two = view.Scrolled(3, one)
  one.Top == 2 and one.Skip == 2 and two.Top == 2 and two.Skip == 5
end

(** The rows of the file above line n, of the lines and their blocks. *)
rowsAbove(n, u) = list.Sum([1 + dict.GetOr("$k", 0, if value.IsMissing(u) {} else u end) for k in list.Range(1, n - 1)])
(** The rows of the file under the words of line n, to the end. *)
rowsUnder(n, count, u) = rowsAbove(count + 1, u) - rowsAbove(n, u) - 1

defn placeOf(b)
  (** The place of a screen as one number: the rows of the file above its first row. *)
  u = view.Under(b)
  rowsAbove(b.Top, u) + view.SkipOf(b, u)
end

defn buffered(p)
  (** A buffer of p.Lines lines with the blocks of p, its screen at p.Top and p.Skip, the cursor on p.Line. *)
  b = text.WithBlocks(list.Map(k -> blockAt(k.Line, k.Rows, "r"), p.Blocks), text.Of(manyLines(p.Lines), missing))
  b.Top = list.Min(p.Top, p.Lines)
  b.Skip = p.Skip
  b.Cursor = {Line: list.Min(p.Line, p.Lines), Column: 0}
  b
end

defn isFollowSettled(p)
  (** For any text, blocks, screen, margin, place and cursor: the screen shows the words of the cursor's line, with the margin above and under them as far as
      the file has rows; it stays where Keeps says, and else moves to the nearest place, the line on the first or the last row the margin allows; followed
      again, it stays. *)
  b = buffered(p)
  f = view.Follow(p.Rows, 80, p.Margin, b)
  u = view.Under(f)
  line = b.Cursor.Line
  row = view.RowOf(line, f, u)
  m = view.Kept(p.Rows, p.Margin)
  low = list.Min(m, rowsAbove(line, u))
  high = p.Rows - 1 - list.Min(m, rowsUnder(line, p.Lines, u))
  fits = low <= row and row <= high
  kept = if view.Keeps(line, p.Rows, p.Margin, b) placeOf(f) == placeOf(b) else row == low or row == high end
  again = view.Follow(p.Rows, 80, p.Margin, f)
  fits and kept and placeOf(again) == placeOf(f)
end

defn isScrolledByRows(p)
  (** The wheel moves the screen by rows, through the blocks as through the lines, from the first row of the file to the last row of its last line. *)
  b = buffered(p)
  u = view.Under(b)
  last = rowsAbove(p.Lines + 1, u) - 1
  k = p.Line - 20
  placeOf(view.Scrolled(k, b)) == list.Max(0, list.Min(placeOf(b) + k, last))
end

defn isWheeledFollows(p)
  (** After the wheel, the cursor is on a line of the screen that Follow keeps, or on the line of the screen nearest to it when none does; the screen holds
      only when no line's words are on it. *)
  b = view.Wheeled(p.Rows, p.Margin, view.Scrolled(p.Line - 20, buffered(p)))
  u = view.Under(b)
  first = if view.SkipOf(b, u) > 0 b.Top + 1 else b.Top end
  shown = list.Range(first, list.Min(p.Lines, view.LineAtRow(p.Rows - 1, b, u)))
  row = view.RowOf(b.Cursor.Line, b, u)
  if view.HoldOf(b) == "wheel"
    value.Len(shown) == 0
  else
    onScreen = 0 <= row and row < p.Rows
    keeps = view.Keeps(b.Cursor.Line, p.Rows, p.Margin, b)
    onScreen and (keeps or not list.Any([view.Keeps(n, p.Rows, p.Margin, b) for n in shown]))
  end
end

blocks = gen.List(gen.Of({Line: gen.Int(1, 40), Rows: gen.Int(1, 16)}), max = 3)
places = gen.Of({Lines: gen.Int(1, 40), Rows: gen.Int(1, 14), Margin: gen.Int(0, 6), Top: gen.Int(1, 40), Skip: gen.Int(0, 16), Line: gen.Int(1, 40),
  Blocks: blocks})
isFollowSettledAlways() = test.ForAll(isFollowSettled, places, cases = 500)
isScrolledByRowsAlways() = test.ForAll(isScrolledByRows, places, cases = 300)
isWheeledFollowsAlways() = test.ForAll(isWheeledFollows, places, cases = 300)

defn isFollowStateMoves()
  b = text.Of(manyLines(100), "a.ce")
  b.Cursor = {Line: 80, Column: 0}
  s = view.FollowState(0, stateOf([b], 800, 600))
  s.Buffers[1].Top > 1
end

defn scrolledSide()
  (** M5 and M6: a click in the margins of the code area is on the nearest cell of the screen. A drag isn't kept there, so that the screen can follow it. *)
  b = text.Of(str.Join("", list.Map(n -> "x", list.Range(1, 100))), "a.ce")
  b.Left = 40
  stateOf([b], 800, 600)
end
isClickInGutterScrolled() = view.ClickAt(10, 4, scrolledSide()) == {Line: 1, Column: 40}
isDragInGutterScrolled() = view.PositionAt(10, 4, scrolledSide()) == {Line: 1, Column: 34}
isClickUnderLastRow() = view.ClickAt(view.Gutter, 540, stateOf([text.Of(manyLines(100), "a.ce")], 800, 600)).Line == 28
isDragUnderLastRow() = view.PositionAt(view.Gutter, 540, stateOf([text.Of(manyLines(100), "a.ce")], 800, 600)).Line == 29
defn isClickAboveFirstRow()
  b = text.Of(manyLines(100), "a.ce")
  b.Top = 10
  view.ClickAt(view.Gutter, 1, stateOf([b], 800, 600)).Line == 10
end
isClickWithNoRows() = view.ClickAt(view.Gutter, 37, stateOf([text.Of(manyLines(3), "a.ce")], 800, 60)).Line == 1

(** M12: the one layout of a state. *)
isLayoutOf() = view.LayoutOf(stateOf([text.Of("", "a.ce")], 800, 600)).Rows == 28 and view.LayoutOf(stateOf([text.Of("", "a.ce")], 800, 600)).Code.Height == 554

defn longLine(left)
  (** A window 800 wide shows 91 columns, from 0 to 90: a click past the last one stays on it, and a drag is not kept there, so that the screen can follow it. *)
  b = text.Of(str.Repeat(200, "x"), "a.ce")
  b.Left = left
  stateOf([b], 800, 600)
end
isClickPastLastColumn() = view.ClickAt(799, 4, longLine(0)) == {Line: 1, Column: 90}
isClickPastLastColumnScrolled() = view.ClickAt(799, 4, longLine(40)) == {Line: 1, Column: 130}
isClickOnLastColumn() = view.ClickAt(view.Gutter + 90 * 8, 4, longLine(0)) == {Line: 1, Column: 90}
isDragPastLastColumn() = view.PositionAt(799, 4, longLine(0)) == {Line: 1, Column: 92}
isClickWithNoColumns() = view.ClickAt(50, 4, stateOf([text.Of(str.Repeat(200, "x"), "a.ce")], 60, 600)) == {Line: 1, Column: 0}

defn fruitList(filter)
  (** A list shows its name in the mode line, its filter in the prompt line, and its rows in one plain color. *)
  b = text.Of("apple\nend 12", missing)
  b.List = {Name: "Fruits", Rows: s -> [], Keys: () -> {}, Filter: filter, Items: [10, 20], Back: 1}
  b
end
isListNamed() = "Fruits" in textsOf(view.View(stateOf([fruitList("")], 800, 600))) and view.BufferName(fruitList("")) == "Fruits"
isListFilterShown() = "Filter: an" in textsOf(view.View(stateOf([fruitList("an")], 800, 600)))
defn labelled(filter)
  (** A list whose filter line starts with its own label, as the folders show their path. *)
  b = fruitList(filter)
  l = b.List
  l.Label = "/p/"
  b.List = l
  b
end
isListLabelShown() = "/p/an" in textsOf(view.View(stateOf([labelled("an")], 800, 600))) and not ("Filter: an" in textsOf(view.View(stateOf([labelled("an")], 800, 600))))
(** end 12 would be a keyword and a number in code: a row is one plain text. *)
isListPlain() = value.Len(list.Filter(c -> c.Kind == "text" and c.Text == "end 12" and c.Color == look.Theme.Syntax[color.Plain], view.View(stateOf([fruitList("")], 800, 600)))) == 1

defn partedList()
  (** A list whose second row gives its parts, each with its color, as the folders color a name and a size. *)
  b = fruitList("")
  l = b.List
  l.Parts = [missing, [[color.Number, "end"], [color.Plain, " 12"]]]
  b.List = l
  b
end
drawn(words, role, b) = value.Len(list.Filter(c -> c.Kind == "text" and c.Text == words and c.Color == look.Theme.Syntax[role], view.View(stateOf([b], 800, 600)))) == 1
isListRowParts() = drawn("end", color.Number, partedList()) and drawn(" 12", color.Plain, partedList()) and drawn("apple", color.Plain, partedList())

defn twoPanes(along, buffers, active)
  (** Panes. A state of two panes cut along "rows" or "columns", the first showing buffer 1 and the second the last buffer, with pane active being edited. *)
  s = stateOf(buffers, 800, 600)
  s.Panes = panes.WithLeaf(2, panes.One(value.Len(buffers)), panes.Split(1, along, panes.One(1)))
  s.Pane = active
  s.Current = panes.At(active, s.Panes).Buffer
  s
end
defn hundredAt(line)
  (** A buffer of 100 lines with the cursor on a line. *)
  b = text.Of(manyLines(100), "a.ce")
  b.Cursor = {Line: line, Column: 0}
  b
end
(** The cursor bars of a frame: rectangles 2 pixels wide. *)
barsOf(commands) = list.Filter(c -> c.Kind == "rect" and c.Width == 2 and c.Height == 19, commands)

isStartHasOnePane() = panes.Count(stateOf([text.Of("", "a.ce")], 800, 600).Panes) == 1 and stateOf([text.Of("", "a.ce")], 800, 600).Pane == 1
defn isViewOfKeepsPlace()
  b = hundredAt(40)
  b.Top = 30
  b.Left = 2
  b.Skip = 2
  b.Hold = "mouse"
  v = view.ViewOf(b)
  put = view.WithView(v, text.Of(manyLines(100), "a.ce"))
  put.Cursor == {Line: 40, Column: 0} and put.Top == 30 and put.Skip == 2 and put.Left == 2 and put.Hold == "mouse" and value.IsMissing(put.Mark)
end
defn isWithViewClamps()
  v = view.ViewOf(hundredAt(90))
  v.Top = 85
  put = view.WithView(v, text.Of(manyLines(10), "a.ce"))
  put.Cursor.Line == 10 and put.Top == 10
end
isWithViewMissingKeepsBuffer() = view.WithView(missing, hundredAt(7)).Cursor.Line == 7
defn isPaneLayoutOfAreaIsLayout()
  lay = view.Layout(800, 600, cell, false)
  one = view.PaneLayout(lay.Area, cell)
  one.Code == lay.Code and one.Mode == lay.Mode and one.Rows == lay.Rows and one.Columns == lay.Columns
end
defn isOutputUnderPanes()
  lay = view.Layout(800, 600, cell, true)
  lay.Output.Y + lay.Output.Height == lay.Prompt.Y and lay.Mode.Y + lay.Mode.Height == lay.Output.Y
end
isLayoutOfActivePane() = view.LayoutOf(twoPanes("rows", [hundredAt(1)], 2)).Code.Y == 289 and view.LayoutOf(twoPanes("rows", [hundredAt(1)], 2)).Rows == 13
isLayoutOfColumns() = view.LayoutOf(twoPanes("columns", [hundredAt(1)], 2)).Code.X == 400 and view.LayoutOf(twoPanes("columns", [hundredAt(1)], 2)).Rows == 28
isPaneAt() = view.PaneAt(10, 300, twoPanes("rows", [hundredAt(1)], 1)) == 2 and view.PaneAt(10, 10, twoPanes("rows", [hundredAt(1)], 1)) == 1 and view.PaneAt(10, 590, twoPanes("rows", [hundredAt(1)], 1)) == 0
isTwoModeLines() = ("a.ce" in textsOf(view.View(twoPanes("rows", [text.Of("a", "a.ce"), text.Of("b", "b.ce")], 1)))) and ("b.ce" in textsOf(view.View(twoPanes("rows", [text.Of("a", "a.ce"), text.Of("b", "b.ce")], 1))))
defn isInactivePaneShowsItsPlace()
  s = twoPanes("rows", [hundredAt(1)], 1)
  v = view.ViewOf(hundredAt(60))
  v.Top = 55
  s.Panes = panes.WithLeaf(2, {Buffer: 1, View: v}, s.Panes)
  shown = list.Filter(c -> c.Kind == "text" and c.Y >= 289 and c.Y < 289 + 265, view.View(s))
  "55" in list.Map(c -> c.Text, shown) and not ("1" in list.Map(c -> c.Text, shown))
end
defn isOneBrightBar()
  bars = barsOf(view.View(view.FollowState(0, twoPanes("rows", [hundredAt(1)], 1))))
  value.Len(bars) == 2 and value.Len(list.Filter(c -> c.Color == look.Theme.Bright, bars)) == 1 and list.Filter(c -> c.Color == look.Theme.Bright, bars)[1].Y < 289
end
isDividerBetweenColumns() = value.Len(list.Filter(c -> c.Kind == "rect" and c.X == 400 and c.Width == 1, view.View(twoPanes("columns", [hundredAt(1)], 1)))) == 1
isNoDividerAlone() = value.Len(list.Filter(c -> c.Kind == "rect" and c.Width == 1 and c.Height > 100, view.View(stateOf([hundredAt(1)], 800, 600)))) == 0
defn isFollowStateFollowsEveryPane()
  s = twoPanes("rows", [hundredAt(1)], 1)
  s.Panes = panes.WithLeaf(2, {Buffer: 1, View: view.ViewOf(hundredAt(80))}, s.Panes)
  f = view.FollowState(0, s)
  leaf = panes.At(2, f.Panes)
  leaf.View.Top > 60 and f.Buffers[1].Top == 1 and f.Buffers[1].Colors.Known >= 80
end

(* The marks of a check: an underline, the number in color, the words after the line, the count in the mode line, and the prompt line on the cursor's line. *)
markOf(line, column, stop, severity, message) = {Line: line, Column: column, End: stop, Severity: severity, Message: message, Hint: "a hint"}
markedState() = stateOf([text.WithMarks([markOf(1, 0, 4, "error", "Name \"Prnt\" doesn't exist."), markOf(1, 5, 6, "warning", "w"), markOf(2, 0, 1, "warning", "late")],
  text.Of("Prnt(1)\nx", "a.ce"))], 800, 600)
framed() = view.View(markedState())
isMarkUnderlined() = value.Len(list.Filter(c -> c.Kind == "rect" and c.Color == view.ErrorColor and c.Height == 2 and c.Width == 32, framed())) == 1
isMarkNumberColored() = value.Len(list.Filter(c -> c.Kind == "text" and c.Text == "1" and c.Color == view.ErrorColor, framed())) == 1
isMarkWordsAfterLine() = "Name \"Prnt\" doesn't exist. (+1)" in textsOf(framed())
isMarkCountInMode() = view.MarkCount(markedState().Buffers[1]) == "1 error, 2 warnings" and "1 error, 2 warnings" in textsOf(framed())
isMarkOnPromptLine() = "Name \"Prnt\" doesn't exist.  a hint" in textsOf(framed())
defn isMarkUnderCursorOnPromptLine()
  (** On the span of the second mark of a line, the prompt line tells that one, and past every span the first one again. *)
  s = markedState()
  s.Buffers[1] = text.Place(1, 5, s.Buffers[1])
  far = s
  far.Buffers[1] = text.Place(1, 7, s.Buffers[1])
  "w  a hint" in textsOf(view.View(s)) and "Name \"Prnt\" doesn't exist.  a hint" in textsOf(view.View(far))
end
isNoMarkNoCount() = view.MarkCount(text.Of("", missing)) == ""
defn isMarkWordsCut()
  s = markedState()
  s.Width = 200
  texts = textsOf(view.View(s))
  not ("Name \"Prnt\" doesn't exist. (+1)" in texts) and value.Len(list.Filter(t -> str.StartsWith("Name", t), texts)) >= 1
end

(* ---- What a run shows: a breakpoint in the gutter, the value of an eval after its line, the variables at a stop. *)

defn ranOn(words)
  (** A state on a file with a run that stopped on its line 2, i = 4 there, and the answer of an eval on its line 1. *)
  s = stateOf([text.Of(words, "a.ce")], 800, 600)
  stop = "$(run.Mark){\"Kind\":\"stop\",\"File\":\"a.ce\",\"Line\":2,\"Reason\":\"break\",\"Error\":\"\",\"Fiber\":0,\"Vars\":[{\"Name\":\"i\",\"Value\":\"4\"}]}\n"
  answer = "$(run.Mark){\"Kind\":\"value\",\"Id\":1,\"Ok\":true,\"Text\":\"42\"}\n"
  s.Run = run.Read(answer, run.Read(stop, run.Ask("x", "a.ce", 1, run.Empty())))
  s.Breaks = [{Path: "a.ce", Line: 2}]
  s
end

isValueAfterLine() = not value.IsMissing(list.IndexOf("= 42", textsOf(view.View(ranOn("x = 1\ny = 2\n")))))   (** The answer, grey, after line 1. *)
isVariablesShown() = not value.IsMissing(list.IndexOf("i = 4", textsOf(view.View(ranOn("x = 1\ny = 2\n")))))   (** The pane lists the variables at a stop. *)
isBreakDotDrawn() = value.Len(list.Filter(c -> c.Kind == "box" and c.Color == 0xE06C75, view.View(ranOn("x = 1\ny = 2\n")))) == 1   (** One dot, on line 2. *)
isOutputHidden() = not view.ShowsOutput(hidden(ranOn("x")))   (** C-c c h hides the pane. *)

defn hidden(state)
  (** The state with its output hidden. *)
  s = state
  r = s.Run
  r.Shown = false
  s.Run = r
  s
end
use core/run

(* ---- The rows that follow keeps from one frame to the next only spare work: the view draws the same with them as without, also when the text changed
   after the last follow. *)

defn withoutRows(state)
  (** The state with no row kept, so that the view reads every line itself. *)
  s = state
  s.Buffers[1].Screen = dict.Dict()
  s
end

defn isSameViewAfter(p)
  (** Edits a buffer step by step, in a window of 14 columns, following after some steps only, and compares the view with and without the rows kept. *)
  s = view.FollowState(0, stateOf([text.Of(p.Text, "a.ce")], 200, 140))
  for step in p.Steps
    s.Buffers[1] = text.InsertWords(step.Words, text.Place(step.Line, step.Column, s.Buffers[1]))
    if step.Follow
      s = view.FollowState(0, s)
    end
    if not value.Equal(view.View(s), view.View(withoutRows(s)))
      return false
    end
  end
  true
end

rowSteps = gen.List(gen.Of({Line: gen.Int(1, 9), Column: gen.Int(0, 30), Words: gen.Text(max = 4, chars = "x\"(*) \né"), Follow: gen.Bool()}), max = 12)
isKeptRowsSameView() = test.ForAll(isSameViewAfter, gen.Of({Text: gen.Text(max = 60, chars = "ab \"(*)\n\\é"), Steps: rowSteps}), cases = 300)

(* At the end of a line of 300 KB of code, the row of the line keeps the stops of its crossing; after an edit, the row made again crosses from the stops
   before the edit, and the view is the one that a reading from the start of the line gives: edits at the end, in the middle and at the start, of a
   comment, of a text and of a quote, the screen kept at the end of the line, each followed or not. *)
longCode = str.Repeat(9677, "f(a, \"b c\", 12) + x.y (* z *) ")
defn isStopsSameView()
  s = view.FollowState(0, stateOf([text.Place(2, value.Len(longCode), text.Of("first\n$longCode\nlast", "a.ce"))], 800, 600))
  crossed = value.Len(dict.Get(longCode, s.Buffers[1].Screen).Stops) == 4
  for step in [[300000, "x", true], [299990, "(* ", true], [150000, "\"", true], [299995, "y", false], [10, "*)", true], [200000, "\"", true],
      [300010, "z", true]]
    b = text.InsertWords(step[2], text.Place(2, step[1], s.Buffers[1]))
    s.Buffers[1] = text.Place(2, text.LineWidth(2, b), b)
    if step[3]
      s = view.FollowState(0, s)
    end
    if not value.Equal(view.View(s), view.View(withoutRows(s)))
      return false
    end
  end
  crossed
end

defn isRowsKeptByText()
  (** Follow keeps one row per text of the lines on the screen, made for the width and the state at the start of each line. *)
  b = view.Follow(3, 80, 0, text.Of("a = 1\n(* b\nc *)\nd", "a.ce"))
  rows = b.Screen
  value.Len(dict.Keys(rows)) == 3 and dict.Get("c *)", rows).State.Comment == 1 and dict.Get("a = 1", rows).Width == 80 and value.IsMissing(dict.Get("d", rows))
end

(* ---- A far place is shown at once, with its colors guessed, and exact after the ticks that read the lines before it: a comment that opens at line
   45,000, after the colors that the first follow reads, makes the last line a comment. *)
farText = str.Join("\n", list.Concat(list.Fill("x", 44999), list.Concat(["(* opened far above"], list.Concat(list.Fill("y", 55000), ["z"]))))
farState() = view.FollowState(0, stateOf([text.Place(100001, 0, text.Of(farText, "a.ce"))], 800, 600))
colorOfZ(s) = list.Map(c -> c.Color, list.Filter(c -> c.Kind == "text" and c.Text == "z", view.View(s)))

defn ticked(state)
  (** The state after the follows of the ticks, until the colors are known or 20 have passed. *)
  s = state
  k = 0
  while view.Colouring(s) and k < 20
    s = view.FollowState(0, s)
    k += 1
  end
  s
end

isFarPlaceAtOnce() = farState().Buffers[1].Colors.Known == 1 + view.ColorBatch() and view.Colouring(farState()) and value.Equal(colorOfZ(farState()), [look.Theme.Syntax[color.Plain]])
isFarColorsExactAfter() = not view.Colouring(ticked(farState())) and value.Equal(colorOfZ(ticked(farState())), [look.Theme.Syntax[color.Comment]]) and value.Equal(view.View(ticked(farState())), view.View(withoutRows(ticked(farState()))))
isNearPlaceExact() = not view.Colouring(view.FollowState(0, stateOf([text.Place(view.ColorBatch() - 100, 0, text.Of(farText, "a.ce"))], 800, 600)))

(* ---- Blocks under lines, as the results of cells: rows that no line holds. *)

(** A block of rows rows under line, drawn as one text. *)
blockAt(line, rows, words) = {Line: line, Rows: rows, Draw: (width, lk) -> [{Kind: "text", X: 0, Y: 0, Text: words, Color: 0}]}

withBlock(line, rows) = text.WithBlocks([blockAt(line, rows, "result")], text.Of(manyLines(100), "a.ce"))

isRowAfterBlock() = view.RowOf(5, withBlock(2, 3), view.Under(withBlock(2, 3))) == 7   (** Line 5 comes three rows later. *)

defn isLineAtRowOfBlock()
  (** A row inside a block is the row of the line above it; the row after it, the next line. *)
  b = withBlock(2, 3)
  u = view.Under(b)
  view.LineAtRow(2, b, u) == 2 and view.LineAtRow(4, b, u) == 2 and view.LineAtRow(5, b, u) == 3
end

defn isFollowCountsBlocks()
  (** The cursor on line 10 of a screen of 10 rows moves the screen when a block of 3 rows is above it: by rows, so that the screen starts inside the
      block, its first two rows above. *)
  b = withBlock(2, 3)
  b.Cursor = {Line: 10, Column: 0}
  f = view.Follow(10, 80, 0, b)
  f.Top == 2 and f.Skip == 2 and view.RowOf(10, f, view.Under(f)) == 9
end

defn isBlockDrawnUnderItsLine()
  (** The block's words are drawn on the row under its line, and fewer lines fit. *)
  state = stateOf([withBlock(2, 3)], 800, 600)
  layout = view.Layout(state.Width, state.Height, state.Cell, false)
  s = state
  s.Buffers = [view.Follow(layout.Rows, layout.Columns, 0, state.Buffers[1])]
  drawn = view.View(s)
  result = list.Filter(c -> c.Kind == "text" and c.Text == "result", drawn)
  words = value.Len(list.Filter(t -> t == "word", textsOf(drawn)))
  value.Len(result) == 1 and result[1].Y == list.Filter(c -> c.Kind == "text" and c.Text == "3", drawn)[1].Y - 19 * 3 and words == layout.Rows - 3
end

defn isBlockMovesWithItsLine()
  (** A line added above a block moves it down; a line added at the end of its line puts the block under the new one. *)
  b = withBlock(3, 2)
  b.Cursor = {Line: 1, Column: 0}
  above = text.NewLine(b)
  c = withBlock(3, 2)
  c.Cursor = {Line: 3, Column: 4}
  after = text.NewLine(c)
  text.BlocksOf(above)[1].Line == 4 and text.BlocksOf(after)[1].Line == 4
end
