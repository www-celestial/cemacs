(** Tests of view.ce and text.Of: run with cesia test . *)
use core/color
use core/text
use core/view
use src/rope
use src/history
use core/panes
use src/ui
use std/text as str
use std/list
use std/value

cell = {Width: 8, Height: 19}
look = ui.Look(ui.Dark, (words, font) -> value.Len(words) * 8, 19)

stateOf(buffers, width, height) = view.Start(buffers, look, cell, width, height)

manyLines(count) = str.Join("\n", list.Map(n -> "word", list.Range(1, count)))   (** A text of count lines, each one "word". *)

textsOf(commands) = list.Map(c -> c.Text, list.Filter(c -> c.Kind == "text", commands))

isOnlyVisibleLines() = isOnlyVisible(stateOf([text.Of(manyLines(20000), "a.ce")], 800, 600))

defn isOnlyVisible(state)
  layout = view.Layout(state.Width, state.Height, state.Cell, false)
  b = view.Follow(layout.Rows, layout.Columns, state.Buffers[1])
  s = state
  s.Buffers = [b]
  shown = value.Len(list.Filter(t -> t == "word", textsOf(view.View(s))))
  shown > 0 and shown <= layout.Rows
end

defn isLongLineFollows()
  b = text.Of(str.Join("", list.Map(n -> "x", list.Range(1, 600))), "a.ce")
  b.Cursor = {Line: 1, Column: 500}
  f = view.Follow(10, 80, b)
  f.Left <= 500 and 500 < f.Left + 80
end

defn isFollowScrollsDown()
  b = text.Of(manyLines(100), "a.ce")
  b.Cursor = {Line: 50, Column: 0}
  f = view.Follow(10, 80, b)
  f.Top <= 50 and 50 < f.Top + 10 and f.Colors.Known >= 50
end

defn isFollowKeepsTop()
  b = text.Of(manyLines(100), "a.ce")
  b.Cursor = {Line: 3, Column: 2}
  f = view.Follow(10, 80, b)
  f.Top == 1 and f.Left == 0
end

defn isTinyWindow()
  s = stateOf([text.Of("a\nb", "a.ce")], 10, 10)
  lay = view.Layout(s.Width, s.Height, s.Cell, false)
  s.Buffers = [view.Follow(lay.Rows, lay.Columns, s.Buffers[1])]
  value.IsArray(view.View(s))
end

defn isNoTabs()
  (** No tabs: the code starts at the top of the window, and the name of a buffer that isn't current is nowhere on the screen. The mode line names the current one. *)
  a = text.Of("a", "/x/a.ce")
  b = text.Of("b", "/x/b.ce")
  b.Version = 3
  commands = view.View(stateOf([a, b], 800, 600))
  shown = textsOf(commands)
  "a.ce" in shown and not ("b.ce" in shown) and not ("b.ce *" in shown) and value.Len(list.Filter(c -> c.Kind == "box" and c.Width == 7, commands)) == 0
end
isCodeAtTop() = view.Layout(800, 600, cell, false).Code.Y == 0 and view.Layout(800, 600, cell, false).Rows == 28

isNoOutputPane() = view.Layout(800, 600, cell, false).Output.Height == 0
isOutputPane() = view.Layout(800, 600, cell, true).Output.Height > 0
isRowsFit() = view.Layout(800, 600, cell, false).Rows * 19 <= view.Layout(800, 600, cell, false).Code.Height
defn isOfFields()
  b = text.Of("a", "a.ce")
  value.IsMissing(b.Mark) and value.IsMissing(b.Disk) and b.Version == 0 and b.Saved == 0 and b.Top == 1 and b.Left == 0 and b.Path == "a.ce" and b.Colors.Known == 1 and b.Cursor.Line == 1 and b.Cursor.Column == 0 and history.CanUndo(b.History) == false
end
isOfRope() = rope.Text(text.Of("ab\ncd", "a.ce").Rope) == "ab\ncd"

defn shownFrom(words, left)
  (** The commands of a one-buffer window 102 pixels wide, so that 4 columns of code fit, showing words from column left. *)
  b = text.Of(words, "a.ce")
  b.Left = left
  view.View(stateOf([b], 102, 600))
end

(** Is this command a text of the code area? The mode line and the prompt are not: the window is 600 high, and the first line is at 4. *)
inCode(c) = c.Kind == "text" and c.Y < 100

(** The texts in the code area, the line number first. *)
codeTexts(commands) = list.Map(c -> c.Text, list.Filter(c -> inCode(c), commands))

isFourColumns() = view.Layout(102, 600, cell, false).Columns == 4
isCutToColumns() = value.Equal(codeTexts(shownFrom("abcdefghij", 3)), ["1", "defg"])

defn isCutX()
  first = list.Filter(c -> inCode(c) and c.Text == "defg", shownFrom("abcdefghij", 3))[1]
  first.X == view.Gutter
end

defn isTokenStraddlingLeft()
  commands = list.Filter(c -> inCode(c) and c.Text != "1", shownFrom("defn x", 2))
  value.Equal(list.Map(c -> c.Text, commands), ["fn", " x"]) and commands[2].X == view.Gutter + 16 and commands[1].Color == ui.Dark.Syntax[color.Keyword]
end

isLineShorterThanLeft() = value.Equal(codeTexts(shownFrom("ab", 5)), ["1"])
isMultibyteCutLikeAscii() = value.Equal(list.Map(t -> value.Len(t), codeTexts(shownFrom("ééééé", 2))), list.Map(t -> value.Len(t), codeTexts(shownFrom("eeeee", 2))))
isMultibyteText() = value.Equal(codeTexts(shownFrom("ééééé", 2)), ["1", "ééé"])

defn isEmptyFile()
  s = stateOf([text.Of("", "a.ce")], 800, 600)
  lay = view.Layout(s.Width, s.Height, s.Cell, false)
  s.Buffers = [view.Follow(lay.Rows, lay.Columns, s.Buffers[1])]
  value.IsArray(view.View(s)) and s.Buffers[1].Top == 1
end

defn isCursorOnLastLine()
  b = text.Of(manyLines(3), "a.ce")
  b.Cursor = {Line: 3, Column: 0}
  s = stateOf([b], 800, 600)
  lay = view.Layout(s.Width, s.Height, s.Cell, false)
  s.Buffers = [view.Follow(lay.Rows, lay.Columns, b)]
  bars = list.Filter(c -> c.Kind == "rect" and c.Width == 2, view.View(s))
  value.Len(bars) == 1 and value.Len(list.Filter(t -> t == "word", textsOf(view.View(s)))) == 3
end

defn isFollowWithoutRows()
  b = text.Of(manyLines(10), "a.ce")
  b.Cursor = {Line: 5, Column: 3}
  f = view.Follow(0, 0, b)
  f.Top <= 5 and f.Left <= 3
end

defn isCursorBarInsideColumns()
  b = text.Of("abcd", "a.ce")
  b.Cursor = {Line: 1, Column: 4}
  s = stateOf([b], 102, 600)
  s.Buffers = [view.Follow(4, 4, b)]
  bars = list.Filter(c -> c.Kind == "rect" and c.Width == 2, view.View(s))
  value.Len(bars) == 1 and bars[1].X < 102
end

(** The rectangles of the theme fill color: the selection. *)
fills(commands) = list.Filter(c -> c.Kind == "rect" and c.Color == ui.Dark.Fill, commands)

defn selectedState(words, mark, cursor)
  b = text.Of(words, "a.ce")
  b.Mark = mark
  b.Cursor = cursor
  stateOf([b], 800, 600)
end

defn isSelectionOneLine()
  s = selectedState("abcdef", {Line: 1, Column: 1}, {Line: 1, Column: 4})
  f = fills(view.View(s))
  value.Len(f) == 1 and f[1].X == view.Gutter + 8 and f[1].Width == 24 and f[1].Height == 19
end

defn isSelectionBackwards()
  s = selectedState("abcdef", {Line: 1, Column: 4}, {Line: 1, Column: 1})
  f = fills(view.View(s))
  value.Len(f) == 1 and f[1].X == view.Gutter + 8 and f[1].Width == 24
end

defn isSelectionLines()
  s = selectedState("abc\ndef\nghi", {Line: 1, Column: 2}, {Line: 3, Column: 1})
  f = fills(view.View(s))
  value.Len(f) == 3 and f[1].Width == 16 and f[2].Width == 32 and f[3].Width == 8 and f[2].Y == f[1].Y + 19
end

isNoSelectionNoFill() = value.Len(fills(view.View(selectedState("abc", missing, {Line: 1, Column: 1})))) == 0
isEmptySelectionNoFill() = value.Len(fills(view.View(selectedState("abc", {Line: 1, Column: 1}, {Line: 1, Column: 1})))) == 0

defn isSelectionUnderText()
  commands = view.View(selectedState("abc", {Line: 1, Column: 0}, {Line: 1, Column: 2}))
  firstFill = list.IndexOf(fills(commands)[1], commands)
  firstText = list.IndexOf(list.Filter(c -> c.Kind == "text" and c.Text == "abc", commands)[1], commands)
  firstFill < firstText
end

defn isSelectionCutToScreen()
  b = text.Of("abcdefghij", "a.ce")
  b.Mark = {Line: 1, Column: 0}
  b.Cursor = {Line: 1, Column: 10}
  b.Left = 3
  f = fills(view.View(stateOf([b], 102, 600)))
  value.Len(f) == 1 and f[1].X == view.Gutter and f[1].Width == 32
end

defn isPromptDrawn()
  s = stateOf([text.Of("a", "a.ce")], 800, 600)
  s.Prompt = {Label: "Find file: ", Answer: "a.ce", Done: (a, t) -> t, Choice: false}
  commands = view.View(s)
  bars = list.Filter(c -> c.Kind == "rect" and c.Width == 2 and c.Y > 500, commands)
  "Find file: a.ce" in textsOf(commands) and value.Len(bars) == 1 and bars[1].X == 12 + value.Len("Find file: a.ce") * 8
end

defn isMessageDrawn()
  s = stateOf([text.Of("a", "a.ce")], 800, 600)
  s.Message = "Saved a.ce"
  commands = view.View(s)
  "Saved a.ce" in textsOf(commands) and value.Len(list.Filter(c -> c.Kind == "rect" and c.Width == 2 and c.Y > 500, commands)) == 0
end

defn isPositionAt()
  s = stateOf([text.Of("abcd\nefgh", "a.ce")], 800, 600)
  p = view.PositionAt(view.Gutter + 17, 4 + 19 + 3, s)
  p == {Line: 2, Column: 2}
end

isPositionClamped() = view.PositionAt(790, 590, stateOf([text.Of("abcd\nefgh", "a.ce")], 800, 600)) == {Line: 2, Column: 4}
isPositionBeforeText() = view.PositionAt(0, 0, stateOf([text.Of("abcd\nefgh", "a.ce")], 800, 600)) == {Line: 1, Column: 0}

defn isPositionWithScroll()
  b = text.Of(manyLines(50), "a.ce")
  b.Top = 10
  b.Left = 0
  view.PositionAt(view.Gutter, 4, stateOf([b], 800, 600)).Line == 10
end

defn isPositionOnCursorBar()
  b = text.Of("abcdef", "a.ce")
  b.Cursor = {Line: 1, Column: 3}
  s = stateOf([b], 800, 600)
  bar = list.Filter(c -> c.Kind == "rect" and c.Width == 2 and c.Y < 100, view.View(s))[1]
  view.PositionAt(bar.X + 1, bar.Y + 1, s).Column == 3
end


defn isInCode()
  s = stateOf([text.Of("a", "x.ce")], 800, 600)
  view.IsInCode(10, 100, s) and view.IsInCode(10, 10, s) and not view.IsInCode(10, 560, s) and not view.IsInCode(10, 590, s)
end

defn isFollowFreeKeepsTop()
  b = text.Of(manyLines(100), "a.ce")
  b.Top = 60
  b.Free = true
  f = view.Follow(10, 80, b)
  f.Top == 60 and f.Colors.Known >= 60
end

defn isFollowStateMoves()
  b = text.Of(manyLines(100), "a.ce")
  b.Cursor = {Line: 80, Column: 0}
  s = view.FollowState(stateOf([b], 800, 600))
  s.Buffers[1].Top > 1
end

defn scrolledSide()
  (** M5 and M6: a click in the margins of the code area is on the nearest cell of the screen. A drag isn't kept there, so that the screen can follow it. *)
  b = text.Of(str.Join("", list.Map(n -> "x", list.Range(1, 100))), "a.ce")
  b.Left = 40
  stateOf([b], 800, 600)
end
isClickInGutterScrolled() = view.ClickAt(10, 4, scrolledSide()) == {Line: 1, Column: 40}
isDragInGutterScrolled() = view.PositionAt(10, 4, scrolledSide()) == {Line: 1, Column: 34}
isClickUnderLastRow() = view.ClickAt(view.Gutter, 540, stateOf([text.Of(manyLines(100), "a.ce")], 800, 600)).Line == 28
isDragUnderLastRow() = view.PositionAt(view.Gutter, 540, stateOf([text.Of(manyLines(100), "a.ce")], 800, 600)).Line == 29
defn isClickAboveFirstRow()
  b = text.Of(manyLines(100), "a.ce")
  b.Top = 10
  view.ClickAt(view.Gutter, 1, stateOf([b], 800, 600)).Line == 10
end
isClickWithNoRows() = view.ClickAt(view.Gutter, 37, stateOf([text.Of(manyLines(3), "a.ce")], 800, 60)).Line == 1

(** M12: the one layout of a state. *)
isLayoutOf() = view.LayoutOf(stateOf([text.Of("", "a.ce")], 800, 600)).Rows == 28 and view.LayoutOf(stateOf([text.Of("", "a.ce")], 800, 600)).Code.Height == 554

defn longLine(left)
  (** A window 800 wide shows 91 columns, from 0 to 90: a click past the last one stays on it, and a drag is not kept there, so that the screen can follow it. *)
  b = text.Of(str.Repeat(200, "x"), "a.ce")
  b.Left = left
  stateOf([b], 800, 600)
end
isClickPastLastColumn() = view.ClickAt(799, 4, longLine(0)) == {Line: 1, Column: 90}
isClickPastLastColumnScrolled() = view.ClickAt(799, 4, longLine(40)) == {Line: 1, Column: 130}
isClickOnLastColumn() = view.ClickAt(view.Gutter + 90 * 8, 4, longLine(0)) == {Line: 1, Column: 90}
isDragPastLastColumn() = view.PositionAt(799, 4, longLine(0)) == {Line: 1, Column: 92}
isClickWithNoColumns() = view.ClickAt(50, 4, stateOf([text.Of(str.Repeat(200, "x"), "a.ce")], 60, 600)) == {Line: 1, Column: 0}

defn fruitList(filter)
  (** A list shows its name in the mode line, its filter in the prompt line, and its rows in one plain color. *)
  b = text.Of("apple\nend 12", missing)
  b.List = {Name: "Fruits", Rows: s -> [], Keys: () -> {}, Filter: filter, Items: [10, 20], Back: 1}
  b
end
isListNamed() = "Fruits" in textsOf(view.View(stateOf([fruitList("")], 800, 600))) and view.BufferName(fruitList("")) == "Fruits"
isListFilterShown() = "Filter: an" in textsOf(view.View(stateOf([fruitList("an")], 800, 600)))
defn labelled(filter)
  (** A list whose filter line starts with its own label, as the folders show their path. *)
  b = fruitList(filter)
  l = b.List
  l.Label = "/p/"
  b.List = l
  b
end
isListLabelShown() = "/p/an" in textsOf(view.View(stateOf([labelled("an")], 800, 600))) and not ("Filter: an" in textsOf(view.View(stateOf([labelled("an")], 800, 600))))
(** end 12 would be a keyword and a number in code: a row is one plain text. *)
isListPlain() = value.Len(list.Filter(c -> c.Kind == "text" and c.Text == "end 12" and c.Color == look.Theme.Syntax[color.Plain], view.View(stateOf([fruitList("")], 800, 600)))) == 1

defn partedList()
  (** A list whose second row gives its parts, each with its color, as the folders color a name and a size. *)
  b = fruitList("")
  l = b.List
  l.Parts = [missing, [[color.Number, "end"], [color.Plain, " 12"]]]
  b.List = l
  b
end
drawn(words, role, b) = value.Len(list.Filter(c -> c.Kind == "text" and c.Text == words and c.Color == look.Theme.Syntax[role], view.View(stateOf([b], 800, 600)))) == 1
isListRowParts() = drawn("end", color.Number, partedList()) and drawn(" 12", color.Plain, partedList()) and drawn("apple", color.Plain, partedList())

defn twoPanes(along, buffers, active)
  (** Panes. A state of two panes cut along "rows" or "columns", the first showing buffer 1 and the second the last buffer, with pane active being edited. *)
  s = stateOf(buffers, 800, 600)
  s.Panes = panes.WithLeaf(2, panes.One(value.Len(buffers)), panes.Split(1, along, panes.One(1)))
  s.Pane = active
  s.Current = panes.At(active, s.Panes).Buffer
  s
end
defn hundredAt(line)
  (** A buffer of 100 lines with the cursor on a line. *)
  b = text.Of(manyLines(100), "a.ce")
  b.Cursor = {Line: line, Column: 0}
  b
end
(** The cursor bars of a frame: rectangles 2 pixels wide. *)
barsOf(commands) = list.Filter(c -> c.Kind == "rect" and c.Width == 2 and c.Height == 19, commands)

isStartHasOnePane() = panes.Count(stateOf([text.Of("", "a.ce")], 800, 600).Panes) == 1 and stateOf([text.Of("", "a.ce")], 800, 600).Pane == 1
defn isViewOfKeepsPlace()
  b = hundredAt(40)
  b.Top = 30
  b.Left = 2
  b.Free = true
  v = view.ViewOf(b)
  put = view.WithView(v, text.Of(manyLines(100), "a.ce"))
  put.Cursor == {Line: 40, Column: 0} and put.Top == 30 and put.Left == 2 and put.Free and value.IsMissing(put.Mark)
end
defn isWithViewClamps()
  v = view.ViewOf(hundredAt(90))
  v.Top = 85
  put = view.WithView(v, text.Of(manyLines(10), "a.ce"))
  put.Cursor.Line == 10 and put.Top == 10
end
isWithViewMissingKeepsBuffer() = view.WithView(missing, hundredAt(7)).Cursor.Line == 7
defn isPaneLayoutOfAreaIsLayout()
  lay = view.Layout(800, 600, cell, false)
  one = view.PaneLayout(lay.Area, cell)
  one.Code == lay.Code and one.Mode == lay.Mode and one.Rows == lay.Rows and one.Columns == lay.Columns
end
defn isOutputUnderPanes()
  lay = view.Layout(800, 600, cell, true)
  lay.Output.Y + lay.Output.Height == lay.Prompt.Y and lay.Mode.Y + lay.Mode.Height == lay.Output.Y
end
isLayoutOfActivePane() = view.LayoutOf(twoPanes("rows", [hundredAt(1)], 2)).Code.Y == 289 and view.LayoutOf(twoPanes("rows", [hundredAt(1)], 2)).Rows == 13
isLayoutOfColumns() = view.LayoutOf(twoPanes("columns", [hundredAt(1)], 2)).Code.X == 400 and view.LayoutOf(twoPanes("columns", [hundredAt(1)], 2)).Rows == 28
isPaneAt() = view.PaneAt(10, 300, twoPanes("rows", [hundredAt(1)], 1)) == 2 and view.PaneAt(10, 10, twoPanes("rows", [hundredAt(1)], 1)) == 1 and view.PaneAt(10, 590, twoPanes("rows", [hundredAt(1)], 1)) == 0
isTwoModeLines() = ("a.ce" in textsOf(view.View(twoPanes("rows", [text.Of("a", "a.ce"), text.Of("b", "b.ce")], 1)))) and ("b.ce" in textsOf(view.View(twoPanes("rows", [text.Of("a", "a.ce"), text.Of("b", "b.ce")], 1))))
defn isInactivePaneShowsItsPlace()
  s = twoPanes("rows", [hundredAt(1)], 1)
  v = view.ViewOf(hundredAt(60))
  v.Top = 55
  s.Panes = panes.WithLeaf(2, {Buffer: 1, View: v}, s.Panes)
  shown = list.Filter(c -> c.Kind == "text" and c.Y >= 289 and c.Y < 289 + 265, view.View(s))
  "55" in list.Map(c -> c.Text, shown) and not ("1" in list.Map(c -> c.Text, shown))
end
defn isOneBrightBar()
  bars = barsOf(view.View(view.FollowState(twoPanes("rows", [hundredAt(1)], 1))))
  value.Len(bars) == 2 and value.Len(list.Filter(c -> c.Color == look.Theme.Bright, bars)) == 1 and list.Filter(c -> c.Color == look.Theme.Bright, bars)[1].Y < 289
end
isDividerBetweenColumns() = value.Len(list.Filter(c -> c.Kind == "rect" and c.X == 400 and c.Width == 1, view.View(twoPanes("columns", [hundredAt(1)], 1)))) == 1
isNoDividerAlone() = value.Len(list.Filter(c -> c.Kind == "rect" and c.Width == 1 and c.Height > 100, view.View(stateOf([hundredAt(1)], 800, 600)))) == 0
defn isFollowStateFollowsEveryPane()
  s = twoPanes("rows", [hundredAt(1)], 1)
  s.Panes = panes.WithLeaf(2, {Buffer: 1, View: view.ViewOf(hundredAt(80))}, s.Panes)
  f = view.FollowState(s)
  leaf = panes.At(2, f.Panes)
  leaf.View.Top > 60 and f.Buffers[1].Top == 1 and f.Buffers[1].Colors.Known >= 80
end

(* The marks of a check: an underline, the number in color, the words after the line, the count in the mode line, and the prompt line on the cursor's line. *)
markOf(line, column, stop, severity, message) = {Line: line, Column: column, End: stop, Severity: severity, Message: message, Hint: "a hint"}
markedState() = stateOf([text.WithMarks([markOf(1, 0, 4, "error", "Name \"Prnt\" doesn't exist."), markOf(1, 5, 6, "warning", "w"), markOf(2, 0, 1, "warning", "late")],
  text.Of("Prnt(1)\nx", "a.ce"))], 800, 600)
framed() = view.View(markedState())
isMarkUnderlined() = value.Len(list.Filter(c -> c.Kind == "rect" and c.Color == view.ErrorColor and c.Height == 2 and c.Width == 32, framed())) == 1
isMarkNumberColored() = value.Len(list.Filter(c -> c.Kind == "text" and c.Text == "1" and c.Color == view.ErrorColor, framed())) == 1
isMarkWordsAfterLine() = "Name \"Prnt\" doesn't exist. (+1)" in textsOf(framed())
isMarkCountInMode() = view.MarkCount(markedState().Buffers[1]) == "1 error, 2 warnings" and "1 error, 2 warnings" in textsOf(framed())
isMarkOnPromptLine() = "Name \"Prnt\" doesn't exist.  a hint" in textsOf(framed())
isNoMarkNoCount() = view.MarkCount(text.Of("", missing)) == ""
defn isMarkWordsCut()
  s = markedState()
  s.Width = 200
  texts = textsOf(view.View(s))
  not ("Name \"Prnt\" doesn't exist. (+1)" in texts) and value.Len(list.Filter(t -> str.StartsWith("Name", t), texts)) >= 1
end
