(** Tests of keys.ce: run with cesia test . *)
use keys

press(key, ctrl, alt, shift) = {Kind: "key", Key: key, Ctrl: ctrl, Alt: alt, Shift: shift, Super: false}
plain(key) = press(key, false, false, false)
withCtrl(key) = press(key, true, false, false)
withAlt(key) = press(key, false, true, false)
withShift(key) = press(key, false, false, true)

isCtrl() = keys.Chord(withCtrl("f")) == "C-f"
isAlt() = keys.Chord(withAlt("w")) == "M-w"
isPlainLetterTypes() = IsMissing(keys.Chord(plain("a")))
isShiftLetterTypes() = IsMissing(keys.Chord(withShift("a")))
isPlainSpaceTypes() = IsMissing(keys.Chord(plain("space")))
isCtrlSpace() = keys.Chord(withCtrl("space")) == "C-space"
isEnter() = keys.Chord(plain("enter")) == "enter"
isTab() = keys.Chord(plain("tab")) == "tab"
isBackspace() = keys.Chord(plain("backspace")) == "backspace"
isShiftMove() = keys.Chord(withShift("right")) == "S-right"
isCtrlShiftMove() = keys.Chord(press("right", true, false, true)) == "C-S-right"
isCtrlShiftLetter() = keys.Chord(press("x", true, false, true)) == "C-S-x"
isCtrlAlt() = keys.Chord(press("f", true, true, false)) == "C-M-f"
isSuperMissing() = IsMissing(keys.Chord({Kind: "key", Key: "f", Ctrl: true, Alt: false, Shift: false, Super: true}))
isFunctionKey() = keys.Chord(plain("f5")) == "f5"
isAltLessThan() = keys.Chord(press("<", false, true, true)) == "M-<"
isAltLessThanPlain() = keys.Chord(withAlt("<")) == "M-<"
isAltGreaterThan() = keys.Chord(press(">", false, true, true)) == "M->"
isAltCommaAlias() = keys.Chord(press(",", false, true, true)) == "M-S-,"
isAltPeriodAlias() = keys.Chord(press(".", false, true, true)) == "M-S-."
isCtrlQuestion() = keys.Chord(press("?", true, false, true)) == "C-?"
isCtrlSlash() = keys.Chord(withCtrl("/")) == "C-/"
isCtrlSlashAlias() = keys.Chord(press("/", true, false, true)) == "C-S-/"
isNoShiftForUnderscore() = keys.Chord(press("_", true, false, true)) == "C-_"
isUpperLetterLowered() = keys.Chord(press("X", true, false, true)) == "C-S-x"

(** Bindings for the logic of pairs, which doesn't care what they run: the keys of the editor are tested with commands. *)
one(state) = state
two(state) = state
sample = {"C-f": one, "S-right": two, "C-x C-s": two, "C-c C-c": one, "C-t C-t": one}

isPair() = keys.Lookup("", "C-x", sample) == {Pending: "C-x"}
isPairC() = keys.Lookup("", "C-c", sample) == {Pending: "C-c"}
isPairEnd() = keys.Lookup("C-x", "C-s", sample) == {Command: two}
isPairEndIsTheFunction() = keys.Lookup("C-c", "C-c", sample) == {Command: one}
isUnknown() = keys.Lookup("", "C-q", sample) == {Unknown: "C-q"}
isUnknownPair() = keys.Lookup("C-x", "C-q", sample) == {Unknown: "C-x C-q"}
isSingle() = keys.Lookup("", "C-f", sample) == {Command: one}
isNamedKey() = keys.Lookup("", "S-right", sample) == {Command: two}
isNoPairAfterPair() = keys.Lookup("C-x", "C-x", sample) == {Unknown: "C-x C-x"}
(** The first key of a pair comes from the bindings, so binding a new pair is one line. The second key alone is nothing. *)
isFirstFromBindings() = keys.Lookup("", "C-t", sample) == {Pending: "C-t"}
isSecondAloneUnknown() = keys.Lookup("", "C-s", sample) == {Unknown: "C-s"}
isNoFirstWithoutBinding() = keys.Lookup("", "C-x", {"C-f": one}) == {Unknown: "C-x"}
(** A chord bound alone runs, even if a pair begins with it. *)
isSingleBeforeFirst() = keys.Lookup("", "C-x", {"C-x": one, "C-x C-s": two}) == {Command: one}

(** Keys in groups, as "C-c f f", with a text that names the group. *)
grouped = {"C-c f": "files", "C-c f f": one, "C-c f s": two, "C-c q q": one, "C-c n": "empty"}
isGroupFirst() = keys.Lookup("", "C-c", grouped) == {Pending: "C-c"}
isGroupNamedWaits() = keys.Lookup("C-c", "f", grouped) == {Pending: "C-c f"}
isGroupUnnamedWaits() = keys.Lookup("C-c", "q", grouped) == {Pending: "C-c q"}
isGroupRuns() = keys.Lookup("C-c f", "s", grouped) == {Command: two}
isGroupNameWithoutKeysUnknown() = keys.Lookup("C-c", "n", grouped) == {Unknown: "C-c n"}
isHintsSorted() = Equal(Map(it.Key, keys.Hints("C-c", grouped)), ["f", "n", "q"])
isHintsNamed() = keys.Hints("C-c", grouped)[1] == {Key: "f", Name: "+files", Group: true} and keys.Hints("C-c", grouped)[3].Name == "+more"
isHintsOfCommands() = Equal(Map(it.Name, keys.Hints("C-c f", {"C-c f f": Lower, "C-c f s": Upper, "C-c f x": one})), ["Lower", "Upper", "a function"])
isHintsNone() = Len(keys.Hints("C-x", grouped)) == 0
isNameOfAnonymous() = keys.NameOf(s -> s) == "a function"
