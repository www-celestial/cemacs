(** Tests of indent.ce: run with cesia test . The whole rule against cesia fmt, on the files of Cesia and of Cemacs, is tools/indent-corpus.sh. *)
use core/color
use core/indent
use src/rope
use std/text as str
use std/list
use std/value

(** A buffer of a file of Cesia holding words, whose colors are known, as the view knows them for the lines on the screen. *)
defn buffer(words)
  lines = str.Split("\n", words)
  {Rope: rope.Of(words), Path: "a.ce", Colors: color.ColoredTo(value.Len(lines), n -> lines[n], color.BlankColors()), Guess: missing}
end

(** The place that a line typed as the last line of words gets, words ending with it. *)
typedAt(words) = indent.Wanted(value.Len(str.Split("\n", words)), buffer(words))

isCesiaByPath() = indent.IsCesia({Path: "src/a.ce"}) and not indent.IsCesia({Path: "a.txt"}) and not indent.IsCesia({Path: missing})

(* A line that starts a statement: two spaces for each block it is in. *)
isAfterIf() = typedAt("if a\nb") == 2
isAfterDefn() = typedAt("defn f()\nx") == 2
isSameAfterStatement() = typedAt("defn f()\n  x = 1\ny") == 2
isEndCloses() = typedAt("defn f()\n  x = 1\nend") == 0
isElseGoesBack() = typedAt("if a\n  b\nelse") == 0
isElseIfGoesBack() = typedAt("if a\n  b\nelse if c") == 0
isNestedBlocks() = typedAt("defn f()\n  for x in xs\n    while y\nz") == 6
isArmIsNoBlock() = typedAt("match x\n  1 -> 2\nelse -> 3") == 2
isArmBody() = typedAt("match x\n  1 ->\nfoo()") == 4
isAfterArmBody() = typedAt("match x\n  1 ->\n    foo()\n2 -> 3") == 2
isEqualsBody() = typedAt("f(x) =\ny") == 2
isAfterEqualsBody() = typedAt("f(x) =\n  x + 1\ng(x) = 2") == 0
isOneLineIfOpensNone() = typedAt("x = if a 1 else 2 end\ny") == 0
isStructOnOneLine() = typedAt("struct P {X, Y}\nz") == 0
isStructBlock() = typedAt("struct P\nX") == 2
isElseIfOpensNoSecond() = typedAt("if a\n  1\nelse if b\n  2\nend\nx") == 0
isCommentOnlyEndsNothing() = typedAt("f(x) =\n  (* the body: *)\nx + 1") == 2
isBlankOfBlock() = indent.Wanted(2, buffer("if a\n\nend")) == 2

(* Where fmt keeps a line as it is written, a line typed gets a place of its own. *)
isInsideBracket() = typedAt("x = [\n1,") == 2
isClosingBracket() = typedAt("  x = foo(\n    1,\n)") == 2
isAsLineAboveInBracket() = typedAt("x = foo(a,\n        b,\nc)") == 8
isWordsAfterBracketTwoIn() = typedAt("x = foo(a,\nb)") == 2
isAfterGoingToken() = typedAt("  x = a +\nb") == 4
isAsGoingLineAbove() = typedAt("x = a +\n    b +\nc") == 4
isThenTwoIn() = typedAt("  x = xs\nthen list.Sum(it)") == 4
isBlockInsideBracket() = typedAt("fiber.Spawn(defn ()\nx") == 2
isEndInsideBracket() = typedAt("io.Print(match x\n  1 -> 2\nend)") == 0
isElseInsideBracket() = typedAt("y = f(if a\n  1\nelse") == 0
isAfterElseInsideBracket() = typedAt("y = f(if a\n  1\nelse\n0") == 2
isArmBodyInsideBracket() = typedAt("y = f(match a\n  1 ->\n    2\n3 -> 4") == 2
isCommentUnderWords() = typedAt("(* a note\nb") == 3
isDocUnderWords() = typedAt("  (** The text\nb") == 6
isDocExample() = typedAt("(** The text\n\nb") == 6
isCommentAsLineAbove() = typedAt("(** The text\n\n      E() --> 1\nb") == 6
isTextAsLineAbove() = typedAt("  x = \"ab\n   cd\ne") == 3

(* The reading starts at a line at the left margin that starts a statement, never inside a text, a comment or brackets. *)
isNoAnchorInText() = typedAt("defn f()\n  x = \"a\ny = 1\n\"\nz") == 2
isNoAnchorInComment() = typedAt("defn f()\n  (*\ndefn g()\n  *)\nz") == 2
isNoAnchorAtEnd() = typedAt("defn f(x, y = if true\n  1\nelse\n  0\nend)\nz") == 2
isNoAnchorAfterOpenBracket() = typedAt("defn f()\n  x = [\nb, c]\ny") == 2

(* A file whose lines at the left margin are far apart is read from the line LookBack() lines up, from its indent. *)
farLines(n) = str.Join("\n", list.Concat(["defn f()", "  if a"], [if k == n "    x = 1" else "    y" end for k in 1..n]))
isFarAnchorFromIndent() = indent.Wanted(indent.LookBack() + 900, buffer(farLines(indent.LookBack() + 1000))) == 4
isNearAnchorExact() = indent.Wanted(500, buffer(farLines(1000))) == 4

(* Enter at a place: the spaces around it go, and the new line starts at its place. *)
defn enter(at, words)
  (** What Enter does at a place of words, without the reading it keeps. *)
  e = indent.NewLine(at, buffer(words))
  {Before: e.Before, After: e.After, Indent: e.Indent}
end
isEnterAfterIf() = value.Equal(enter({Line: 1, Column: 4}, "if a"), {Before: 0, After: 0, Indent: "  "})
isEnterDropsSpaces() = value.Equal(enter({Line: 2, Column: 7}, "if a\n  x = 1   + 2"), {Before: 0, After: 3, Indent: "  "}) and
  value.Equal(enter({Line: 2, Column: 10}, "if a\n  x = 1   + 2"), {Before: 3, After: 0, Indent: "  "})
isEnterSplitsAWord() = enter({Line: 2, Column: 3}, "if a\n  bend").Indent == ""
isEnterBeforeEnd() = enter({Line: 2, Column: 3}, "if a\n  b end").Indent == ""
isMisplacedLineNoAnchor() = typedAt("defn f()\nx = 1\ny = 2\nz") == 2
isEnterInBracketOfLeftPart() = enter({Line: 1, Column: 8}, "x = foo(a, b)").Indent == "  "
isEnterInTextKeepsSpaces() = value.Equal(enter({Line: 1, Column: 10}, "  x = \"a  b\""), {Before: 0, After: 0, Indent: "  "})

(* The reading that Enter keeps for the next line gives what a reading from the anchor gives, and an edit above it forgets it. *)
defn keptAfter(words, at)
  (** The buffer of words with the reading that Enter at a place keeps, as text.NewLine keeps it. *)
  b = buffer(words)
  b.Layout = indent.NewLine(at, b).Layout
  b
end
(** A definition to type line by line: each line, as Enter after the line above leaves it, is read from the kept reading and from its anchor. *)
typedLines = ["defn f(x)", "  y = foo(x,", "    [1, 2,", "     3])", "  match y", "    1 ->", "      if x", "        z = \"a", "b\"", "      end",
  "    else -> 0", "  end", "  (** The end:", "", "        e *)", "  w", "end"]
defn isKeptAsFresh()
  for k in 2..value.Len(typedLines)
    words = str.Join("\n", list.Take(k, typedLines))
    kept = keptAfter(words, {Line: k - 1, Column: value.Len(str.Chars(typedLines[k - 1]))})
    if indent.Wanted(k, kept) != indent.Wanted(k, buffer(words)) or not value.Equal(indent.Plan(k, k, kept), indent.Plan(k, k, buffer(words)))
      return false
    end
  end
  true
end
isKeptForgottenAbove() = value.IsMissing(indent.Forget(1, keptAfter("if a\nb", {Line: 1, Column: 4}))) and
  not value.IsMissing(indent.Forget(2, keptAfter("if a\nb", {Line: 1, Column: 4})))

(* Tab: whole statements at their place, as cesia fmt puts them. *)
isPlanOfOneLine() = value.Equal(indent.Plan(2, 2, buffer("if a\nb\nend")), [{Line: 2, Indent: 2, Old: 0}])
isPlanKeepsPlacedLine() = value.Len(indent.Plan(2, 2, buffer("if a\n  b\nend"))) == 0
isPlanMovesStatement() = value.Equal(indent.Plan(3, 3, buffer("if a\nb(1,\n  2)\nend")), [{Line: 2, Indent: 2, Old: 0}, {Line: 3, Indent: 4, Old: 2}])
isPlanKeepsText() = value.Equal(indent.Plan(2, 2, buffer("if a\nx = \"a\n  b\"\nend")), [{Line: 2, Indent: 2, Old: 0}])
isPlanEmptiesBlankLines() = value.Equal(indent.Plan(1, 3, buffer("if a\n   \nend")), [{Line: 2, Indent: 0, Old: 3}])
isPlanLeavesBlankOutside() = value.Len(indent.Plan(1, 1, buffer("if a\n   \nend"))) == 0
isPlanReplacesTabs() = value.Equal(indent.Plan(2, 2, buffer("if a\n\tb\nend")), [{Line: 2, Indent: 2, Old: 1}])

(** messy.ce of Cesia's tests of fmt, and what cesia fmt makes of it: Tab on all its lines gives each line that holds more than spaces the indent
    that fmt gives it, and only fmt drops the spaces at the ends of lines and the blank lines in a row. *)
messy = str.Join("\n", ["", "use std/io   ", "use std/list", "", "defn twice(x)", "      (** Two times x, written out of the style:",
  "          its comment moves with its line. *)", "      y = x * 2    ", "      if y > 3", "              io.Print(\"big\", [k for k in 1..3 if k > 1])",
  "         else if y > 1", "    io.Print(\"mid\")", "      else", "   io.Print(\"small\")", "            end", "      match y", "  4 -> io.Print(\"four\")",
  "         v if v > 4 ->", "       io.Print(\"more\",", "                v)", "      else -> io.Print(\"other\")", "   end", "      t = \"a text that",
  "   keeps its spaces   ", "      and its lines\"", "         y", "end", "", "", "", "struct Point", " X", "    Y = 0   (** a default *)", "end", "   help =",
  "\"Commands\"", "io.Print(twice(3), Point(1).Y, help)", ""])
formatted = ["use std/io", "use std/list", "defn twice(x)", "  (** Two times x, written out of the style:", "      its comment moves with its line. *)",
  "  y = x * 2", "  if y > 3", "    io.Print(\"big\", [k for k in 1..3 if k > 1])", "  else if y > 1", "    io.Print(\"mid\")", "  else",
  "    io.Print(\"small\")", "  end", "  match y", "    4 -> io.Print(\"four\")", "    v if v > 4 ->", "      io.Print(\"more\",", "               v)",
  "    else -> io.Print(\"other\")", "  end", "  t = \"a text that", "   keeps its spaces", "      and its lines\"", "  y", "end", "struct Point", "  X",
  "  Y = 0   (** a default *)", "end", "help =", "  \"Commands\"", "io.Print(twice(3), Point(1).Y, help)"]

defn applied(changes, words)
  (** The lines of words with the changes of a plan. *)
  lines = str.Split("\n", words)
  for c in changes
    lines[c.Line] = "$(str.Repeat(c.Indent, " "))$(str.Join("", list.Skip(c.Old, str.Chars(lines[c.Line]))))"
  end
  lines
end

trimEnd(line) = str.Join("", list.Reverse(list.DropWhile(c -> c == " ", list.Reverse(str.Chars(line)))))
held(lines) = [trimEnd(l) for l in lines if str.Trim(l) != ""]
tabbedMessy() = applied(indent.Plan(1, value.Len(str.Split("\n", messy)), buffer(messy)), messy)
isTabAsFmt() = value.Equal(held(tabbedMessy()), formatted)
isTabTwiceSame() = value.Len(indent.Plan(1, value.Len(tabbedMessy()), buffer(str.Join("\n", tabbedMessy())))) == 0
isNoBlankLeftWithSpaces() = list.All([l == "" for l in tabbedMessy() if str.Trim(l) == "" and not str.Contains("spaces", l)])
