(** Tests of color.ce: run with cesia test . *)
use core/color
use std/text as str
use std/bug
use std/list
use std/dict
use std/value
use std/num
use std/math
use std/gen
use std/test

roles(line) = list.Map(t -> t[1], color.Tokens(line, color.FirstState).Tokens)
joined(tokens) = str.Join("", list.Map(t -> t[2], tokens))
lost(line) = joined(color.Tokens(line, color.FirstState).Tokens) == line

defn commentFirst(n)
  if n == 1
    "(* a"
  else
    "b"
  end
end

knownToTen = color.ColoredTo(10, n -> "line", color.BlankColors())

isKeyword() = value.Equal(color.Tokens("defn f(x)", color.FirstState).Tokens[1], [color.Keyword, "defn"])
isNameBeforeParen() = value.Equal(color.Tokens("defn f(x)", color.FirstState).Tokens[3], [color.Name, "f"])
isFieldAfterDot() = value.Equal(color.Tokens("p.x", color.FirstState).Tokens, [[color.Plain, "p."], [color.Field, "x"]])
isFieldBeforeParen() = value.Equal(color.Tokens("a.f(1)", color.FirstState).Tokens[2], [color.Field, "f"])
isPlainWord() = value.Equal(color.Tokens("count", color.FirstState).Tokens, [[color.Plain, "count"]])
isDoAfterCall() = value.Equal(color.Tokens("f(xs) do x", color.FirstState).Tokens[3], [color.Keyword, "do"]) and
  value.Equal(color.Tokens("f() do", color.FirstState).Tokens[3], [color.Keyword, "do"])
isDoElsewherePlain() = not (color.Keyword in roles("do = 3")) and not (color.Keyword in roles("f(1) do = 4")) and not (color.Keyword in roles("x do y"))
isHoleKeyword() = value.Equal(color.Tokens("g(\"/\", _) do r", color.FirstState).Tokens[5], [color.Keyword, "_"])
isKeywordInsideAName() = value.Equal(color.Tokens("ending", color.FirstState).Tokens, [[color.Plain, "ending"]])
isNumber() = value.Equal(color.Tokens("x = 0x1F + 2.5", color.FirstState).Tokens[2], [color.Number, "0x1F"])
isFloat() = value.Equal(color.Tokens("x = 2.5", color.FirstState).Tokens[2], [color.Number, "2.5"])
isText() = color.String in roles("x = \"a\"")
isTextWhole() = value.Equal(color.Tokens("x = \"a\"", color.FirstState).Tokens[2], [color.String, "\"a\""])
isTextWithEscape() = value.Equal(color.Tokens("\"a\\\"b\" c", color.FirstState).Tokens[1], [color.String, "\"a\\\"b\""])
isInterpolationStaysString() = value.Equal(color.Tokens("\"a $$(b) c\"", color.FirstState).Tokens, [[color.String, "\"a $$(b) c\""]])
isCommentLine() = value.Equal(color.Tokens("(* note *)", color.FirstState).Tokens, [[color.Comment, "(* note *)"]])
isCommentAfterCode() = value.Equal(color.Tokens("x (* note *)", color.FirstState).Tokens, [[color.Plain, "x "], [color.Comment, "(* note *)"]])
isDocIsAComment() = value.Equal(color.Tokens("(** doc *)", color.FirstState).Tokens, [[color.Comment, "(** doc *)"]])
isDashesAreNoComment() = not (color.Comment in roles("x -- note")) and lost("x -- note")
isDashesInTextStay() = value.Equal(roles("\"a -- b\""), [color.String])
isCommentCarries() = color.Tokens("(* a", color.FirstState).State.Comment == 1
isCommentNests() = color.Tokens("(* (* a *)", color.FirstState).State.Comment == 1
isCommentCloses() = color.Tokens("(* a *) x", color.FirstState).State.Comment == 0
isCommentContinues() = value.Equal(color.Tokens("b *) if", {Comment: 1, Text: false}).Tokens, [[color.Comment, "b *)"], [color.Plain, " "], [color.Keyword, "if"]])
isTextCarries() = color.Tokens("x = \"one", color.FirstState).State.Text
isTextContinues() = value.Equal(color.Tokens("two\" + y", {Comment: 0, Text: true}).Tokens[1], [color.String, "two\""])
isTextEnds() = not color.Tokens("two\"", {Comment: 0, Text: true}).State.Text
isEmptyLine() = value.Equal(color.Tokens("", color.FirstState).Tokens, []) and color.Tokens("", color.FirstState).State.Comment == 0
isNothingLost() = list.All(list.Map(lost, ["defn f(x)", "  x = \"a\" -- b", "(* a *) if (* b", "é = 1.5e3 $$(", "\t.. ... ::", "\"\" \"\"\"\""]))
isBrokenCodeColors() = lost("x = (* \" $$(")
isForgetLimits() = color.ForgetFrom(5, knownToTen).Known == 5
isForgetKeepsStates() = value.Len(list.Flatten(color.ForgetFrom(5, knownToTen).Chunks)) == 5
isForgetAfterKnownChangesNothing() = value.Equal(color.ForgetFrom(20, knownToTen), knownToTen)
isForgetKeepsFirst() = color.ForgetFrom(0, knownToTen).Known == 1
isBlank() = value.Equal(color.BlankColors(), {Chunks: [[color.FirstState]], Known: 1})
isColoredToReaches() = knownToTen.Known == 10 and value.Len(list.Flatten(knownToTen.Chunks)) == 10
isColoredToKeepsKnown() = value.Equal(color.ColoredTo(3, n -> bug.Panic("not read"), knownToTen), knownToTen)
isColoredToFollowsComments() = color.StartOf(3, color.ColoredTo(3, commentFirst, color.BlankColors())).Comment == 1

(* The states kept in chunks are the states of the lines, one after the other: read in parts that end anywhere, forgotten from any line and read again,
   they are those of one reading from the start. The lines open and close comments and texts, so that the states differ from line to line. *)
chunkLine(n) = ["(* a", "b *) \"c", "d\" x", "y", "(* (* e *)", "f *)"][math.Mod(n * 7, 6) + 1]
flatStates(last) = list.Scan((state, n) -> color.Tokens(chunkLine(n), state).State, color.FirstState, list.Range(1, last - 1))
allStates(last, colors) = [color.StartOf(n, colors) for n in 1..last]
isChunksAsFlat() = test.ForAll(p -> value.Equal(allStates(p.Last, color.ColoredTo(p.Last, chunkLine, color.ForgetFrom(p.Cut, color.ColoredTo(p.Second, chunkLine, color.ColoredTo(p.First, chunkLine, color.BlankColors()))))), list.Concat([color.FirstState], flatStates(p.Last))), chunkCase, cases = 60)
chunkCase = gen.Map(p -> {First: p.A, Second: p.A + p.B, Cut: p.C, Last: p.A + p.B + p.D}, gen.Of({A: gen.Int(1, 2100), B: gen.Int(0, 1100), C: gen.Int(0, 3300), D: gen.Int(0, 1100)}))
isForgetAtChunkEdges() = list.All([color.ForgetFrom(k, color.ColoredTo(3000, chunkLine, color.BlankColors())).Known == k and value.Len(list.Flatten(color.ForgetFrom(k, color.ColoredTo(3000, chunkLine, color.BlankColors())).Chunks)) == k for k in [1, 2, 1023, 1024, 1025, 2048, 2049, 2999]])

(* StateAfter gives the state that Tokens gives, on random lines made of the marks that matter and of characters of one to four bytes, from every
   kind of state. *)
alphabet = ["(", "*", ")", "\"", "\\", "$", "a", " ", "é", "€", "😀", "1", "("]
starts = [color.FirstState, {Comment: 1, Text: false}, {Comment: 2, Text: false}, {Comment: 0, Text: true}]
defn isStateAfterAsTokens()
  dice = num.Uniform(60000)
  k = 1
  for line in 1..2000
    n = math.Floor(dice[k] * 24)
    k += 1
    chars = []
    for j in 1..n
      chars = list.Append(alphabet[math.Floor(dice[k] * value.Len(alphabet)) + 1], chars)
      k += 1
    end
    words = str.Join("", chars)
    for state in starts
      if not value.Equal(color.StateAfter(words, state), color.Tokens(words, state).State)
        bug.Panic("StateAfter differs on $(words) from $(state)")
      end
    end
  end
  true
end

(* Tokens walks the bytes of a line: here it is read a character at a time, as it was written before, and the two must give the same words, roles and
   states on any line, bytes that are no UTF-8 too, as a file can hold. Each character is a text, cs holds an empty one before them and two after. *)
charDigit(c) = c >= "0" and c <= "9"
charNameStart(c) = c == "_" or (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or str.ByteLength(c) > 1
charName(c) = charNameStart(c) or charDigit(c)
charSpace(c) = c == " " or c == "\t" or c == "\r"
defn charCommentEnd(cs, from, n, depth)
  i = from
  while i <= n and depth > 0
    if cs[i] == "(" and cs[i + 1] == "*"
      depth += 1
      i += 2
    else if cs[i] == "*" and cs[i + 1] == ")"
      depth -= 1
      i += 2
    else
      i += 1
    end
  end
  {At: list.Min(i, n + 1), Depth: depth}
end
defn charTextEnd(cs, from, n)
  i = from
  closed = false
  while i <= n and not closed
    c = cs[i]
    if c == "\\" or (c == "\"" and cs[i + 1] == "\"") or (c == "$" and cs[i + 1] == "$")
      i += 2
    else
      closed = c == "\""
      i += 1
    end
  end
  {At: list.Min(i, n + 1), Open: not closed}
end
defn charWhile(holds, cs, from, n)
  i = from
  while i <= n and holds(cs, i)
    i += 1
  end
  i
end
defn charSolidBefore(cs, from)
  i = from - 1
  while i > 1 and charSpace(cs[i])
    i -= 1
  end
  cs[i]
end
defn charAdd(role, words, out)
  last = value.Len(out)
  if role == color.Plain and last > 0 and out[last][1] == color.Plain
    list.Concat(list.Take(last - 1, out), [[color.Plain, "$(out[last][2])$(words)"]])
  else
    list.Append([role, words], out)
  end
end
defn charTokens(line, state)
  (** The tokens of a line read a character at a time. *)
  cs = list.Concat([""], list.Concat(str.Chars(line), ["", ""]))
  n = value.Len(cs) - 2
  out = []
  depth = state.Comment
  inText = state.Text
  i = 2
  while i <= n
    start = i
    c = cs[i]
    role = color.Plain
    if depth > 0 or (not inText and c == "(" and cs[i + 1] == "*")
      r = charCommentEnd(cs, if depth > 0 i else i + 2 end, n, if depth > 0 depth else 1 end)
      depth = r.Depth
      i = r.At
      role = color.Comment
    else if inText or c == "\""
      r = charTextEnd(cs, if inText i else i + 1 end, n)
      inText = r.Open
      i = r.At
      role = color.String
    else if charDigit(c)
      i = charWhile((xs, k) -> charName(xs[k]) or (xs[k] == "." and charDigit(xs[k + 1])), cs, i + 1, n)
      role = color.Number
    else if charNameStart(c)
      i = charWhile((xs, k) -> charName(xs[k]), cs, i + 1, n)
      word = str.Join("", cs[start..i - 1])
      next = cs[charWhile((xs, k) -> charSpace(xs[k]), cs, i, n)]
      if word == "do" and charSolidBefore(cs, start) == ")" and (next == "" or charNameStart(next))
        role = color.Keyword
      else if cs[start - 1] == "."
        role = color.Field
      else if word in ["if", "else", "end", "for", "in", "while", "break", "return", "defn", "match", "struct", "and", "or", "not", "then", "use", "true", "false", "missing", "_"]
        role = color.Keyword
      else if cs[i] == "("
        role = color.Name
      end
    else if charSpace(c)
      i = charWhile((xs, k) -> charSpace(xs[k]), cs, i + 1, n)
    else
      i += 1
    end
    out = charAdd(role, str.Join("", cs[start..i - 1]), out)
  end
  {Tokens: out, State: {Comment: depth, Text: inText}}
end

(* The pieces of the lines: the marks of comments and texts, escapes, names, numbers and do, characters of one to four bytes, and bytes that are no
   UTF-8: one that continues alone, one that starts a character and is not followed, a character cut short, a byte that never is UTF-8. *)
pieces = ["(*", "*)", "(", ")", "*", "\"", "\"\"", "\\", "$$", ".", "1", "9", "0x1F", "2.5", " ", "\t", "\r", "a", "Z", "_", "do", "end", "f(", "é",
  "€", "😀", str.FromBytes([128]), str.FromBytes([191]), str.FromBytes([195]), str.FromBytes([226, 130]), str.FromBytes([255])]
lineCase = gen.Of({Words: gen.Map(ps -> str.Join("", ps), gen.List(gen.Pick(pieces), max = 40)), Start: gen.Pick(starts), Column: gen.Int(0, 60)})
isTokensAsCharacters() = test.ForAll(p -> value.Equal(color.Tokens(p.Words, p.Start), charTokens(p.Words, p.Start)), lineCase, cases = 2000)

defn cutFrom(from, tokens)
  (** The tokens from byte from on, the one that starts before it cut there, as a screen that starts at that byte shows them. *)
  out = []
  at = 1
  for t in tokens
    stop = at + str.ByteLength(t[2])
    if stop > from
      out = list.Append([t[1], str.ByteSlice(list.Max(at, from) - at + 1, stop - at, t[2])], out)
    end
    at = stop
  end
  out
end

defn isFromAsCut(p)
  (** Tokens from the byte where a column starts gives the words of the whole line from there, and the same state at the end. *)
  column = list.Min(p.Column, value.Len(p.Words))
  from = str.ByteLength(str.Slice(1, column, p.Words)) + 1
  whole = color.Tokens(p.Words, p.Start)
  part = color.Tokens(p.Words, p.Start, from = from)
  value.Equal(part.Tokens, cutFrom(from, whole.Tokens)) and value.Equal(part.State, whole.State)
end
isTokensFromAsCut() = test.ForAll(isFromAsCut, lineCase, cases = 2000)

(* Long lines, where the reading from a byte skips most of the line: code, a name of 5,000 letters, more than synced looks back over, and a comment and a
   text that reach the screen from far before it. *)
longLines = ["$(str.Repeat(5000, "a")) b(c)", str.Repeat(300, "f(a, \"b c\", 12) + x.y (* z *) "), "(* $(str.Repeat(2000, "a (* b *) ")) *) do",
  "\"$(str.Repeat(2000, "a\\\"b\"\"")) \" end", str.Repeat(400, "x.do 1.5.5 9é ) do y")]
defn isLongFromAsCut()
  for w in longLines
    for s in starts
      for c in [0, 1, 4999, 5000, 5003, 6000, 9000, 20000]
        if not isFromAsCut({Words: w, Start: s, Column: c})
          return false
        end
      end
    end
  end
  true
end
isFromOutsideTheLine() = value.Equal(color.Tokens("ab c", color.FirstState, from = 9).Tokens, []) and value.Equal(color.Tokens("ab c", color.FirstState, from = 0), color.Tokens("ab c", color.FirstState)) and
  color.Tokens("(* a", color.FirstState, from = 9).State.Comment == 1

(* The stops of a crossing, given back for a line that starts with the same bytes up to StopMargin() past each, make the same words, the same state and
   the same stops as a reading from the start: random lines of the pieces made 200 KB long, read near their end, then cut at a random byte and given
   another end of 200 KB, which the stops of the first line past the cut would read wrong. *)
defn longOf(words)
  (** The words repeated to 200 KB at least. *)
  unit = "$words \n"
  str.Repeat(1 + math.Div(200000, str.ByteLength(unit)), unit)
end
nearEnd(line, back) = str.ByteLength(str.Slice(1, list.Max(0, value.Len(line) - back), line)) + 1
defn isStopsAsFromStart(p)
  (** A line read from its stops after an edit past them reads as from its start. *)
  line = longOf(p.Words)
  first = color.Tokens(line, p.Start, from = nearEnd(line, p.Column), stops = [])
  cut = math.Div(str.ByteLength(line), 2) + p.Cut
  edited = "$(str.ByteSlice(1, cut, line))$(longOf(p.Tail))"
  held = [s for s in first.Stops if s.At + color.StopMargin() <= cut]
  from = nearEnd(edited, p.Column)
  value.Equal(color.Tokens(edited, p.Start, from = from, stops = held), color.Tokens(edited, p.Start, from = from, stops = []))
end
stopsCase = gen.Of({Words: gen.Map(ps -> str.Join("", ps), gen.List(gen.Pick(pieces), max = 30)), Start: gen.Pick(starts), Column: gen.Int(0, 60),
  Cut: gen.Int(0, 90000), Tail: gen.Map(ps -> str.Join("", ps), gen.List(gen.Pick(pieces), max = 30))})
isStopsHold() = test.ForAll(isStopsAsFromStart, stopsCase, cases = 60)
isStopsOnlyAsked() = value.IsMissing(dict.GetOr("Stops", missing, color.Tokens("ab", color.FirstState, from = 2))) and value.Equal(color.Tokens("ab", color.FirstState, from = 2, stops = []).Stops, [])

(* The colors keep the stops of the reading of the first long line they read, and after an edit the state at the end of that line is read from the
   last one that still holds: the colors are then those that a reading from the start gives, the stops kept too. Random lines of the pieces made 200 KB
   long, under a line that leaves each kind of state, cut at a random byte and given another end of 200 KB, which the stops past the cut would read
   wrong. *)
aboves = ["x", "(*", "(* (*", "\""]
defn isEndAsFromStart(p)
  (** The colors of a long line read again after an edit, from the stops kept, are those of a reading from its start. *)
  line = longOf(p.Words)
  first = color.ColoredTo(3, n -> [p.Above, line][n], color.BlankColors())
  edited = "$(str.ByteSlice(1, list.Min(p.Cut, str.ByteLength(line)), line))$(longOf(p.Tail))"
  value.Equal(color.ColoredTo(3, n -> [p.Above, edited][n], color.ForgetFrom(2, first)), color.ColoredTo(3, n -> [p.Above, edited][n], color.BlankColors()))
end
endCase = gen.Of({Words: gen.Map(ps -> str.Join("", ps), gen.List(gen.Pick(pieces), max = 30)), Above: gen.Pick(aboves), Cut: gen.Int(0, 200000),
  Tail: gen.Map(ps -> str.Join("", ps), gen.List(gen.Pick(pieces), max = 30))})
isEndFromStops() = test.ForAll(isEndAsFromStart, endCase, cases = 60)

(* The state at the end of a long line is read from the last stop kept that holds, not from the start of the line: told that the line is in a comment
   from its byte 70,000 on, the colors find it in a comment at its end, where a reading from its start finds none; read from another state, or after
   an edit before the stop, the line is read from its start. Lines of 40 KB keep no stop, and colors that read no long line keep none. *)
quoted = str.Repeat(20000, "x \"y\" ")
told = {Chunks: [[color.FirstState]], Known: 1, Long: {State: color.FirstState, Text: quoted, Stops: [{At: 70000, Comment: 1, Text: false}]}}
endOf(words, colors) = color.StartOf(2, color.ColoredTo(2, n -> words, colors))
isEndReadFromStop() = endOf(quoted, told).Comment == 1 and value.Equal(endOf(quoted, color.BlankColors()), color.FirstState)
isStopOfAnotherStateLeft() = value.Equal(endOf(quoted, {Chunks: [[{Comment: 0, Text: true}]], Known: 1, Long: told.Long}), color.StateAfter(quoted, {Comment: 0, Text: true}))
isStopBeforeEditLeft() = value.Equal(endOf("$(str.ByteSlice(1, 70007, quoted))z$(str.ByteSlice(70009, str.ByteLength(quoted), quoted))", told), color.FirstState)
isStopPastEditKept() = endOf("$(str.ByteSlice(1, 70008, quoted))z$(str.ByteSlice(70010, str.ByteLength(quoted), quoted))", told).Comment == 1
isLongKept() = value.Equal(color.ColoredTo(2, n -> quoted, color.BlankColors()).Long, {State: color.FirstState, Text: quoted, Stops: [{At: 65538, Comment: 0, Text: false}]})
isShortKeepsNoStop() = value.IsMissing(dict.GetOr("Long", missing, color.ColoredTo(3, n -> str.Repeat(10000, "\"a\" "), color.BlankColors())))
isLongLeftByShort() = value.IsMissing(dict.GetOr("Long", missing, color.ColoredTo(3, n -> "\"a\"", color.ForgetFrom(1, color.ColoredTo(2, n -> quoted, color.BlankColors())))))
