(** The colors of the code: a line is read in one pass, by states, and gives words with a role. Nothing here panics, whatever the line:
    unfinished texts and comments only carry their state to the next line. *)
use std/list
use std/math
use std/text as str
use std/value

(** The role of a keyword: an index in the syntax colors of the theme. *)
Keyword = 1
(** The role of a name that is called. *)
Name = 2
(** The role of a text, interpolations included. *)
String = 3
(** The role of a number. *)
Number = 4
(** The role of a comment. *)
Comment = 5
(** The role of everything else. *)
Plain = 6
(** The role of a name after a dot. *)
Field = 7

(** The state at the start of a file: in no comment and in no text. *)
FirstState = {Comment: 0, Text: false}

keywords = ["if", "else", "end", "for", "in", "while", "break", "return", "defn", "match", "struct", "and", "or", "not", "then", "use", "true", "false", "missing"]

isDigit(c) = c >= "0" and c <= "9"
isNameStart(c) = c == "_" or (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or str.ByteLength(c) > 1
isName(c) = isNameStart(c) or isDigit(c)
isSpace(c) = c == " " or c == "\t" or c == "\r"

defn commentEnd(cs, from, n, depth)
  (** Where a comment that holds depth openings ends: {At, Depth}, at being the first character after what was read. *)
  i = from
  while i <= n and depth > 0
    if cs[i] == "(" and cs[i + 1] == "*"
      depth += 1
      i += 2
    else if cs[i] == "*" and cs[i + 1] == ")"
      depth -= 1
      i += 2
    else
      i += 1
    end
  end
  {At: list.Min(i, n + 1), Depth: depth}
end

defn textEnd(cs, from, n)
  (** Where a text that is open ends: {At, Open}, at being the first character after what was read. Escapes take two characters. *)
  i = from
  closed = false
  while i <= n and not closed
    c = cs[i]
    if c == "\\" or (c == "\"" and cs[i + 1] == "\"") or (c == "$" and cs[i + 1] == "$")
      i += 2
    else if c == "\""
      closed = true
      i += 1
    else
      i += 1
    end
  end
  {At: list.Min(i, n + 1), Open: not closed}
end

defn numberEnd(cs, from, n)
  (** The end of a number, which may hold letters, digits, underscores and dots followed by a digit. *)
  i = from + 1
  while i <= n and (isName(cs[i]) or (cs[i] == "." and isDigit(cs[i + 1])))
    i += 1
  end
  i
end

defn nameEnd(cs, from, n)
  i = from + 1
  while i <= n and isName(cs[i])
    i += 1
  end
  i
end

defn spaceEnd(cs, from, n)
  i = from + 1
  while i <= n and isSpace(cs[i])
    i += 1
  end
  i
end

defn nameRole(word, before, after)
  (** The role of a name, from the character before it and the one after it. *)
  if before == "."
    Field
  else if word in keywords
    Keyword
  else if after == "("
    Name
  else
    Plain
  end
end

defn add(role, words, out)
  (** Adds a word to the tokens. Two plain words in a row make one. *)
  last = value.Len(out)
  if role == Plain and last > 0 and out[last][1] == Plain
    list.Concat(list.Take(last - 1, out), [[Plain, "$(out[last][2])$(words)"]])
  else
    list.Append([role, words], out)
  end
end

defn Tokens(line, state)
  (** Reads one line given the state at its start: the words with their roles, in order and with every character, and the state at its end.

        Tokens("defn f", FirstState).Tokens[1] --> [1, "defn"] *)
  (* cs holds an empty text before and two after the characters, so that looking around never leaves the list. *)
  cs = list.Concat([""], list.Concat(str.Chars(line), ["", ""]))
  n = value.Len(cs) - 2
  out = []
  depth = state.Comment
  inText = state.Text
  i = 2
  while i <= n
    start = i
    if depth > 0
      r = commentEnd(cs, i, n, depth)
      depth = r.Depth
      i = r.At
      out = add(Comment, str.Join("", cs[start..i - 1]), out)
    else if inText
      r = textEnd(cs, i, n)
      inText = r.Open
      i = r.At
      out = add(String, str.Join("", cs[start..i - 1]), out)
    else
      c = cs[i]
      if c == "(" and cs[i + 1] == "*"
        r = commentEnd(cs, i + 2, n, 1)
        depth = r.Depth
        i = r.At
        out = add(Comment, str.Join("", cs[start..i - 1]), out)
      else if c == "\""
        r = textEnd(cs, i + 1, n)
        inText = r.Open
        i = r.At
        out = add(String, str.Join("", cs[start..i - 1]), out)
      else if isDigit(c)
        i = numberEnd(cs, i, n)
        out = add(Number, str.Join("", cs[start..i - 1]), out)
      else if isNameStart(c)
        i = nameEnd(cs, i, n)
        word = str.Join("", cs[start..i - 1])
        out = add(nameRole(word, cs[start - 1], cs[i]), word, out)
      else if isSpace(c)
        i = spaceEnd(cs, i, n)
        out = add(Plain, str.Join("", cs[start..i - 1]), out)
      else
        i += 1
        out = add(Plain, c, out)
      end
    end
  end
  {Tokens: out, State: {Comment: depth, Text: inText}}
end

(** Nothing is known yet but the state at the start of the first line. The states known are kept in Chunks, lists of chunkLines() states each, the
    last one filled first: an edit at a line keeps the chunks before it and cuts one, adding lines fills the last chunk and makes new ones, so both cost
    the number of chunks plus one chunk, not the number of lines known. Emacs keeps its syntax-ppss cache sparse for the same reason.

      BlankColors().Known --> 1 *)
BlankColors() = {Chunks: [[FirstState]], Known: 1}

(* How many states a chunk holds. A function: a variable added under --watch is read before it has a value. *)
chunkLines() = 1024

(** The state at the start of line n, which must be known.

      StartOf(1, BlankColors()) --> FirstState *)
StartOf(n, colors) = colors.Chunks[math.Div(n - 1, chunkLines()) + 1][math.Mod(n - 1, chunkLines()) + 1]

defn StateAt(n, colors, guess)
  (** The state at the start of line n: the one known, else the one guessed for a screen, {From, States} or missing, else the first, as if no
      comment or text opened in the lines above.

        StateAt(3, BlankColors(), missing) --> FirstState *)
  if n <= colors.Known
    return StartOf(n, colors)
  end
  if not value.IsMissing(guess) and n >= guess.From and n < guess.From + value.Len(guess.States)
    guess.States[n - guess.From + 1]
  else
    FirstState
  end
end

(** The states guessed for the screen of a buffer, or missing when its colors are known: a state from before this field has none.

      GuessOf({Colors: BlankColors()}) --> missing *)
GuessOf(b) = match b
  {Guess: g} -> g
  else -> missing
end

(** Is a state out of any comment and text?

      IsCode(FirstState) --> true *)
IsCode(state) = state.Comment == 0 and not state.Text

(** Can this line change the state? Only a quote or a comment mark can open or close a text or a comment. *)
mayChange(words) = str.Contains("\"", words) or str.Contains("(*", words) or str.Contains("*)", words)

(** How many bytes the character at byte at takes, from its first byte: one past the end of the words. *)
charBytes(at, words) = if at > str.ByteLength(words) 1 else bytesOfLead(str.Byte(at, words)) end
bytesOfLead(b) = if b < 0xC0 1 else if b < 0xE0 2 else if b < 0xF0 3 else 4 end

(** The earlier of two byte positions, either of which may be missing. *)
earlier(a, b) = if value.IsMissing(a) b else if value.IsMissing(b) a else list.Min(a, b) end

defn StateAfter(words, state)
  (** The state at the end of a line, given the one at its start: the one that Tokens gives, without making the tokens. A line with no quote and no
      comment mark leaves it as it is. Else the line is read from mark to mark, each found natively: in a comment, the next opening or closing of one,
      as comments nest; in a text, the next quote, a doubled quote and a character after a backslash being part of it; elsewhere, the next quote or
      opening of a comment. A jump to the end of a large file reads the state of every line before it.

        StateAfter("x = \"a (* b", FirstState) --> {Comment: 0, Text: true}
        StateAfter("a *) \"b\"", {Comment: 1, Text: false}) --> {Comment: 0, Text: false} *)
  if not mayChange(words)
    return state
  end
  depth = state.Comment
  inText = state.Text
  i = 1
  n = str.ByteLength(words)
  while i <= n
    if depth > 0
      open = str.ByteFind("(*", i, words)
      close = str.ByteFind("*)", i, words)
      next = earlier(open, close)
      if value.IsMissing(next)
        i = n + 1
      else if next == open
        depth += 1
        i = open + 2
      else
        depth -= 1
        i = close + 2
      end
    else if inText
      quote = str.ByteFind("\"", i, words)
      slash = str.ByteFind("\\", i, words)
      if value.IsMissing(quote)
        i = n + 1
      else if not value.IsMissing(slash) and slash < quote
        i = slash + 1 + charBytes(slash + 1, words)
      else if quote < n and str.Byte(quote + 1, words) == 34
        i = quote + 2
      else
        inText = false
        i = quote + 1
      end
    else
      quote = str.ByteFind("\"", i, words)
      open = str.ByteFind("(*", i, words)
      next = earlier(quote, open)
      if value.IsMissing(next)
        i = n + 1
      else if next == quote
        inText = true
        i = quote + 1
      else
        depth = 1
        i = open + 2
      end
    end
  end
  {Comment: depth, Text: inText}
end

defn ColoredTo(line, lineOf, colors)
  (** The state at the start of line number line, once the lines before it are known; line_of(n) gives the text of line n.

        StartOf(2, ColoredTo(2, n -> str.Join("", ["(", "* a"]), BlankColors())).Comment --> 1 *)
  have = colors.Known
  if line <= have
    return colors
  end
  chunks = colors.Chunks
  last = value.Len(chunks)
  part = chunks[last]
  state = StartOf(have, colors)
  for n in have..(line - 1)
    state = StateAfter(lineOf(n), state)
    if value.Len(part) == chunkLines()
      chunks[last] = part
      chunks = list.Append([], chunks)
      last += 1
      part = []
    end
    part = list.Append(state, part)
  end
  chunks[last] = part
  {Chunks: chunks, Known: line}
end

defn ForgetFrom(line, colors)
  (** The colors with only the lines before the given one still known, after an edit in it. The first line is always known.

        ForgetFrom(2, ColoredTo(5, n -> "x", BlankColors())).Known --> 2 *)
  keep = list.Max(1, line)
  if colors.Known <= keep
    return colors
  end
  whole = math.Div(keep - 1, chunkLines())
  chunks = list.Take(whole + 1, colors.Chunks)
  chunks[whole + 1] = list.Take(keep - whole * chunkLines(), chunks[whole + 1])
  {Chunks: chunks, Known: keep}
end
