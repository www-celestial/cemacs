(** The colors of the code: a line is read in one pass, by states, and gives words with a role. Nothing here panics, whatever the line:
    unfinished texts and comments only carry their state to the next line. *)
use std/list
use std/math
use std/text as str
use std/value

(** The role of a keyword: an index in the syntax colors of the theme. *)
Keyword = 1
(** The role of a name that is called. *)
Name = 2
(** The role of a text, interpolations included. *)
String = 3
(** The role of a number. *)
Number = 4
(** The role of a comment. *)
Comment = 5
(** The role of everything else. *)
Plain = 6
(** The role of a name after a dot. *)
Field = 7

(** The state at the start of a file: in no comment and in no text. *)
FirstState = {Comment: 0, Text: false}

keywords = ["if", "else", "end", "for", "in", "while", "break", "return", "defn", "match", "struct", "and", "or", "not", "then", "use", "true", "false", "missing"]

(* The lexer walks the bytes of a line, never its characters: a text for each character of a line of a megabyte took 0.2 s before the first token.
   A character is a byte that continues none, 10xxxxxx in UTF-8, with the bytes that continue it, as value.Len and text.Chars count them in a text
   that isn't UTF-8 too: so a byte followed by one that continues is a character of more than one byte, and those are all letters. The walks of names
   and spaces test their bytes inline: a call for each byte made a long name a third slower. *)

(** Does a byte continue a character, 10xxxxxx in UTF-8, instead of starting one? *)
continues(v) = v >= 128 and v < 192

(** Is the character at byte i of a text of n bytes one byte alone: the byte after it, if any, starts a character? *)
alone(i, words, n) = i >= n or not continues(str.Byte(i + 1, words))

(** Is the character at byte i a digit? One of more than one byte counts too when its first byte is 0 to 8: that is how a text compares with "9". *)
isDigitAt(i, words, n) = i <= n and str.Byte(i, words) >= 48 and (str.Byte(i, words) <= 56 or (str.Byte(i, words) == 57 and alone(i, words, n)))

defn isNameStartAt(i, words, n)
  (** Does a name start with the character at byte i: a letter of ASCII, an underscore, or any character of more than one byte? *)
  v = str.Byte(i, words)
  v == 95 or (v >= 97 and v <= 122) or (v >= 65 and v <= 90) or not alone(i, words, n)
end

defn found(part, from, words, n)
  (** The first byte from from on where part starts, part being one or two characters of one byte each, and the byte after it continuing none:
      else it is the start of a longer character, not part. Missing if there is none. *)
  size = str.ByteLength(part)
  at = str.ByteFind(part, from, words)
  while not value.IsMissing(at) and at + size <= n and continues(str.Byte(at + size, words))
    at = str.ByteFind(part, at + 1, words)
  end
  at
end

(** Does at, where a mark was found from an earlier byte, still answer from byte from on: missing, there was none and there is none; a place still
    ahead is the first. 0 is a mark not looked for yet. Each search of a line goes on from where the last one stopped, so its marks cost its bytes once,
    where a search from each text to the end of a line with no backslash cost the line once a text. *)
kept(at, from) = value.IsMissing(at) or (at != 0 and at >= from)

(** The first place of part from byte from on, as found gives it, knowing at, the place found before. *)
seek(part, at, from, words, n) = if kept(at, from) at else found(part, from, words, n) end

(** The earlier of two byte positions, either of which may be missing. *)
earlier(a, b) = if value.IsMissing(a) b else if value.IsMissing(b) a else list.Min(a, b) end

(** No mark looked for yet in a line, for commentEnd and textEnd. *)
noMarks() = {Open: 0, Close: 0, Quote: 0, Slash: 0}

defn commentEnd(words, from, n, depth, marks)
  (** Where a comment that holds depth openings ends: {At, Depth, Marks}, at being the first byte after what was read. The next opening and closing
      are each found natively, and the places found are kept in marks for the rest of the line. *)
  i = from
  m = marks
  while i <= n and depth > 0
    m.Open = seek("(*", m.Open, i, words, n)
    m.Close = seek("*)", m.Close, i, words, n)
    next = earlier(m.Open, m.Close)
    if value.IsMissing(next)
      i = n + 1
    else if next == m.Open
      depth += 1
      i = m.Open + 2
    else
      depth -= 1
      i = m.Close + 2
    end
  end
  {At: list.Min(i, n + 1), Depth: depth, Marks: m}
end

defn textEnd(words, from, n, marks)
  (** Where a text that is open ends: {At, Open, Marks}, at being the first byte after what was read. A backslash takes the character after it, and a
      doubled quote stays in the text; the next quote and backslash are each found natively, and the places found are kept in marks for the rest of
      the line. *)
  i = from
  m = marks
  while i <= n
    m.Quote = seek("\"", m.Quote, i, words, n)
    m.Slash = seek("\\", m.Slash, i, words, n)
    if value.IsMissing(m.Quote) and value.IsMissing(m.Slash)
      return {At: n + 1, Open: true, Marks: m}
    end
    if not value.IsMissing(m.Slash) and (value.IsMissing(m.Quote) or m.Slash < m.Quote)
      i = m.Slash + 2
      while i <= n and continues(str.Byte(i, words))
        i += 1
      end
    else if m.Quote < n and str.Byte(m.Quote + 1, words) == 34 and alone(m.Quote + 1, words, n)
      i = m.Quote + 2
    else
      return {At: m.Quote + 1, Open: false, Marks: m}
    end
  end
  {At: n + 1, Open: true, Marks: m}
end

defn nameEnd(words, from, n)
  (** The first byte after the letters, digits and underscores from from on, a character of more than one byte being a letter. *)
  i = from
  while i <= n
    v = str.Byte(i, words)
    if (v >= 97 and v <= 122) or (v >= 65 and v <= 90) or (v >= 48 and v <= 57) or v == 95 or (v >= 128 and v < 192)
      i += 1
    else if i < n and continues(str.Byte(i + 1, words))
      i += 2
    else
      return i
    end
  end
  i
end

defn numberEnd(words, from, n)
  (** The end of a number, which may hold letters, digits, underscores and dots followed by a digit. *)
  i = nameEnd(words, from, n)
  while i < n and str.Byte(i, words) == 46 and isDigitAt(i + 1, words, n)
    i = nameEnd(words, i + 1, n)
  end
  i
end

defn spaceEnd(words, from, n)
  (** The first byte after the spaces, tabs and carriage returns from from on: one followed by a byte that continues is a longer character. *)
  i = from
  while i <= n
    v = str.Byte(i, words)
    if (v == 32 or v == 9 or v == 13) and (i == n or not continues(str.Byte(i + 1, words)))
      i += 1
    else
      return i
    end
  end
  i
end

defn isBlock(words, start, stop, n)
  (** Is the name do from start to stop a keyword: right after the ) of a call, before a name or the line end, it starts a block. *)
  i = start - 1
  while i >= 1 and (str.Byte(i, words) == 32 or str.Byte(i, words) == 9 or str.Byte(i, words) == 13)
    i -= 1
  end
  after = spaceEnd(words, stop, n)
  i >= 1 and str.Byte(i, words) == 41 and (after > n or isNameStartAt(after, words, n))
end

defn nameRole(words, start, stop, n)
  (** The role of the name from byte start to the byte before stop, from the character before it and the one after it. *)
  if start > 1 and str.Byte(start - 1, words) == 46
    return Field
  end
  word = str.ByteSlice(start, stop - 1, words)
  if word in keywords or word == "_" or (word == "do" and isBlock(words, start, stop, n))
    Keyword
  else if stop <= n and str.Byte(stop, words) == 40 and alone(stop, words, n)
    Name
  else
    Plain
  end
end

defn synced(words, start, from, n)
  (** The last byte from start to from where a reading of code from start starts a word: just after a character that is always a word of its own,
      one byte of ASCII that is no letter, digit, underscore, space, tab, carriage return or dot, and that no byte continues. Between start and from
      there is no quote and no opening of a comment, so no word crosses such a character. Looked for back from from, 4,096 bytes at most: start if
      there is none, as in a name of a megabyte. *)
  j = from - 1
  stop = list.Max(start, from - 4096)
  while j >= stop
    v = str.Byte(j, words)
    if v < 128 and not ((v >= 97 and v <= 122) or (v >= 65 and v <= 90) or (v >= 48 and v <= 57) or v == 95 or v == 32 or v == 9 or v == 13 or v == 46) and (j == n or not continues(str.Byte(j + 1, words)))
      return j + 1
    end
    j -= 1
  end
  start
end

(** How many bytes apart the crossing of a line keeps its stops, at least: see Tokens. A function: a variable added under --watch is read before it has
    a value. *)
stopBytes() = 65536

(** How many bytes past its end a step of the crossing reads, at most, and some more: a stop holds for a line whose bytes are those of the line it was
    made on up to this many bytes past it, see Tokens. *)
StopMargin() = 8

defn resumeAt(words, state, from, n, stops)
  (** Where Tokens can start to read a line, with the state there, {At, Comment, Text, Stops}, and still make from byte from on the words that a reading
      from the start makes. The comments and texts before from are crossed from mark to mark, each found natively, and the code between them is not read:
      in code, only a quote or the opening of a comment changes the state, and each starts a word. A comment or a text that reaches from is read from
      its start; code, from the place synced finds. The crossing starts at the last of the stops before from, and keeps a stop, {At, Comment, Text},
      at the first place between two steps stopBytes() past the last one: Stops are those, the ones given before from among them. *)
  depth = state.Comment
  inText = state.Text
  i = 1
  out = []
  for s in stops
    if s.At < from
      out = list.Append(s, out)
      depth = s.Comment
      inText = s.Text
      i = s.At
    end
  end
  stop = i + stopBytes()
  marks = noMarks()
  while i < from
    if i >= stop
      out = list.Append({At: i, Comment: depth, Text: inText}, out)
      stop = i + stopBytes()
    end
    if depth > 0
      r = commentEnd(words, i, n, depth, marks)
      if r.At > from
        return {At: i, Comment: depth, Text: inText, Stops: out}
      end
      depth = r.Depth
      i = r.At
      marks = r.Marks
    else if inText
      r = textEnd(words, i, n, marks)
      if r.At > from
        return {At: i, Comment: 0, Text: true, Stops: out}
      end
      inText = r.Open
      i = r.At
      marks = r.Marks
    else
      marks.Quote = seek("\"", marks.Quote, i, words, n)
      marks.Open = seek("(*", marks.Open, i, words, n)
      next = earlier(marks.Quote, marks.Open)
      if value.IsMissing(next) or next >= from
        return {At: synced(words, i, from, n), Comment: 0, Text: false, Stops: out}
      end
      if next == marks.Quote
        r = textEnd(words, next + 1, n, marks)
        if r.At > from
          return {At: next, Comment: 0, Text: false, Stops: out}
        end
        inText = r.Open
        i = r.At
        marks = r.Marks
      else
        r = commentEnd(words, next + 2, n, 1, marks)
        if r.At > from
          return {At: next, Comment: 0, Text: false, Stops: out}
        end
        depth = r.Depth
        i = r.At
        marks = r.Marks
      end
    end
  end
  {At: i, Comment: depth, Text: inText, Stops: out}
end

defn Tokens(line, state, from = 1, stops = missing)
  (** Reads one line given the state at its start: the words with their roles, in order and with every character, and the state at its end, {Tokens,
      State}. Two plain words in a row make one. With from, the byte where a character starts, only the words from there on are made, the one
      that starts before it cut there: a screen that shows the end of a long line makes only the words it shows, and the line before them is crossed by
      its comments and texts only. The line is walked a byte at a time, the inside of a comment or a text from mark to mark, each found natively, so a
      line of a megabyte costs its bytes once at most.
      With stops, a list, the result has Stops too: the places where the crossing passed, with the state there, {At, Comment, Text}, one every
      64 KB at least, in order. Given back as stops for a line read from the same state whose bytes are the same up to StopMargin() bytes past each
      stop, the crossing starts at the last of them before from, as it would get there in the same state: after an edit at the end of a line of a
      megabyte, the screen crosses only the bytes after the last stop before the edit, and makes the same words and the same stops.

        Tokens("defn f", FirstState).Tokens[1] --> [1, "defn"]
        Tokens("defn f", FirstState, from = 3).Tokens --> [[1, "fn"], [6, " f"]] *)
  n = str.ByteLength(line)
  first = list.Max(1, list.Min(from, n + 1))
  out = []
  marks = noMarks()
  plain = 0
  (* From a byte past the start, the reading starts where resumeAt says: the words before it are not made, and most of the line is not read. *)
  at = if first > 1 resumeAt(line, state, first, n, if value.IsMissing(stops) [] else stops end) else {At: 1, Comment: state.Comment, Text: state.Text} end
  depth = at.Comment
  inText = at.Text
  i = at.At
  while i <= n
    start = i
    role = Plain
    if depth > 0
      r = commentEnd(line, i, n, depth, marks)
      depth = r.Depth
      i = r.At
      marks = r.Marks
      role = Comment
    else if inText
      r = textEnd(line, i, n, marks)
      inText = r.Open
      i = r.At
      marks = r.Marks
      role = String
    else
      (* The byte of the character and the one after it tell what starts here; one that continues makes the character longer, and a letter. *)
      v = str.Byte(i, line)
      w = if i < n str.Byte(i + 1, line) else 0 end
      one = w < 128 or w >= 192
      if v == 40 and w == 42 and (i + 2 > n or not continues(str.Byte(i + 2, line)))
        r = commentEnd(line, i + 2, n, 1, marks)
        depth = r.Depth
        i = r.At
        marks = r.Marks
        role = Comment
      else if v == 34 and one
        r = textEnd(line, i + 1, n, marks)
        inText = r.Open
        i = r.At
        marks = r.Marks
        role = String
      else if v >= 48 and (v <= 56 or (v == 57 and one))
        i = numberEnd(line, i + 1, n)
        role = Number
      else if (v >= 97 and v <= 122) or (v >= 65 and v <= 90) or v == 95 or not one
        i = nameEnd(line, i + 1, n)
        role = nameRole(line, start, i, n)
      else if v == 32 or v == 9 or v == 13
        i = spaceEnd(line, i + 1, n)
      else
        i += 1
      end
    end
    (* Plain words are kept as the byte where they start, and sliced once a word of another role or the end of the line comes. *)
    if role == Plain
      plain = if plain == 0 start else plain end
    else
      if plain > 0 and start > first
        out = list.Append([Plain, str.ByteSlice(list.Max(plain, first), start - 1, line)], out)
      end
      plain = 0
      if i > first
        out = list.Append([role, str.ByteSlice(list.Max(start, first), i - 1, line)], out)
      end
    end
  end
  if plain > 0 and n >= first
    out = list.Append([Plain, str.ByteSlice(list.Max(plain, first), n, line)], out)
  end
  if value.IsMissing(stops)
    {Tokens: out, State: {Comment: depth, Text: inText}}
  else
    {Tokens: out, State: {Comment: depth, Text: inText}, Stops: if first > 1 at.Stops else [] end}
  end
end

(** Nothing is known yet but the state at the start of the first line. The states known are kept in Chunks, lists of chunkLines() states each, the
    last one filled first: an edit at a line keeps the chunks before it and cuts one, adding lines fills the last chunk and makes new ones, so both cost
    the number of chunks plus one chunk, not the number of lines known. Emacs keeps its syntax-ppss cache sparse for the same reason.

      BlankColors().Known --> 1 *)
BlankColors() = {Chunks: [[FirstState]], Known: 1}

(* How many states a chunk holds. A function: a variable added under --watch is read before it has a value. *)
chunkLines() = 1024

(** The state at the start of line n, which must be known.

      StartOf(1, BlankColors()) --> FirstState *)
StartOf(n, colors) = colors.Chunks[math.Div(n - 1, chunkLines()) + 1][math.Mod(n - 1, chunkLines()) + 1]

defn StateAt(n, colors, guess)
  (** The state at the start of line n: the one known, else the one guessed for a screen, {From, States} or missing, else the first, as if no
      comment or text opened in the lines above.

        StateAt(3, BlankColors(), missing) --> FirstState *)
  if n <= colors.Known
    return StartOf(n, colors)
  end
  if not value.IsMissing(guess) and n >= guess.From and n < guess.From + value.Len(guess.States)
    guess.States[n - guess.From + 1]
  else
    FirstState
  end
end

(** The states guessed for the screen of a buffer, or missing when its colors are known: a state from before this field has none.

      GuessOf({Colors: BlankColors()}) --> missing *)
GuessOf(b) = match b
  {Guess: g} -> g
  else -> missing
end

(** Is a state out of any comment and text?

      IsCode(FirstState) --> true *)
IsCode(state) = state.Comment == 0 and not state.Text

(** Can this line change the state? Only a quote or a comment mark can open or close a text or a comment. *)
mayChange(words) = str.Contains("\"", words) or str.Contains("(*", words) or str.Contains("*)", words)

(** How many bytes the character at byte at takes, from its first byte: one past the end of the words. *)
charBytes(at, words) = if at > str.ByteLength(words) 1 else bytesOfLead(str.Byte(at, words)) end
bytesOfLead(b) = if b < 0xC0 1 else if b < 0xE0 2 else if b < 0xF0 3 else 4 end

defn StateAfter(words, state)
  (** The state at the end of a line, given the one at its start: the one that Tokens gives, without making the tokens. A line with no quote and no
      comment mark leaves it as it is. Else the line is read from mark to mark, each found natively: in a comment, the next opening or closing of one,
      as comments nest; in a text, the next quote, a doubled quote and a character after a backslash being part of it; elsewhere, the next quote or
      opening of a comment. A jump to the end of a large file reads the state of every line before it.

        StateAfter("x = \"a (* b", FirstState) --> {Comment: 0, Text: true}
        StateAfter("a *) \"b\"", {Comment: 1, Text: false}) --> {Comment: 0, Text: false} *)
  if not mayChange(words)
    return state
  end
  walk(words, state, missing)
end

defn walk(words, state, stops)
  (** The reading of a line that StateAfter makes, from the start of the line in the state given. With stops missing, it gives the state at the end of
      the line. With a list, it gives {State, Stops}, and starts from the last of the stops given, with the state there, if any: it keeps a stop, {At,
      Comment, Text}, at the first place between two steps stopBytes() past the last one, as the crossing of Tokens does, and Stops are the ones given
      and those, in order. A step reads no byte after the one where the next starts, the one after a quote, so a stop holds for a line read from the
      same state whose bytes are those of the line it was made on up to it: the reading from it goes as the reading from the start would, and keeps
      the same stops. *)
  depth = state.Comment
  inText = state.Text
  i = 1
  if not value.IsMissing(stops) and value.Len(stops) > 0
    depth = list.Last(stops).Comment
    inText = list.Last(stops).Text
    i = list.Last(stops).At
  end
  out = stops
  n = str.ByteLength(words)
  stop = if value.IsMissing(stops) n + 1 else i + stopBytes() end
  (* The places found are kept while they are ahead, so that each mark is looked for once: see kept. *)
  open = 0
  close = 0
  quote = 0
  slash = 0
  while i <= n
    if i >= stop
      out = list.Append({At: i, Comment: depth, Text: inText}, out)
      stop = i + stopBytes()
    end
    if depth > 0
      open = if kept(open, i) open else str.ByteFind("(*", i, words) end
      close = if kept(close, i) close else str.ByteFind("*)", i, words) end
      next = earlier(open, close)
      if value.IsMissing(next)
        i = n + 1
      else if next == open
        depth += 1
        i = open + 2
      else
        depth -= 1
        i = close + 2
      end
    else if inText
      quote = if kept(quote, i) quote else str.ByteFind("\"", i, words) end
      slash = if kept(slash, i) slash else str.ByteFind("\\", i, words) end
      if value.IsMissing(quote)
        i = n + 1
      else if not value.IsMissing(slash) and slash < quote
        i = slash + 1 + charBytes(slash + 1, words)
      else if quote < n and str.Byte(quote + 1, words) == 34
        i = quote + 2
      else
        inText = false
        i = quote + 1
      end
    else
      quote = if kept(quote, i) quote else str.ByteFind("\"", i, words) end
      open = if kept(open, i) open else str.ByteFind("(*", i, words) end
      next = earlier(quote, open)
      if value.IsMissing(next)
        i = n + 1
      else if next == quote
        inText = true
        i = quote + 1
      else
        depth = 1
        i = open + 2
      end
    end
  end
  if value.IsMissing(stops)
    {Comment: depth, Text: inText}
  else
    {State: {Comment: depth, Text: inText}, Stops: out}
  end
end

defn held(long, words, state)
  (** The stops of the line kept by the colors, long, {State, Text, Stops}, that still hold for the words of a line read from the state given: none if
      long was read from another state, else those up to the last one past which, by StopMargin() bytes, the words are the same as long.Text. It is
      looked for by halves, as the screen looks for the stops of a row, so a line of a megabyte is compared a few times at most. *)
  if value.IsMissing(long) or not (long.State == state)
    return []
  end
  stops = long.Stops
  size = str.ByteLength(long.Text)
  holds(k) = stops[k].At + StopMargin() <= size and str.StartsWith(str.ByteSlice(1, stops[k].At + StopMargin(), long.Text), words)
  (* The first and the last first, as each of these takes a slice of the line as long as the bytes before its stop: after a key at the start of the
     line the first fails, and at its far end the last holds. *)
  if value.Len(stops) == 0 or not holds(1)
    return []
  end
  if holds(value.Len(stops))
    return stops
  end
  low = 1
  high = value.Len(stops) - 1
  while low < high
    middle = math.Div(low + high + 1, 2)
    if holds(middle)
      low = middle
    else
      high = middle - 1
    end
  end
  list.Take(low, stops)
end

(** The line that the colors keep the stops of, {State, Text, Stops}, or missing: see ColoredTo. *)
longOf(colors) = match colors
  {Long: long} -> long
  else -> missing
end

defn ColoredTo(line, lineOf, colors)
  (** The state at the start of line number line, once the lines before it are known; line_of(n) gives the text of line n.
      The first line of more than 64 KB that may change the state, of those read, is kept with its stops, as Long, {State, Text, Stops}: where its
      reading passed, with the state there, one every 64 KB at least, as Tokens keeps them; a reading of no such line keeps none. The next reading of
      a line of that size starts from the last of them that still holds, the line read from the same state and the same up to StopMargin() bytes past
      it: after a key at the far end of a line of a megabyte, the state at its end, for the lines under it, reads only the bytes after the last stop
      before the edit, and is the same.

        StartOf(2, ColoredTo(2, n -> str.Join("", ["(", "* a"]), BlankColors())).Comment --> 1 *)
  have = colors.Known
  if line <= have
    return colors
  end
  chunks = colors.Chunks
  last = value.Len(chunks)
  part = chunks[last]
  state = StartOf(have, colors)
  long = longOf(colors)
  kept = missing
  (* As StateAfter, a line with no mark is not read; the first long one found is read with stops, and the size of a line is asked only until then. *)
  looking = true
  big = stopBytes()
  for n in have..(line - 1)
    words = lineOf(n)
    if mayChange(words)
      if looking and str.ByteLength(words) > big
        r = walk(words, state, held(long, words, state))
        kept = {State: state, Text: words, Stops: r.Stops}
        looking = false
        state = r.State
      else
        state = walk(words, state, missing)
      end
    end
    if value.Len(part) == chunkLines()
      chunks[last] = part
      chunks = list.Append([], chunks)
      last += 1
      part = []
    end
    part = list.Append(state, part)
  end
  chunks[last] = part
  out = {Chunks: chunks, Known: line}
  if not value.IsMissing(kept)
    out.Long = kept
  end
  out
end

defn ForgetFrom(line, colors)
  (** The colors with only the lines before the given one still known, after an edit in it. The first line is always known. The long line kept, if
      any, stays: its stops are used only where they still hold, see ColoredTo.

        ForgetFrom(2, ColoredTo(5, n -> "x", BlankColors())).Known --> 2 *)
  keep = list.Max(1, line)
  if colors.Known <= keep
    return colors
  end
  whole = math.Div(keep - 1, chunkLines())
  chunks = list.Take(whole + 1, colors.Chunks)
  chunks[whole + 1] = list.Take(keep - whole * chunkLines(), chunks[whole + 1])
  out = colors
  out.Chunks = chunks
  out.Known = keep
  out
end
