(** The window of Cemacs and its loop. A program starts it with a config, as src/cemacs.ce does: the core knows no app, so the keys and the settings come from there. *)
use src/sdl
use src/ui
use core/commands
use core/text
use core/view
use std/io
use std/list
use std/result
use std/sys
use std/text as str
use std/value

defn opened(home, size, window)
  (** The window, of the size window gives, {Width, Height} in pixels, with the three fonts of Cemacs found in fonts/ under its home, all of this size: body,
      strong and code. *)
  first = sdl.Open("Cemacs", window.Width, window.Height, "$home/fonts/AdwaitaSans-Regular.ttf", size = size, light = true)?
  second = sdl.AddFont("strong", "$home/fonts/NotoSans-Medium.ttf", size, first, light = true)?
  sdl.AddFont("code", "$home/fonts/JetBrainsMono-Regular.ttf", size, second)
end

defn themeOf(c)
  (** The theme that the Theme of a config gives, or ui.Dark for a config without one, as one made before this field: see view.Start. *)
  match c
    {Theme: f} -> f()
    else -> ui.Dark
  end
end

defn windowOf(c)
  (** The size of the window at the start, {Width, Height} in pixels, that the Window of a config gives, or 1280 by 720 for a config without one. *)
  match c
    {Window: f} -> f()
    else -> {Width: 1280, Height: 720}
  end
end

defn begun(c, state)
  (** The state after the Start of a config, the function from a state to a state that runs once, after the files opened; the state as it is for a config
      without one. *)
  match c
    {Start: f} -> f(state)
    else -> state
  end
end

defn optionsOf(c)
  (** The options of the command line that the apps of a config take, as the cells take --app: what its Options gives, or none for a config without it. *)
  match c
    {Options: f} -> f()
    else -> []
  end
end

defn Options(args, known)
  (** The words of a command line after the home, {Options, Files} in an Ok: the options are the first words that start with --, each kept once, up to --,
      which ends them, or to the first other word, which is a file, as each word after it is, --app too; the files are the rest. An option not in known is an
      Err of the line that says so.

        Options(["--app", "a.ce"], ["--app"]) --> result.Ok({Options: ["--app"], Files: ["a.ce"]})
        Options(["--", "--app"], ["--app"]) --> result.Ok({Options: [], Files: ["--app"]}) *)
  options = []
  k = 1
  while k <= value.Len(args) and str.StartsWith("--", args[k])
    word = args[k]
    k += 1
    if word == "--"
      break
    end
    if not (word in known)
      return result.Err("cemacs: unknown option $word (known: $(if value.Len(known) == 0 "none" else str.Join(", ", known) end))")
    end
    if not (word in options)
      options = list.Append(word, options)
    end
  end
  result.Ok({Options: options, Files: list.Skip(k - 1, args)})
end

defn Start(config)
  (** Opens the window with config, the function that gives the keys and the settings, opens the files given after the home or one empty buffer, runs the
      Start of the config, and runs until the editor ends. The size of the window, its theme and its fonts are read once, here. bin/cemacs gives the home of
      Cemacs first, then the options and the files to open, see Options: the state keeps the options as Options, and an option that no app of the config
      takes stops Cemacs before its window opens, with a line on the standard error and the exit code 2. cesia do dev runs from the home and gives nothing. *)
  home = if value.Len(sys.Args) == 0 "." else sys.Args[1] end
  c = config()
  line = Options(list.Skip(1, sys.Args), optionsOf(c))
  if result.IsErr(line)
    io.PrintError(line.Error)
    sys.Exit(2)
  end
  size = windowOf(c)
  window = opened(home, c.FontSize(), size)?
  measured = sdl.Measure(window)
  look = ui.Look(themeOf(c), measured.Width, measured.Height)
  cell = {Width: look.Width("M", "code"), Height: sdl.TextSize("Ag", window, font = "code").Height + view.LineGap}
  empty = view.Start([text.Of("", missing)], look, cell, size.Width, size.Height)
  empty.Window = window
  empty.Config = config
  empty.Home = home
  empty.Options = line.Value.Options
  state = commands.Settled(begun(c, commands.OpenAll(line.Value.Files, empty)))
  sdl.Run(state, commands.Update, view.View, window, moving = commands.Moving)
  sdl.Close(window)
  result.Ok(missing)
end
