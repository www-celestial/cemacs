(** The buffer of a file: a rope, a cursor, a mark and the history. Lines count from 1, columns from 0. *)
use src/rope
use src/history
use core/color
use core/indent
use std/text as str
use std/list
use std/dict
use std/math
use std/value

defn Of(words, path)
  (** A buffer holding words, for the file at path (or missing for a text with no file). The cursor is at the start, nothing is selected,
      nothing is colored yet, and the text counts as saved. The editor owns three more fields: hold, what holds the screen until the next key (see
      view.HoldOf), skip, the rows of the top line above the screen (see view.SkipOf), and origin, where the mark came from: "" for no mark, "key" for C-space, "shift" for a selection with Shift, "mouse" for a drag.
      Marks are the errors and warnings that a check found, each {Line, Column, End, Severity, Message, Hint}: see MarksOf; MarksNote, words that the
      mode line shows when there are none, such as why the text wasn't checked: see MarksNoteOf. Screen is what the view keeps
      of the lines on the screen from one frame to the next, and Guess the states it guessed for a screen past the colors known: see view.Follow.
      Layout is the reading of the layout of Cesia that the last Enter kept, for the line after it: see indent.Forget.
      Besides the fields of the state, a buffer has three private ones: wanted, the column that
      MoveLine and MovePage try to keep through shorter lines (a column, or missing, and every other move and every edit clears it); clock, the
      highest version given so far, so that a new edit never gets the number of a state that was undone; and typing, which is true while the last
      command was a letter typed that a following letter continues (the step of undo).

        Of("a", "a.ce").Cursor.Line --> 1 *)
  r = rope.Of(words)
  cursor = {Line: 1, Column: 0}
  {Rope: r, Cursor: cursor, Mark: missing, History: history.Of({Rope: r, Cursor: cursor, Version: 0, Before: cursor, Line: 1}), Version: 0, Top: 1, Left: 0, Path: path, Saved: 0, Disk: missing,
    Colors: color.BlankColors(), Guess: missing, Screen: dict.Dict(), Wanted: missing, Clock: 0, Typing: false, Hold: "", Skip: 0, Origin: "", Marks: [], MarksNote: "",
    Layout: missing}
end

(** Does line n end with a CRLF? Then its \r belongs to the line end. A \r anywhere else, or at the end of the last line, is an ordinary character. Only
    the byte before the line end is read, so a long line costs no more than a short one. *)
defn hasCr(n, b)
  if n >= rope.LineCount(b.Rope)
    return false
  end
  stop = rope.LineEnd(n, b.Rope)
  stop > rope.LineStart(n, b.Rope) and rope.Slice(stop - 1, stop, b.Rope) == "\r"
end

defn line(n, b)
  (** The text of line n, without its line end: a \r before the line end is not part of it. *)
  s = rope.Line(n, b.Rope)
  if hasCr(n, b) withoutLast(s) else s end
end

withoutLast(s) = str.ByteSlice(1, str.ByteLength(s) - 1, s)   (** A text without its last byte, the \r of its CRLF. *)

defn eol(n, b)
  (** The line end of line n: \r\n or \n. The last line has none, so it takes the one of the line above, or \n if it is alone. *)
  if n < rope.LineCount(b.Rope)
    if hasCr(n, b) "\r\n" else "\n" end
  else if n > 1 and hasCr(n - 1, b)
    "\r\n"
  else
    "\n"
  end
end
width(n, b) = value.Len(line(n, b))   (** The number of characters of line n. *)

defn clamp(pos, b)
  (** A position {Line, Column} brought inside the text. *)
  line = list.Min(list.Max(1, pos.Line), rope.LineCount(b.Rope))
  {Line: line, Column: list.Min(list.Max(0, pos.Column), width(line, b))}
end

defn ByteOf(pos, b)
  (** The byte of the rope at a position: the start of its line, plus the bytes of the characters before it.

        ByteOf({Line: 2, Column: 1}, Of("é\nab", missing)) --> 4 *)
  start = rope.LineStart(pos.Line, b.Rope)
  if pos.Column == 0
    start
  else
    start + str.ByteLength(str.Slice(1, pos.Column, line(pos.Line, b)))
  end
end

defn PositionOf(at, b)
  (** The position {Line, Column} of a byte of the rope, the column counted in characters.

        PositionOf(4, Of("é\nab", missing)) --> {Line: 2, Column: 1} *)
  line = rope.LineOf(at, b.Rope)
  {Line: line, Column: value.Len(rope.Slice(rope.LineStart(line, b.Rope), at, b.Rope))}
end

defn forwardFrom(pos, b)
  (** The position after another one, or missing at the end of the file. A line end counts as one step. *)
  if pos.Column < width(pos.Line, b)
    {Line: pos.Line, Column: pos.Column + 1}
  else if pos.Line < rope.LineCount(b.Rope)
    {Line: pos.Line + 1, Column: 0}
  else
    missing
  end
end

defn back(pos, b)
  (** The position before another one, or missing at the start of the file. *)
  if pos.Column > 0
    {Line: pos.Line, Column: pos.Column - 1}
  else if pos.Line > 1
    {Line: pos.Line - 1, Column: width(pos.Line - 1, b)}
  else
    missing
  end
end

(** Does the first position come before the second? *)
before(p, q) = p.Line < q.Line or (p.Line == q.Line and p.Column < q.Column)

defn moved(cursor, b, dir = -1)
  (** The buffer with a cursor, after a command that is not a move by lines: no wanted column, and the step of typing ends. A cursor on a line that a fold
      hides goes on to the first line shown in the direction dir, 1 down or -1 up, or else back the other way: at the start of a line below, at the end of
      a line above; with every line hidden it stays where it was. A buffer without a fold pays one match. *)
  if value.IsSome(FoldOf(b)) and not Visible(cursor.Line, b)
    n = ShownFrom(cursor.Line, dir, b)
    cursor = if value.IsMissing(n) b.Cursor else {Line: n, Column: if n > cursor.Line 0 else width(n, b) end} end
  end
  b.Cursor = cursor
  b.Wanted = missing
  b.Typing = false
  b
end

(** Is a byte one of a word: a letter, a digit or an underscore, or a byte of a character outside ASCII? Cesia knows the case of the ASCII letters only,
    so any character of more than one byte counts as a letter, as in color.ce: accents and other alphabets are in words, and so are the rare symbols
    outside ASCII. Each of its bytes is 128 or more, so a byte tells for its character. *)
wordByte(v) = v == 95 or (v >= 48 and v <= 57) or (v >= 97 and v <= 122) or (v >= 65 and v <= 90) or v >= 128

(** Is a character one of a word, as wordByte tells from its first byte? *)
isWord(c) = c != "" and wordByte(str.Byte(1, c))

(** Does a byte continue a character, 10xxxxxx in UTF-8, instead of starting one? *)
continues(v) = v >= 128 and v < 192

defn skip(forward, word, pos, b)
  (** The position after moving from pos, forward or back, across the characters that are of a word, word true, or that are not, word false; a line end
      is a character of no word. The text of each line is taken once, and walked a byte at a time: a move costs the length of the lines it reads, not
      their square. Forward across a word, its ASCII letters, digits and underscores are skipped natively, each run at once, and its characters counted
      natively at the end: a word of a million letters, as a minified file holds, is crossed in milliseconds. *)
  n = pos.Line
  column = pos.Column
  atEnd = false
  while true
    l = line(n, b)
    size = str.ByteLength(l)
    column = if atEnd value.Len(l) else list.Min(column, value.Len(l)) end
    i = if atEnd size else str.ByteLength(str.Slice(1, column, l)) end
    if forward and word
      (* The word ends before the first byte of ASCII that is of none: a byte from 128 on is of a word, and continues none of ASCII. Its characters are
         those that value.Len counts in it, as the loop below counts them, the first byte one whatever it is. *)
      e = i
      while e < size
        v = str.Byte(e + 1, l)
        if (v >= 97 and v <= 122) or (v >= 65 and v <= 90) or (v >= 48 and v <= 57) or v == 95
          k = str.ByteFindAny("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_", e + 2, l, not = true)
          e = if value.IsMissing(k) size else k - 1 end
        else if v >= 128
          e += 1
        else
          break
        end
      end
      return {Line: n, Column: column + (if e > i value.Len(str.ByteSlice(i + 1, e, l)) else 0 end)}
    else if forward
      while i < size
        if wordByte(str.Byte(i + 1, l)) != word
          return {Line: n, Column: column}
        end
        i += 1
        while i < size and continues(str.Byte(i + 1, l))
          i += 1
        end
        column += 1
      end
      if word or n >= rope.LineCount(b.Rope)
        return {Line: n, Column: column}
      end
      n += 1
      column = 0
    else
      while i > 0
        j = i
        while j > 1 and continues(str.Byte(j, l))
          j -= 1
        end
        if wordByte(str.Byte(j, l)) != word
          return {Line: n, Column: column}
        end
        i = j - 1
        column -= 1
      end
      if word or n == 1
        return {Line: n, Column: column}
      end
      n -= 1
      atEnd = true
    end
  end
end

defn MoveChar(by, b)
  (** The cursor moved by whole characters: forward for a positive number, back for a negative one, stopping at the ends of the file.

        MoveChar(1, Of("ab", missing)).Cursor.Column --> 1 *)
  p = b.Cursor
  n = math.Abs(by)
  while n > 0
    next = if by > 0 forwardFrom(p, b) else back(p, b) end
    if value.IsMissing(next)
      n = 0
    else
      p = next
      n -= 1
    end
  end
  moved(p, b, dir = if by < 0 (-1) else 1 end)
end

defn MoveWord(by, b)
  (** The cursor moved by words: a word is a run of letters, digits and underscores, in any alphabet. Forward it goes to the end of the next
      word, back to the start of the previous one.

        MoveWord(1, Of("foo bar", missing)).Cursor.Column --> 3 *)
  p = b.Cursor
  for i in list.Range(1, math.Abs(by))
    p = skip(by > 0, true, skip(by > 0, false, p, b), b)
  end
  moved(p, b, dir = if by < 0 (-1) else 1 end)
end

defn MoveLine(by, b)
  (** The cursor moved by lines, keeping the column the person wanted through shorter lines. At the first and last lines it stays there. In a buffer
      with a fold, a move that ends on a hidden line goes on in its direction to the first line shown, or else back to the nearest one: see ShownFrom.

        MoveLine(1, Of("ab\ncd", missing)).Cursor.Line --> 2 *)
  wanted = if value.IsMissing(b.Wanted) b.Cursor.Column else b.Wanted end
  line = list.Min(list.Max(1, b.Cursor.Line + by), rope.LineCount(b.Rope))
  if value.IsSome(FoldOf(b))
    shown = ShownFrom(line, if by < 0 (-1) else 1 end, b)
    line = if value.IsMissing(shown) b.Cursor.Line else shown end
  end
  b.Cursor = {Line: line, Column: list.Min(wanted, width(line, b))}
  b.Wanted = wanted
  b.Typing = false
  b
end

(** The cursor moved by pages of rows lines: forward for a positive number, back for a negative one. It keeps the wanted column, and passes the lines
    hidden by a fold, as MoveLine does.

      MovePage(1, 2, Of("a\nb\nc", missing)).Cursor.Line --> 3 *)
MovePage(by, rows, b) = MoveLine(by * list.Max(1, rows), b)

(** The cursor at the start of its line.

      ToLineStart(Place(1, 1, Of("ab", missing))).Cursor.Column --> 0 *)
ToLineStart(b) = moved({Line: b.Cursor.Line, Column: 0}, b)

(** The cursor at the end of its line.

      ToLineEnd(Of("ab", missing)).Cursor.Column --> 2 *)
ToLineEnd(b) = moved({Line: b.Cursor.Line, Column: width(b.Cursor.Line, b)}, b)

(** The cursor at the start of the file.

      ToFileStart(Place(1, 1, Of("ab", missing))).Cursor.Column --> 0 *)
ToFileStart(b) = moved({Line: 1, Column: 0}, b, dir = 1)

(** The cursor at the end of the file.

      ToFileEnd(Of("a\nbc", missing)).Cursor.Line --> 2 *)
ToFileEnd(b) = moved(clamp({Line: rope.LineCount(b.Rope), Column: width(rope.LineCount(b.Rope), b)}, b), b)

(** The cursor at a line and a column, brought inside the text. A line that a fold hides gives the nearest line shown above it, or else below it.

      Place(9, 9, Of("ab", missing)).Cursor.Column --> 2 *)
Place(line, column, b) = moved(clamp({Line: line, Column: column}, b), b)

defn MarksOf(b)
  (** The marks of a buffer, each {Line, Column, End, Severity, Message, Hint}: a line from 1, the columns from 0 with End after the span, the severity
      "error" or "warning", and a hint or missing. A buffer from before this field has none, and reading one it lacks would panic.

        MarksOf(Of("a", missing)) --> [] *)
  match b
    {Marks: marks} -> marks
    else -> []
  end
end

defn WithMarks(marks, b, note = "")
  (** The buffer with these marks, as a check gives them, and a note for the mode line to show when there are none, or "".

        value.Len(MarksOf(WithMarks([{Line: 1, Column: 0, End: 1, Severity: "error", Message: "m", Hint: missing}], Of("a", missing)))) --> 1
        MarksNoteOf(WithMarks([], Of("a", missing), note = "not checked")) --> "not checked" *)
  out = b
  out.Marks = marks
  out.MarksNote = note
  out
end

defn MarksNoteOf(b)
  (** The note that came with the marks of a buffer, or "": a buffer from before this field has none.

        MarksNoteOf(Of("a", missing)) --> "" *)
  match b
    {MarksNote: note} -> note
    else -> ""
  end
end

defn BlocksOf(b)
  (** The blocks drawn under lines of a buffer, as the results of cells: each {Line, Rows, Draw}, under line Line, Rows rows of the code font high, and
      Draw(width, look) the commands that draw it, from its top left, at most width pixels wide. They are no text: never typed, never saved. A buffer from
      before this field has none.

        BlocksOf(Of("a", missing)) --> [] *)
  match b
    {Blocks: blocks} -> blocks
    else -> []
  end
end

defn WithBlocks(blocks, b)
  (** The buffer with these blocks under its lines, in the order of their lines.

        value.Len(BlocksOf(WithBlocks([{Line: 1, Rows: 2, Draw: (w, look) -> []}], Of("a", missing)))) --> 1 *)
  out = b
  out.Blocks = blocks
  out
end

defn FoldOf(b)
  (** The fold of a buffer, or missing for none, as every buffer has until an app gives it one: {Hidden, Titles}, Hidden the runs of lines hidden, each
      {From, To}, in order, apart and not touching, which take no row on the screen (the blocks under them still show), and Titles the lines drawn as their
      words alone, by line as a text, as "4" -> "Settings": in the strong font, without their number. A line hidden is not drawn, even with a title. An app
      may add Written, the version of a write of its own that the editor lets through, and Note, what the editor says when it refuses a change of the text
      (see commands.Update). A fold is a view: never typed, never saved. A buffer from before this field has none.

        FoldOf(Of("a", missing)) --> missing *)
  match b
    {Fold: f} -> f
    else -> missing
  end
end

defn WithFold(fold, b)
  (** The buffer with this fold, its runs in order and those that touch or overlap made one, and its cursor on a line shown, as Place puts it; missing
      takes the fold away.

        FoldOf(WithFold({Hidden: [{From: 3, To: 4}, {From: 2, To: 2}], Titles: {}}, Of("a\nb\nc\nd", missing))).Hidden --> [{From: 2, To: 4}] *)
  out = b
  if value.IsMissing(fold)
    out.Fold = missing
    return out
  end
  runs = []
  for r in list.SortBy(x -> x.From, [x for x in fold.Hidden if x.To >= x.From])
    if value.Len(runs) > 0 and r.From <= list.Last(runs).To + 1
      runs[value.Len(runs)].To = list.Max(list.Last(runs).To, r.To)
    else
      runs = list.Append({From: r.From, To: r.To}, runs)
    end
  end
  f = fold
  f.Hidden = runs
  out.Fold = f
  if Visible(out.Cursor.Line, out) out else moved(out.Cursor, out) end
end

defn HiddenRun(n, fold)
  (** The run {From, To} of a fold that hides line n, or missing: looked for by halves, so a fold of many runs costs a few steps.

        HiddenRun(3, {Hidden: [{From: 2, To: 4}], Titles: {}}) --> {From: 2, To: 4} *)
  runs = fold.Hidden
  low = 1
  high = value.Len(runs)
  while low <= high
    middle = math.Div(low + high, 2)
    r = runs[middle]
    if n < r.From
      high = middle - 1
    else if n > r.To
      low = middle + 1
    else
      return r
    end
  end
  missing
end

(** Is line n shown: not hidden by the fold of the buffer? Every line of a buffer without a fold is.

      Visible(2, WithFold({Hidden: [{From: 2, To: 2}], Titles: {}}, Of("a\nb\nc", missing))) --> false *)
Visible(n, b) = (f -> value.IsMissing(f) or value.IsMissing(HiddenRun(n, f)))(FoldOf(b))

defn ShownFrom(n, dir, b)
  (** The line shown nearest to line n going dir, 1 down or -1 up: n itself when shown, else the first line after the run that hides it in that direction,
      or else the one before it the other way; missing when every line from the start to the end is hidden.

        ShownFrom(2, 1, WithFold({Hidden: [{From: 2, To: 2}], Titles: {}}, Of("a\nb\nc", missing))) --> 3 *)
  f = FoldOf(b)
  r = if value.IsMissing(f) missing else HiddenRun(n, f) end
  if value.IsMissing(r)
    return n
  end
  count = rope.LineCount(b.Rope)
  ahead = if dir < 0 (r.From - 1) else r.To + 1 end
  behind = if dir < 0 (r.To + 1) else r.From - 1 end
  if ahead >= 1 and ahead <= count
    ahead
  else if behind >= 1 and behind <= count
    behind
  else
    missing
  end
end

defn blocksShifted(line, before, after, blocks)
  (** The blocks after an edit at line that took the text from before lines to after: those below move with their lines, and one under a line of the
      edit goes under its last line, so that a line added at the end of a cell comes above its result. *)
  if value.Len(blocks) == 0
    return blocks
  end
  last = line + list.Max(0, before - after)
  out = []
  for k in blocks
    moved = k
    moved.Line = if k.Line > last k.Line + after - before else if k.Line >= line list.Min(after, k.Line + list.Max(0, after - before)) else k.Line end
    out = list.Append(moved, out)
  end
  out
end

defn lineMoved(by, m)
  (** A mark moved by some lines. *)
  out = m
  out.Line = m.Line + by
  out
end

defn shifted(line, before, after, marks)
  (** The marks after an edit at line that took the text from before lines to after: those of the lines it changed go, so that a fix being typed loses its
      mark, and those below move with their lines. *)
  last = line + list.Max(0, before - after)
  [if m.Line > last lineMoved(after - before, m) else m end for m in marks if m.Line < line or m.Line > last]
end

defn edit(r, cursor, line, continues, typing, b)
  (** The buffer with a new rope, a new cursor and the history that records it. A step that continues typing replaces the last state of the history
      instead of adding one. line is the first line that changed, where the colors stop being known. The cursor is brought inside the new text, also in
      the history: a \r that ends up before a line end joins it, and the line is then shorter than the caller counted. *)
  version = b.Clock + 1
  merging = continues and b.Typing
  now = b.History.Present
  b.Marks = shifted(line, rope.LineCount(b.Rope), rope.LineCount(r), MarksOf(b))
  b.Blocks = blocksShifted(line, rope.LineCount(b.Rope), rope.LineCount(r), BlocksOf(b))
  b.Rope = r
  inside = clamp(cursor, b)
  state = {Rope: r, Cursor: inside, Version: version, Before: if merging now.Before else b.Cursor end, Line: if merging list.Min(line, now.Line) else line end}
  h = if merging history.Record(state, history.Undo(b.History)) else history.Record(state, b.History) end
  b.Cursor = inside
  b.Version = version
  b.Clock = version
  b.History = h
  b.Wanted = missing
  b.Typing = typing
  b.Colors = color.ForgetFrom(line, b.Colors)
  b.Layout = indent.Forget(line, b)
  b
end

defn leadingOf(n, column, b)
  (** The leading spaces and tabs of line n, up to the column: each is one byte, so the line is read only as far as they go, natively. *)
  words = line(n, b)
  first = str.ByteFindAny(" \t", 1, words, not = true)
  str.ByteSlice(1, list.Min(column, if value.IsMissing(first) str.ByteLength(words) else first - 1 end), words)
end

defn insert(words, continues, b)
  (** Inserts a text at the cursor. Only one character typed continues the step of undo, and a space or a line end ends it. *)
  pieces = str.Split("\n", words)
  at = b.Cursor
  cursor = if value.Len(pieces) == 1
    {Line: at.Line, Column: at.Column + value.Len(words)}
  else
    {Line: at.Line + value.Len(pieces) - 1, Column: value.Len(list.Last(pieces))}
  end
  r = rope.Insert(ByteOf(at, b), words, b.Rope)
  typing = value.Len(words) == 1 and not (words == " " or words == "\t" or words == "\n")
  edit(r, cursor, at.Line, continues and value.Len(words) == 1, typing, b)
end

(** The text typed at the cursor. The cursor goes after it. Typing one character at a time makes words of undo: a step ends at a space, at a line end
    and at any command other than typing.

      InsertWords("a", Of("", missing)).Cursor.Column --> 1 *)
InsertWords(words, b) = if words == "" b else insert(words, true, b) end

defn delete(p, q, b)
  (** The buffer without the text from one position up to another, which comes after it. The cursor goes to the first. *)
  r = rope.Delete(ByteOf(p, b), ByteOf(q, b), b.Rope)
  edit(r, p, p.Line, false, false, b)
end

defn NewLine(b)
  (** A line end inserted at the cursor. In a file of Cesia, the new line starts where cesia fmt would put it, one block deeper after a line
      that opens one (see indent.Wanted), and the spaces around the cursor go, since no line ends with spaces; inside a text, which holds its
      spaces, as in another file. In another file, the new line starts with the spaces and tabs the line starts with, so that it is indented as
      this one.

        NewLine(Place(1, 3, Of("  x", missing))).Cursor.Column --> 2
        rope.Text(NewLine(Place(1, 4, Of("if a", "a.ce"))).Rope) --> "if a\n  " *)
  if not indent.IsCesia(b)
    return insert("$(eol(b.Cursor.Line, b))$(leadingOf(b.Cursor.Line, b.Cursor.Column, b))", false, b)
  end
  at = b.Cursor
  n = indent.NewLine(at, b)
  from = ByteOf({Line: at.Line, Column: at.Column - n.Before}, b)
  r = rope.Insert(from, "$(eol(at.Line, b))$(n.Indent)", rope.Delete(from, ByteOf({Line: at.Line, Column: at.Column + n.After}, b), b.Rope))
  out = edit(r, {Line: at.Line + 1, Column: value.Len(n.Indent)}, at.Line, false, false, b)
  out.Layout = n.Layout
  out
end

defn reindented(changes, continues, typing, b)
  (** The buffer with the changes of indent of indent.Plan, {Line, Indent, Old}, as one step of undo, or as the last step of typing when it
      continues it. The cursor keeps its place in the words of its line, and goes to the end of the indent from inside it. *)
  if value.Len(changes) == 0
    return b
  end
  r = b.Rope
  cursor = b.Cursor
  for c in list.Reverse(changes)
    start = rope.LineStart(c.Line, r)
    r = rope.Insert(start, str.Repeat(c.Indent, " "), rope.Delete(start, start + c.Old, r))
    if c.Line == cursor.Line
      cursor = {Line: cursor.Line, Column: if cursor.Column <= c.Old c.Indent else cursor.Column + c.Indent - c.Old end}
    end
  end
  edit(r, cursor, changes[1].Line, continues, typing, b)
end

(** The number of spaces and tabs that line n starts with. *)
leadingWidth(n, b) = value.Len(leadingOf(n, width(n, b), b))

defn Indent(b)
  (** In a file of Cesia, the statement of the line of the cursor, or every statement with a line in the selection, at the place cesia fmt gives
      it: its first line two spaces in for each block it is in, the lines that go on with it moved as much, a line inside a text as it is (see
      indent.Plan); a blank line of the cursor goes where a line typed there would start, and the cursor from inside the indent to its end. One
      step of undo. A selection that ends at the start of a line leaves that line out. In another file, nothing changes.

        rope.Text(Indent(Place(2, 0, Of("if a\nb\nend", "a.ce"))).Rope) --> "if a\n  b\nend" *)
  if not indent.IsCesia(b)
    return b
  end
  e = ends(b)
  here = b.Cursor.Line
  changes = if not value.IsMissing(e) and before(e.First, e.Last)
    last = if e.Last.Column == 0 and e.Last.Line > e.First.Line e.Last.Line - 1 else e.Last.Line end
    indent.Plan(e.First.Line, last, b)
  else if str.Trim(line(here, b)) == ""
    want = indent.Wanted(here, b)
    if want == leadingWidth(here, b) and not str.Contains("\t", line(here, b)) [] else [{Line: here, Indent: want, Old: leadingWidth(here, b)}] end
  else
    indent.Plan(here, here, b)
  end
  if value.Len(changes) > 0
    reindented(changes, false, false, b)
  else if b.Cursor.Column < leadingWidth(here, b)
    moved({Line: here, Column: leadingWidth(here, b)}, b)
  else
    b
  end
end

(** The words that, typed at the start of a line of Cesia, change its place: end and else close or go on with a block, then goes on with a
    statement, and a closing bracket ends one. *)
isElectric(w) = w == "end" or w == "else" or w == "then" or w == ")" or w == "]" or w == "}"

defn opening(words, least)
  (** The start of a line: its spaces and tabs, then least characters more, or the whole line if it is shorter. The rest of the line is not read, and
      its spaces and tabs are skipped natively: only the last of them can be followed by a byte that continues, which makes it a longer character. *)
  n = str.ByteLength(words)
  k = str.ByteFindAny(" \t", 1, words, not = true)
  k = if value.IsMissing(k) n + 1 else if k > 1 and continues(str.Byte(k, words)) k - 1 else k end
  for c in 1..least
    if k <= n
      k += 1
      while k <= n and continues(str.Byte(k, words))
        k += 1
      end
    end
  end
  str.ByteSlice(1, k - 1, words)
end

defn headOf(words)
  (** The first token of a line after its spaces: its first name, or its first other character, or "". *)
  cs = list.DropWhile(c -> c == " " or c == "\t", str.Chars(words))
  if value.Len(cs) == 0
    return ""
  end
  if isWord(cs[1]) str.Join("", list.TakeWhile(isWord, cs)) else cs[1] end
end

defn Electric(typed, b)
  (** In a file of Cesia, after typed was typed before the cursor: when it makes the first token of the line end, else, then or a closing
      bracket, or one no longer, and the cursor is at that token or after its arrow, the line goes to the place a line typed there gets (see
      indent.Wanted), in the same step of undo as the typing. In another file, or anywhere else, nothing changes.

        rope.Text(Electric("d", Place(3, 5, Of("if a\n  b\n  end", "a.ce"))).Rope) --> "if a\n  b\nend" *)
  at = b.Cursor
  n = value.Len(typed)
  if not indent.IsCesia(b) or n == 0 or at.Column < n
    return b
  end
  if typed == "%"
    marked = cellMarked(b)
    if value.IsSome(marked)
      return marked
    end
  end
  words = line(at.Line, b)
  (* The first token that changes a place is at most four characters, else and its arrow seven: from further in, nothing to do. *)
  k = str.ByteFindAny(" \t", 1, words, not = true)
  k = if value.IsMissing(k) str.ByteLength(words) + 1 else k end
  if at.Column > k + 10
    return b
  end
  (* Only the start of the line is split into characters: its spaces and tabs, then six characters more than the column of the cursor, enough to tell
     a word of four letters from a longer one; of the line without the typed words, its spaces and six characters. A key at the start of a line of a
     megabyte reads a few bytes of it, where all its characters took 1.3 s. *)
  start = opening(words, at.Column + 6)
  cs = str.Chars(start)
  head = list.TakeWhile(c -> c == " " or c == "\t", cs)
  near = list.Skip(value.Len(head), list.Take(at.Column, cs))
  (* Of the rest of the line after the cursor, only its spaces and six characters more can reach that start: it is cut natively at the byte of the
     cursor and read as far as them, where its characters were all counted and copied twice. *)
  after = opening(str.ByteSlice(str.ByteLength(str.Slice(1, at.Column, words)) + 1, str.ByteLength(words), words), 6)
  was = headOf(opening("$(str.Slice(1, at.Column - n, words))$after", 6))
  now = headOf(start)
  rest = list.Skip(value.Len(str.Chars(now)), near)
  if not (isElectric(now) or isElectric(was)) or not list.All([c == " " or c == "-" or c == ">" for c in rest])
    return b
  end
  if str.Contains("\t", str.Join("", head))
    return b
  end
  want = indent.Wanted(at.Line, b)
  if want == value.Len(head)
    b
  else
    reindented([{Line: at.Line, Indent: want, Old: value.Len(head)}], true, b.Typing, b)
  end
end

(** The marker of a cell that %% makes and C-c e i writes, with no title yet: the title goes at column 6, between its two spaces. A function: a variable
    added under --watch is read before it has a value. *)
CellMarker() = "(* %%  *)"

defn startState(n, b)
  (** The state of the colors at the start of line n, out of any comment and text or in one: the one known, else read from the last one known, line by
      line, as a buffer that no screen showed yet has them. *)
  c = b.Colors
  k = list.Max(1, list.Min(n, c.Known))
  st = color.StartOf(k, c)
  while k < n
    st = color.StateAfter(line(k, b), st)
    k += 1
  end
  st
end

defn cellMarked(b)
  (** After a second % typed at the end of a line that holds only spaces and %%, out of any comment and text: the line replaced by CellMarker, the cursor
      where its title goes, in a step of undo of its own, so that undo gives back %%. Missing for any other line. *)
  at = b.Cursor
  words = line(at.Line, b)
  if str.Trim(words) != "%%" or at.Column != value.Len(words) or not color.IsCode(startState(at.Line, b))
    return missing
  end
  from = rope.LineStart(at.Line, b.Rope)
  r = rope.Insert(from, CellMarker(), rope.Delete(from, from + str.ByteLength(words), b.Rope))
  out = edit(r, {Line: at.Line, Column: 6}, at.Line, false, false, b)
  out.Typing = false
  out
end

(* ---- Comments of Cesia: M-; puts (* and *) around lines, or takes them away. *)

defn commentInside(words, start)
  (** The words inside the comment that a line is, after its spaces, or missing: a line that starts out of any comment and text, in the state start, and is
      one comment from its (* and a space to a space and its *), as (* x = 1 *) and (* x (* one *) *) are, and (* a *) b (* c *) is not. A comment of
      documentation, whose opening has two stars, is no such comment: M-; puts one inside a comment, as any other line. *)
  t = str.Trim(words)
  if not color.IsCode(start) or not str.StartsWith("(* ", t) or not str.EndsWith(" *)", t) or str.StartsWith("(**", t) or value.Len(t) < 5
    return missing
  end
  read = color.Tokens(t, color.FirstState)
  if value.Len(read.Tokens) != 1 or read.Tokens[1][1] != color.Comment or not color.IsCode(read.State)
    return missing
  end
  str.Slice(4, value.Len(t) - 3, t)
end

defn commentTouched(b)
  (** The lines that M-; changes: the line of the cursor, or the lines of the selection, without the last one when the selection ends at its start. *)
  e = ends(b)
  if value.IsMissing(e) or not before(e.First, e.Last)
    return [b.Cursor.Line]
  end
  last = if e.Last.Column == 0 and e.Last.Line > e.First.Line e.Last.Line - 1 else e.Last.Line end
  [k for k in e.First.Line..last]
end

defn columnAfter(pos, changes)
  (** A place of the text once the lines of changes, each {Line, Lead, By}, are commented or not: on such a line, a place in its words moves by By, and one
      in its indent stays, as one in a comment taken away goes no further left than the indent. *)
  for c in changes
    if c.Line == pos.Line and pos.Column >= c.Lead
      return {Line: pos.Line, Column: list.Max(c.Lead, pos.Column + c.By)}
    end
  end
  pos
end

defn Commented(b)
  (** M-; in a file of Cesia: the line of the cursor, or each line of the selection, as a comment of (* and *), or back as it was. A line that is a comment
      (see commentInside) loses its (* and *); any other line gets them around its words, after its indent, so x = 1 becomes (* x = 1 *), and a line that
      holds a comment already is one comment still, since comments nest. With a selection, its lines are taken back when each of them that isn't blank is
      a comment, else each of them that isn't blank becomes one. One step of undo; the cursor and the mark keep their places in the words. In another file,
      nothing changes.

        rope.Text(Commented(Of("  x = 1", "a.ce")).Rope) --> "  (* x = 1 *)"
        rope.Text(Commented(Of("(* x = 1 *)", "a.ce")).Rope) --> "x = 1" *)
  if not indent.IsCesia(b)
    return b
  end
  touched = commentTouched(b)
  alone = value.Len(touched) == 1
  rows = []
  for k in touched
    words = line(k, b)
    lead = leadingOf(k, width(k, b), b)
    rows = list.Append({Line: k, Words: words, Lead: lead, Inside: commentInside(words, startState(k, b))}, rows)
  end
  full = [x for x in rows if alone or str.Trim(x.Words) != ""]
  if value.Len(full) == 0
    return b
  end
  undo = list.All([value.IsSome(x.Inside) for x in full])
  changes = []
  for x in full
    rest = str.Slice(value.Len(x.Lead) + 1, value.Len(x.Words), x.Words)
    fresh = if undo "$(x.Lead)$(x.Inside)" else "$(x.Lead)(* $rest *)" end
    changes = list.Append({Line: x.Line, Lead: value.Len(x.Lead), By: if undo (-3) else 3 end, Text: fresh}, changes)
  end
  r = b.Rope
  for c in list.Reverse(changes)
    start = rope.LineStart(c.Line, r)
    r = rope.Insert(start, c.Text, rope.Delete(start, start + str.ByteLength(line(c.Line, b)), r))
  end
  mark = if value.IsMissing(b.Mark) missing else columnAfter(clamp(b.Mark, b), changes) end
  out = edit(r, columnAfter(b.Cursor, changes), changes[1].Line, false, false, b)
  out.Mark = if value.IsMissing(mark) missing else clamp(mark, out) end
  out
end

defn Completed(word, n, b)
  (** The n characters before the cursor replaced by word, the cursor after it, as one step of undo: a completion. In a file of Cesia, a word
      that moves its line puts it at its place in the same step, see Electric.

        rope.Text(Completed("Hello", 2, Place(1, 2, Of("he", missing))).Rope) --> "Hello" *)
  at = b.Cursor
  from = ByteOf({Line: at.Line, Column: at.Column - n}, b)
  r = rope.Insert(from, word, rope.Delete(from, ByteOf(at, b), b.Rope))
  out = Electric(word, edit(r, {Line: at.Line, Column: at.Column - n + value.Len(word)}, at.Line, false, true, b))
  out.Typing = false
  out
end

defn DeleteBefore(b)
  (** The character before the cursor deleted, or the line end before it if it is at the start of a line, which joins the two lines. At the
      start of the file nothing changes.

        DeleteBefore(Place(1, 1, Of("ab", missing))).Cursor.Column --> 0 *)
  p = back(b.Cursor, b)
  if value.IsMissing(p)
    b
  else
    delete(p, b.Cursor, b)
  end
end

defn DeleteAfter(b)
  (** The character after the cursor deleted, or the line end after it if it is at the end of a line. At the end of the file nothing changes.

        DeleteAfter(Of("ab", missing)).Cursor.Column --> 0 *)
  q = forwardFrom(b.Cursor, b)
  if value.IsMissing(q)
    b
  else
    delete(b.Cursor, q, b)
  end
end

defn SetMark(b)
  (** The mark put at the cursor. *)
  b.Mark = b.Cursor
  b.Wanted = missing
  b.Typing = false
  b
end

defn ClearMark(b)
  (** The mark taken away. *)
  b.Mark = missing
  b.Wanted = missing
  b.Typing = false
  b
end

defn ends(b)
  (** The two ends of the selection {First, Last}, the first being the one that comes first in the text, or missing if there is no mark. A mark that
      an edit left outside the text is brought back inside. *)
  if value.IsMissing(b.Mark)
    missing
  else
    m = clamp(b.Mark, b)
    if before(m, b.Cursor) {First: m, Last: b.Cursor} else {First: b.Cursor, Last: m} end
  end
end

(** The two ends of the selection {First, Last}, the first being the one that comes first in the text, or missing if there is no mark.

      Selection(MoveChar(1, SetMark(Of("ab", missing)))).Last.Column --> 1 *)
Selection(b) = ends(b)

(** The number of characters of line n, without its line end.

      LineWidth(1, Of("abc", missing)) --> 3 *)
LineWidth(n, b) = width(n, b)

defn Region(b)
  (** The selected text, between the mark and the cursor in whichever order, or an empty text if there is no mark.

        Region(MoveChar(1, SetMark(Of("ab", missing)))) --> "a" *)
  e = ends(b)
  if value.IsMissing(e)
    ""
  else
    rope.Slice(ByteOf(e.First, b), ByteOf(e.Last, b), b.Rope)
  end
end

defn CutRegion(b)
  (** The selected text removed. The cursor goes to its start and the mark is taken away. Without a mark, nothing is removed. *)
  e = ends(b)
  if value.IsMissing(e) or not before(e.First, e.Last)
    ClearMark(b)
  else
    ClearMark(delete(e.First, e.Last, b))
  end
end

defn JoinSteps(b)
  (** The buffer with the last two steps of its history made one, which undo takes back at once: the second one, from where the first one began. A
      replace of a region joins its cut and what it puts there, and the moves of a slider of the cells, a drag or keys in a row, make one step.

        rope.Text(Undo(JoinSteps(InsertWords("b", MoveChar(1, InsertWords("a ", Of("", missing)))))).Rope) --> "" *)
  second = b.History.Present
  h = history.Undo(b.History)
  first = h.Present
  second.Before = first.Before
  second.Line = list.Min(first.Line, second.Line)
  b.History = history.Record(second, history.Undo(h))
  b
end

defn ReplaceRegion(f, b)
  (** What f makes of the buffer without its selection, as one step of undo. Without a selection, it is only f.

        ReplaceRegion(b -> InsertWords("x", b), MoveChar(1, SetMark(Of("ab", missing)))).Cursor.Column --> 1 *)
  e = ends(b)
  if value.IsMissing(e) or not before(e.First, e.Last)
    return f(b)
  end
  gone = CutRegion(b)
  done = f(gone)
  if done.Version == gone.Version done else JoinSteps(done) end
end

defn Replaced(spans, b)
  (** The buffer with spans of its lines replaced at once, each {Line, Column, End, Text}, its columns from 0 on one line, as one step of undo, as a rename
      makes them; the spans don't overlap. The cursor stays where it was.

        rope.Text(Replaced([{Line: 1, Column: 0, End: 1, Text: "xy"}, {Line: 1, Column: 2, End: 3, Text: "z"}], Of("abc", missing)).Rope) --> "xybz" *)
  if value.Len(spans) == 0
    return b
  end
  placed = [{From: ByteOf({Line: s.Line, Column: s.Column}, b), To: ByteOf({Line: s.Line, Column: s.End}, b), Text: s.Text} for s in spans]
  r = b.Rope
  for k in list.Reverse(list.Order([p.From for p in placed]))
    p = placed[k]
    r = rope.Insert(p.From, p.Text, rope.Delete(p.From, p.To, r))
  end
  edit(r, b.Cursor, list.Min([s.Line for s in spans]), false, false, b)
end

defn Retyped(words, b)
  (** The buffer with its whole text replaced by words, as one step of undo, as cesia fmt gives it at a save: the cursor stays on its line, moved with the
      indent of that line when the lines didn't change in number, and brought inside the text.

        Retyped("  x = 1", Place(1, 4, Of("x = 1", missing))).Cursor --> {Line: 1, Column: 6} *)
  before = rope.Text(b.Rope)
  if words == before
    return b
  end
  old = str.Split("\n", before)
  new = str.Split("\n", words)
  c = b.Cursor
  column = c.Column
  if value.Len(old) == value.Len(new) and c.Line <= value.Len(old)
    lead(l) = value.Len(list.TakeWhile(ch -> ch == " ", str.Chars(l)))
    column = list.Max(0, c.Column + lead(new[c.Line]) - lead(old[c.Line]))
  end
  edit(rope.Of(words), {Line: c.Line, Column: column}, 1, false, false, b)
end

defn CutLine(b)
  (** Cuts from the cursor to the end of its line, or the line end itself if the cursor is already there: {Buffer, Cut}, cut being the removed
      text. At the end of the file there is nothing to cut.

        CutLine(Of("ab", missing)).Cut --> "ab" *)
  at = b.Cursor
  q = if at.Column < width(at.Line, b) {Line: at.Line, Column: width(at.Line, b)} else forwardFrom(at, b) end
  if value.IsMissing(q)
    {Buffer: b, Cut: ""}
  else
    {Buffer: delete(at, q, b), Cut: rope.Slice(ByteOf(at, b), ByteOf(q, b), b.Rope)}
  end
end

defn travel(h, s, cursor, line, b)
  (** The buffer with the text and version of a state of the history, the cursor given, and the colors and the marks known only up to the line given. *)
  b.Marks = shifted(line, rope.LineCount(b.Rope), rope.LineCount(s.Rope), MarksOf(b))
  b.Blocks = blocksShifted(line, rope.LineCount(b.Rope), rope.LineCount(s.Rope), BlocksOf(b))
  b.Rope = s.Rope
  b.Cursor = cursor
  b.Version = s.Version
  b.History = h
  b.Wanted = missing
  b.Typing = false
  b.Colors = color.ForgetFrom(line, b.Colors)
  b.Layout = indent.Forget(line, b)
  b
end

defn Undo(b)
  (** The last step of typing or editing undone, with the cursor where it was before that step. A mark stays where it was, and region and
      CutRegion bring it inside the text. Without a step before, nothing changes. *)
  if history.CanUndo(b.History)
    left = b.History.Present
    h = history.Undo(b.History)
    travel(h, history.Current(h), left.Before, left.Line, b)
  else
    b
  end
end

defn Redo(b)
  (** The step that was undone, done again, with the cursor where that step left it. An edit after an undo forgets it. *)
  if history.CanRedo(b.History)
    h = history.Redo(b.History)
    entered = history.Current(h)
    travel(h, entered, entered.Cursor, entered.Line, b)
  else
    b
  end
end

(** Is the text different from the last one saved? Undoing back to the saved text makes it false again. A buffer with no file whose text an app keeps,
    as *scratch*, never is: nothing asks to save it, see KeptOf.

      IsModified(Of("", missing)) --> false *)
IsModified(b) = b.Version != b.Saved and not (value.IsMissing(b.Path) and value.IsSome(KeptOf(b)))

defn KeptOf(b)
  (** The file where an app keeps the text of a buffer with no file of its own, as *scratch* is kept in the folder of the person's data, or missing: its
      Kept field, which a buffer from before it lacks. Such a buffer never asks to be saved, and takes its kind from that file, Cesia for one that ends in
      .ce; once saved as a file of its own, with C-x C-s, it is that file and Kept no longer counts.

        KeptOf(Of("", missing)) --> missing *)
  match b
    {Kept: path} -> path
    else -> missing
  end
end

(** The file of a buffer: its path, or, for a buffer with no file, the file an app keeps its text in, or missing. What reads a buffer as a file of
    Cesia, its check, its cells and its session, reads it there.

      FileOf(Of("", "a.ce")) --> "a.ce" *)
FileOf(b) = if value.IsMissing(b.Path) KeptOf(b) else b.Path end

defn MarkSaved(disk, b)
  (** The buffer after a save: the current version counts as saved, and disk is the time of the file that was written. *)
  b.Saved = b.Version
  b.Disk = disk
  b.Typing = false
  b
end
