(** The files of the editor. Saving never loses text: the new words go to a file next to the old one, which a rename then replaces, so a
    failure at any step leaves the old file whole. A disk is what the file looked like when it was read: {Modified, Size}, or missing for a
    file that didn't exist. *)
use std/sys
use std/text as str
use std/list
use std/math
use std/result
use std/value

(** An Err of kind "changed": the file is not the one that was read. *)
changed(path) = result.Err({Kind: "changed", Message: "$path changed on disk since it was read."})

(** The disk of a stat: the time of the file and its size. Two files that differ in either are not the same file. *)
disk(info) = {Modified: info.Modified, Size: info.Size}

defn current(path)
  (** The disk of the file at path: Ok(missing) for a file that doesn't exist, Ok of a disk, or an Err for a folder or an unreadable file. *)
  if not sys.Exists(path)
    return result.Ok(missing)
  end
  info = sys.Stat(path)?
  if info.IsDir
    return result.Err({Kind: "folder", Message: "$path is a folder."})
  end
  result.Ok(disk(info))
end

defn IsText(words)
  (** Is this text one that the editor opens: valid UTF-8 as RFC 3629 defines it, and no zero byte? Both are read by Cesia in OCaml, eight bytes
      at a time, in place: about 60 ms for 100 MB, with no copy of the text.

        IsText("é") --> true
        IsText(str.FromBytes([0x63, 0x61, 0x66, 0xE9])) --> false
        IsText(str.FromBytes([0x61, 0, 0x62])) --> false *)
  str.Count(str.FromBytes([0]), words) == 0 and str.IsUtf8(words)
end

defn Normal(path)
  (** A path without the parts . and a/.. and without doubled or trailing slashes. It doesn't follow symbolic links: it keeps a leading / and
      the .. that nothing before it can cancel, except at the root, where .. stays at the root. An empty path is ".".

        Normal("./a/../b.ce") --> "b.ce" *)
  absolute = str.StartsWith("/", path)
  parts = []
  for part in str.Split("/", path)
    if part == "" or part == "."
      parts = parts
    else if part != ".."
      parts = list.Append(part, parts)
    else if value.Len(parts) > 0 and parts[value.Len(parts)] != ".."
      parts = list.Take(value.Len(parts) - 1, parts)
    else if not absolute
      parts = list.Append(part, parts)
    end
  end
  joined = str.Join("/", parts)
  if absolute
    "/$joined"
  else if joined == ""
    "."
  else
    joined
  end
end

(* The largest file the editor opens, in bytes: 1 GiB. Reading one too large for memory would panic and lose the text of every buffer. A file takes
   about three times its size in memory at its peak, as it is read and made into a rope, the check making no copy: see the chapter Speed of the book. *)
largest = 1024 * 1024 * 1024

defn ReadFile(path)
  (** The file at path, in an Ok of {Words, Disk}. A file that doesn't exist is {Words: "", Disk: missing}. A folder, what isn't a regular file, a file
      that can't be read, one too large, one with a zero byte and one that isn't valid UTF-8 are an Err, and the file is not touched. The disk is taken before
      the read, so a file changed in between makes the next save ask instead of overwriting. A device or a FIFO has the size 0, and reading one never ends,
      so sys.Stat must say what it is first. *)
  disk = current(path)?
  if value.IsMissing(disk)
    return result.Ok({Words: "", Disk: missing})
  end
  if not sys.Stat(path)?.IsFile
    return result.Err({Kind: "special", Message: "$path is not a regular file: it may be a device, a pipe or a socket."})
  end
  if disk.Size > largest
    return result.Err({Kind: "large", Message: "$path is too large to open: $(disk.Size) bytes, and the limit is $largest."})
  end
  words = sys.Read(path)?
  if not IsText(words)
    return result.Err({Kind: "text", Message: "$path is not valid UTF-8 text, or holds a zero byte."})
  end
  result.Ok({Words: words, Disk: disk})
end

defn isFresh(path)
  (** A name next to path that nothing uses yet: it holds the time, and a counter if that name is taken. Gives Ok of the name, or an Err of kind
      "io" after a few tries. Nothing at the name is touched. *)
  stamp = value.Text(math.Floor(sys.Now() * 1000000))
  for n in list.Range(0, 20)
    name = if n == 0 "$path.cemacs-$stamp" else "$path.cemacs-$stamp-$n" end
    if not sys.Exists(name)
      return result.Ok(name)
    end
  end
  result.Err({Kind: "io", Message: "No free name next to $path for a new file."})
end

(** A failure on the new file, as a failure on path: the person never heard of the new one. *)
named(path, fresh, failure) = result.Err({Kind: failure.Error.Kind, Message: str.Replace(fresh, path, failure.Error.Message)})

defn replace(path, words)
  (** Writes the words to path through a new file next to it, then renames it over the file. The new file has a name that nothing used, and the
      cleanup removes only it. On any failure the old file stays whole. Gives Ok of the new disk. If only the stat after the rename fails, the file
      is saved and the Err has the kind "saved". *)
  fresh = isFresh(path)?
  written = sys.Write(fresh, words)
  if result.IsErr(written)
    sys.Remove(fresh)
    return named(path, fresh, written)
  end
  moved = sys.Rename(fresh, path)
  if result.IsErr(moved)
    sys.Remove(fresh)
    return named(path, fresh, moved)
  end
  match current(path)
    result.Ok(disk) -> result.Ok(disk)
    result.Err(e) -> result.Err({Kind: "saved", Message: "$path was saved, but its time couldn't be read: $(e.Message)"})
  end
end

defn SaveFile(path, words, disk)
  (** Saves the words to path if the file is still the one that was read, that is if its disk is the given one. A file that appeared since a
      read of a missing one counts as changed too. Gives Ok of the new disk, an Err of kind "changed" if the file is not the one that was
      read (nothing is written), or another Err for a failure (the old file is whole). An Err of kind "saved" means the file was saved but its
      time couldn't be read: a caller treats it as a save, with disk missing, so that the next save will ask. The file saved is a new one, so a
      read-only file becomes writable, and a symbolic link is replaced by a file. *)
  now = current(path)?
  if now != disk
    return changed(path)
  end
  replace(path, words)
end

defn ForceSave(path, words)
  (** Saves the words to path with no check of the file there, in the same safe way. Gives Ok of the new disk, or an Err. *)
  replace(path, words)
end
