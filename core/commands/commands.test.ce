(** Tests of commands.ce that need no file: run with cesia test .
    What opens or saves a file is in tests/commands-check.ce. *)
use src/emacs
use core/commands
use core/complete
use core/keys
use core/panes
use core/press
use core/text
use core/view
use src/rope
use src/ui
use std/text as str
use std/cesia
use std/dict
use std/list
use std/value

cell = {Width: 8, Height: 19}
look = ui.Look(ui.Dark, (words, font) -> value.Len(words) * 8, 19)

(** What the editor runs on in these tests: the Emacs keys and the settings, as src/cemacs.ce gives them without its apps. *)
testConfig() = emacs.Config(emacs.Keys)
defn begun(buffers, look, cell, width, height)
  (** A state as view.Start gives it, with the config of the tests. *)
  s = view.Start(buffers, look, cell, width, height)
  s.Config = testConfig
  s
end
(** A state of one buffer holding words, with no window. *)
stateOf(words) = begun([text.Of(words, missing)], look, cell, 800, 600)
here(state) = state.Buffers[state.Current]
regionOf(state) = text.Region(here(state))
wordsOf(state) = rope.Text(here(state).Rope)
modified(words) = press.Press(["x"], stateOf(words))   (** A state whose current buffer is modified. *)
(** The key event of a mouse event. *)
mouse(action, x, y) = {Kind: "mouse", Action: action, X: x, Y: y, Button: 1, Amount: 0.0}
(** The pixel under a character of the first line: the code starts at x = view.Gutter and the first line at y = 4. *)
atChar(column) = view.Gutter + column * 8 + 1

(** A binding holds the function itself, never its name; a text only names a group, and keys go on after it. *)
isEveryBindingAFunction() = value.Len(list.Filter(f -> not value.IsFunction(f), list.Flatten([dict.Values(emacs.PromptKeys()), dict.Values(emacs.MouseKeys()), dict.Values(emacs.PromptMouseKeys()),
  dict.Values(emacs.CompleteKeys())]))) == 0 and
  value.Len(list.Filter(k -> not value.IsFunction(emacs.Keys()[k]) and not (value.IsText(emacs.Keys()[k]) and list.Any(list.Map(j -> str.StartsWith("$k ", j), dict.Keys(emacs.Keys())))), dict.Keys(emacs.Keys()))) == 0
isShiftKeysBound() = emacs.Keys()["S-backspace"] == commands.DeleteBefore and emacs.Keys()["S-enter"] == commands.NewLine and emacs.Keys()["S-delete"] == commands.DeleteAfter and emacs.Keys()["S-tab"] == commands.Tab
isTypeAndMove() = wordsOf(press.Press(["a", "b", "C-b", "x"], stateOf(""))) == "axb"
isTypeCursor() = here(press.Press(["a", "b", "C-b", "x"], stateOf(""))).Cursor.Column == 2
isTab() = wordsOf(press.Press(["tab"], stateOf(""))) == "  "
isShiftTab() = wordsOf(press.Press(["S-tab"], stateOf(""))) == "  "
isShiftSelects() = regionOf(press.Press(["a", "b", "S-left"], stateOf(""))) == "b"
isPlainMoveClearsShiftMark() = value.IsMissing(here(press.Press(["a", "b", "S-left", "left"], stateOf(""))).Mark)
isShiftExtends() = regionOf(press.Press(["a", "b", "c", "S-left", "S-left"], stateOf(""))) == "bc"
isCancelPair() = wordsOf(press.Press(["C-x", "C-g", "C-s"], stateOf("a"))) == "a" and press.Press(["C-x", "C-g", "C-s"], stateOf("a")).Prompt.Label == "I-search: "   (** C-s alone, not C-x C-s. *)
isCancelPairClearsPending() = press.Press(["C-x", "C-g"], stateOf("")).Pending == ""
isPairPending() = press.Press(["C-x"], stateOf("")).Pending == "C-x"
isPromptGetsKeys() = press.Press(["C-x", "C-f", "a.ce"], stateOf("hi")).Prompt.Answer == "a.ce" and wordsOf(press.Press(["C-x", "C-f", "a.ce"], stateOf("hi"))) == "hi"
isPromptLabel() = press.Press(["C-x", "C-f"], stateOf("")).Prompt.Label == "Find file: "
isPromptBackspace() = press.Press(["C-x", "C-f", "a.ce", "backspace"], stateOf("")).Prompt.Answer == "a.c"
isPromptIgnoresChords() = press.Press(["C-x", "C-f", "C-f", "C-a", "left", "tab"], stateOf("hi")).Prompt.Answer == "" and wordsOf(press.Press(["C-x", "C-f", "C-a", "tab"], stateOf("hi"))) == "hi"
isPromptCancel() = value.IsMissing(press.Press(["C-x", "C-f", "a", "C-g"], stateOf("hi")).Prompt) and wordsOf(press.Press(["C-x", "C-f", "a", "C-g"], stateOf("hi"))) == "hi"
isPromptShiftEnterAndBackspace() = press.Press(["C-x", "C-f", "ab", "S-backspace"], stateOf("")).Prompt.Answer == "a"
isSaveAsAsks() = press.Press(["C-x", "C-s"], stateOf("a")).Prompt.Label == "Save as: "
isNextBuffer() = press.Press(["C-x", "b"], begun([text.Of("a", "x.ce"), text.Of("b", "y.ce")], look, cell, 800, 600)).Current == 2
isNextBufferGoesRound() = press.Press(["C-x", "b", "C-x", "b"], begun([text.Of("a", "x.ce"), text.Of("b", "y.ce")], look, cell, 800, 600)).Current == 1
isCloseUnsavedAsks() = closeAsks()
defn closeAsks()
  s = press.Press(["C-x", "k"], modified(""))
  s.Prompt.Label == "Text not saved. Close anyway? (y or n)" and value.Len(s.Buffers) == 1
end
isCloseUnsavedYes() = value.Len(press.Press(["C-x", "k", "y"], modified("")).Buffers) == 1 and wordsOf(press.Press(["C-x", "k", "y"], modified(""))) == "" and press.Press(["C-x", "k", "y"], modified("")).Prompt == missing
isCloseUnsavedNo() = wordsOf(press.Press(["C-x", "k", "n"], modified(""))) == "x"
isCloseSavedDirectly() = value.IsMissing(press.Press(["C-x", "k"], stateOf("")).Prompt)
defn isLastBufferClosed()
  s = press.Press(["C-x", "k"], stateOf("abc"))
  value.Len(s.Buffers) == 1 and wordsOf(s) == ""
end
defn isCloseGoesToNeighbour()
  s = press.Press(["C-x", "k"], begun([text.Of("a", "x.ce"), text.Of("b", "y.ce")], look, cell, 800, 600))
  value.Len(s.Buffers) == 1 and wordsOf(s) == "b"
end
defn isQuitAsks()
  s = press.Press(["C-x", "C-c"], modified(""))
  s.Prompt.Label == "Text not saved. Quit anyway? (y or n)" and not s.Ending
end
isQuitNoKeeps() = not press.Press(["C-x", "C-c", "n"], modified("")).Ending and value.IsMissing(press.Press(["C-x", "C-c", "n"], modified("")).Prompt)
isQuitYesEnds() = press.Press(["C-x", "C-c", "y"], modified("")).Ending
isQuitSavedEnds() = press.Press(["C-x", "C-c"], stateOf("")).Ending
isQuitPromptIgnoresOtherText() = press.Press(["C-x", "C-c", "q"], modified("")).Prompt.Label == "Text not saved. Quit anyway? (y or n)"
isQuitPromptIgnoresEnter() = not value.IsMissing(press.Press(["C-x", "C-c", "enter"], modified("")).Prompt)
isWindowCloseAsks() = not value.IsMissing(commands.Update({Kind: "quit"}, modified(""))) and commands.Update({Kind: "quit"}, modified("")).Prompt.Label == "Text not saved. Quit anyway? (y or n)"
isWindowCloseClean() = value.IsMissing(commands.Update({Kind: "quit"}, stateOf("")))
isWindowCloseAnswerY() = press.Press(["y"], commands.Update({Kind: "quit"}, modified(""))).Ending
isClick() = clickPlaces()
defn clickPlaces()
  s = commands.Update(mouse("down", atChar(2), 4), stateOf("abcd\nefgh"))
  here(s).Cursor == {Line: 1, Column: 2}
end
defn isClickSecondLine()
  s = commands.Update(mouse("down", atChar(1), 40 + 19), stateOf("abcd\nefgh"))
  here(s).Cursor == {Line: 2, Column: 1}
end
isClickBelowText() = here(commands.Update(mouse("down", atChar(30), 300), stateOf("abcd\nefgh"))).Cursor == {Line: 2, Column: 4}
defn isDragSelects()
  s = commands.Update(mouse("down", atChar(1), 4), stateOf("abcd\nefgh"))
  s = commands.Update(mouse("move", atChar(3), 4), s)
  s = commands.Update(mouse("up", atChar(3), 4), s)
  regionOf(s) == "bc" and not s.Dragging
end
defn isClickWithoutDragClearsMark()
  s = commands.Update(mouse("down", atChar(1), 4), stateOf("abcd"))
  s = commands.Update(mouse("up", atChar(1), 4), s)
  value.IsMissing(here(s).Mark)
end
defn isMoveWithoutButtonIgnored()
  s = commands.Update(mouse("move", atChar(3), 4), stateOf("abcd"))
  here(s).Cursor == {Line: 1, Column: 0} and value.IsMissing(here(s).Mark)
end
defn isMouseMarkClearedByMove()
  s = commands.Update(mouse("down", atChar(1), 4), stateOf("abcd"))
  s = commands.Update(mouse("move", atChar(3), 4), s)
  s = commands.Update(mouse("up", atChar(3), 4), s)
  value.IsMissing(here(press.Press(["right"], s)).Mark)
end
defn isClickAtTopIsInCode()
  (** The top of the window is code: a click there goes to the first line, and stays in the buffer. *)
  s = commands.Update(mouse("down", atChar(1), 10), twoFiles())
  s.Current == 1 and here(s).Cursor == {Line: 1, Column: 1}
end
defn isWheel()
  s = stateOf(str.Join("\n", list.Map(n -> "word", list.Range(1, 100))))
  s = commands.Update({Kind: "mouse", Action: "wheel", X: 100, Y: 100, Button: 0, Amount: -1.0}, s)
  here(s).Top == 4 and here(s).Cursor == {Line: 1, Column: 0} and here(s).Free
end
defn isWheelUpStaysInFile()
  s = stateOf("a\nb")
  s = commands.Update({Kind: "mouse", Action: "wheel", X: 100, Y: 100, Button: 0, Amount: 5.0}, s)
  here(s).Top == 1
end
defn isWheelDownStaysInFile()
  s = stateOf("a\nb")
  s = commands.Update({Kind: "mouse", Action: "wheel", X: 100, Y: 100, Button: 0, Amount: -50.0}, s)
  here(s).Top == 2
end
defn isWheelNotPulledBack()
  s = stateOf(str.Join("\n", list.Map(n -> "word", list.Range(1, 100))))
  s = commands.Update({Kind: "mouse", Action: "wheel", X: 100, Y: 100, Button: 0, Amount: -10.0}, s)
  here(s).Top == 31
end
defn isKeyAfterWheelFollows()
  s = stateOf(str.Join("\n", list.Map(n -> "word", list.Range(1, 100))))
  s = commands.Update({Kind: "mouse", Action: "wheel", X: 100, Y: 100, Button: 0, Amount: -10.0}, s)
  s = press.Press(["a"], s)
  here(s).Top == 1 and not here(s).Free
end
defn isResize()
  s = commands.Update({Kind: "resize", Width: 500, Height: 300}, stateOf(""))
  s.Width == 500 and s.Height == 300
end
isUnknownKey() = str.Contains("C-q", press.Press(["C-q"], stateOf("")).Message)
isUnknownPairClearsPending() = press.Press(["C-x", "C-q"], stateOf("")).Pending == "" and str.Contains("C-x C-q", press.Press(["C-x", "C-q"], stateOf("")).Message)
defn isTextEventWithCtrl()
  key = {Kind: "key", Key: "f", Ctrl: true, Alt: false, Shift: false, Super: false}
  s = commands.Update({Kind: "text", Text: "f"}, commands.Update(key, stateOf("")))
  wordsOf(s) == "" and not s.Chorded
end
defn isTextAfterCtrlThenRealText()
  key = {Kind: "key", Key: "f", Ctrl: true, Alt: false, Shift: false, Super: false}
  s = commands.Update({Kind: "text", Text: "f"}, commands.Update(key, stateOf("")))
  wordsOf(commands.Update({Kind: "text", Text: "g"}, s)) == "g"
end
defn isTextAfterAlt()
  key = {Kind: "key", Key: "f", Ctrl: false, Alt: true, Shift: false, Super: false}
  wordsOf(commands.Update({Kind: "text", Text: "f"}, commands.Update(key, stateOf("")))) == ""
end
isAccents() = wordsOf(press.Press(["é", "ñ"], stateOf(""))) == "éñ"
isEnterAtStart() = wordsOf(press.Press(["enter"], stateOf("  x"))) == "\n  x"
defn isEnterKeepsIndent()
  s = press.Press(["C-e", "enter", "y"], stateOf("  x"))
  wordsOf(s) == "  x\n  y"
end
defn isEnterUsesEol()
  s = press.Press(["enter"], stateOf("a\r\nb"))
  wordsOf(s) == "\r\na\r\nb"
end
isBackspace() = wordsOf(press.Press(["C-e", "backspace"], stateOf("ab"))) == "a"
isDelete() = wordsOf(press.Press(["delete"], stateOf("ab"))) == "b"
isShiftBackspace() = wordsOf(press.Press(["C-e", "S-backspace"], stateOf("ab"))) == "a"
isShiftDelete() = wordsOf(press.Press(["S-delete"], stateOf("ab"))) == "b"
isShiftEnter() = wordsOf(press.Press(["S-enter"], stateOf("ab"))) == "\nab"
isCtrlD() = wordsOf(press.Press(["C-d"], stateOf("ab"))) == "b"
isTypingReplacesSelection() = wordsOf(press.Press(["C-e", "S-left", "x"], stateOf("ab"))) == "ax"
isPasteReplacesSelection() = wordsOf(press.Press(["C-space", "C-e", "M-w", "C-e", "S-left", "C-y"], stateOf("ab"))) == "aab"
isBackspaceDeletesSelection() = wordsOf(press.Press(["C-e", "S-left", "backspace"], stateOf("ab"))) == "a"
isDeleteDeletesSelection() = wordsOf(press.Press(["S-right", "delete"], stateOf("ab"))) == "b"
isBackspaceWithEmptyKeyMark() = wordsOf(press.Press(["C-e", "C-space", "backspace"], stateOf("ab"))) == "a"
isKeyMarkStaysThroughMoves() = regionOf(press.Press(["C-space", "right", "right"], stateOf("abc"))) == "ab"
isKeyMarkCancelled() = value.IsMissing(here(press.Press(["C-space", "right", "C-g"], stateOf("abc"))).Mark)
isEditClearsMark() = value.IsMissing(here(press.Press(["C-space", "right", "x"], stateOf("abc"))).Mark)
isKeyMarkShiftExtend() = regionOf(press.Press(["C-space", "S-right", "S-right"], stateOf("abc"))) == "ab"
isCutAndPaste() = wordsOf(press.Press(["S-right", "S-right", "C-w", "C-e", "C-y"], stateOf("abc"))) == "cab"
isCopyAndPaste() = wordsOf(press.Press(["S-right", "M-w", "C-e", "C-y"], stateOf("abc"))) == "abca"
isCopyClearsMark() = value.IsMissing(here(press.Press(["S-right", "M-w"], stateOf("abc"))).Mark)
defn isCutNothingSaysSo()
  s = press.Press(["C-w"], stateOf("abc"))
  s.Message != "" and s.Clip == "" and wordsOf(s) == "abc"
end
defn isCopyNothingSaysSo()
  s = press.Press(["M-w"], stateOf("abc"))
  s.Message != "" and s.Clip == ""
end
defn isCopyNothingKeepsClip()
  s = press.Press(["S-right", "M-w", "M-w"], stateOf("abc"))
  s.Clip == "a"
end
isPasteEmpty() = wordsOf(press.Press(["C-y"], stateOf("abc"))) == "abc"
isPasteMultiline() = wordsOf(press.Press(["S-down", "C-w", "C-y"], stateOf("a\nb"))) == "a\nb"
isCutLine() = wordsOf(press.Press(["C-k"], stateOf("ab\ncd"))) == "\ncd" and press.Press(["C-k"], stateOf("ab\ncd")).Clip == "ab"
isCutLineAccumulates() = press.Press(["C-k", "C-k"], stateOf("ab\ncd")).Clip == "ab\n" and wordsOf(press.Press(["C-k", "C-k"], stateOf("ab\ncd"))) == "cd"
isCutLineChainBroken() = press.Press(["C-k", "C-k", "C-f", "C-k"], stateOf("ab\ncd\nef")).Clip == "d"
isCutLineEmptyFile() = press.Press(["C-k"], stateOf("")).Clip == ""
isCutLineYank() = wordsOf(press.Press(["C-k", "C-k", "C-y"], stateOf("ab\ncd"))) == "ab\ncd"
isUndo() = wordsOf(press.Press(["a", "b", "C-/"], stateOf(""))) == ""
isRedo() = wordsOf(press.Press(["a", "b", "C-/", "C-?"], stateOf(""))) == "ab"
isPageDown() = here(press.Press(["C-v"], stateOf(str.Join("\n", list.Map(n -> "w", list.Range(1, 100)))))).Cursor.Line > 10
isPageUp() = here(press.Press(["C-v", "M-v"], stateOf(str.Join("\n", list.Map(n -> "w", list.Range(1, 100)))))).Cursor.Line == 1
isSelectPageDown() = regionOf(press.Press(["S-pagedown"], stateOf(str.Join("\n", list.Map(n -> "w", list.Range(1, 100)))))) != ""
isFileEnds() = here(press.Press(["M->"], stateOf("a\nbc"))).Cursor == {Line: 2, Column: 2} and here(press.Press(["M->", "M-<"], stateOf("a\nbc"))).Cursor == {Line: 1, Column: 0}
isWordMoves() = here(press.Press(["M-f"], stateOf("foo bar"))).Cursor.Column == 3 and here(press.Press(["C-e", "M-b"], stateOf("foo bar"))).Cursor.Column == 4
isLineEnds() = here(press.Press(["C-e"], stateOf("abc"))).Cursor.Column == 3 and here(press.Press(["C-e", "C-a"], stateOf("abc"))).Cursor.Column == 0
isWantedColumn() = here(press.Press(["C-e", "C-n", "C-n"], stateOf("abcd\nx\nabcd"))).Cursor == {Line: 3, Column: 4}
isMessageClearedByNextKey() = press.Press(["C-q", "a"], stateOf("")).Message == ""
isPlaceholders() = press.Press(["C-c", "C-c"], stateOf("")).Message != "" and press.Press(["C-c", "C-k"], stateOf("")).Message != "" and press.Press(["C-c", "C-o"], stateOf("")).Message != ""
isMovingFalse() = not commands.Moving(stateOf(""))
isTickIgnored() = wordsOf(commands.Update({Kind: "tick", Seconds: 0.01}, stateOf("a"))) == "a"
isSuperKeyIgnored() = wordsOf(commands.Update({Kind: "key", Key: "a", Ctrl: false, Alt: false, Shift: false, Super: true}, stateOf("a"))) == "a"
isAllKeysOnEmptyFile() = emptyFileSurvives()
defn emptyFileSurvives()
  chords = list.Filter(k -> not str.Contains(" ", k), dict.Keys(emacs.Keys()))
  s = stateOf("")
  for c in chords
    s = press.Press([c], s)
    s = press.Press(["C-g", "y"], s)
  end
  value.IsArray(view.View(s))
end
isViewWithPrompt() = value.IsArray(view.View(press.Press(["C-x", "C-f", "a"], stateOf(""))))
isTitleFollowsBuffer() = press.Press(["C-x", "b"], begun([text.Of("a", "d/x.ce"), text.Of("b", "d/y.ce")], look, cell, 800, 600)).Title == "y.ce"
isFollowAfterEvent() = here(press.Press(["C-v", "C-v", "C-v"], stateOf(str.Join("\n", list.Map(n -> "w", list.Range(1, 100)))))).Top > 1

defn withClip(words, clip)
  (** A state holding words with a text in the clipboard. *)
  s = stateOf(words)
  s.Clip = clip
  s
end

defn isPasteCrThenEdit()
  (** C1: the two repros of the review. Each one panicked at the edit after the \r reached a line end. *)
  s = press.Press(["C-e", "C-y", "z"], withClip("ab\ncd", "x\r"))
  wordsOf(s) == "abxz\r\ncd" and here(s).Cursor == {Line: 1, Column: 4}
end
defn isDeleteThenEditWithCr()
  s = press.Press(["C-f", "C-f", "delete", "z"], stateOf("a\rb\nc"))
  wordsOf(s) == "az\r\nc" and here(s).Cursor == {Line: 1, Column: 2}
end
defn isPasteCrUndoRedoThenEdit()
  s = press.Press(["C-e", "C-y", "C-/", "C-?", "z"], withClip("ab\ncd", "x\r"))
  wordsOf(s) == "abxz\r\ncd"
end

(** I3: undo and redo end the mark, or the next key replaces a selection left over from another text. *)
isUndoEndsMark() = value.IsMissing(here(press.Press(["x", "C-space", "C-e", "C-/"], stateOf("hello"))).Mark)
isRedoEndsMark() = value.IsMissing(here(press.Press(["x", "C-/", "C-space", "C-e", "C-?"], stateOf("hello"))).Mark)
isTypeAfterUndoReplacesNothing() = wordsOf(press.Press(["x", "C-space", "C-e", "C-/", "y"], stateOf("hello"))) == "yhello"
isTypeAfterRedoReplacesNothing() = wordsOf(press.Press(["x", "C-/", "C-space", "C-e", "C-?", "y"], stateOf("hello"))) == "xyhello"

(** Two buffers with files, the first one current. *)
twoFiles() = begun([text.Of("a", "x.ce"), text.Of("b", "y.ce")], look, cell, 800, 600)
(** A mouse press with another button than the first. *)
otherButton(x, y) = {Kind: "mouse", Action: "down", X: x, Y: y, Button: 3, Amount: 0.0}

defn isQuitQuestionEndsPending()
  (** I4: a pending key doesn't outlive a question or a click, so y answers and the b after a click is typed. *)
  s = commands.Update({Kind: "quit"}, press.Press(["x", "C-x"], stateOf("")))
  s.Pending == "" and press.Press(["y"], s).Ending
end
defn isQuitQuestionNoAfterPending()
  s = press.Press(["n"], commands.Update({Kind: "quit"}, press.Press(["x", "C-x"], stateOf(""))))
  not s.Ending and value.IsMissing(s.Prompt) and s.Pending == ""
end
defn isClickEndsPending()
  s = commands.Update(mouse("down", atChar(1), 4), press.Press(["C-x"], twoFiles()))
  s.Pending == "" and s.Message == ""
end
defn isTypeAfterClickWithPending()
  s = commands.Update(mouse("down", atChar(1), 4), press.Press(["C-x"], twoFiles()))
  s = press.Press(["b"], commands.Update(mouse("up", atChar(1), 4), s))
  s.Current == 1 and wordsOf(s) == "ab"
end
isClickAtTopEndsPending() = commands.Update(mouse("down", 70, 10), press.Press(["C-x"], twoFiles())).Pending == ""
isOtherButtonEndsPending() = commands.Update(otherButton(atChar(1), 4), press.Press(["C-x"], twoFiles())).Pending == ""

defn isTextOfChordKeepsCutChain()
  (** I5: only another command ends a chain of cuts, and every other command does. *)
  key = {Kind: "key", Key: "k", Ctrl: true, Alt: false, Shift: false, Super: false}
  s = commands.Update({Kind: "text", Text: "k"}, commands.Update(key, stateOf("ab\ncd")))
  press.Press(["C-k"], s).Clip == "ab\n"
end
defn isClickEndsCutChain()
  s = commands.Update(mouse("down", atChar(1), 40 + 19), press.Press(["C-k"], stateOf("ab\ncd")))
  s = commands.Update(mouse("up", atChar(1), 40 + 19), s)
  press.Press(["C-k"], s).Clip == "d"
end
isUnboundKeyEndsCutChain() = press.Press(["C-k", "C-q", "C-k"], stateOf("ab\ncd")).Clip == "\n"
isUnboundPairEndsCutChain() = press.Press(["C-k", "C-x", "C-q", "C-k"], stateOf("ab\ncd")).Clip == "\n"
isQuestionEndsCutChain() = press.Press(["n", "C-k"], commands.Update({Kind: "quit"}, press.Press(["C-k"], stateOf("ab\ncd")))).Clip == "\n"

defn isReleaseDuringPrompt()
  (** I6: the end of a drag counts during a question, or the next move would select with no button down. *)
  s = commands.Update(mouse("down", atChar(1), 4), modified("abcd"))
  s = commands.Update(mouse("up", atChar(1), 4), commands.Update({Kind: "quit"}, s))
  s = commands.Update(mouse("move", atChar(3), 4), press.Press(["n"], s))
  not s.Dragging and here(s).Cursor == {Line: 1, Column: 1} and value.IsMissing(here(s).Mark)
end
defn isReleaseDuringPromptKeepsSelection()
  s = commands.Update(mouse("down", atChar(1), 4), modified("abcd"))
  s = commands.Update(mouse("move", atChar(3), 4), s)
  s = press.Press(["n"], commands.Update(mouse("up", atChar(3), 4), commands.Update({Kind: "quit"}, s)))
  not s.Dragging and regionOf(s) == "ab"
end
defn isMoveDuringPromptChangesNothing()
  s = commands.Update(mouse("down", atChar(1), 4), modified("abcd"))
  s = commands.Update(mouse("move", atChar(3), 4), commands.Update({Kind: "quit"}, s))
  here(s).Cursor == {Line: 1, Column: 1}
end

(** M1: any command ends a step of typing, even one that changes nothing. *)
isCancelEndsTypingStep() = wordsOf(press.Press(["a", "C-g", "b", "C-/"], stateOf(""))) == "a"
isUnboundKeyEndsTypingStep() = wordsOf(press.Press(["a", "C-q", "b", "C-/"], stateOf(""))) == "a"
isNothingToCutEndsTypingStep() = wordsOf(press.Press(["a", "C-w", "b", "C-/"], stateOf(""))) == "a"
isEmptyPasteEndsTypingStep() = wordsOf(press.Press(["a", "C-y", "b", "C-/"], stateOf(""))) == "a"
isBufferSwitchEndsTypingStep() = wordsOf(press.Press(["x", "C-x", "b", "C-x", "b", "y", "C-/"], twoFiles())) == "xa"
defn isClickEndsTypingStep()
  (** A click ends a step of typing: what is typed after it is its own step. *)
  s = commands.Update(mouse("down", atChar(0), 4), press.Press(["x"], twoFiles()))
  wordsOf(press.Press(["y", "C-/"], s)) == "xa"
end

defn isTypeOverSelectionOneUndo()
  (** M2: a selection replaced is one step of undo, and undo puts the cursor back. *)
  s = press.Press(["C-e", "S-left", "x", "C-/"], stateOf("ab"))
  wordsOf(s) == "ab" and here(s).Cursor == {Line: 1, Column: 1} and not text.IsModified(here(s))
end
isPasteOverSelectionOneUndo() = wordsOf(press.Press(["C-e", "S-left", "C-y", "C-/"], withClip("ab", "zz"))) == "ab"
isEnterOverSelectionOneUndo() = wordsOf(press.Press(["C-e", "S-left", "enter", "C-/"], stateOf("ab"))) == "ab"
isTabOverSelectionOneUndo() = wordsOf(press.Press(["C-e", "S-left", "tab", "C-/"], stateOf("ab"))) == "ab"
isRedoOverSelection() = wordsOf(press.Press(["C-e", "S-left", "x", "C-/", "C-?"], stateOf("ab"))) == "ax"
isWordOverSelectionOneUndo() = wordsOf(press.Press(["C-e", "S-left", "x", "y", "C-/"], stateOf("ab"))) == "ab"

(** M3: C-g after the first key of a pair cancels the pair and leaves the selection alone. Alone, it ends the selection. *)
isCancelPairKeepsSelection() = regionOf(press.Press(["S-right", "C-x", "C-g"], stateOf("ab"))) == "a"
isCancelPairSays() = press.Press(["S-right", "C-x", "C-g"], stateOf("ab")).Message == "Quit" and press.Press(["S-right", "C-x", "C-g"], stateOf("ab")).Pending == ""
isCancelAloneEndsSelection() = regionOf(press.Press(["S-right", "C-g"], stateOf("ab"))) == ""

hundred = str.Join("\n", list.Map(n -> "word", list.Range(1, 100)))
wheelBy(amount) = {Kind: "mouse", Action: "wheel", X: 100, Y: 100, Button: 0, Amount: amount}   (** A wheel event. *)
(** A state after the same wheel event count times. *)
wheeled(count, amount, state) = list.Reduce((acc, n) -> commands.Update(wheelBy(amount), acc), state, list.Range(1, count))

(** M4: each event of a touchpad is too small to move a line, and they add up: ten of a tenth make one notch, which is three lines. *)
isSmallWheelAddsUp() = here(wheeled(10, -0.1, stateOf(hundred))).Top == 4
defn isSmallWheelUpAddsUp()
  s = stateOf(hundred)
  s.Buffers[1].Top = 10
  here(wheeled(10, 0.1, s)).Top == 7
end
isOneSmallWheelMovesNothing() = here(wheeled(1, -0.1, stateOf(hundred))).Top == 1
isNotchStaysThreeLines() = here(wheeled(2, -1.0, stateOf(hundred))).Top == 7

defn isGutterClickKeepsScreen()
  (** M5: a click in the gutter of a line scrolled to the side goes to the first column shown: x = 10 is six columns left of it. *)
  s = stateOf(str.Join("", list.Map(n -> "x", list.Range(1, 100))))
  s.Buffers[1].Left = 40
  s = commands.Update(mouse("down", 10, 4), s)
  here(s).Left == 40 and here(s).Cursor == {Line: 1, Column: 40}
end

defn isClickUnderLastRowKeepsScreen()
  (** M6: the code area of a window 800 by 600 runs from y = 0 to 554, with 28 full rows from y = 4 to 536. A click under them, or above them, stays on the screen. *)
  s = commands.Update(mouse("down", atChar(0), 540), stateOf(hundred))
  here(s).Top == 1 and here(s).Cursor == {Line: 28, Column: 0}
end
defn isClickAboveFirstRowKeepsScreen()
  s = stateOf(hundred)
  s.Buffers[1].Top = 10
  s = commands.Update(mouse("down", atChar(0), 1), s)
  here(s).Top == 10 and here(s).Cursor == {Line: 10, Column: 0}
end
defn isDragBelowCodeScrolls()
  (** A drag past the bottom of the code area still scrolls: y = 580 is row 30, so line 31, and the last row shown is then that line. *)
  s = commands.Update(mouse("down", atChar(0), 4), stateOf(hundred))
  s = commands.Update(mouse("move", atChar(0), 580), s)
  here(s).Top == 4 and here(s).Cursor == {Line: 31, Column: 0}
end

defn isDragInGutterScrolls()
  (** A drag into the gutter of a line scrolled to the side still scrolls: x = 10 is column 34, six left of the first one shown. *)
  s = stateOf(str.Join("", list.Map(n -> "x", list.Range(1, 100))))
  s.Buffers[1].Left = 40
  s = commands.Update(mouse("down", atChar(0), 4), s)
  s = commands.Update(mouse("move", 10, 4), s)
  here(s).Left == 34 and here(s).Cursor == {Line: 1, Column: 34}
end

(** M8: C-y pastes into the answer of a prompt: its first line, since an answer has one. A prompt of y or n takes no paste. *)
isPasteInPrompt() = press.Press(["C-x", "C-f", "a", "C-y"], withClip("", "b.ce")).Prompt.Answer == "ab.ce"
isPasteInPromptFirstLine() = press.Press(["C-x", "C-f", "C-y"], withClip("", "b.ce\r\nc\n")).Prompt.Answer == "b.ce"
isPasteInPromptEmpty() = press.Press(["C-x", "C-f", "a", "C-y"], stateOf("")).Prompt.Answer == "a"
isPasteInPromptLeavesText() = wordsOf(press.Press(["C-x", "C-f", "C-y"], withClip("hi", "b.ce"))) == "hi"
defn isPasteDoesNotAnswerChoice()
  s = press.Press(["x", "C-x", "C-c", "C-y"], withClip("", "y"))
  not s.Ending and s.Prompt.Label == "Text not saved. Quit anyway? (y or n)"
end

(** A state as a session keeps it through a reload under --watch, from before the fields added to view.Start since: code changes, and the state doesn't. *)
oldState(words) = {Buffers: [text.Of(words, missing)], Current: 1, Pending: "", Prompt: missing, Message: "", Run: missing, Window: missing, Width: 800, Height: 600, Cell: cell, Look: look,
  Clip: "", Chorded: false, Chain: false, Dragging: false, Ending: false, Title: "", Config: testConfig}

(** The wheel on an old state: a notch is three lines from line 1, then the field exists and two notches add up, and tenths still add up to one notch. *)
isWheelOnOldState() = here(commands.Update(wheelBy(-1.0), oldState(hundred))).Top == 4
isTwoNotchesOnOldState() = here(wheeled(2, -1.0, oldState(hundred))).Top == 7
isSmallWheelOnOldState() = here(wheeled(10, -0.1, oldState(hundred))).Top == 4

defn scrolledTo(left, count)
  (** A line of count x with the screen scrolled to column left. *)
  s = stateOf(str.Repeat(count, "x"))
  s.Buffers[1].Left = left
  s
end
(** The state after a press at one point and a move to another, with the button held. *)
pressAndMove(x, y, toX, toY, state) = commands.Update(mouse("move", toX, toY), commands.Update(mouse("down", x, y), state))

defn isSmallMoveKeepsGutterClick()
  (** The dead zone: 1 px during a click in the gutter, on column 200 of the screen, used to give x = 11, which is 6 columns left of it: Left 194 and 6 characters selected. *)
  s = pressAndMove(10, 4, 11, 4, scrolledTo(200, 400))
  here(s).Left == 200 and here(s).Cursor == {Line: 1, Column: 200} and regionOf(s) == ""
end
defn isSmallMoveKeepsClickUnderLastRow()
  (** 1 px under the last row used to reach row 28, which is line 29 and scrolls by one. *)
  s = pressAndMove(atChar(0), 540, atChar(0), 541, stateOf(hundred))
  here(s).Top == 1 and here(s).Cursor == {Line: 28, Column: 0}
end
defn isClickWithSmallMoveLeavesNoMark()
  s = pressAndMove(atChar(1), 4, atChar(1) + 1, 4, stateOf("abcd"))
  s = commands.Update(mouse("up", atChar(1) + 1, 4), s)
  value.IsMissing(here(s).Mark) and not s.Dragging and here(s).Cursor == {Line: 1, Column: 1}
end
(** The press at x = 63 is on column 0. 4 px is x = 67, and it stays a click though the column under it is 1: 5 px is a drag, and selects one character. *)
isFourPixelsStayAClick() = regionOf(pressAndMove(atChar(0), 4, atChar(0) + 4, 4, stateOf("abcd"))) == ""
isFivePixelsAreADrag() = regionOf(pressAndMove(atChar(0), 4, atChar(0) + 5, 4, stateOf("abcd"))) == "a"
(** A press at y = 19 is on the first row. y = 23 is on the second one but 4 px away, and y = 24 is 5 px away: the selection reaches line 2. *)
isFourPixelsDownStayAClick() = here(pressAndMove(atChar(0), 19, atChar(0), 23, stateOf("ab\ncd"))).Cursor == {Line: 1, Column: 0}
isFivePixelsDownAreADrag() = here(pressAndMove(atChar(0), 19, atChar(0), 24, stateOf("ab\ncd"))).Cursor == {Line: 2, Column: 0}
defn isDragBackIntoZoneFollows()
  (** The zone holds only until the mouse leaves it: a drag that comes back follows the mouse to where it began. *)
  s = pressAndMove(atChar(0), 4, atChar(3), 4, stateOf("abcd"))
  s = commands.Update(mouse("move", atChar(0), 4), s)
  regionOf(s) == "" and here(s).Cursor == {Line: 1, Column: 0} and s.Dragging
end
defn isSecondPressHasItsZone()
  (** A second press has a zone of its own. *)
  s = pressAndMove(atChar(0), 4, atChar(3), 4, stateOf("abcd"))
  s = commands.Update(mouse("up", atChar(3), 4), s)
  regionOf(pressAndMove(atChar(2), 4, atChar(2) + 1, 4, s)) == ""
end
defn isDragOnOldStateFollows()
  (** A drag that began before the zone existed has no press to compare with, and follows the mouse. *)
  s = oldState("abcd")
  s.Dragging = true
  here(commands.Update(mouse("move", atChar(3), 4), s)).Cursor == {Line: 1, Column: 3}
end
isPressOnOldState() = regionOf(pressAndMove(atChar(1), 4, atChar(1) + 1, 4, oldState("abcd"))) == ""

defn isClickAtRightEdgeKeepsScreen()
  (** The right edge: a click at x = 799 of a window 800 wide used to move Left from 0 to 2, and a drag there still does. *)
  s = commands.Update(mouse("down", 799, 4), stateOf(str.Repeat(200, "x")))
  here(s).Left == 0 and here(s).Cursor == {Line: 1, Column: 90}
end
defn isDragPastRightEdgeScrolls()
  s = pressAndMove(atChar(0), 4, 799, 4, stateOf(str.Repeat(200, "x")))
  here(s).Left == 2 and here(s).Cursor == {Line: 1, Column: 92}
end

(** The events of a key with modifiers, and of a text. *)
keyWith(key, ctrl, alt, shift) = {Kind: "key", Key: key, Ctrl: ctrl, Alt: alt, Shift: shift, Super: false}
textOf(words) = {Kind: "text", Text: words}
(** The state after the events, one after the other. *)
played(events, state) = list.Reduce((acc, event) -> commands.Update(event, acc), state, events)

(** A key of the numeric keypad has no name in sdl, so only its text comes. No text follows C-f, and the first digit used to pass for the text of that chord. *)
isDigitsAfterChord() = wordsOf(played([keyWith("f", true, false, false), textOf("1"), textOf("2")], stateOf("ab"))) == "a12b"
isDigitAfterAltChord() = wordsOf(played([keyWith("f", false, true, false), textOf("1")], stateOf("ab cd"))) == "ab1 cd"
isDigitAfterCtrlSpace() = regionOf(played([keyWith("space", true, false, false), textOf("1")], stateOf("ab"))) == ""  and wordsOf(played([keyWith("space", true, false, false), textOf("1")], stateOf("ab"))) == "1ab"
defn isDigitInPromptAfterChord()
  s = press.Press(["C-x", "C-f"], stateOf(""))
  played([keyWith("f", true, false, false), textOf("1")], s).Prompt.Answer == "1"
end
(** The text of the chord itself stays out, in any case, and only once. *)
isChordTextDropped() = wordsOf(played([keyWith("f", true, false, false), textOf("f")], stateOf("ab"))) == "ab"
isChordTextUpperDropped() = wordsOf(played([keyWith("f", true, false, false), textOf("F")], stateOf("ab"))) == "ab"
isChordTextDroppedOnce() = wordsOf(played([keyWith("f", true, false, false), textOf("f"), textOf("f")], stateOf("ab"))) == "afb"
isAltSpaceTextDropped() = wordsOf(played([keyWith("space", false, true, false), textOf(" ")], stateOf("ab"))) == "ab"
(** With Shift the key doesn't tell its text: M-> is Alt, Shift and the key of the period, and its text >. The second key of a pair is the same: on a French keyboard, Shift and & give 1. *)
isShiftedChordTextDropped() = wordsOf(played([keyWith(".", false, true, true), textOf(">")], stateOf("ab"))) == "ab"
isSecondKeyTextDropped() = wordsOf(played([keyWith("x", true, false, false), keyWith("&", false, false, true), textOf("1")], stateOf("ab"))) == "ab"
defn isOldChordedDropsOnce()
  (** A state of a session from before the change has true there. *)
  s = stateOf("ab")
  s.Chorded = true
  wordsOf(played([textOf("1"), textOf("2")], s)) == "2ab"
end

global() = emacs.Keys()   (** The keys of the editor, as the tests of keys.Lookup can't see them. *)
isCancelBound() = keys.Lookup("", "C-g", global()) == {Command: commands.Cancel}
isCancelInPair() = keys.Lookup("C-x", "C-g", global()) == {Command: commands.CancelPair} and keys.Lookup("C-c", "C-g", global()) == {Command: commands.CancelPair}
isArrowBound() = keys.Lookup("", "S-right", global()) == {Command: commands.SelectForwardChar}
isChordThenBound() = keys.Lookup("", keys.Chord(keyWith("<", false, true, true)), global()) == {Command: commands.FileStart}
isAliasesBound() = keys.Lookup("", "M-S-,", global()) == {Command: commands.FileStart} and keys.Lookup("", "C-S-/", global()) == {Command: commands.Redo}
isEveryPairBound() = global()["C-c C-c"] == commands.Run and global()["C-c C-k"] == commands.Stop and global()["C-c c h"] == commands.ToggleOutput and global()["C-x C-s"] == commands.Save and global()["C-x C-f"] == commands.FindFile and global()["C-x b"] == commands.NextBuffer and global()["C-x k"] == commands.CloseBuffer and global()["C-x C-c"] == commands.Quit
isFirstKeysFromBindings() = keys.Lookup("", "C-x", global()) == {Pending: "C-x"} and keys.Lookup("", "C-c", global()) == {Pending: "C-c"}

(** A binding can be any function: a state after a chord, with bindings of the test. *)
withHi() = {"C-t": s -> say("hi", s), "C-c C-x": s -> say("hi there", s)}
isAnonymousBindingRuns() = chorded("C-t", withHi(), stateOf("")).Message == "hi"
isAnonymousPairRuns() = chorded("C-x", withHi(), chorded("C-c", withHi(), stateOf(""))).Message == "hi there"
isAnonymousPairClearsPending() = chorded("C-x", withHi(), chorded("C-c", withHi(), stateOf(""))).Pending == ""
isFirstOfAnonymousPairWaits() = chorded("C-c", withHi(), stateOf("")).Pending == "C-c"
isUnboundUnderOtherBindings() = chorded("C-f", withHi(), stateOf("ab")).Message == "C-f is not bound."
(** A function that edits, as a command does. *)
isAnonymousEditRuns() = wordsOf(chorded("C-t", {"C-t": s -> typed("hi", s)}, stateOf("ab"))) == "hiab"

defn isAnonymousCutKeepsChain()
  (** A chain of cuts is the affair of CutLine, so it goes through any function that calls it, and ends with any other. *)
  bound = {"C-k": s -> commands.CutLine(s)}
  chorded("C-k", bound, chorded("C-k", bound, stateOf("ab\ncd"))).Clip == "ab\n"
end
defn isAnonymousBindingEndsChain()
  bound = {"C-k": commands.CutLine, "C-t": s -> say("hi", s)}
  s = chorded("C-t", bound, chorded("C-k", bound, stateOf("ab\ncd")))
  not s.Chain and chorded("C-k", bound, s).Clip == "\n"
end
isChainTrueAfterCut() = press.Press(["C-k"], stateOf("ab")).Chain == true
isChainFalseAfterMove() = press.Press(["C-k", "C-f"], stateOf("ab\ncd")).Chain == false
defn isChainOfOldSession()
  s = stateOf("ab\ncd")
  s.Chain = true
  s.Clip = "before"
  press.Press(["C-k"], s).Clip == "beforeab"
end
(** The mouse moving without a button is no command: it leaves a chain alone. *)
isHoverKeepsCutChain() = press.Press(["C-k"], commands.Update(mouse("move", atChar(1), 4), press.Press(["C-k"], stateOf("ab\ncd")))).Clip == "ab\n"

(** A prompt key is found the same way, through bindings of the test. *)
promptOpen() = press.Press(["C-x", "C-f", "ab"], stateOf("hi"))
isPromptKeyFound() = promptChord("C-t", {"C-t": s -> say("in the prompt", s)}, promptOpen()).Message == "in the prompt"
isPromptUnboundDoesNothing() = promptChord("C-q", emacs.PromptKeys(), promptOpen()).Prompt.Answer == "ab"
isPromptKeysBound() = emacs.PromptKeys()["enter"] == commands.PromptAccept and emacs.PromptKeys()["S-enter"] == commands.PromptAccept and emacs.PromptKeys()["backspace"] == commands.PromptDeleteBefore and emacs.PromptKeys()["S-backspace"] == commands.PromptDeleteBefore and emacs.PromptKeys()["C-y"] == commands.PromptPaste and emacs.PromptKeys()["C-g"] == commands.PromptCancel
(** A prompt command needs a prompt, and any command can be bound to any key: without one it does nothing, and can't panic. *)
isPromptCommandWithoutPrompt() = wordsOf(commands.PromptAccept(commands.PromptDeleteBefore(commands.PromptPaste(commands.PromptCancel(stateOf("ab")))))) == "ab"

(** A mouse action is found the same way, and takes the event too. *)
isMouseActionFound() = onMouse(mouse("down", 5, 7), {"down": (event, s) -> say("at $(event.X) $(event.Y)", s)}, stateOf("")).Message == "at 5 7"
isMouseUnboundDoesNothing() = wordsOf(onMouse(mouse("down", atChar(1), 4), {"up": commands.Release}, stateOf("ab"))) == "ab" and here(onMouse(mouse("down", atChar(1), 4), {"up": commands.Release}, stateOf("ab"))).Cursor == {Line: 1, Column: 0}
isMouseKeysBound() = emacs.MouseKeys()["down"] == commands.Press and emacs.MouseKeys()["move"] == commands.Drag and emacs.MouseKeys()["up"] == commands.Release and emacs.MouseKeys()["wheel"] == commands.Wheel
(** Under a prompt only the wheel and the end of a drag count. *)
isPromptMouseKeysBound() = emacs.PromptMouseKeys()["up"] == commands.Release and emacs.PromptMouseKeys()["wheel"] == commands.Wheel and value.Len(dict.Keys(emacs.PromptMouseKeys())) == 2

(** The values that were written inline. *)
isTabText() = wordsOf(press.Press(["tab"], stateOf(""))) == emacs.TabText() and emacs.TabText() == "  "
isWheelLines() = emacs.WheelLines() == 3.0
isDragZone() = emacs.DragZone() == 4

defn isEveryCommandVisible()
  (** cesia doc commands lists every command: that is what visible means. *)
  shown = cesia.DocNames("commands")
  names = ["ForwardChar", "BackwardChar", "NextLine", "PreviousLine", "ForwardWord", "BackwardWord", "LineStart", "LineEnd", "PageDown", "PageUp", "FileStart", "FileEnd",
    "SelectForwardChar", "SelectBackwardChar", "SelectNextLine", "SelectPreviousLine", "SelectLineStart", "SelectLineEnd", "SelectPageDown", "SelectPageUp",
    "SetMark", "Cancel", "CancelPair", "DeleteBefore", "DeleteAfter", "NewLine", "Tab", "Undo", "Redo", "Cut", "Copy", "Paste", "CutLine",
    "Save", "FindFile", "NextBuffer", "CloseBuffer", "Quit", "Run", "Stop", "ToggleOutput", "DebugRun", "ToggleBreak", "Eval", "Continue", "StepOver", "StepInto", "StepOut",
    "PromptAccept", "PromptDeleteBefore", "PromptPaste", "PromptCancel", "Press", "Drag", "Release", "Wheel", "Complete", "CompleteNext", "CompletePrevious",
    "CompleteAccept"]
  value.Len(list.Filter(name -> not ("commands.$name" in shown), names)) == 0
end

(** A button released with no drag, as after a press out of the code, is nothing: an empty selection stays, from C-space or from a drag taken back with Shift. *)
isReleaseWithoutDragKeepsKeyMark() = not value.IsMissing(here(commands.Update(mouse("up", atChar(1), 4), press.Press(["C-space"], stateOf("ab")))).Mark)
defn isReleaseWithoutDragKeepsMouseMark()
  s = pressAndMove(atChar(0), 4, atChar(1), 4, stateOf("ab"))
  s = press.Press(["S-left"], commands.Update(mouse("up", atChar(1), 4), s))
  regionOf(s) == "" and not value.IsMissing(here(commands.Update(mouse("up", atChar(1), 4), s)).Mark)
end
(** With Caps Lock, the key & of a French keyboard gives 1 with no Shift: the second key of a pair can't compare its text. *)
isSecondKeyOtherTextDropped() = wordsOf(played([keyWith("x", true, false, false), keyWith("&", false, false, false), textOf("1")], stateOf("ab"))) == "ab"

defn isEveryKeyAndSettingVisible()
  (** cesia doc emacs lists every key and every setting, as it does the commands. *)
  shown = cesia.DocNames("emacs")
  names = ["Keys", "PromptKeys", "MouseKeys", "PromptMouseKeys", "CompleteKeys", "TabText", "WheelLines", "DragZone", "FontSize", "Config"]
  value.Len(list.Filter(name -> not ("emacs.$name" in shown), names)) == 0
end
(** The core holds no key: a state with no config, as from a session before it, runs no command and doesn't panic, and text still types. *)
isNoConfigRunsNothing() = here(press.Press(["C-f"], view.Start([text.Of("ab", missing)], look, cell, 800, 600))).Cursor.Column == 0
isNoConfigTypes() = wordsOf(press.Press(["x"], view.Start([text.Of("ab", missing)], look, cell, 800, 600))) == "xab"
(** The font size is a setting, so that the tests and the editor read the same one. *)
isFontSize() = emacs.FontSize() == 15

(** Lists: a buffer of rows from an app, which typing filters. This one has four rows that stand for 10 to 40, and enter says which one is under the cursor. *)
fruits(state) = [{Words: "apple", Item: 10}, {Words: "banana", Item: 20}, {Words: "cherry", Item: 30}, {Words: "date", Item: 40}]
fruitKeys() = {"enter": (item, s) -> say("picked $item", s)}
withFruits(state) = commands.Settled(commands.ShowList("Fruits", fruits, fruitKeys, state))
inFruits(items) = press.Press(items, withFruits(stateOf("x")))
isListShowsRows() = wordsOf(withFruits(stateOf("x"))) == "apple\nbanana\ncherry\ndate" and withFruits(stateOf("x")).Current == 2 and value.Len(withFruits(stateOf("x")).Buffers) == 2
isListNotModified() = not text.IsModified(here(withFruits(stateOf("x"))))
isEnterGetsItem() = inFruits(["C-n", "enter"]).Message == "picked 20"
isTypingFilters() = wordsOf(inFruits(["an"])) == "banana"
isFilterFuzzy() = wordsOf(inFruits(["bna"])) == "banana"
isFilterIgnoresCase() = wordsOf(inFruits(["CH"])) == "cherry"
isEnterAfterFilter() = inFruits(["ch", "enter"]).Message == "picked 30"
isBackspaceShrinksFilter() = wordsOf(inFruits(["chx"])) == "" and wordsOf(inFruits(["chx", "backspace"])) == "cherry"
isCancelClearsFilter() = wordsOf(inFruits(["ch", "C-g"])) == "apple\nbanana\ncherry\ndate" and inFruits(["ch", "C-g"]).Current == 2
isCancelClosesList() = inFruits(["C-g"]).Current == 1 and value.Len(inFruits(["C-g"]).Buffers) == 1 and wordsOf(inFruits(["C-g"])) == "x"
(** The cursor stays on its item when the rows change: on cherry, line 3, the filter e leaves apple, cherry and date, and cherry is then line 2. *)
isCursorStaysOnItem() = inFruits(["C-n", "C-n", "e", "enter"]).Message == "picked 30"
isEnterOnNothing() = inFruits(["zz", "enter"]).Message == "Nothing here."
(** A list is read only: an edit is taken back, with a message. Moves, the filter and copy still work. *)
isCutLineInListTakenBack() = wordsOf(inFruits(["C-k"])) == "apple\nbanana\ncherry\ndate" and inFruits(["C-k"]).Message == "This list is read only."
isUndoInListChangesNothing() = wordsOf(inFruits(["C-/"])) == "apple\nbanana\ncherry\ndate"
isCopyFromList() = clipped(inFruits(["S-down", "M-w"])) == "apple\n"
isSaveInListAsksNothing() = value.IsMissing(inFruits(["C-x", "C-s"]).Prompt) and inFruits(["C-x", "C-s"]).Message == "A list has no file."
isQuitWithListAsksNothing() = inFruits(["C-x", "C-c"]).Ending
(** A list open already gives its place: there is one at a time. *)
isOneListAtATime() = value.Len(commands.ShowList("Fruits", fruits, fruitKeys, withFruits(stateOf("x"))).Buffers) == 2
(** From a list, ToBuffer goes to a buffer and closes the list on the way. *)
isToBufferClosesList() = commands.ToBuffer(1, withFruits(stateOf("x"))).Current == 1 and value.Len(commands.ToBuffer(1, withFruits(stateOf("x"))).Buffers) == 1

(** Panes: C-x 2 and C-x 3 split the pane being edited, C-x o goes to the next one, C-x 0 closes it and C-x 1 keeps only it. In a window of 800 by 600, two
    panes one above the other are 289 high, and the code of the second one starts at y = 289. *)
paneCount(state) = panes.Count(state.Panes)
shownBuffers(state) = list.Map(leaf -> leaf.Buffer, panes.Leaves(state.Panes))
threeFiles() = begun([text.Of("a", "x.ce"), text.Of("b", "y.ce"), text.Of("c", "z.ce")], look, cell, 800, 600)
wheelAt(x, y, amount) = {Kind: "mouse", Action: "wheel", X: x, Y: y, Button: 0, Amount: amount}

isPaneKeysBound() = emacs.Keys()["C-x 2"] == commands.SplitBelow and emacs.Keys()["C-x 3"] == commands.SplitRight and emacs.Keys()["C-x o"] == commands.NextPane and emacs.Keys()["C-x 0"] == commands.ClosePane and emacs.Keys()["C-x 1"] == commands.OnlyPane
isSplitBelow() = paneCount(press.Press(["C-x", "2"], stateOf("a"))) == 2 and press.Press(["C-x", "2"], stateOf("a")).Panes.Along == "rows" and press.Press(["C-x", "2"], stateOf("a")).Pane == 1
isSplitRight() = paneCount(press.Press(["C-x", "3"], stateOf("a"))) == 2 and press.Press(["C-x", "3"], stateOf("a")).Panes.Along == "columns"
isSplitShowsSameBuffer() = value.Equal(shownBuffers(press.Press(["C-x", "2"], twoFiles())), [1, 1]) and wordsOf(press.Press(["C-x", "2"], twoFiles())) == "a"
isSplitTypesNothing() = wordsOf(press.Press(["C-x", "2", "C-x", "3"], stateOf("a"))) == "a"
isNextPane() = press.Press(["C-x", "2", "C-x", "o"], stateOf("a")).Pane == 2 and press.Press(["C-x", "2", "C-x", "o", "C-x", "o"], stateOf("a")).Pane == 1
isNextPaneAlone() = press.Press(["C-x", "o"], stateOf("a")).Pane == 1
defn isPanesKeepTheirCursor()
  s = press.Press(["C-x", "2", "M->"], stateOf(hundred))
  away = press.Press(["C-x", "o"], s)
  back = press.Press(["C-x", "o"], away)
  here(s).Cursor.Line == 100 and here(away).Cursor.Line == 1 and here(back).Cursor.Line == 100
end
defn isEditShowsInOtherPane()
  s = press.Press(["C-x", "2", "x", "C-x", "o"], stateOf("ab"))
  wordsOf(s) == "xab" and s.Current == 1 and s.Pane == 2
end
defn isOtherPaneCursorInsideShorterText()
  s = press.Press(["C-x", "2", "M->", "C-x", "o", "C-space", "M->", "C-w", "C-x", "o"], stateOf(hundred))
  wordsOf(s) == "" and here(s).Cursor == {Line: 1, Column: 0} and s.Pane == 1
end
isClosePane() = paneCount(press.Press(["C-x", "2", "C-x", "0"], stateOf("a"))) == 1
isCloseOnlyPaneSays() = press.Press(["C-x", "0"], stateOf("a")).Message == "This is the only pane." and paneCount(press.Press(["C-x", "0"], stateOf("a"))) == 1
defn isClosePaneGoesToOther()
  s = press.Press(["C-x", "2", "M->", "C-x", "o", "C-x", "0"], stateOf(hundred))
  paneCount(s) == 1 and s.Pane == 1 and here(s).Cursor.Line == 100
end
defn isClosePaneOfThree()
  s = press.Press(["C-x", "3", "C-x", "o", "C-x", "2", "C-x", "b", "C-x", "0"], twoFiles())
  paneCount(s) == 2 and s.Pane == 2 and value.Equal(shownBuffers(s), [1, 1])
end
isOnlyPane() = paneCount(press.Press(["C-x", "2", "C-x", "3", "C-x", "1"], stateOf("a"))) == 1 and press.Press(["C-x", "2", "C-x", "3", "C-x", "1"], stateOf("a")).Pane == 1
defn isOnlyPaneKeepsActive()
  s = press.Press(["C-x", "2", "C-x", "o", "M->", "C-x", "1"], stateOf(hundred))
  paneCount(s) == 1 and here(s).Cursor.Line == 100
end
isOtherBufferInPane() = value.Equal(shownBuffers(press.Press(["C-x", "2", "C-x", "b"], twoFiles())), [2, 1])
defn isCloseBufferShownElsewhere()
  s = press.Press(["C-x", "2", "C-x", "b", "C-x", "k"], twoFiles())
  value.Len(s.Buffers) == 1 and value.Equal(shownBuffers(s), [1, 1])
end
defn isCloseBufferOfOtherPane()
  s = press.Press(["C-x", "2", "C-x", "o", "C-x", "b", "C-x", "o", "C-x", "b", "C-x", "k"], twoFiles())
  value.Len(s.Buffers) == 1 and value.Equal(shownBuffers(s), [1, 1])
end
defn isCloseBufferRenumbers()
  s = press.Press(["C-x", "2", "C-x", "o", "C-x", "b", "C-x", "b", "C-x", "o", "C-x", "k"], threeFiles())
  value.Len(s.Buffers) == 2 and s.Buffers[panes.At(2, s.Panes).Buffer].Path == "z.ce" and here(s).Path == "y.ce"
end
isTooSmallToSplitBelow() = paneCount(press.Press(["C-x", "2"], begun([text.Of("a", missing)], look, cell, 800, 120))) == 1 and press.Press(["C-x", "2"], begun([text.Of("a", missing)], look, cell, 800, 120)).Message == "This pane is too small to split."
isTooSmallToSplitRight() = paneCount(press.Press(["C-x", "3"], begun([text.Of("a", missing)], look, cell, 200, 600))) == 1
defn isClickFocusesPane()
  s = commands.Update(mouse("down", atChar(1), 300), press.Press(["C-x", "2"], stateOf(hundred)))
  s.Pane == 2 and here(s).Cursor == {Line: 1, Column: 1}
end
defn isClickInOtherPaneKeepsItsPlace()
  s = press.Press(["C-x", "2", "M->", "C-x", "o"], stateOf(hundred))
  clicked = commands.Update(mouse("up", 100, 280), commands.Update(mouse("down", 100, 280), s))
  clicked.Pane == 1 and here(clicked).Cursor.Line == 100
end
defn isWheelScrollsPaneUnderMouse()
  s = commands.Update(wheelAt(100, 400, -1.0), press.Press(["C-x", "2"], stateOf(hundred)))
  s.Pane == 1 and here(s).Top == 1 and panes.At(2, s.Panes).View.Top == 4
end
isWheelOnActivePane() = here(commands.Update(wheelAt(100, 100, -1.0), press.Press(["C-x", "2"], stateOf(hundred)))).Top == 4
isSplitOnOldState() = paneCount(press.Press(["C-x", "2"], oldState("a"))) == 2
isNextPaneOnOldState() = panes.Active(press.Press(["C-x", "o"], oldState("a"))) == 1 and wordsOf(press.Press(["C-x", "o"], oldState("a"))) == "a"
isClickOnOldState() = commands.Update(mouse("down", atChar(1), 4), oldState("ab")).Buffers[1].Cursor == {Line: 1, Column: 1}
fourFiles() = begun([text.Of("a", "w.ce"), text.Of("b", "x.ce"), text.Of("c", "y.ce"), text.Of("d", "z.ce")], look, cell, 800, 600)
defn isCloseBufferRenumbersAmongFour()
  s = press.Press(["C-x", "2", "C-x", "o", "C-x", "b", "C-x", "b", "C-x", "o", "C-x", "k"], fourFiles())
  value.Len(s.Buffers) == 3 and s.Buffers[panes.At(2, s.Panes).Buffer].Path == "y.ce" and here(s).Path == "x.ce"
end
defn isSplitOfMovedPaneCopiesItsPlace()
  s = press.Press(["C-x", "2", "C-x", "o", "M->", "C-x", "2", "C-x", "o"], stateOf(hundred))
  s.Pane == 3 and here(s).Cursor.Line == 100
end

(** What SDL sends for ? on a US keyboard: the key / with Shift, then the text ?. *)
question = [{Kind: "key", Key: "/", Ctrl: false, Alt: false, Shift: true, Super: false}, {Kind: "text", Text: "?"}]
updated(events, state) = list.Reduce((s, e) -> commands.Update(e, s), state, events)   (** The state after these events, as the window sends them. *)
defn withQuestion()
  (** A state whose keys bind C-x ?. *)
  s = stateOf("")
  s.Config = () -> emacs.Config(() -> dict.Merge(emacs.Keys(), {"C-x ?": st -> commands.Say("help", st)}))
  s
end
isSecondKeyIsWhatItTypes() = updated(question, press.Press(["C-x"], stateOf(""))).Message == "C-x ? is not bound."
isSecondKeyTypesNothing() = wordsOf(updated(question, press.Press(["C-x"], stateOf("")))) == ""
isSecondKeyRunsItsBinding() = updated(question, press.Press(["C-x"], withQuestion())).Message == "help"

(* ---- The groups of C-c and the band of hints *)

tick(seconds) = {Kind: "tick", Seconds: seconds}
ticked(times, seconds, state) = list.Reduce((s, k) -> commands.Update(tick(seconds), s), state, 1..times)   (** The state after a number of ticks. *)

isGroupWaits() = press.Press(["C-c", "f"], stateOf("")).Pending == "C-c f"
isGroupRuns() = press.Press(["C-c", "f", "f"], stateOf("")).Prompt.Label == press.Press(["C-x", "C-f"], stateOf("")).Prompt.Label
isGroupSplits() = value.Len(panes.Leaves(press.Press(["C-c", "w", "v"], stateOf("")).Panes)) == 2
isGroupCancel() = press.Press(["C-c", "f", "C-g"], stateOf("")).Pending == "" and press.Press(["C-c", "f", "C-g"], stateOf("")).Message == "Quit"
isGroupUnknown() = str.Contains("C-c f z", press.Press(["C-c", "f", "z"], stateOf("")).Message)
isGroupKeysOfTheCommand() = press.Press(["C-c", "f", "s"], stateOf("")).Chords == "C-c f s"
isMovingWhileWaiting() = commands.Moving(press.Press(["C-c"], stateOf(""))) and not commands.Moving(stateOf(""))
isNoHintsBeforeTheDelay() = value.Len(ticked(4, 0.1, press.Press(["C-c"], stateOf(""))).Hints) == 0
isHintsAfterTheDelay() = value.Len(ticked(6, 0.1, press.Press(["C-c"], stateOf(""))).Hints) > 0 and not commands.Moving(ticked(6, 0.1, press.Press(["C-c"], stateOf(""))))
isHintsOfTheGroups() = {Key: "f", Name: "+files", Group: true} in ticked(6, 0.1, press.Press(["C-c"], stateOf(""))).Hints
isHintsOfAGroup() = {Key: "s", Name: "Save", Group: false} in ticked(6, 0.1, press.Press(["C-c", "f"], stateOf(""))).Hints
isHintsWaitAgainInAGroup() = value.Len(ticked(6, 0.1, press.Press(["C-c"], stateOf(""))).Hints) > 0 and value.Len(press.Press(["f"], ticked(6, 0.1, press.Press(["C-c"], stateOf("")))).Hints) == 0
isHintsDrawn() = value.Len(list.Filter(c -> c.Kind == "text" and c.Text == "+files", view.View(ticked(6, 0.1, press.Press(["C-c"], stateOf("")))))) == 1
isHintsGoneAfterTheCommand() = value.Len(list.Filter(c -> c.Kind == "text" and c.Text == "+files", view.View(press.Press(["f", "s"], ticked(6, 0.1, press.Press(["C-c"], stateOf(""))))))) == 0
isNoTickWithoutKeys() = value.Len(ticked(3, 0.5, stateOf("")).Hints) == 0 and not commands.Moving(ticked(3, 0.5, stateOf("")))

(* ---- Running a program, without one: the commands that need it say so; the breakpoints stay in the state. *)

inFile(words) = begun([text.Of(words, "a.ce")], look, cell, 800, 600)   (** A state on a buffer of a file. *)
isBreakSet() = value.Equal(view.BreaksOf(press.Press(["C-c", "d", "b"], inFile("x = 1\n"))), [{Path: "a.ce", Line: 1}])   (** C-c d b sets one. *)
isBreakCleared() = value.Len(view.BreaksOf(press.Press(["C-c", "d", "b", "C-c", "d", "b"], inFile("x = 1\n")))) == 0   (** Again, it goes. *)
isBreakNeedsFile() = value.Len(view.BreaksOf(press.Press(["C-c", "d", "b"], stateOf("x")))) == 0   (** A buffer without a file has none. *)
isEvalNeedsRun() = str.StartsWith("No program runs under the debugger", press.Press(["C-c", "d", "e"], inFile("1 + 1")).Message)   (** C-c d e without a program says so. *)
isContinueNeedsStop() = press.Press(["C-c", "d", "c"], inFile("1")).Message == "The program isn't stopped."   (** Nothing to go on from. *)
isNoOutputYet() = str.StartsWith("There is no output", press.Press(["C-c", "c", "h"], inFile("1")).Message)   (** C-c c h before any run. *)
isRunNeedsFile() = str.StartsWith("This buffer has no file", press.Press(["C-c", "c", "r"], stateOf("1")).Message)   (** A buffer never saved can't run. *)

(* ---- Search: C-s and C-r, as in Emacs. *)
words3 = "one two\nthree two\nfour Two"
cursorOf(state) = here(state).Cursor
isSearchOpens() = press.Press(["C-s"], stateOf(words3)).Prompt.Label == "I-search: " and press.Press(["C-r"], stateOf(words3)).Prompt.Label == "I-search backward: "
isSearchFindsAsTyped() = cursorOf(press.Press(["C-s", "tw"], stateOf(words3))) == {Line: 1, Column: 6}   (** The cursor goes to the end of the place. *)
isSearchSelects() = regionOf(press.Press(["C-s", "two"], stateOf(words3))) == "two"   (** The place shows selected. *)
isSearchNext() = cursorOf(press.Press(["C-s", "two", "C-s"], stateOf(words3))) == {Line: 2, Column: 9}
isSearchFolds() = cursorOf(press.Press(["C-s", "two", "C-s", "C-s"], stateOf(words3))) == {Line: 3, Column: 8}   (** No capital: either case. *)
isSearchCase() = press.Press(["C-s", "Two", "C-s"], stateOf(words3)).Prompt.Label == "Failing I-search: "   (** A capital: that case only. *)
isSearchFails() = press.Press(["C-s", "two", "C-s", "C-s", "C-s"], stateOf(words3)).Prompt.Label == "Failing I-search: " and cursorOf(press.Press(["C-s", "two", "C-s", "C-s", "C-s"], stateOf(words3))) == {Line: 3, Column: 8}
isSearchWraps() = press.Press(["C-s", "two", "C-s", "C-s", "C-s", "C-s"], stateOf(words3)).Prompt.Label == "Wrapped I-search: " and cursorOf(press.Press(["C-s", "two", "C-s", "C-s", "C-s", "C-s"], stateOf(words3))) == {Line: 1, Column: 7}
isSearchBackward() = cursorOf(press.Press(["M->", "C-r", "two"], stateOf(words3))) == {Line: 3, Column: 5} and cursorOf(press.Press(["M->", "C-r", "two", "C-r"], stateOf(words3))) == {Line: 2, Column: 6}
isSearchEnterStays() = value.IsMissing(press.Press(["C-s", "three", "enter"], stateOf(words3)).Prompt) and cursorOf(press.Press(["C-s", "three", "enter"], stateOf(words3))) == {Line: 2, Column: 5} and value.IsMissing(here(press.Press(["C-s", "three", "enter"], stateOf(words3))).Mark)
isSearchCancelGoesBack() = cursorOf(press.Press(["C-f", "C-s", "three", "C-g"], stateOf(words3))) == {Line: 1, Column: 1} and press.Press(["C-f", "C-s", "three", "C-g"], stateOf(words3)).Message == "Quit"
isSearchCancelTakesBackFailing() = press.Press(["C-s", "twx", "C-g"], stateOf(words3)).Prompt.Answer == "tw"   (** C-g first takes back what matched nothing. *)
isSearchBackspace() = cursorOf(press.Press(["C-s", "two", "C-s", "backspace"], stateOf(words3))) == {Line: 1, Column: 7} and press.Press(["C-s", "two", "C-s", "backspace", "backspace"], stateOf(words3)).Prompt.Answer == "tw"
isSearchOtherKeyEnds() = value.IsMissing(press.Press(["C-s", "three", "C-a"], stateOf(words3)).Prompt) and cursorOf(press.Press(["C-s", "three", "C-a"], stateOf(words3))) == {Line: 2, Column: 0}
isSearchTypesNothing() = wordsOf(press.Press(["C-s", "three", "enter"], stateOf(words3))) == words3   (** What is typed in a search goes to the search. *)
isSearchRepeatsLast() = cursorOf(press.Press(["C-s", "three", "enter", "M-<", "C-s", "C-s"], stateOf(words3))) == {Line: 2, Column: 5}   (** C-s C-s looks for the words of the last search. *)
isSearchGroup() = emacs.Keys()["C-c s"] == "search" and emacs.Keys()["C-c s s"] == commands.SearchForward and emacs.Keys()["C-c s r"] == commands.SearchBackward
isSearchInAnotherPrompt() = press.Press(["C-x", "C-f", "C-s"], stateOf(words3)).Prompt.Label == "Find file: "   (** C-s does nothing in another prompt. *)
isSearchAcrossWindows() = cursorOf(press.Press(["C-s", "needle"], stateOf("$(str.Repeat(70000, "a"))needle"))) == {Line: 1, Column: 70006}   (** A place past the first window of 64 KiB. *)
isSearchCharacters() = cursorOf(press.Press(["C-s", "été"], stateOf("un été, l'été"))) == {Line: 1, Column: 6}   (** Columns count characters, not bytes. *)

(* In a file of Cesia, Enter, Tab and the words that close or go on with a block put a line where cesia fmt puts it; elsewhere Tab types its text,
   as the tests above show. *)
isEnterIndentsCesia() = wordsOf(press.Press(["C-e", "enter", "x"], inFile("if a"))) == "if a\n  x"
(** "end" alone is the key End: the word is typed in two. *)
isEndTypedGoesBack() = wordsOf(press.Press(["C-e", "enter", "x", "enter", "en", "d"], inFile("if a"))) == "if a\n  x\nend"
isEndUndoneWithItsPlace() = wordsOf(press.Press(["C-e", "enter", "x", "enter", "en", "d", "C-/"], inFile("if a"))) == "if a\n  x\n  "
isTabPutsCesiaLine() = wordsOf(press.Press(["C-n", "tab"], inFile("if a\nb\nend"))) == "if a\n  b\nend" and cursorOf(press.Press(["C-n", "tab"], inFile("if a\nb\nend"))) == {Line: 2, Column: 2}
isTabOnSelection() = wordsOf(press.Press(["C-space", "M->", "tab"], inFile("defn f()\nif a\nb\nend\nend"))) == "defn f()\n  if a\n    b\n  end\nend" and
  value.IsMissing(here(press.Press(["C-space", "M->", "tab"], inFile("defn f()\nif a\nb\nend\nend"))).Mark)
isTabOnSelectionOneUndo() = wordsOf(press.Press(["C-space", "M->", "tab", "C-/"], inFile("defn f()\nif a\nb\nend\nend"))) == "defn f()\nif a\nb\nend\nend"
isTabTypesNothingInCesia() = wordsOf(press.Press(["C-e", "tab"], inFile("if a\n  b\nend"))) == "if a\n  b\nend"
defn cesiaClip(words, clip)
  (** A state on a buffer of a file of Cesia holding words, with a text in the clipboard. *)
  s = inFile(words)
  s.Clip = clip
  s
end
isPasteKeepsItsPlace() = wordsOf(press.Press(["C-e", "enter", "C-y"], cesiaClip("if a", "end"))) == "if a\n  end"   (** A paste is no typing. *)

(* Completion: Tab at the end of a word of a line at its place, in a file of Cesia. *)
words4 = "Hello = 1\nHelp = 2\n"
opened() = press.Press(["M->", "Hel", "tab"], inFile(words4))   (** The list open on Hel: Help, the nearest, then Hello. *)
isTabOpensList() = value.Equal(list.Take(2, complete.Of(opened()).Words), ["Help", "Hello"]) and wordsOf(opened()) == "$(words4)Hel"
isTabAccepts() = wordsOf(press.Press(["tab"], opened())) == "$(words4)Help" and value.IsMissing(complete.Of(press.Press(["tab"], opened())))
isNextAccepts() = wordsOf(press.Press(["C-n", "tab"], opened())) == "$(words4)Hello" and wordsOf(press.Press(["down", "tab"], opened())) == "$(words4)Hello"
isPreviousWraps() = complete.Of(press.Press(["C-p"], opened())).Picked == value.Len(complete.Of(opened()).Words) and
  complete.Of(press.Press(["C-p", "up", "C-n"], opened())).Picked == value.Len(complete.Of(opened()).Words)
isAcceptOneUndo() = wordsOf(press.Press(["tab", "C-/"], opened())) == "$(words4)Hel"
isTypingRefines() = value.Equal(complete.Of(press.Press(["l"], opened())).Words, ["Hello"]) and complete.Of(press.Press(["l"], opened())).Prefix == "Hell"
isTypingPastEveryWordCloses() = value.IsMissing(complete.Of(press.Press(["lx"], opened()))) and wordsOf(press.Press(["lx"], opened())) == "$(words4)Hellx"
isOtherKeyClosesAndRuns() = value.IsMissing(complete.Of(press.Press(["C-a"], opened()))) and cursorOf(press.Press(["C-a"], opened())) == {Line: 3, Column: 0}
isEnterClosesAndRuns() = value.IsMissing(complete.Of(press.Press(["enter"], opened()))) and wordsOf(press.Press(["enter"], opened())) == "$(words4)Hel\n"
isCancelCloses() = value.IsMissing(complete.Of(press.Press(["C-g"], opened()))) and wordsOf(press.Press(["C-g"], opened())) == "$(words4)Hel"
isMoveBackDoesNotReopen() = value.IsMissing(complete.Of(press.Press(["C-b", "C-f"], opened())))
isClickCloses() = value.IsMissing(complete.Of(commands.Update(mouse("down", atChar(0), 4), opened())))
isOneWordAtOnce() = wordsOf(press.Press(["M->", "Hell", "tab"], inFile(words4))) == "$(words4)Hello" and value.IsMissing(complete.Of(press.Press(["M->", "Hell", "tab"], inFile(words4))))
isNoWordSays() = press.Press(["M->", "Hzq", "tab"], inFile(words4)).Message == "No completion for Hzq."
isLowerFindsCapitals() = complete.Of(press.Press(["M->", "hel", "tab"], inFile(words4))).Words[1] == "Help" and
  wordsOf(press.Press(["M->", "hel", "tab", "tab"], inFile(words4))) == "$(words4)Help"
isNamesOfCesia() = wordsOf(press.Press(["M->", "ByteFi", "tab"], inFile(words4))) == "$(words4)ByteFind"
isTabIndentsBeforeCompleting() = wordsOf(press.Press(["M->", "enter", "Hel", "C-a", " ", "C-e", "tab"], inFile("Help = 1\nif a"))) == "Help = 1\nif a\n  Hel" and
  value.IsMissing(complete.Of(press.Press(["M->", "enter", "Hel", "C-a", " ", "C-e", "tab"], inFile("Help = 1\nif a"))))
isTabMidWordCompletesNothing() = value.IsMissing(complete.Of(press.Press(["M->", "Hel", "C-b", "tab"], inFile(words4))))
isOtherFileTabTypes() = wordsOf(press.Press(["M->", "Hel", "tab"], stateOf(words4))) == "$(words4)Hel  "
isCompletedElseMoves() = wordsOf(press.Press(["C-e", "enter", "x", "enter", "els", "tab"], inFile("if a"))) == "if a\n  x\nelse"
isListDrawn() = list.Any([c.Kind == "text" and c.Text == "Hello" and c.Y > 40 for c in view.View(opened())])
