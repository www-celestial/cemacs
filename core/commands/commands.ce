(** The editor: one small public function per command, from a state to a state, and update, which turns the events of the window into commands.
    No key is bound here: the Config of the state says which key runs which function, as src/emacs/emacs.ce does, and cesia doc commands lists every command.
    Errors from the file system never panic: they become a message. *)
use src/rope
use src/sdl
use core/files
use core/keys
use core/lists
use core/panes
use core/run
use core/text
use core/view
use std/text as str
use std/dict
use std/list
use std/math
use std/result
use std/value

current(state) = state.Buffers[state.Current]   (** The buffer being edited. *)

defn put(b, state)
  (** The state with a buffer in place of the current one. *)
  s = state
  s.Buffers[state.Current] = b
  s
end

defn say(words, state)
  (** The state with a message for the person. *)
  s = state
  s.Message = words
  s
end

Say(words, state) = say(words, state)   (** The state with a message for the person, as an app shows one. *)

defn Home(state)
  (** The folder of Cemacs, where fonts/ and src/ are: what the program gave, or "." for a state with none, as one from a session before this field. *)
  match state
    {Home: home} -> home
    else -> "."
  end
end

defn unmarked(b)
  (** The buffer without its mark. *)
  out = b
  out.Mark = missing
  out.Origin = ""
  out
end

defn hasSelection(b)
  (** Is something selected? A mark with nothing between it and the cursor selects nothing. *)
  e = text.Selection(b)
  not value.IsMissing(e) and e.First != e.Last
end

(* ---- The clipboard: the one of the system when there is a window, else the state's own. *)

defn clip(words, state)
  (** The state with words in the clipboard. *)
  if not value.IsMissing(state.Window)
    sdl.Copy(words, state.Window)
    state
  else
    s = state
    s.Clip = words
    s
  end
end

(** The words in the clipboard. *)
clipped(state) = if value.IsMissing(state.Window) state.Clip else sdl.Paste(state.Window) end

(* ---- Moves *)

defn move(f, state)
  (** The current buffer moved by f. A mark stays only if C-space set it: the others end with the next move. *)
  b = f(current(state))
  if b.Origin != "key"
    b = unmarked(b)
  end
  put(b, state)
end

defn select(f, state)
  (** The current buffer moved by f, selecting: a mark is put where the cursor was, if there is none. *)
  before = current(state)
  b = f(before)
  if value.IsMissing(before.Mark)
    b.Mark = before.Cursor
    b.Origin = "shift"
  end
  put(b, state)
end

rows(state) = view.LayoutOf(state).Rows   (** The number of lines of a page. *)

(* Moves. The Select ones keep the mark of a selection. *)

ForwardChar(state) = move(b -> text.MoveChar(1, b), state)   (** One character on. *)
BackwardChar(state) = move(b -> text.MoveChar(-1, b), state)   (** One character back. *)
NextLine(state) = move(b -> text.MoveLine(1, b), state)   (** One line down. *)
PreviousLine(state) = move(b -> text.MoveLine(-1, b), state)   (** One line up. *)
ForwardWord(state) = move(b -> text.MoveWord(1, b), state)   (** One word on. *)
BackwardWord(state) = move(b -> text.MoveWord(-1, b), state)   (** One word back. *)
LineStart(state) = move(text.ToLineStart, state)   (** To the start of the line. *)
LineEnd(state) = move(text.ToLineEnd, state)   (** To the end of the line. *)
PageDown(state) = move(b -> text.MovePage(1, rows(state), b), state)   (** One page down. *)
PageUp(state) = move(b -> text.MovePage(-1, rows(state), b), state)   (** One page up. *)
FileStart(state) = move(text.ToFileStart, state)   (** To the start of the file. *)
FileEnd(state) = move(text.ToFileEnd, state)   (** To the end of the file. *)
SelectForwardChar(state) = select(b -> text.MoveChar(1, b), state)   (** Selecting one character on. *)
SelectBackwardChar(state) = select(b -> text.MoveChar(-1, b), state)   (** Selecting one character back. *)
SelectNextLine(state) = select(b -> text.MoveLine(1, b), state)   (** Selecting one line down. *)
SelectPreviousLine(state) = select(b -> text.MoveLine(-1, b), state)   (** Selecting one line up. *)
SelectLineStart(state) = select(text.ToLineStart, state)   (** Selecting to the start of the line. *)
SelectLineEnd(state) = select(text.ToLineEnd, state)   (** Selecting to the end of the line. *)
SelectPageDown(state) = select(b -> text.MovePage(1, rows(state), b), state)   (** Selecting one page down. *)
SelectPageUp(state) = select(b -> text.MovePage(-1, rows(state), b), state)   (** Selecting one page up. *)

defn SetMark(state)
  (** The mark put at the cursor, and kept through moves until C-g, an edit or a cut. *)
  b = text.SetMark(current(state))
  b.Origin = "key"
  put(b, state)
end

defn Cancel(state)
  (** The mark taken away, and the message to show it. *)
  say("Quit", put(unmarked(current(state)), state))
end

(** C-g after the first keys of a pair or more: they are already forgotten, and the selection stays. Any C-g that no binding takes after them does it too. *)
CancelPair(state) = say("Quit", state)

(* ---- Edits *)

(** The current buffer after f, in place of the selection if there is one, as one step of undo. The mark ends. *)
replacing(f, state) = put(unmarked(text.ReplaceRegion(f, current(state))), state)

defn deleting(f, state)
  (** The current buffer after f, or only without its selection if it has one: Backspace and Delete delete what is selected. *)
  b = current(state)
  if hasSelection(b)
    put(unmarked(text.CutRegion(b)), state)
  else
    put(unmarked(f(b)), state)
  end
end

(** Words typed or pasted at the cursor, in place of the selection. *)
typed(words, state) = replacing(b -> text.InsertWords(words, b), state)

(** The character before the cursor deleted, or the selection. *)
DeleteBefore(state) = deleting(text.DeleteBefore, state)
(** The character after the cursor deleted, or the selection. *)
DeleteAfter(state) = deleting(text.DeleteAfter, state)
(** A line end with the indent of the line, in place of the selection. *)
NewLine(state) = replacing(text.NewLine, state)
Tab(state) = typed(config(state).TabText(), state)   (** The text of a tab, in place of the selection. *)

(** The undone step back, and the mark ended: left where it was, it would select a text the person never chose. *)
Undo(state) = put(unmarked(text.Undo(current(state))), state)
Redo(state) = put(unmarked(text.Redo(current(state))), state)   (** The undone step done again, and the mark ended. *)

defn Cut(state)
  (** The selection removed and put in the clipboard. Without a selection, nothing changes but the message. *)
  b = current(state)
  if hasSelection(b)
    put(unmarked(text.CutRegion(b)), clip(text.Region(b), state))
  else
    say("Nothing is selected.", state)
  end
end

defn Copy(state)
  (** The selection put in the clipboard, and the mark ended. Without a selection, nothing changes but the message. *)
  b = current(state)
  if hasSelection(b)
    put(unmarked(b), clip(text.Region(b), state))
  else
    say("Nothing is selected.", state)
  end
end

defn Paste(state)
  (** The clipboard inserted at the cursor, in place of the selection. *)
  words = clipped(state)
  if words == ""
    say("The clipboard is empty.", state)
  else
    typed(words, state)
  end
end

defn CutLine(state)
  (** The rest of the line cut into the clipboard, or the line end if the cursor is already there. Cuts one after the other add up, as in Emacs. It sets Chain itself,
      so that the cuts add up through any function that calls it, and any other command ends them: see ran. *)
  r = text.CutLine(current(state))
  if r.Cut == ""
    say("Nothing to cut.", state)
  else
    before = if state.Chain == wasCut() clipped(state) else "" end
    s = clip("$before$(r.Cut)", put(unmarked(r.Buffer), state))
    s.Chain = true
    s
  end
end

(* ---- Prompts *)

defn prompted(prompt, state)
  (** The state with a prompt open. The first key of a pair ends here, or the next key would be its second one instead of an answer, and so does a chain of cuts. *)
  s = state
  s.Prompt = prompt
  s.Pending = ""
  s.Chain = false
  s
end

(** The state with a prompt that takes an answer: done gets the answer and the state, without the prompt. *)
ask(label, answer, done, state) = prompted({Label: label, Answer: answer, Done: done, Choice: false}, state)

(** The state with a prompt that takes y or n. *)
confirm(label, done, state) = prompted({Label: label, Answer: "", Done: done, Choice: true}, state)

(** A prompt for an app: label, the answer it starts with, and done, which gets the answer and the state without the prompt. *)
Ask(label, answer, done, state) = ask(label, answer, done, state)

Confirm(label, done, state) = confirm(label, done, state)   (** A prompt for an app that takes y or n: done gets "y" or "n" and the state. *)

defn accept(state)
  (** The state after the answer of the prompt is accepted. *)
  p = state.Prompt
  s = state
  s.Prompt = missing
  p.Done(p.Answer, s)
end

defn closed(state)
  (** The state with the prompt closed. *)
  s = state
  s.Prompt = missing
  s
end

(** The state after f on the prompt that is open. With none, as when a global key is bound to one of these commands, nothing changes. *)
inPrompt(f, state) = if value.IsMissing(state.Prompt) state else f(state.Prompt, state) end

(** Accepts the answer of a prompt. A prompt of y or n waits for one of the two. *)
PromptAccept(state) = inPrompt((p, s) -> if p.Choice s else accept(s) end, state)

(** The last character of the answer of a prompt removed. *)
PromptDeleteBefore(state) = inPrompt((p, s) -> withAnswer(str.Join("", list.Take(list.Max(0, value.Len(p.Answer) - 1), str.Chars(p.Answer))), s), state)

defn withAnswer(answer, state)
  (** The state with this answer in the prompt. *)
  s = state
  s.Prompt.Answer = answer
  s
end

(** The first line of the clipboard added to the answer of a prompt, since an answer has one. A prompt of y or n takes no paste. *)
PromptPaste(state) = inPrompt((p, s) -> if p.Choice s else promptText(str.Join("", list.Take(1, str.Lines(clipped(s)))), s) end, state)

PromptCancel(state) = inPrompt((p, s) -> say("Quit", closed(s)), state)   (** Closes the prompt with no answer. *)

defn promptChord(chord, bindings, state)
  (** A chord while a prompt is open: it runs what bindings give it, and any other chord does nothing. *)
  match keys.Lookup("", chord, bindings)
    {Command: f} -> ran(f, state)
    else -> state
  end
end

defn promptText(words, state)
  (** Text while a prompt is open: it goes to the answer. A prompt of y or n takes one of the two and ends. *)
  p = state.Prompt
  if p.Choice
    answer = str.Lower(words)
    if answer == "y" or answer == "n" p.Done(answer, closed(state)) else state end
  else
    withAnswer("$(p.Answer)$words", state)
  end
end

(* ---- Buffers and files *)

defn withBuffers(buffers, current, state)
  (** The state with the buffers. At least one is kept, and current stays among them. *)
  s = state
  s.Buffers = if value.Len(buffers) == 0 [text.Of("", missing)] else buffers end
  s.Current = list.Min(list.Max(1, current), value.Len(s.Buffers))
  s
end

without(k, items) = list.Concat(list.Take(k - 1, items), list.Skip(k, items))   (** An array without its element k. *)

defn dropped(k, current, state)
  (** The state without buffer k, and current the current one, as withBuffers keeps it. A pane that showed buffer k shows the buffer that takes its place, at
      the place that one holds, and a pane on a buffer after it counts one less. *)
  s = withBuffers(without(k, state.Buffers), current, state)
  n = value.Len(s.Buffers)
  s.Panes = panes.MapLeaves(leaf -> renumbered(k, n, leaf), panes.Tree(state))
  s
end

(** A leaf of a pane after buffer k went, of the n buffers left. *)
renumbered(k, n, leaf) = if leaf.Buffer > k {Buffer: leaf.Buffer - 1, View: leaf.View} else if leaf.Buffer == k panes.One(list.Min(k, n)) else leaf end

defn folder(path)
  (** The folder of a path with its slash, or an empty text for a path with no folder. *)
  if value.IsMissing(path) or not str.Contains("/", path)
    ""
  else
    "$(str.Join("/", list.Take(value.Len(str.Split("/", path)) - 1, str.Split("/", path))))/"
  end
end

defn indexOfFile(path, state)
  (** The index of the buffer for this file, or 0. *)
  wanted = files.Normal(path)
  for k in 1..value.Len(state.Buffers)
    b = state.Buffers[k]
    if not value.IsMissing(b.Path) and files.Normal(b.Path) == wanted
      return k
    end
  end
  0
end

defn OpenFile(path, state)
  (** Goes to the file at path, in a new buffer or in the one that has it. A file that can't be read is a message. *)
  if path == ""
    return say("No file name.", state)
  end
  known = indexOfFile(path, state)
  if known > 0
    s = state
    s.Current = known
    return s
  end
  match files.ReadFile(path)
    result.Ok(read) -> opened(path, read, state)
    result.Err(e) -> say(e.Message, state)
  end
end

defn opened(path, read, state)
  (** The state with a buffer for the file just read, and the person in it. *)
  b = text.Of(read.Words, path)
  b.Disk = read.Disk
  s = state
  s.Buffers = list.Append(b, state.Buffers)
  s.Current = value.Len(s.Buffers)
  s
end

defn OpenAll(paths, state)
  (** Opens every file in order, in new buffers, and stays in the first one that was opened. An empty buffer that nothing touched makes room. *)
  s = list.Reduce((acc, path) -> OpenFile(path, acc), state, paths)
  if value.Len(s.Buffers) == value.Len(state.Buffers)
    s
  else if isPlaceholder(state)
    dropped(1, 1, s)
  else
    withBuffers(s.Buffers, value.Len(state.Buffers) + 1, s)
  end
end

(** Does the state have only an untouched empty buffer with no file, which a first file replaces? *)
isPlaceholder(state) = value.Len(state.Buffers) == 1 and value.IsMissing(state.Buffers[1].Path) and not text.IsModified(state.Buffers[1]) and rope.Text(state.Buffers[1].Rope) == ""

(** Asks for a file to open, with the folder of the current file as the start of the answer. *)
FindFile(state) = ask("Find file: ", folder(current(state).Path), (answer, s) -> OpenFile(answer, s), state)

defn NextBuffer(state)
  (** Goes to the next buffer, from the last to the first. *)
  s = state
  s.Current = math.Mod(state.Current, value.Len(state.Buffers)) + 1
  s
end

defn close(k, state)
  (** The state with buffer k closed. *)
  dropped(k, k, state)
end

(** The answer to the question about closing buffer k. *)
closeIfYes(k, answer, state) = if answer == "y" close(k, state) else state end

defn CloseBuffer(state)
  (** Closes the current buffer, asking first if its text isn't saved. The last one is replaced by an empty buffer. *)
  k = state.Current
  if text.IsModified(current(state))
    confirm("Text not saved. Close anyway? (y or n)", (answer, s) -> closeIfYes(k, answer, s), state)
  else
    close(k, state)
  end
end

defn saved(k, path, disk, words, state)
  (** The state with buffer k saved at path, with the time of the file given, and a message. *)
  b = text.MarkSaved(disk, state.Buffers[k])
  b.Path = path
  s = state
  s.Buffers[k] = b
  hooks(s).Saved(say(words, s))
end

defn overwrite(k, path, answer, state)
  (** The answer to the question about writing over a file that changed. *)
  if answer == "y"
    store(k, path, true, missing, state)
  else
    say("Not saved.", state)
  end
end

defn store(k, path, force, disk, state)
  (** Writes buffer k to path, if the file is still the one of disk, or whatever is there when force is true. An Err of kind changed asks first,
      one of kind saved counts as a save whose time is unknown, and any other Err is a message with the text still modified. *)
  words = rope.Text(state.Buffers[k].Rope)
  r = if force files.ForceSave(path, words) else files.SaveFile(path, words, disk) end
  match r
    result.Ok(now) -> saved(k, path, now, "Saved $path", state)
    result.Err(e) -> failed(k, path, disk, e, state)
  end
end

defn failed(k, path, disk, e, state)
  (** The state after a save that gave an error. *)
  if e.Kind == "changed"
    confirm("File changed on disk. Overwrite? (y or n)", (answer, s) -> overwrite(k, path, answer, s), state)
  else if e.Kind == "saved"
    saved(k, path, missing, e.Message, state)
  else
    say(e.Message, state)
  end
end

defn saveAs(k, answer, state)
  (** The answer of the prompt Save as: the buffer gets a path only if the save works. A file there already is asked about, as one that changed,
      and a file open in another buffer is refused: one file would get two buffers, with two texts. *)
  if answer == ""
    say("No file name.", state)
  else if indexOfFile(answer, state) > 0
    say("$answer is open in another buffer.", state)
  else
    store(k, answer, false, missing, state)
  end
end

defn Save(state)
  (** Saves the current buffer, asking for a file name first if it has none. A list has no file to save. *)
  b = current(state)
  k = state.Current
  if lists.IsList(b)
    say("A list has no file.", state)
  else if value.IsMissing(b.Path)
    ask("Save as: ", "", (answer, s) -> saveAs(k, answer, s), state)
  else
    store(k, b.Path, false, b.Disk, state)
  end
end

defn ended(state)
  (** The state that ends the editor. *)
  s = state
  s.Ending = true
  s
end

(** The answer to the question about quitting. *)
quitIfYes(answer, state) = if answer == "y" ended(state) else state end

defn Quit(state)
  (** Ends the editor, asking first if any text isn't saved. *)
  if value.Len(list.Filter(text.IsModified, state.Buffers)) > 0
    confirm("Text not saved. Quit anyway? (y or n)", quitIfYes, state)
  else
    ended(state)
  end
end

(* ---- Running a program, under the debugger of Cemacs: see core/run. *)

running(state) = not value.IsMissing(state.Run) and not state.Run.Ended   (** Does a program run, or wait at a stop? *)

defn withRun(r, state)
  (** The state with a run in place of the one before. *)
  s = state
  s.Run = r
  s
end

defn started(debug, state)
  (** The state with the file of the current buffer run, as saved, with the debugger of Cemacs or without it. *)
  b = current(state)
  if running(state)
    say("A program runs: C-c c k stops it.", state)
  else if value.IsMissing(b.Path)
    say("This buffer has no file to run: save it first.", state)
  else
    match run.Start(Home(state), b.Path, view.BreaksOf(state), debug)
      result.Ok(r) -> say(if text.IsModified(b) "Running $(b.Path) as saved, without the changes here." else "Running $(b.Path)." end, withRun(r, state))
      result.Err(e) -> say("$(b.Path) doesn't run: $e", state)
    end
  end
end

(** Runs the file of the current buffer, as saved, as fast as cesia run does: its output shows below the panes. *)
Run(state) = started(false, state)

(** Runs the file of the current buffer, as saved, under the debugger of Cemacs: it stops at the breakpoints, and C-c d e runs code in it. *)
DebugRun(state) = started(true, state)

(** Ends the program that runs. *)
Stop(state) = if running(state) say("Stopping the program.", withRun(run.Kill(state.Run), state)) else say("No program is running.", state) end

defn ToggleOutput(state)
  (** Shows or hides the output of the last program run. *)
  if value.IsMissing(state.Run)
    return say("There is no output yet: C-c c r runs the file.", state)
  end
  r = state.Run
  r.Shown = not r.Shown
  withRun(r, state)
end

defn ToggleBreak(state)
  (** A breakpoint on the line of the cursor, or none if it had one: the program that runs takes it at once. *)
  b = current(state)
  if value.IsMissing(b.Path)
    return say("A breakpoint needs a file: save the buffer first.", state)
  end
  here = {Path: b.Path, Line: b.Cursor.Line}
  breaks = view.BreaksOf(state)
  had = value.Len(list.Filter(x -> x.Path == here.Path and x.Line == here.Line, breaks)) > 0
  s = state
  s.Breaks = if had list.Filter(x -> x.Path != here.Path or x.Line != here.Line, breaks) else list.Append(here, breaks) end
  if running(state)
    s = withRun(run.Send({Do: if had "clear" else "break" end, File: here.Path, Line: here.Line}, state.Run), s)
  end
  say(if had "Breakpoint removed." else "Breakpoint on line $(here.Line)." end, s)
end

defn Eval(state)
  (** Runs the selection, or else the line of the cursor, in the program, and shows its value at the end of that line: in the frame where the program
      stopped, or at the file level of its main file while it runs. *)
  b = current(state)
  if not running(state) or not state.Run.Debug
    return say("No program runs under the debugger: C-c d r runs the file under it.", state)
  end
  code = if hasSelection(b) text.Region(b) else rope.Line(b.Cursor.Line, b.Rope) end
  line = if hasSelection(b) text.Selection(b).Last.Line else b.Cursor.Line end
  withRun(run.Ask(code, b.Path, line, state.Run), state)
end

defn resumed(word, state)
  (** The program going on from its stop, as continue, step, next or out say. *)
  if running(state) and not value.IsMissing(state.Run.Stop)
    withRun(run.Resume(word, state.Run), state)
  else
    say("The program isn't stopped.", state)
  end
end

Continue(state) = resumed("continue", state)   (** The program going on to its next stop. *)
StepOver(state) = resumed("next", state)   (** One line, a call as a whole. *)
StepInto(state) = resumed("step", state)   (** One line, into a call. *)
StepOut(state) = resumed("out", state)   (** On to the return of the function. *)

(** The state with what the program wrote since the last tick. *)
drained(state) = if running(state) withRun(run.Drain(state.Run), state) else state end

(* ---- Panes: the pane being edited holds its place in the current buffer, and each other pane keeps its own in its leaf, see panes.ce. *)

defn synced(state)
  (** The state with its pane being edited on the current buffer, after a command that changed buffer. *)
  tree = panes.Tree(state)
  i = panes.Active(state)
  if panes.At(i, tree).Buffer == state.Current
    state
  else
    s = state
    s.Panes = panes.WithLeaf(i, panes.One(state.Current), tree)
    s
  end
end

defn showing(j, tree, state)
  (** The state with the panes of tree and pane j being edited: its buffer becomes the current one, at the place its leaf keeps. *)
  leaf = panes.At(j, tree)
  k = list.Min(leaf.Buffer, value.Len(state.Buffers))
  s = state
  s.Buffers[k] = view.WithView(leaf.View, state.Buffers[k])
  s.Current = k
  s.Panes = tree
  s.Pane = j
  s
end

defn focused(j, state)
  (** The state with pane j being edited: the place of the current buffer is kept in the leaf of the pane that was, and the buffer of pane j comes at its own. *)
  s = synced(state)
  i = panes.Active(s)
  if j == i
    s
  else
    showing(j, panes.WithLeaf(i, {Buffer: s.Current, View: view.ViewOf(current(s))}, panes.Tree(s)), s)
  end
end

defn split(along, state)
  (** The pane being edited split in two along "rows" or "columns", if each half has room for two lines of eight characters. It stays the one being edited,
      and the new half shows the same buffer at the same place. *)
  s = synced(state)
  i = panes.Active(s)
  cut = panes.Split(i, along, panes.Tree(s))
  s.Panes = panes.WithLeaf(i + 1, {Buffer: s.Current, View: view.ViewOf(current(s))}, cut)
  s.Pane = i
  halves = list.Skip(i - 1, list.Take(i + 1, view.PaneLayouts(s)))
  if value.Len(list.Filter(one -> one.Rows < 2 or one.Columns < 8, halves)) == 0
    s
  else
    say("This pane is too small to split.", state)
  end
end

SplitBelow(state) = split("rows", state)   (** The pane being edited split in two, one above the other. *)
SplitRight(state) = split("columns", state)   (** The pane being edited split in two, side by side. *)

(** The next pane, from the last to the first. *)
NextPane(state) = focused(math.Mod(panes.Active(state), panes.Count(panes.Tree(state))) + 1, state)

defn ClosePane(state)
  (** The pane being edited closed: the other side of its split takes its place, and the pane there is edited. The last pane stays. *)
  tree = panes.Tree(state)
  if panes.Count(tree) == 1
    return say("This is the only pane.", state)
  end
  i = panes.Active(state)
  rest = panes.Remove(i, tree)
  showing(list.Min(i, panes.Count(rest)), rest, state)
end

defn OnlyPane(state)
  (** Only the pane being edited is kept. *)
  s = state
  s.Panes = panes.One(state.Current)
  s.Pane = 1
  s
end

(* ---- Config *)

defn config(state)
  (** What the editor runs on: the record that the function in the Config of the state gives, with the keys and the settings, as emacs.Config in src/ makes it.
      A state with none, as one from a session before this field, has no key and the settings of unconfigured: see view.Start. *)
  match state
    {Config: f} -> if value.IsMissing(f) unconfigured() else f() end
    else -> unconfigured()
  end
end

(** The config of a state that has none: no key, so that nothing runs that nobody bound, and plain settings. *)
unconfigured() = {Keys: () -> dict.Dict(), PromptKeys: () -> dict.Dict(), MouseKeys: () -> dict.Dict(), PromptMouseKeys: () -> dict.Dict(), ListKeys: () -> dict.Dict(), TabText: () -> "  ",
  WheelLines: () -> 3.0, DragZone: () -> 4, FontSize: () -> 15}

(* ---- Lists: a buffer of rows that an app gives, which typing filters. See lists.ce for what a list holds. *)

defn ShowList(name, rows, rowKeys, state, free = missing, label = missing, typed = missing)
  (** Opens a list named name. rows is the rows, each {Words, Item} and maybe a Key, which the filter reads in place of the words, or a function that gives
      them from the state, for rows that change with it.
      rowKeys is a function that gives the keys of the list, whose functions take the item under the cursor and the state; free, if given, gives keys that take
      only the state, and so run with no row left. Typing filters the rows, and the ListKeys of the config take the filter back; label, if given, takes the
      place of "Filter: " before it, and typed gets each typed text and the state in place of the filter, which AddToFilter can still grow. A list open
      already gives its place to this one. *)
  here = current(state)
  back = if lists.IsList(here) lists.Of(here).Back else state.Current end
  s = withoutList(state)
  b = text.Of("", missing)
  b.List = {Name: name, Rows: rows, Keys: rowKeys, Free: free, Filter: "", Items: [], Back: list.Min(back, value.Len(s.Buffers)), Shown: missing, Label: label, Typed: typed}
  s.Buffers = list.Append(b, s.Buffers)
  s.Current = value.Len(s.Buffers)
  refreshed(s)
end

defn withoutList(state)
  (** The state without its list, if one is open, and current on the same buffer as before. *)
  for k in 1..value.Len(state.Buffers)
    if lists.IsList(state.Buffers[k])
      return dropped(k, if state.Current > k state.Current - 1 else state.Current end, state)
    end
  end
  state
end

defn ToBuffer(k, state)
  (** Goes to buffer k. From a list, the list closes on the way, and k counts the buffers as they were with it. *)
  if lists.IsList(current(state))
    at = state.Current
    dropped(at, if k > at k - 1 else k end, state)
  else
    withBuffers(state.Buffers, k, state)
  end
end

defn withFilter(filter, state)
  (** The state with this filter in the list of the current buffer. *)
  b = current(state)
  l = lists.Of(b)
  l.Filter = filter
  b.List = l
  put(b, state)
end

(** The state with a text added to the filter of the list of the current buffer, for the typed function of an app. *)
AddToFilter(words, state) = withFilter("$(lists.Of(current(state)).Filter)$words", state)

Clipboard(state) = clipped(state)   (** The text of the clipboard, for an app. *)

Bindings(state) = config(state).Keys()   (** Every key of the editor and the function it runs, as the config gives them. *)

defn ListBack(state)
  (** The last character of the filter of a list taken back. Out of a list, nothing changes. *)
  l = lists.Of(current(state))
  if value.IsMissing(l) state else withFilter(str.Join("", list.Take(list.Max(0, value.Len(l.Filter) - 1), str.Chars(l.Filter))), state) end
end

defn ListCancel(state)
  (** The filter of a list cleared, or with none the list closed, back to the buffer it was opened from. Out of a list, nothing changes. *)
  l = lists.Of(current(state))
  if value.IsMissing(l)
    state
  else if l.Filter != ""
    withFilter("", state)
  else
    ToBuffer(l.Back, state)
  end
end

defn refreshed(state)
  (** The state with the list in the current buffer, if it is one, made again from its rows and its filter. The cursor stays on the item it was on, if that one is
      still shown, else on its line. When the words don't change, the buffer stays as it is, with its selection. Fixed rows are filtered again only when the
      filter changed, and from the rows shown when it only grew: every event comes here, and a folder can have ten thousand rows. *)
  b = current(state)
  l = lists.Of(b)
  if value.IsMissing(l)
    return state
  end
  fixed = not value.IsFunction(l.Rows)
  last = if fixed lists.ShownOf(l) else missing end
  if not value.IsMissing(last) and last.Filter == l.Filter
    return state
  end
  from = if fixed and not value.IsMissing(last) and str.StartsWith(last.Filter, l.Filter) last.Rows else if fixed l.Rows else l.Rows(state) end
  shown = lists.Filtered(l.Filter, from)
  words = lists.Words(shown)
  items = list.Map(r -> r.Item, shown)
  out = b
  if words != rope.Text(b.Rope)
    was = lists.ItemAt(b)
    out = text.Place(lists.LineOf(was, items, b.Cursor.Line), 0, text.Of(words, missing))
    out.Top = b.Top
  end
  l.Items = items
  l.Parts = list.Map(lists.PartsOf, shown)
  if fixed
    l.Shown = {Filter: l.Filter, Rows: shown}
  end
  out.List = l
  put(out, state)
end

defn listKeys(state)
  (** The keys of the list in the current buffer, over the keys of the config and its ListKeys: a key of the list gets the item under the cursor. *)
  l = lists.Of(current(state))
  own = dict.MapValues(f -> (s -> withItem(f, s)), l.Keys())
  dict.Merge(dict.Merge(dict.Merge(config(state).Keys(), config(state).ListKeys()), lists.FreeKeys(l)), own)
end

defn withItem(f, state)
  (** The state after f on the item under the cursor of the list, or a message when no row is left. *)
  item = lists.ItemAt(current(state))
  if value.IsMissing(item) say("Nothing here.", state) else f(item, state) end
end

defn guarded(after, before)
  (** A list is read only: after a command that changed its text, as a cut or an undo, its buffer is put back as it was, with a message. *)
  if after.Current == before.Current and value.Len(after.Buffers) == value.Len(before.Buffers) and lists.IsList(current(after)) and current(after).Version != current(before).Version
    say("This list is read only.", put(current(before), after))
  else
    after
  end
end

(* ---- Keys and events *)

(** Does the editor need frames of its own? Only while keys wait for the next one and their hints aren't shown yet, or while an app waits for time to
    pass, as a check does: the ticks count the time; and while a program runs, since they read what it writes. *)
Moving(state) = (state.Pending != "" and value.Len(hintsOf(state)) == 0) or hooks(state).Moving(state) or running(state)

defn hooks(state)
  (** What an app adds to the config to hear of time and saves, as src/check does: Idle(state) at each tick, Saved(state) after a save, and Moving(state),
      whether it needs ticks. A config without them has hooks that do nothing. *)
  match config(state)
    {Idle: idle, Saved: done, Moving: moving} -> {Idle: idle, Saved: done, Moving: moving}
    else -> {Idle: s -> s, Saved: s -> s, Moving: s -> false}
  end
end

defn Still(state)
  (** The seconds since the last key, text or mouse event, from the ticks. A state from before this field has none, and reading one it lacks would panic. *)
  match state
    {Still: seconds} -> seconds
    else -> 0.0
  end
end

defn hintsOf(state)
  (** The hints shown under the pending keys, or [] for none. A state from before this field has none, and reading one it lacks would panic. *)
  match state
    {Hints: shown} -> shown
    else -> []
  end
end

defn waitedOf(state)
  (** The seconds since the last pending key, from the ticks. *)
  match state
    {Waited: seconds} -> seconds
    else -> 0.0
  end
end

defn onTick(event, state)
  (** The state after a tick: what the program that runs wrote, the time counted since the last event, the hints of the pending keys, then the Idle hook
      of an app. *)
  s = drained(state)
  s.Still = Still(state) + event.Seconds
  hooks(s).Idle(hinted(event, s))
end

defn hinted(event, state)
  (** Once the pending keys have waited for HintDelay seconds of the config, the keys that can follow them, as keys.Hints gives them. *)
  if state.Pending == "" or value.Len(hintsOf(state)) > 0
    return state
  end
  s = state
  s.Waited = waitedOf(state) + event.Seconds
  if s.Waited >= config(state).HintDelay()
    s.Hints = keys.Hints(state.Pending, bindingsHere(state))
  end
  s
end

defn bindingsHere(state)
  (** The keys that a chord would be looked up in now: those of the list in the current buffer, or else those of the editor. A prompt has no pairs. *)
  if lists.IsList(current(state)) listKeys(state) else config(state).Keys() end
end

(** What Chain holds while a command runs, if the command before it was a cut of a line: neither true, which only a new cut sets, nor false. *)
wasCut() = "cut"

defn ran(f, state)
  (** The state after f, a command. A chain of cuts ends here unless the command cut a line, whatever function it is. *)
  s = state
  s.Chain = if state.Chain wasCut() else false end
  after = f(s)
  after.Chain = after.Chain == true
  after
end

(** Is this key, with no chord of its own, the second key of a pair, as the b of C-x b? Its chord is what it types, which its text event tells. *)
isSecond(event, state) = state.Pending != "" and not event.Ctrl and not event.Alt and not event.Super

defn awaitsSecond(state)
  (** Is the state waiting for the text of the second key of a pair? A state from before this field has none, and reading one it lacks would panic. *)
  match state
    {Second: waiting} -> waiting == true
    else -> false
  end
end

(** The chord of the second key of a pair from the text it typed: in lower case, as C-x b for Shift and b, and space for a space. Shift and / on a US
    keyboard type ?, so they give C-x ?: the name of the key would say /. *)
secondOf(words) = if words == " " "space" else str.Lower(words) end

defn routed(chord, state)
  (** The state after a chord: in the prompt if one is open, in the list of the current buffer, or else in the buffer. *)
  if not value.IsMissing(state.Prompt)
    promptChord(chord, config(state).PromptKeys(), state)
  else if lists.IsList(current(state))
    guarded(chorded(chord, listKeys(state), state), state)
  else
    s = state
    s.Buffers[state.Current].Typing = false
    chorded(chord, config(s).Keys(), s)
  end
end

defn chorded(chord, bindings, state)
  (** The state after a chord, found in bindings with the pending key. *)
  s = state
  s.Pending = ""
  match keys.Lookup(state.Pending, chord, bindings)
    {Pending: first} -> pending(first, s)
    {Command: f} -> ran(f, withChords(if state.Pending == "" chord else "$(state.Pending) $chord" end, s))
    {Unknown: name} -> if state.Pending != "" and chord == "C-g" CancelPair(s) else unbound(name, s) end
  end
end

defn withChords(chords, state)
  (** The state with the keys of the command about to run, which Chords gives it, as "C-c f ?". *)
  s = state
  s.Chords = chords
  s
end

defn Chords(state)
  (** The keys that ran the command running now, as "C-x C-s", or "" if a command runs without a key. *)
  match state
    {Chords: chords} -> chords
    else -> ""
  end
end

defn unbound(name, state)
  (** The state after keys with no command, which end a chain of cuts as a command does. *)
  s = say("$name is not bound.", state)
  s.Chain = false
  s
end

defn pending(first, state)
  (** The state waiting for the next key after first, its hints not shown until it has waited a while. *)
  s = state
  s.Pending = first
  s.Message = "$first -"
  s.Waited = 0.0
  s.Hints = []
  s
end

defn onKey(event, state)
  (** The state after a key event. A key that types gives its text event the work, unless it is the second key of a pair. Any other key is a command,
      which ends a step of typing even if it changes nothing. *)
  s = state
  s.Message = if state.Pending != "" "$(state.Pending) -" else "" end
  s.Buffers[state.Current].Free = false
  s.Second = false
  chord = keys.Chord(event)
  held = event.Ctrl or event.Alt
  s.Chorded = if held and not event.Shift echo(event.Key) else held end
  if value.IsMissing(chord)
    s.Second = isSecond(event, state)
    s
  else
    s.Message = ""
    routed(chord, s)
  end
end

(** The text that a key with Ctrl or Alt may also send, which is only the same key again. Most systems send none. *)
echo(key) = if key == "space" " " else str.Lower(key) end

defn onText(event, state)
  (** The state after a text event: typed at the cursor, or into the prompt. Right after a key with Ctrl or Alt it is only the same key again, and so is any
      text after such a key with Shift, or after the second key of a pair, whose text the key doesn't tell. A key of the numeric keypad comes only as a text. *)
  s = state
  same = state.Chorded == true or state.Chorded == str.Lower(event.Text)
  s.Chorded = false
  if awaitsSecond(state)
    s.Second = false
    s.Message = ""
    routed(secondOf(event.Text), s)
  else if same
    s
  else if not value.IsMissing(state.Prompt)
    promptText(event.Text, s)
  else if lists.IsList(current(s))
    if value.IsMissing(lists.TypedOf(lists.Of(current(s)))) AddToFilter(event.Text, s) else lists.TypedOf(lists.Of(current(s)))(event.Text, s) end
  else
    s.Chain = false
    s.Buffers[state.Current].Free = false
    typed(event.Text, s)
  end
end

defn wheelRest(state)
  (** What the wheel left for the next event. A state from before this field has none, and reading one it lacks would panic: see view.Start. *)
  match state
    {Wheel: rest} -> rest
    else -> 0.0
  end
end

defn Wheel(event, state)
  (** The screen of the pane under the mouse moved by the wheel, the WheelLines of the config for each notch, without moving the cursor, and without making that pane
      the one being edited. What is less than a line stays for the next event, since a touchpad sends many small ones. *)
  i = panes.Active(state)
  j = view.PaneAt(event.X, event.Y, state)
  if j > 0 and j != i
    focused(i, wheeled(event, focused(j, state)))
  else
    wheeled(event, state)
  end
end

defn wheeled(event, state)
  (** The screen of the current buffer moved by the wheel. *)
  b = current(state)
  wanted = wheelRest(state) - event.Amount * config(state).WheelLines()
  lines = math.Div(math.Floor(wanted + 0.5), 1)
  b.Top = list.Min(list.Max(1, b.Top + lines), rope.LineCount(b.Rope))
  b.Free = true
  s = put(b, state)
  s.Wheel = wanted - lines
  s
end

defn down(event, state)
  (** The state after a mouse press: the pane under it is edited, and in its code the cursor goes under the point and a mark from the mouse starts there. *)
  j = view.PaneAt(event.X, event.Y, state)
  s = if j > 0 focused(j, state) else state end
  if view.IsInCode(event.X, event.Y, s)
    at = view.ClickAt(event.X, event.Y, s)
    b = text.Place(at.Line, at.Column, current(s))
    b.Mark = b.Cursor
    b.Origin = "mouse"
    b.Free = false
    out = put(b, s)
    out.Dragging = true
    out.Pressed = {X: event.X, Y: event.Y}
    out
  else
    s
  end
end

defn pressPoint(state)
  (** The place of the press, until the mouse has left the zone around it, or missing. A state from before this field has none: see view.Start. *)
  match state
    {Pressed: at} -> at
    else -> missing
  end
end

(** Is this event still in the zone around the press at this point? A hand that moves one pixel during a click means no drag. *)
inZone(event, at, zone) = not value.IsMissing(at) and math.Abs(event.X - at.X) <= zone and math.Abs(event.Y - at.Y) <= zone

defn Drag(event, state)
  (** The mouse moved: with the button held, the cursor follows it once it has left the zone around the press, even if it comes back. *)
  if not state.Dragging or inZone(event, pressPoint(state), config(state).DragZone())
    state
  else
    at = view.PositionAt(event.X, event.Y, state)
    s = put(text.Place(at.Line, at.Column, current(state)), state)
    s.Pressed = missing
    s
  end
end

defn Release(event, state)
  (** The end of a drag: a click that selected nothing leaves no mark. *)
  b = current(state)
  s = state
  s.Dragging = false
  if state.Dragging and not hasSelection(b) and b.Origin == "mouse"
    put(unmarked(b), s)
  else
    s
  end
end

defn Press(event, state)
  (** A mouse button pressed, which counts as a command: it ends the first key of a pair, a chain of cuts and a step of typing. Only the first button does more. *)
  s = state
  s.Pending = ""
  s.Message = ""
  s.Chain = false
  s.Buffers[state.Current].Typing = false
  if event.Button == 1 down(event, s) else s end
end

defn onMouse(event, bindings, state)
  (** The state after a mouse event: it runs what bindings give its action, with the event, and any other action does nothing. *)
  match keys.Lookup("", event.Action, bindings)
    {Command: f} -> f(event, state)
    else -> state
  end
end

defn onQuit(state)
  (** The state after the window closed: it asks if some text isn't saved, replacing any question that was open. *)
  s = state
  s.Prompt = missing
  Quit(s)
end

defn resized(event, state)
  (** The state with the size of the window. *)
  s = state
  s.Width = event.Width
  s.Height = event.Height
  s
end

defn Settled(state)
  (** The state with a list made again from its rows, the pane being edited on the current buffer, the screen of each pane on its cursor, and the title of the
      window the name of the current buffer. *)
  s = view.FollowState(synced(refreshed(state)))
  name = view.BufferName(current(s))
  if name != s.Title
    if not value.IsMissing(s.Window)
      sdl.SetTitle(name, s.Window)
    end
    s.Title = name
  end
  s
end

defn Update(event, state)
  (** The new state after an event, or missing when the editor ends. *)
  next = match event.Kind
    "quit" -> onQuit(state)
    "resize" -> resized(event, state)
    "key" -> onKey(event, state)
    "text" -> onText(event, state)
    "tick" -> onTick(event, state)
    "mouse" -> onMouse(event, if value.IsMissing(state.Prompt) config(state).MouseKeys() else config(state).PromptMouseKeys() end, state)
    else -> state
  end
  if event.Kind == "key" or event.Kind == "text" or event.Kind == "mouse"
    next.Still = 0.0
  end
  if next.Ending missing else Settled(next) end
end
