(** The relay of the folders of Cemacs: src/folders runs it as cesia run --allow exec=PROGRAM tools/folders.ce, with that one program alone, so that Cemacs
    itself never holds the permission to run it: gzip, tar, zip, unzip, git or the shell of ! and &. The question comes in JSON on its input, {Program,
    Args, Dir, Limit, Diff}; it runs the program with those arguments, each one word, never through a shell, in that folder, ended after Limit seconds when
    Limit is more than 0, and writes {Code, Out, Err} as one line of JSON, with Rows, the rows of the diff as src/git makes them, when Diff is true. *)
use src/git
use std/dict
use std/io
use std/json
use std/list
use std/result
use std/sys
use std/value

defn main()
  (** The answer to the question on the input, or an Error that says why there is none. *)
  read = sys.ReadInput()
  if result.IsErr(read)
    return {Error: "The question can't be read."}
  end
  parsed = json.Parse(read.Value)
  q = if result.IsOk(parsed) parsed.Value else missing end
  ok = value.IsDict(q) and value.IsText(dict.GetOr("Program", missing, q)) and value.IsArray(dict.GetOr("Args", missing, q)) and
    list.All([value.IsText(a) for a in dict.GetOr("Args", [], q)]) and value.IsText(dict.GetOr("Dir", missing, q))
  if not ok
    return {Error: "A question needs a Program, its Args and a Dir."}
  end
  limit = dict.GetOr("Limit", 0, q)
  got = sys.Run(q.Program, q.Args, dir = q.Dir, timeout = if value.IsNumber(limit) limit else 0 end)
  if result.IsErr(got)
    return {Error: "$(q.Program) can't run: $(if value.IsText(got.Error) got.Error else got.Error.Message end)"}
  end
  out = {Code: got.Value.Code, Out: got.Value.Out, Err: got.Value.Err}
  if dict.GetOr("Diff", false, q) == true
    out.Rows = git.DiffRows(got.Value.Out, q.Dir)
  end
  out
end

io.Print(json.Text(main()))
