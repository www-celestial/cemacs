(** The program that answers a question of Cemacs about the search of a project: src/ide runs it as cesia run --allow read,exec=git tools/grep.ce, from a fiber, writes the
    question in JSON on its input and reads the answer in JSON on its output, one line, after which it ends. It runs git grep and nothing else: src/grep does the work,
    which none of the editor loads at its start. *)
use src/grep
use std/io
use std/json
use std/result
use std/sys

defn main()
  (** The answer to the question on the input, or an Error that says why there is none. *)
  read = sys.ReadInput()
  if result.IsErr(read)
    return {Error: "The question can't be read."}
  end
  q = json.Parse(read.Value)
  if result.IsErr(q)
    return {Error: "The question isn't JSON."}
  end
  grep.Answered(q.Value)
end

io.Print(json.Text(main()))
