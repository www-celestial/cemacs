(** Makes the pictures of Cemacs that its book shows, docs/book/images/NAME.png, each from a shot of tools/shots/book.ce: Cemacs opens in a window under SDL's
    dummy driver, as it comes, whatever user/ changed, plays the keys and the mouse of the shot, and saves its pixels; see tools/shots/shots.ce. After a
    change of how Cemacs looks, run them all again from the root of cemacs, or only those named:

    SDL_VIDEODRIVER=dummy cesia run --allow ffi=SDL3,ffi=SDL3_ttf,read,write,exec=cesia,exec=git,exec=mktemp,exec=rm,env=HOME,env=PWD,env=SHELL,env=XDG_DATA_HOME \
      --allow "exec=$(readlink -f "$(command -v cesia)")" tools/shots.ce [NAME...]

    With --cesia FOLDER first, it makes instead the pictures of Cemacs that the book of Cesia shows, into FOLDER, the docs/book/images of a clone of Cesia:

    SDL_VIDEODRIVER=dummy cesia run --allow ... tools/shots.ce --cesia ../cesia/docs/book/images [NAME...]

    It needs SDL 3.4 or later, for SDL_SavePNG. It prints each picture it wrote with its size, and stops at the first shot that fails. *)
use tools/shots
use std/io
use std/list
use std/result
use std/sys
use std/value

defn main()
  forCesia = value.Len(sys.Args) > 0 and sys.Args[1] == "--cesia"
  if forCesia and value.Len(sys.Args) < 2
    return result.Err("--cesia takes the folder of the images of Cesia's book, as ../cesia/docs/book/images.")
  end
  folder = if forCesia sys.Args[2] else "docs/book/images" end
  wanted = if forCesia list.Skip(2, sys.Args) else sys.Args end
  book = if forCesia shots.CesiaBook() else shots.Book() end
  chosen = [one for one in book if value.Len(wanted) == 0 or one.Name in wanted]
  unknown = [name for name in wanted if not (name in [one.Name for one in book])]
  if value.Len(unknown) > 0
    return result.Err("No shot is named $(unknown[1]).")
  end
  for one in chosen
    started = sys.Now()
    path = shots.Take(one, ".", folder)?
    io.Print("$path  $(one.Size[1])x$(one.Size[2])  $(sys.Now() - started) s")
  end
  result.Ok(value.Len(chosen))
end

io.Print(main())
