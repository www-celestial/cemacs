(** The debugger that Cemacs gives to the programs it runs, cesia run --debugger HOME/tools/debugger.ce FILE: it speaks
    with Cemacs over the standard input and output of the program. Each of its messages is one line that starts with the
    byte 1, then a map in JSON: Kind "stop", with File, Line, Reason, Error, Fiber and the Vars of the innermost frame;
    "value", the answer to an eval, with Id, Ok and Text; or "reload", with Ok and Text, when a fix doesn't load. Cemacs
    writes one command per line, a map in JSON whose Do is "eval" (with Id and Code), "break" or "clear" (with File and
    Line), or "continue", "step", "next" or "out". While the program runs, a fiber reads the commands, and an eval runs
    at the file level of the main file; at a stop, OnStop reads them, and an eval runs in the innermost frame. It lives
    outside core/ and src/, so that no package of Cemacs loads it. *)
use std/debug
use std/fiber
use std/io
use std/json
use std/list
use std/result
use std/text
use std/value

defn send(message)
  (** Writes a message for Cemacs, on one line that starts with the byte 1. *)
  io.Print("$(text.Char(1))$(json.Text(message))")
end

defn shown(e)
  (** An error of an eval, for the end of a line: its first line, without its place when that is the code sent, as
      <prompt>:1:5:. The other lines show that code again, with a ^ under the place. *)
  first = text.Lines(e)[1]
  parts = text.Split(": ", first)
  if text.StartsWith("<prompt>:", parts[1]) text.Join(": ", list.Skip(1, parts)) else first end
end

defn answer(id, r)
  (** Sends the answer to an eval: its value as the program would print it, or its error. *)
  match r
    result.Ok(v) -> send({Kind: "value", Id: id, Ok: true, Text: "$v"})
    result.Err(e) -> send({Kind: "value", Id: id, Ok: false, Text: shown(e)})
  end
end

defn command(line)
  (** The command of a line from Cemacs, or missing for a line that isn't one. *)
  match json.Parse(line)
    result.Ok(c) -> if value.IsDict(c) c else missing end
    result.Err(e) -> missing
  end
end

defn apply(c, frame)
  (** Runs a command that doesn't resume the program: an eval in the frame, or at the file level when frame is missing, or a
      breakpoint. *)
  if c.Do == "eval"
    answer(c.Id, if value.IsMissing(frame) debug.Eval(c.Code) else debug.Eval(c.Code, frame) end)
  else if c.Do == "break"
    debug.SetBreak(c.File, c.Line)
  else if c.Do == "clear"
    debug.ClearBreak(c.File, c.Line)
  end
end

defn Listen()
  (** Reads the commands that come while the program runs, until the end of the input. *)
  line = debug.ReadLine()
  while not value.IsMissing(line)
    c = command(line)
    if not value.IsMissing(c)
      apply(c, missing)
    end
    line = debug.ReadLine()
  end
end

defn resumes(c)
  (** Does the command resume the program? *)
  not value.IsMissing(c) and (c.Do == "continue" or c.Do == "step" or c.Do == "next" or c.Do == "out")
end

defn reloaded()
  (** Reloads the files changed since they were loaded: false, after telling Cemacs the errors, when one doesn't load. *)
  match debug.Reload()
    result.Ok(paths) -> true
    result.Err(e) -> failed(e)
  end
end

defn failed(e)
  (** Tells Cemacs the errors of a reload: false. *)
  send({Kind: "reload", Ok: false, Text: e})
  false
end

defn tell(stop, reason)
  (** Tells Cemacs where the program stopped, with the variables of the innermost frame. *)
  error = if value.IsMissing(stop.Error) "" else stop.Error end
  vars = list.Map(v -> {Name: v.Name, Value: "$(v.Value)"}, stop.Frames[1].Vars)
  send({Kind: "stop", File: stop.File, Line: stop.Line, Reason: reason, Error: error, Fiber: stop.Fiber, Vars: vars})
end

defn resumed(stop)
  (** Runs the commands of Cemacs at a stop until one resumes the program and the fixes load: gives its word. *)
  while true
    line = debug.ReadLine()
    if value.IsMissing(line)
      return "continue"
    end
    c = command(line)
    if resumes(c)
      if reloaded()
        return c.Do
      end
    else if not value.IsMissing(c)
      apply(c, stop.Frames[1])
    end
  end
end

(** A path without its parts . and its doubled slashes, as Cesia compares the file of a breakpoint with the file of a line. *)
bare(path) = "$(if text.StartsWith("/", path) "/" else "" end)$(text.Join("/", list.Filter(p -> p != "" and p != ".", text.Split("/", path))))"

(** Does a breakpoint of the program name this file and line? A file named without a folder names every file of that name, as for Cesia. *)
armed(file, line) = value.Len(list.Filter(b -> b.Line == line and (bare(b.File) == bare(file) or (not text.Contains("/", b.File) and list.Last(text.Split("/", file)) == b.File)), debug.Breaks())) > 0

defn OnStop(stop)
  (** Tells Cemacs where the program stopped, then runs its commands until one resumes the program: gives its word. The stop before the first line is the
      debugger's own, and Cemacs never hears of it: the breakpoints and the word to go on that Cemacs sent with the start are read there, and only a
      breakpoint on that line makes it a stop. *)
  if stop.Reason == "start"
    word = resumed(stop)
    if word != "continue" or not armed(stop.File, stop.Line)
      return word
    end
    tell(stop, "break")
  else
    tell(stop, stop.Reason)
  end
  resumed(stop)
end

listening = fiber.Spawn(Listen)
