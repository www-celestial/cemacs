-- The frame: from a state to an array of commands for sdl. Everything here is pure and knows no window. The look of the state gives
-- the theme and the widths of the proportional fonts; cell is the size of one character of the code font.
use rope
use ui
use "./color"
use "./text"

-- The width of the line numbers and the space around them, before the first column of text.
gutter = 62

-- Pixels added under the height of the code font to space the lines: JetBrains Mono at 13 is 18 high, and the 19 of ui.code reads less tight.
line_gap = 1

_tabs_height = 36
_mode_height = 24
_prompt_height = 22

-- The state of the editor with its buffers, before any key: the first buffer is current, there is no pending key, no prompt, no run and no window yet.
-- The editor adds its own fields: clip, the clipboard when there is no window; chorded, true right after a key with Ctrl or Alt, whose text event
-- is ignored; chain, true while the last command was C-k; dragging, true while the mouse selects; ending, true when the editor must stop; and title.
--
--   start([], ui.look(ui.dark, (w, f) -> 8, 19), {width: 8, height: 19}, 800, 600).current --> 1
start(buffers, look, cell, width, height) = {buffers: buffers, current: 1, pending: "", prompt: missing, message: "", run: missing, window: missing, width: width, height: height, cell: cell, look: look,
  clip: "", chorded: false, chain: false, dragging: false, ending: false, title: ""}

-- The rectangles of the screen {tabs, code, output, mode, prompt}, and rows and columns, the lines and the characters that fit in code.
-- With showing_output false, output is empty. No size goes below zero, so a tiny window still has a layout.
--
--   layout(800, 600, {width: 8, height: 19}, false).output.height --> 0
defn layout(width, height, cell, showing_output)
  whole = {x: 0, y: 0, width: width, height: height}
  tabs = ui.top(_tabs_height, whole)
  prompt = ui.bottom(_prompt_height, tabs.rest)
  mode = ui.bottom(_mode_height, prompt.rest)
  output_height = if showing_output max(0, div(mode.rest.height, 3)) else 0 end
  output = ui.bottom(output_height, mode.rest)
  code = output.rest
  {tabs: tabs.part, code: code, output: output.part, mode: mode.part, prompt: prompt.part,
    rows: max(0, div(code.height - 8, cell.height)), columns: max(0, div(code.width - gutter - 8, cell.width))}
end

-- The name of a buffer in its tab: the last part of its path, or untitled.
_name(b) = if is_missing(b.path) "untitled" else last(split("/", b.path)) end

-- The name of a buffer, as its tab and the title of the window show it.
--
--   buffer_name(text.of("", "src/a.kp")) --> "a.kp"
buffer_name(b) = _name(b)

-- Is the text of a buffer modified since it was saved?
_modified(b) = b.version != b.saved

-- The label of the mode line: the name, and a star if the text isn't saved. Tabs show the plain name and a dot instead.
_label(b) = if _modified(b) "$(_name(b)) *" else _name(b) end

-- A buffer whose top and left keep the cursor on the screen of rows lines and columns characters, and whose colors are known up to the last line on the screen.
-- It is the only place that moves the screen: view only reads. A buffer that is free, after the wheel, keeps its top and left: the cursor may be off the screen.
--
--   follow(2, 10, {rope: rope.of("a\nb\nc"), cursor: {line: 3, column: 0}, top: 1, left: 0, free: false, colors: color.blank_colors()}).top --> 2
defn follow(rows, columns, b)
  line = b.cursor.line
  column = b.cursor.column
  seen_rows = max(1, rows)
  seen_columns = max(1, columns)
  top = if b.free
    b.top
  else if line < b.top
    line
  else if line >= b.top + seen_rows
    line - seen_rows + 1
  else
    b.top
  end
  left = if b.free
    b.left
  else if column < b.left
    column
  else if column >= b.left + seen_columns
    column - seen_columns + 1
  else
    b.left
  end
  last_line = min(rope.line_count(b.rope), top + seen_rows)
  out = b
  out.top = top
  out.left = left
  out.colors = color.colored_to(last_line, n -> rope.line(n, b.rope), b.colors)
  out
end

-- The state with the screen of its current buffer kept on the cursor, as follow does.
defn follow_state(state)
  lay = layout(state.width, state.height, state.cell, not is_missing(state.run))
  s = state
  s.buffers[state.current] = follow(lay.rows, lay.columns, state.buffers[state.current])
  s
end

-- A text command in the font code, or in the font of the theme if none.
_text(x, y, words, color) = {kind: "text", x: x, y: y, text: words, color: color}
_in(font, x, y, words, color) = {kind: "text", x: x, y: y, text: words, color: color, font: font}
_rect(x, y, w, h, color) = {kind: "rect", x: x, y: y, width: max(0, w), height: max(0, h), color: color}
_box(x, y, w, h, color, radius) = {kind: "box", x: x, y: y, width: max(0, w), height: max(0, h), color: color, radius: radius}

-- The tokens [role, text] of a line that are in the columns from left on, as [role, text, column], cutting the first one that straddles left.
defn _visible(tokens, left)
  out = []
  column = 0
  for token in tokens
    size = length(token[2])
    if column + size > left
      skipped = max(0, left - column)
      words = if skipped > 0 join("", skip(skipped, chars(token[2]))) else token[2] end
      out = push([token[1], words, column + skipped], out)
    end
    column = column + size
  end
  out
end

-- The state at the start of line n, or the first one if the colors don't reach it yet.
_start_of(n, colors) = if n <= colors.known colors.starts[n] else color.first_state end

-- The commands of line n of a buffer: its number, then one text per token. The line is cut to the columns on the screen before
-- it is read, since sdl has no clipping and the tail would not be seen.
defn _line(b, n, y, columns, rect, look)
  th = look.theme
  cw = look.width("M", "code")
  cs = chars(rope.line(n, b.rope))
  words = if length(cs) > b.left + columns join("", take(b.left + columns, cs)) else join("", cs) end
  read = color.tokens(words, _start_of(n, b.colors))
  x0 = rect.x + gutter
  numbered = _in("code", rect.x + gutter - 16 - length("$n") * cw, y, "$n", th.faint)
  out = [numbered]
  for token in _visible(read.tokens, b.left)
    out = push(_in("code", x0 + (token[3] - b.left) * cw, y, token[2], th.syntax[token[1]]), out)
  end
  out
end

-- The space between the top of the code area and its first line.
_inset = 4

-- The y of the row of the code area (0 is the first one) and the x of a column of the screen, in pixels. Drawing and the mouse both use them.
_row_y(row, rect, cell) = rect.y + _inset + row * cell.height
_column_x(column, rect, cell) = rect.x + gutter + column * cell.width

-- The division of two whole numbers rounded down, also when the first is negative.
defn _floor_div(a, b)
  if a >= 0
    div(a, b)
  else
    0 - div(b - 1 - a, b)
  end
end

-- The row and the column of the screen under a point, rounding the column to the nearest edge between two characters. They may be
-- outside the text, even negative.
defn _cell_at(x, y, rect, cell)
  dy = y - rect.y - _inset
  dx = x - rect.x - gutter + div(cell.width, 2)
  {row: _floor_div(dy, cell.height), column: _floor_div(dx, cell.width)}
end

-- The layout of a state.
_layout_of(state) = layout(state.width, state.height, state.cell, not is_missing(state.run))

-- Is a point inside the code area?
--
--   is_in_code(10, 100, start([], ui.look(ui.dark, (w, f) -> 8, 19), {width: 8, height: 19}, 800, 600)) --> true
defn is_in_code(x, y, state)
  r = _layout_of(state).code
  x >= r.x and x < r.x + r.width and y >= r.y and y < r.y + r.height
end

-- The position {line, column} of the current buffer under a point of the code area, brought inside the text.
--
--   position_at(0, 0, start([text.of("ab", missing)], ui.look(ui.dark, (w, f) -> 8, 19), {width: 8, height: 19}, 800, 600)).line --> 1
defn position_at(x, y, state)
  lay = _layout_of(state)
  b = state.buffers[state.current]
  at = _cell_at(x, y, lay.code, state.cell)
  text.place(b.top + at.row, b.left + at.column, b).cursor
end

-- The selection of a buffer on the lines from first to last: one rectangle per line, from the mark to the cursor. A line that the selection
-- crosses is filled one character past its end, to show that its line end is selected.
defn _selection(b, first, last, lay, look)
  ends = text.selection(b)
  if is_missing(ends)
    return []
  end
  rect = lay.code
  cell = lay.cell
  out = []
  for n in max(first, ends.first.line):min(last, ends.last.line)
    from = if n == ends.first.line ends.first.column else 0 end
    to = if n == ends.last.line ends.last.column else text.line_width(n, b) + 1 end
    a = max(from, b.left)
    z = min(to, b.left + lay.columns)
    if z > a
      out = push(_rect(_column_x(a - b.left, rect, cell), _row_y(n - b.top, rect, cell), (z - a) * cell.width, cell.height, look.theme.fill), out)
    end
  end
  out
end

-- The code area of a buffer: the band of the current line, the lines on the screen and the cursor bar.
defn _code(b, lay, look)
  th = look.theme
  cell = lay.cell
  rect = lay.code
  out = [_box(rect.x, rect.y, rect.width, rect.height, th.code, 0)]
  first = b.top
  last = min(rope.line_count(b.rope), b.top + lay.rows - 1)
  line_y(n) = _row_y(n - b.top, rect, cell)
  here = b.cursor.line
  if here >= first and here <= last
    out = push(_box(rect.x + 4, line_y(here), rect.width - 8, cell.height, th.hover, 4), out)
  end
  out = concat(out, _selection(b, first, last, lay, look))
  for n in first:last
    out = concat(out, _line(b, n, line_y(n), lay.columns, rect, look))
  end
  if here >= first and here <= last and b.cursor.column >= b.left and b.cursor.column - b.left < lay.columns
    out = push(_rect(_column_x(b.cursor.column - b.left, rect, cell), line_y(here), 2, cell.height, th.bright), out)
  end
  out
end

-- A dot, for a file that isn't saved.
_dot(x, y, color) = _box(x, y, 7, 7, color, 3)

-- The width of the tab of a buffer: its name, the space around it, and room for the dot of a text that isn't saved.
_tab_size(b, look) = look.width(_name(b), "body") + 28 + if _modified(b) 13 else 0 end

-- The index of the tab under a point, or 0 if it is not on a tab.
--
--   tab_at(0, 100, start([], ui.look(ui.dark, (w, f) -> 8, 19), {width: 8, height: 19}, 800, 600)) --> 0
defn tab_at(x, y, state)
  rect = _layout_of(state).tabs
  if y < rect.y or y >= rect.y + rect.height
    return 0
  end
  left = rect.x + 8
  for k in 1:length(state.buffers)
    size = _tab_size(state.buffers[k], state.look)
    if x >= left and x < left + size
      return k
    end
    left = left + size
  end
  0
end

-- The tabs: one per buffer, flat on the bar. The current one has a blue line under it, and a blue dot marks a file that isn't saved.
defn _tabs(state, lay, look)
  th = look.theme
  rect = lay.tabs
  out = [_rect(rect.x, rect.y, rect.width, rect.height, th.code), _rect(rect.x, rect.y + rect.height - 1, rect.width, 1, th.line)]
  x = rect.x + 8
  y = rect.y + div(rect.height - look.height, 2)
  for k in 1:length(state.buffers)
    b = state.buffers[k]
    name = _name(b)
    dot = if _modified(b) 13 else 0 end
    size = _tab_size(b, look)
    if k == state.current
      out = concat(out, [_in("strong", x + 14, y, name, th.bright), _box(x + 8, rect.y + rect.height - 3, size - 16, 3, th.accent, 1)])
    else
      out = push(_text(x + 14, y, name, th.muted), out)
    end
    if dot > 0
      out = push(_dot(x + 14 + look.width(name, "body") + 7, y + 6, th.accent), out)
    end
    x = x + size
  end
  out
end

-- The mode line: the tab name, the position of the cursor, and the language.
defn _mode(b, lay, look)
  th = look.theme
  rect = lay.mode
  y = rect.y + div(rect.height - look.height, 2)
  position = "$(b.cursor.line):$(b.cursor.column)"
  language = "Kepler"
  right = rect.x + rect.width - 12
  [_rect(rect.x, rect.y, rect.width, rect.height, th.header), _text(rect.x + 12, y, _label(b), th.ink),
    _text(right - look.width(language, "body"), y, language, th.muted),
    _text(right - look.width(language, "body") - 24 - look.width(position, "body"), y, position, th.muted)]
end

-- The prompt line: the question and the answer being typed, or else the last message.
defn _prompt(state, lay, look)
  th = look.theme
  rect = lay.prompt
  y = rect.y + div(rect.height - look.height, 2)
  words = if is_missing(state.prompt) state.message else "$(state.prompt.label)$(state.prompt.answer)" end
  bar = if is_missing(state.prompt) [] else [_rect(rect.x + 12 + look.width(words, "body"), y, 2, look.height, th.bright)] end
  concat([_rect(rect.x, rect.y, rect.width, rect.height, th.panel), _text(rect.x + 12, y, words, th.ink)], bar)
end

-- The output pane, when there is room for it: its title and the status of the program.
defn _output(state, lay, look)
  th = look.theme
  rect = lay.output
  if rect.height == 0 or is_missing(state.run)
    []
  else
    y = rect.y + 4
    [_rect(rect.x, rect.y, rect.width, rect.height, th.well), _rect(rect.x, rect.y, rect.width, 1, th.line), _in("strong", rect.x + 12, y, "Output", th.ink),
      _text(rect.x + 24 + look.width("Output", "strong"), y, state.run.status, th.muted)]
  end
end

-- The frame of a state: an array of commands for sdl. Only the lines on the screen are read, so a large file costs no more than a small one.
-- The screen of the buffer (top, left and colors) is what follow gave it.
defn view(state)
  look = state.look
  lay = layout(state.width, state.height, state.cell, not is_missing(state.run))
  lay.cell = state.cell
  b = state.buffers[state.current]
  flatten([[{kind: "clear", color: look.theme.ground}], _code(b, lay, look), _tabs(state, lay, look), _output(state, lay, look), _mode(b, lay, look), _prompt(state, lay, look)])
end
