-- The editor: one small function per command, from a state to a state, and update, which turns the events of the window into commands.
-- Commands are found by name in names, and keys.kp says which key runs which name. Errors from the file system never panic: they become a message.
use rope
use sdl
use "./files"
use "./keys"
use "./text"
use "./view"

-- The buffer being edited.
_current(state) = state.buffers[state.current]

-- The state with a buffer in place of the current one.
defn _put(b, state)
  s = state
  s.buffers[state.current] = b
  s
end

-- The state with a message for the person.
defn _say(words, state)
  s = state
  s.message = words
  s
end

-- The buffer without its mark.
defn _unmarked(b)
  out = b
  out.mark = missing
  out.origin = ""
  out
end

-- Is something selected? A mark with nothing between it and the cursor selects nothing.
defn _has_selection(b)
  e = text.selection(b)
  not is_missing(e) and e.first != e.last
end

-- ---- The clipboard: the one of the system when there is a window, else the state's own.

-- The state with words in the clipboard.
defn _clip(words, state)
  if not is_missing(state.window)
    sdl.copy(words, state.window)
    state
  else
    s = state
    s.clip = words
    s
  end
end

-- The words in the clipboard.
_clipped(state) = if is_missing(state.window) state.clip else sdl.paste(state.window) end

-- ---- Moves

-- The current buffer moved by f. A mark stays only if C-space set it: the others end with the next move.
defn _move(f, state)
  b = f(_current(state))
  if b.origin != "key"
    b = _unmarked(b)
  end
  _put(b, state)
end

-- The current buffer moved by f, selecting: a mark is put where the cursor was, if there is none.
defn _select(f, state)
  before = _current(state)
  b = f(before)
  if is_missing(before.mark)
    b.mark = before.cursor
    b.origin = "shift"
  end
  _put(b, state)
end

-- The number of lines of a page.
_rows(state) = view.layout(state.width, state.height, state.cell, not is_missing(state.run)).rows

-- Moves, by name of a command. The select_ ones keep the mark of a selection.

-- One character on.
forward_char(state) = _move(b -> text.move_char(1, b), state)
-- One character back.
backward_char(state) = _move(b -> text.move_char(-1, b), state)
-- One line down.
next_line(state) = _move(b -> text.move_line(1, b), state)
-- One line up.
previous_line(state) = _move(b -> text.move_line(-1, b), state)
-- One word on.
forward_word(state) = _move(b -> text.move_word(1, b), state)
-- One word back.
backward_word(state) = _move(b -> text.move_word(-1, b), state)
-- To the start of the line.
line_start(state) = _move(text.to_line_start, state)
-- To the end of the line.
line_end(state) = _move(text.to_line_end, state)
-- One page down.
page_down(state) = _move(b -> text.move_page(1, _rows(state), b), state)
-- One page up.
page_up(state) = _move(b -> text.move_page(-1, _rows(state), b), state)
-- To the start of the file.
file_start(state) = _move(text.to_file_start, state)
-- To the end of the file.
file_end(state) = _move(text.to_file_end, state)
-- Selecting one character on.
select_forward_char(state) = _select(b -> text.move_char(1, b), state)
-- Selecting one character back.
select_backward_char(state) = _select(b -> text.move_char(-1, b), state)
-- Selecting one line down.
select_next_line(state) = _select(b -> text.move_line(1, b), state)
-- Selecting one line up.
select_previous_line(state) = _select(b -> text.move_line(-1, b), state)
-- Selecting to the start of the line.
select_line_start(state) = _select(text.to_line_start, state)
-- Selecting to the end of the line.
select_line_end(state) = _select(text.to_line_end, state)
-- Selecting one page down.
select_page_down(state) = _select(b -> text.move_page(1, _rows(state), b), state)
-- Selecting one page up.
select_page_up(state) = _select(b -> text.move_page(-1, _rows(state), b), state)

-- The mark put at the cursor, and kept through moves until C-g, an edit or a cut.
defn set_mark(state)
  b = text.set_mark(_current(state))
  b.origin = "key"
  _put(b, state)
end

-- The mark taken away, and the message to show it.
defn cancel(state)
  _say("Quit", _put(_unmarked(_current(state)), state))
end

-- ---- Edits

-- The current buffer after f. The selection, if any, is removed first, and the mark ends.
defn _replacing(f, state)
  b = _current(state)
  gone = if _has_selection(b) text.cut_region(b) else b end
  _put(_unmarked(f(gone)), state)
end

-- The current buffer after f, or only without its selection if it has one: Backspace and Delete delete what is selected.
defn _deleting(f, state)
  b = _current(state)
  if _has_selection(b)
    _put(_unmarked(text.cut_region(b)), state)
  else
    _put(_unmarked(f(b)), state)
  end
end

-- Words typed or pasted at the cursor, in place of the selection.
typed(words, state) = _replacing(b -> text.insert_words(words, b), state)

-- The character before the cursor deleted, or the selection.
delete_before(state) = _deleting(text.delete_before, state)
-- The character after the cursor deleted, or the selection.
delete_after(state) = _deleting(text.delete_after, state)
-- A line end with the indent of the line, in place of the selection.
new_line(state) = _replacing(text.new_line, state)
-- Two spaces, in place of the selection.
tab(state) = typed("  ", state)

-- The undone step back.
undo(state) = _put(text.undo(_current(state)), state)
-- The undone step done again.
redo(state) = _put(text.redo(_current(state)), state)

-- The selection removed and put in the clipboard. Without a selection, nothing changes but the message.
defn cut(state)
  b = _current(state)
  if _has_selection(b)
    _put(_unmarked(text.cut_region(b)), _clip(text.region(b), state))
  else
    _say("Nothing is selected.", state)
  end
end

-- The selection put in the clipboard, and the mark ended. Without a selection, nothing changes but the message.
defn copy(state)
  b = _current(state)
  if _has_selection(b)
    _put(_unmarked(b), _clip(text.region(b), state))
  else
    _say("Nothing is selected.", state)
  end
end

-- The clipboard inserted at the cursor, in place of the selection.
defn paste(state)
  words = _clipped(state)
  if words == ""
    _say("The clipboard is empty.", state)
  else
    typed(words, state)
  end
end

-- The rest of the line cut into the clipboard, or the line end if the cursor is already there. Cuts one after the other add up, as in Emacs.
defn cut_line(state)
  r = text.cut_line(_current(state))
  if r.cut == ""
    _say("Nothing to cut.", state)
  else
    before = if state.chain _clipped(state) else "" end
    s = _clip("$before$(r.cut)", _put(_unmarked(r.buffer), state))
    s.chain = true
    s
  end
end

-- ---- Prompts

-- The state with a prompt that takes an answer: done gets the answer and the state, without the prompt.
defn _ask(label, answer, done, state)
  s = state
  s.prompt = {label: label, answer: answer, done: done, choice: false}
  s
end

-- The state with a prompt that takes y or n.
defn _confirm(label, done, state)
  s = state
  s.prompt = {label: label, answer: "", done: done, choice: true}
  s
end

-- The state after the answer of the prompt is accepted.
defn _accept(state)
  p = state.prompt
  s = state
  s.prompt = missing
  p.done(p.answer, s)
end

-- The state with the prompt closed.
defn _closed(state)
  s = state
  s.prompt = missing
  s
end

-- A chord while a prompt is open: Enter accepts, Backspace removes a character, C-g closes. Others do nothing.
defn _prompt_chord(chord, state)
  p = state.prompt
  if chord == "enter" or chord == "S-enter"
    if p.choice state else _accept(state) end
  else if chord == "backspace" or chord == "S-backspace"
    s = state
    s.prompt.answer = join("", take(max(0, length(p.answer) - 1), chars(p.answer)))
    s
  else if chord == "C-g"
    _say("Quit", _closed(state))
  else
    state
  end
end

-- Text while a prompt is open: it goes to the answer. A prompt of y or n takes one of the two and ends.
defn _prompt_text(words, state)
  p = state.prompt
  if p.choice
    answer = lower(words)
    if answer == "y" or answer == "n" p.done(answer, _closed(state)) else state end
  else
    s = state
    s.prompt.answer = "$(p.answer)$words"
    s
  end
end

-- ---- Buffers and files

-- The state with the buffers. At least one is kept, and current stays among them.
defn _with_buffers(buffers, current, state)
  s = state
  s.buffers = if length(buffers) == 0 [text.of("", missing)] else buffers end
  s.current = min(max(1, current), length(s.buffers))
  s
end

-- An array without its element k.
_without(k, items) = concat(take(k - 1, items), skip(k, items))

-- The folder of a path with its slash, or an empty text for a path with no folder.
defn _folder(path)
  if is_missing(path) or not contains("/", path)
    ""
  else
    "$(join("/", take(length(split("/", path)) - 1, split("/", path))))/"
  end
end

-- The index of the buffer for this file, or 0.
defn _index_of_file(path, state)
  wanted = files.normal(path)
  for k in 1:length(state.buffers)
    b = state.buffers[k]
    if not is_missing(b.path) and files.normal(b.path) == wanted
      return k
    end
  end
  0
end

-- Goes to the file at path, in a new buffer or in the one that has it. A file that can't be read is a message.
defn open_file(path, state)
  if path == ""
    return _say("No file name.", state)
  end
  known = _index_of_file(path, state)
  if known > 0
    s = state
    s.current = known
    return s
  end
  match files.read_file(path)
    Ok(read) -> _opened(path, read, state)
    Err(e) -> _say(e.message, state)
  end
end

-- The state with a buffer for the file just read, and the person in it.
defn _opened(path, read, state)
  b = text.of(read.words, path)
  b.disk = read.disk
  s = state
  s.buffers = push(b, state.buffers)
  s.current = length(s.buffers)
  s
end

-- Opens every file in order, in new buffers, and stays in the first one that was opened. An empty buffer that nothing touched makes room.
defn open_all(paths, state)
  s = reduce((acc, path) -> open_file(path, acc), state, paths)
  if length(s.buffers) == length(state.buffers)
    s
  else if _is_placeholder(state)
    _with_buffers(skip(1, s.buffers), 1, s)
  else
    _with_buffers(s.buffers, length(state.buffers) + 1, s)
  end
end

-- Does the state have only an untouched empty buffer with no file, which a first file replaces?
_is_placeholder(state) = length(state.buffers) == 1 and is_missing(state.buffers[1].path) and not text.is_modified(state.buffers[1]) and rope.text(state.buffers[1].rope) == ""

-- The prompt for a file to open, with the folder of the current file as the start of the answer.
ask_file(state) = _ask("Find file: ", _folder(_current(state).path), (answer, s) -> open_file(answer, s), state)

-- Goes to the next buffer, from the last to the first.
defn next_buffer(state)
  s = state
  s.current = mod(state.current, length(state.buffers)) + 1
  s
end

-- The state with buffer k closed.
defn _close(k, state)
  _with_buffers(_without(k, state.buffers), k, state)
end

-- The answer to the question about closing buffer k.
_close_if_yes(k, answer, state) = if answer == "y" _close(k, state) else state end

-- Closes the current buffer, asking first if its text isn't saved. The last one is replaced by an empty buffer.
defn close_buffer(state)
  k = state.current
  if text.is_modified(_current(state))
    _confirm("Text not saved. Close anyway? (y or n)", (answer, s) -> _close_if_yes(k, answer, s), state)
  else
    _close(k, state)
  end
end

-- The state with buffer k saved at path, with the time of the file given, and a message.
defn _saved(k, path, disk, words, state)
  b = text.mark_saved(disk, state.buffers[k])
  b.path = path
  s = state
  s.buffers[k] = b
  _say(words, s)
end

-- The answer to the question about writing over a file that changed.
defn _overwrite(k, path, answer, state)
  if answer == "y"
    _store(k, path, true, missing, state)
  else
    _say("Not saved.", state)
  end
end

-- Writes buffer k to path, if the file is still the one of disk, or whatever is there when force is true. An Err of kind changed asks first,
-- one of kind saved counts as a save whose time is unknown, and any other Err is a message with the text still modified.
defn _store(k, path, force, disk, state)
  words = rope.text(state.buffers[k].rope)
  r = if force files.force_save(path, words) else files.save_file(path, words, disk) end
  match r
    Ok(now) -> _saved(k, path, now, "Saved $path", state)
    Err(e) -> _failed(k, path, disk, e, state)
  end
end

-- The state after a save that gave an error.
defn _failed(k, path, disk, e, state)
  if e.kind == "changed"
    _confirm("File changed on disk. Overwrite? (y or n)", (answer, s) -> _overwrite(k, path, answer, s), state)
  else if e.kind == "saved"
    _saved(k, path, missing, e.message, state)
  else
    _say(e.message, state)
  end
end

-- The answer of the prompt Save as: the buffer gets a path only if the save works. A file there already is asked about, as one that changed.
defn _save_as(k, answer, state)
  if answer == ""
    _say("No file name.", state)
  else
    _store(k, answer, false, missing, state)
  end
end

-- Saves the current buffer, asking for a file name first if it has none.
defn save(state)
  b = _current(state)
  k = state.current
  if is_missing(b.path)
    _ask("Save as: ", "", (answer, s) -> _save_as(k, answer, s), state)
  else
    _store(k, b.path, false, b.disk, state)
  end
end

-- The state that ends the editor.
defn _ended(state)
  s = state
  s.ending = true
  s
end

-- The answer to the question about quitting.
_quit_if_yes(answer, state) = if answer == "y" _ended(state) else state end

-- Ends the editor, asking first if any text isn't saved.
defn quit(state)
  if length(filter(text.is_modified, state.buffers)) > 0
    _confirm("Text not saved. Quit anyway? (y or n)", _quit_if_yes, state)
  else
    _ended(state)
  end
end

-- Running a program comes later: these three only say so.
run(state) = _say("Running a program is not there yet.", state)
-- Stopping a program: not there yet.
stop(state) = _say("No program is running.", state)
-- Showing the output: not there yet.
toggle_output(state) = _say("There is no output yet.", state)

-- ---- Names, keys and events

-- The commands by name, as keys.table calls them.
names = {
  "forward_char": forward_char, "backward_char": backward_char, "next_line": next_line, "previous_line": previous_line,
  "forward_word": forward_word, "backward_word": backward_word, "line_start": line_start, "line_end": line_end,
  "page_down": page_down, "page_up": page_up, "file_start": file_start, "file_end": file_end,
  "delete_before": delete_before, "delete_after": delete_after, "cut_line": cut_line, "set_mark": set_mark,
  "select_forward_char": select_forward_char, "select_backward_char": select_backward_char,
  "select_next_line": select_next_line, "select_previous_line": select_previous_line,
  "select_line_start": select_line_start, "select_line_end": select_line_end,
  "select_page_down": select_page_down, "select_page_up": select_page_up,
  "cut": cut, "copy": copy, "paste": paste, "undo": undo, "redo": redo, "cancel": cancel,
  "tab": tab, "new_line": new_line, "save": save, "open_file": ask_file, "next_buffer": next_buffer,
  "close_buffer": close_buffer, "quit": quit, "run": run, "stop": stop, "toggle_output": toggle_output
}

-- Is a program running? Not for now.
moving(state) = false

-- The state after the command called name. Any command but C-k ends a chain of cuts.
defn _run(name, state)
  s = names[name](state)
  if name != "cut_line"
    s.chain = false
  end
  s
end

-- The chord of a key with no chord of its own that follows the first key of a pair, as the b of C-x b, or missing.
defn _second(event, state)
  if state.pending != "" and not event.ctrl and not event.alt and not event.super
    lower(event.key)
  else
    missing
  end
end

-- The state after a chord has been resolved against the pending key.
defn _chorded(chord, state)
  s = state
  s.pending = ""
  match keys.resolved(state.pending, chord)
    {pending: first} -> _pending(first, s)
    {command: name} -> _run(name, s)
    {unknown: name} -> _say("$name is not bound.", s)
  end
end

-- The state waiting for the second key of a pair.
defn _pending(first, state)
  s = state
  s.pending = first
  s.message = "$first -"
  s
end

-- The state after a key event. A key that types gives its text event the work, unless it is the second key of a pair.
defn _on_key(event, state)
  s = state
  s.message = ""
  s.buffers[state.current].free = false
  chord = keys.chord(event)
  second = if is_missing(chord) _second(event, state) else missing end
  s.chorded = event.ctrl or event.alt or not is_missing(second)
  if is_missing(chord) and is_missing(second)
    s
  else if not is_missing(state.prompt)
    _prompt_chord(if is_missing(chord) second else chord end, s)
  else
    _chorded(if is_missing(chord) second else chord end, s)
  end
end

-- The state after a text event: typed at the cursor, or into the prompt. Right after a key with Ctrl or Alt it is only the same key again.
defn _on_text(event, state)
  s = state
  was = state.chorded
  s.chorded = false
  s.chain = false
  if was
    s
  else if not is_missing(state.prompt)
    _prompt_text(event.text, s)
  else
    s.buffers[state.current].free = false
    typed(event.text, s)
  end
end

-- The state with the screen of the current buffer moved by the wheel, three lines for each notch, without moving the cursor.
defn _wheel(event, state)
  b = _current(state)
  lines = div(floor(0.0 - event.amount * 3.0 + 0.5), 1)
  b.top = min(max(1, b.top + lines), rope.line_count(b.rope))
  b.free = true
  _put(b, state)
end

-- The state after a mouse press in the code: the cursor goes under the point and a mark from the mouse starts there. On a tab, goes to it.
defn _down(event, state)
  tab = view.tab_at(event.x, event.y, state)
  if tab > 0
    s = state
    s.current = tab
    s
  else if view.is_in_code(event.x, event.y, state)
    at = view.position_at(event.x, event.y, state)
    b = text.place(at.line, at.column, _current(state))
    b.mark = b.cursor
    b.origin = "mouse"
    b.free = false
    s = _put(b, state)
    s.dragging = true
    s
  else
    state
  end
end

-- The state after the mouse moved with the button held: the cursor follows it.
defn _drag(event, state)
  at = view.position_at(event.x, event.y, state)
  _put(text.place(at.line, at.column, _current(state)), state)
end

-- The state after the button is released: a click that selected nothing leaves no mark.
defn _release(state)
  b = _current(state)
  s = state
  s.dragging = false
  if not _has_selection(b) and b.origin == "mouse"
    _put(_unmarked(b), s)
  else
    s
  end
end

-- The state after a mouse event. While a prompt is open only the wheel counts, so that the buffer can't change under a question.
defn _on_mouse(event, state)
  if event.action == "wheel"
    _wheel(event, state)
  else if not is_missing(state.prompt)
    state
  else if event.action == "down" and event.button == 1
    _down(event, state)
  else if event.action == "move" and state.dragging
    _drag(event, state)
  else if event.action == "up" and state.dragging
    _release(state)
  else
    state
  end
end

-- The state after the window closed: it asks if some text isn't saved, replacing any question that was open.
defn _on_quit(state)
  s = state
  s.prompt = missing
  quit(s)
end

-- The state with the size of the window.
defn _resized(event, state)
  s = state
  s.width = event.width
  s.height = event.height
  s
end

-- The state with the screen on the cursor and the title of the window the name of the current file.
defn settled(state)
  s = view.follow_state(state)
  name = view.buffer_name(_current(s))
  if name != s.title
    if not is_missing(s.window)
      sdl.set_title(name, s.window)
    end
    s.title = name
  end
  s
end

-- The new state after an event, or missing when the editor ends.
defn update(event, state)
  next = match event.kind
    "quit" -> _on_quit(state)
    "resize" -> _resized(event, state)
    "key" -> _on_key(event, state)
    "text" -> _on_text(event, state)
    "mouse" -> _on_mouse(event, state)
    else -> state
  end
  if next.ending missing else settled(next) end
end
