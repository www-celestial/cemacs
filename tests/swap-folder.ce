(** The other person of the check of a deletion for good in tests/folders-check.ce, one who can write the folder above the one deleted: it writes the
    file ready, waits until the folder holds fewer names than the count given, then renames it away and puts a link to another folder in its place. It
    exits with 0 once it swapped, with 2 when the folder went before, and with 3 when it stayed whole for 20 seconds. Args: the folder, the count, the
    folder the link points to, the file ready. *)
use std/result
use std/sys
use std/text as str
use std/value

folder = sys.Args[1]
count = str.Number(sys.Args[2])
target = sys.Args[3]
result.Unwrap(sys.Write(sys.Args[4], ""))
start = sys.Now()
while sys.Now() - start < 20
  names = sys.List(folder)
  if result.IsErr(names)
    sys.Exit(2)
  end
  if value.Len(names.Value) < count
    if result.IsErr(sys.Rename(folder, "$folder.moved"))
      sys.Exit(2)
    end
    result.Unwrap(sys.Symlink(target, folder))
    sys.Exit(0)
  end
end
sys.Exit(3)
