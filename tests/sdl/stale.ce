(** sdl.Frame returns the window, but a program that keeps the old value must not lose text objects, nor make new ones at each frame. *)
use std/c
use src/sdl
use std/io
use std/result

line = {Kind: "text", X: 8, Y: 8, Text: "same", Color: 0xFFFFFF}
other = {Kind: "text", X: 8, Y: 30, Text: "other", Color: 0xFFFFFF}

defn check()
  window = sdl.Open("test", 320, 200, "../../fonts/JetBrainsMono-Regular.ttf")?
  sdl.Frame([line], window)
  sdl.Frame([line], window)
  sdl.Frame([line, other], window)
  io.Print(c.Get("i64", 0, window.Objects))
  sdl.Close(window)
  result.Ok(missing)
end

io.Print(check())
