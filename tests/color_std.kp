-- Every line of every .kp file of the Kepler std goes through color.tokens, keeping the state: no line may lose a character.
-- Run from the root of kemacs with: kepler run --allow read tests/color_std.kp
use sys
use "../color"

std_folder = "../kepler/std"

defn lost_in(path, text)
  state = color.first_state
  bad = []
  for line in lines(text)
    r = color.tokens(line, state)
    state = r.state
    if join("", map(t -> t[2], r.tokens)) != line
      bad = push("$(path): $(line)", bad)
    end
  end
  bad
end

-- The states at the start of every line given by colored_to must equal the ones given by reading every line with tokens.
defn states_differ_in(path, text)
  all_lines = lines(text)
  state = color.first_state
  expected = [state]
  for line in all_lines
    state = color.tokens(line, state).state
    expected = push(state, expected)
  end
  count = length(all_lines)
  if count == 0
    []
  else
    got = color.colored_to(count, n -> all_lines[n], color.blank_colors()).starts
    if equal(got, take(count, expected)) [] else ["$(path)"] end
  end
end

-- The paths of the .kp files of the folder. No file at all is a bug of the test.
defn kp_files(folder)
  names = filter(f -> ends_with(".kp", f), unwrap(sys.list(folder)))
  if length(names) == 0
    panic("no .kp file in $(folder)")
  end
  names
end

bad = flat_map(f -> lost_in(f, unwrap(sys.read("$(std_folder)/$(f)"))), kp_files(std_folder))
if length(bad) > 0
  panic("lines that lose a character:\n$(join("\n", take(5, bad)))")
end
differ = flat_map(f -> states_differ_in(f, unwrap(sys.read("$(std_folder)/$(f)"))), kp_files(std_folder))
if length(differ) > 0
  panic("colored_to differs from tokens in:\n$(join("\n", differ))")
end
print("ok")
