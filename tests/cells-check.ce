(** Checks of the cells, as C-c e runs them, against a real session of std/cells on a file in a new folder under /tmp: a cell and the cells that read what it
    defines, their results drawn under them, an error, the variables and the rows of a viewer, *repl* with a refused definition, a stop, the blocks put back
    under their cells after an edit, and the page of the file. It is a script, not a test file: it needs permissions. Run it from the root of cemacs with
    cesia run --allow read,write,exec=mktemp,exec=rm,env=PWD --allow exec=CESIA tests/cells-check.ce, CESIA the real path of the cesia that runs it. It prints ok at the end and
    stops at the first failure. *)
use core/commands
use core/lists
use core/press
use core/text
use core/view
use src/notebook
use src/rope
use src/ui
use std/bug
use std/dict
use std/io
use std/list
use std/math
use std/result
use std/sys
use std/text as str
use std/value

defn check(condition, words)
  (** Stops the script with the words if the condition is false. *)
  if not condition
    bug.Panic("FAILED: $words")
  end
end

defn settled(state)
  (** The state once the cells stop moving, ticked as the editor ticks it, or a failure after ten seconds. *)
  s = state
  waited = 0.0
  while notebook.Moving(s)
    check(waited < 10.0, "the cells never ended")
    sys.Sleep(0.01)
    waited = waited + 0.01
    s = notebook.Hooked({}).Idle(s)
  end
  s
end

(** The words of the blocks of a buffer, line by line, each with the line it is under. *)
shown(b) = [{Line: k.Line, Words: [str.Trim(c.Text) for c in k.Draw(2000, look) if c.Kind == "text" and not str.StartsWith("Out[", str.Trim(c.Text))]} for k in text.BlocksOf(b)]
(** The labels of the blocks of a buffer, as Out[3]:, each with its row in pixels. *)
labels(b) = [[{Y: c.Y, Words: str.Trim(c.Text)} for c in k.Draw(2000, look) if c.Kind == "text" and str.StartsWith("Out[", str.Trim(c.Text))] for k in text.BlocksOf(b)]

look = ui.Look(ui.Dark, (w, f) -> value.Len(w) * 8, 19)
folder = str.Trim(result.Unwrap(sys.Run("mktemp", ["-d"])).Out)
path = "$folder/nb.ce"
source = "use std/frame\nuse std/io\n\n(* %% Data *)\nn = 3\nxs = [i * 10 for i in 1..n]\n\n(* %% Sum *)\nio.Print(\"sum\")\nxs[1] + xs[2] + xs[3]\n\n(* %% Table *)\nframe.Of({\"a\": xs})\n\n(* %% Broken *)\nnope + 1\n"
_ = result.Unwrap(sys.Write(path, source))
state = view.Start([], look, {Width: 8, Height: 19}, 1280, 720)
state = commands.OpenFile(path, state)
check(notebook.IsCells(state.Buffers[state.Current]), "a file with a marker is a file of cells")

(* C-c e a: every cell, from the top. *)
all = settled(notebook.RunAll(state))
blocks = shown(all.Buffers[all.Current])
check(value.Len(blocks) == 3, "three cells drew a result: $(blocks)")
check(blocks[1].Line == 10 and value.Equal(blocks[1].Words, ["sum", "60"]), "the sum prints and shows its value under its last line: $(blocks[1])")
check(blocks[2].Words[1] == "a" and blocks[2].Words[3] == "20" and blocks[2].Words[5] == "3 rows", "a frame shows as a table: $(blocks[2])")
marks = labels(all.Buffers[all.Current])
sumTexts = [c for c in text.BlocksOf(all.Buffers[all.Current])[1].Draw(2000, look) if c.Kind == "text"]
check(value.Equal(marks[1], [{Y: 0, Words: "Out[3]:"}]) and value.Equal(marks[2], [{Y: 0, Words: "Out[4]:"}]) and str.StartsWith("          sum", sumTexts[1].Text),
  "each result has its Out label, numbered by the runs of the session, its lines after it: $(marks)")
check(str.StartsWith("line 16: Name", blocks[3].Words[1]), "a name no cell defines is an error of the analysis: $(blocks[3])")

(* C-c e e on the cell Data: it and the cells that read xs run again. *)
data = all
data.Buffers[data.Current] = text.Place(5, 0, all.Buffers[all.Current])
again = settled(notebook.RunCell(data))
check(value.Len(shown(again.Buffers[again.Current])) == 3, "the cells that read xs ran again, and Data, which shows nothing, has no block")

(* *variables* and a viewer. *)
vars = notebook.ShowVariables(again)
rows = lists.Of(vars.Buffers[vars.Current]).Rows(vars)
check(value.Len(rows) == 2 and str.StartsWith("n ", rows[1].Words), "*variables* lists n and xs: $(rows)")
viewer = lists.Of(vars.Buffers[vars.Current]).Keys()["enter"]("xs", vars)
seen = lists.Of(viewer.Buffers[viewer.Current]).Rows(viewer)
check(value.Len(seen) == 4 and str.Contains("30", seen[4].Words), "the viewer of xs shows its rows under their numbers: $(seen)")

(* *repl*: an expression, a definition of a name a cell defines, and code that goes on. *)
repl = notebook.OpenRepl(commands.ToBuffer(1, again))
b = repl.Buffers[repl.Current]
check(view.BufferName(b) == "*repl*", "C-c e r opens *repl*")
typed = repl
typed.Buffers[typed.Current] = text.InsertWords("n * 7", b)
answered = settled(notebook.Enter(typed))
words = rope.Text(answered.Buffers[answered.Current].Rope)
check(str.Contains("\n21\n> ", words), "*repl* shows the value of n * 7: $(words)")
redefine = answered
redefine.Buffers[redefine.Current] = text.InsertWords("n = 9", answered.Buffers[answered.Current])
refused = settled(notebook.Enter(redefine))
check(str.Contains("n is defined by the cell \"Data\"", rope.Text(refused.Buffers[refused.Current].Rope)), "*repl* refuses a name a cell defines")
open = refused
open.Buffers[open.Current] = text.InsertWords("if true", refused.Buffers[refused.Current])
check(str.EndsWith("if true\n. ", rope.Text(notebook.Enter(open).Buffers[open.Current].Rope)), "a block not ended goes on on the next line")

(* A stop, then the blocks put back under their cells after a line is added above them. *)
long = again
long.Buffers[long.Current] = text.Place(17, 0, text.InsertWords("(* %% Slow *)\nk = 0\nwhile true\n  k = k + 1\nend\n", text.Place(17, 0, again.Buffers[again.Current])))
running = notebook.RunCell(long)
sys.Sleep(0.3)
running = notebook.Hooked({}).Idle(running)
stop = settled(notebook.StopCell(running))
slow = list.Filter(x -> x.Line >= 17, shown(stop.Buffers[stop.Current]))
check(value.Len(slow) == 1 and value.Equal(slow[1].Words, ["Stopped."]), "C-c e s stops the cell that runs: $(slow)")
moved = stop
moved.Buffers[moved.Current] = text.InsertWords("\n", text.Place(1, 0, stop.Buffers[stop.Current]))
moved.Still = 1.0
rested = notebook.Hooked({}).Idle(moved)
check(shown(rested.Buffers[rested.Current])[1].Line == 11, "a line added above moves the results with their cells")

(* A graph of std/plot under its cell, drawn by sdl from its scene at the width of the pane, or its own 640 when the pane is wider, with the shape of
   its own size, 640 by 400; and again when that width changes. *)
shaped(g, want) = g.Scene.Width == list.Min(640, want) and math.Abs(g.Scene.Height - g.Scene.Width * 0.625) <= 0.5 and g.Asked == want
plotted = again
plotted.Buffers[plotted.Current] = text.InsertWords("\n(* %% Plot *)\nuse std/plot\nplot.Line([1, 2, 3], [1, 4, 9])\n", text.ToFileEnd(again.Buffers[again.Current]))
plotted = settled(notebook.RunCell(plotted))
graphs = [x for x in text.BlocksOf(plotted.Buffers[plotted.Current]) if value.IsSome(dict.GetOr("Graph", missing, x))]
check(value.Len(graphs) == 1 and shaped(graphs[1].Graph, notebook.GraphWidth(plotted)), "a graph shows under its cell at the width of the pane, at most its own, with its shape")
drawn = [c for c in graphs[1].Draw(1000, look) if c.Kind == "graph"]
check(value.Len(drawn) == 1 and value.Len(drawn[1].Items) > 10 and value.IsNumber(drawn[1].Items[1].Color), "the block draws the scene, its colors as numbers")
narrow = plotted
narrow.Width = 600
check(notebook.Moving(narrow), "a graph whose pane changed its width asks for ticks")
narrowed = settled(narrow)
again2 = [x for x in text.BlocksOf(narrowed.Buffers[narrowed.Current]) if value.IsSome(dict.GetOr("Graph", missing, x))]
check(shaped(again2[1].Graph, notebook.GraphWidth(narrowed)) and notebook.GraphWidth(narrowed) < 640, "the graph is drawn again at the new width, narrower than its own, with its shape")
(* cells.Show: a graph, a text and the value's graph of one cell, in their order, each graph with its key, and both drawn again at a new width. *)
showing = narrowed
showing.Buffers[showing.Current] = text.InsertWords("\n(* %% Two *)\nuse std/cells\nio.Print(\"first\")\ncells.Show(plot.Line([1, 2], [2, 1]))\nio.Print(\"then\")\ncells.Show(9)\nplot.Line([1, 2], [1, 2])\n",
  text.ToFileEnd(narrowed.Buffers[narrowed.Current]))
showing = settled(notebook.RunCell(showing))
partsOf = st -> [x for x in text.BlocksOf(st.Buffers[st.Current]) if dict.GetOr("Cell", 0, x) == dict.GetOr("Cell", 0, list.Last(text.BlocksOf(st.Buffers[st.Current])))]
two = partsOf(showing)
twoWords = [[str.Trim(c.Text) for c in x.Draw(2000, look) if c.Kind == "text" and not str.StartsWith("Out[", str.Trim(c.Text))] for x in two]
check(value.Len(two) == 2 and value.Equal(twoWords, [["first"], ["then", "9"]]) and value.IsSome(dict.GetOr("Graph", missing, two[1])) and value.IsSome(dict.GetOr("Graph", missing, two[2])) and
  not value.Equal(two[1].Graph.Key, two[2].Graph.Key), "cells.Show draws its parts in order, each graph with its key: $(twoWords)")
wide = showing
wide.Width = 1100
wide = settled(wide)
check(list.All([shaped(x.Graph, notebook.GraphWidth(wide)) for x in partsOf(wide)]) and notebook.GraphWidth(wide) != notebook.GraphWidth(showing), "both graphs of the cell are drawn again at the new width")
prompt = notebook.OpenRepl(commands.ToBuffer(1, wide))
drawing = prompt
drawing.Buffers[drawing.Current] = text.InsertWords("plot.Of([plot.Line([1, 2], [3, 4])], title = \"In the prompt\")", prompt.Buffers[prompt.Current])
shownGraph = settled(notebook.Enter(drawing))
check(value.Len([x for x in text.BlocksOf(shownGraph.Buffers[shownGraph.Current]) if value.IsSome(dict.GetOr("Graph", missing, x))]) == 1, "*repl* draws a graph under its answer")

(* C-c e h: the page beside the file, from the file as saved. *)
page = settled(notebook.WriteHtml(again))
html = result.Unwrap(sys.Read("$folder/nb.html"))
check(str.Contains("<h2>Sum</h2>", html) and str.Contains("<pre class=\"output\">sum</pre>", html), "the page has the cells and what they printed")

(* A page there already is asked about first, and n leaves it; a link there, as a folder from elsewhere can bring one, is replaced by the page after y,
   never written through: the file it pointed to stays as it was. *)
asked = notebook.WriteHtml(again)
check(not value.IsMissing(asked.Prompt) and asked.Prompt.Label == "nb.html exists. Replace it? (y or n) ", "a page there is asked about: $(asked.Message)")
check(press.Press(["n"], asked).Message == "Nothing done." and result.Unwrap(sys.Read("$folder/nb.html")) == html, "n leaves the page")
decoy = "$folder/decoy"
_ = result.Unwrap(sys.Write(decoy, "my precious file\n"))
_ = result.Unwrap(sys.Remove("$folder/nb.html"))
_ = result.Unwrap(sys.Symlink(decoy, "$folder/nb.html"))
linked = settled(press.Press(["y"], notebook.WriteHtml(again)))
check(result.Unwrap(sys.Read(decoy)) == "my precious file\n", "the file the link pointed to is left as it was: $(linked.Message)")
check(result.IsErr(sys.ReadLink("$folder/nb.html")) and result.Unwrap(sys.Read("$folder/nb.html")) == html, "the page takes the place of the link")
_ = result.Unwrap(sys.Run("rm", ["-r", folder]))
io.Print("ok")
