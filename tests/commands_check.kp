-- Checks of commands.kp against real files, in a new folder under /tmp. It is a script, not a test file: it needs permissions.
-- Run it with kepler run --allow read,write tests/commands_check.kp. It prints ok at the end and stops at the first failure.
use rope
use sys
use ui
use "../commands"
use "../press"
use "../text"
use "../view"

-- Stops the script with the words if the condition is false.
defn check(condition, words)
  if not condition
    panic("FAILED: $words")
  end
end

look = ui.look(ui.dark, (words, font) -> length(words) * 8, 19)
cell = {width: 8, height: 19}

-- A state with one empty buffer and no window.
fresh() = view.start([text.of("", missing)], look, cell, 800, 600)
here(state) = state.buffers[state.current]
words_of(state) = rope.text(here(state).rope)

-- The text of a file, or panics.
read(path) = unwrap(sys.read(path))
-- Writes a file for the checks.
write(path, words) = unwrap(sys.write(path, words))

folder = "/tmp/kemacs-commands-check-$(text(sys.now()))"
check(is_ok(sys.mkdir(folder)), "the folder is made")
a_path = "$folder/a.kp"
b_path = "$folder/b.kp"
write(a_path, "one\ntwo\n")
write(b_path, "bee\n")

-- Opening a file gives a buffer with its text and path, and the person in it.
s = commands.open_file(a_path, fresh())
check(length(s.buffers) == 2 and s.current == 2, "a new buffer for the file")
check(words_of(s) == "one\ntwo\n" and here(s).path == a_path, "the buffer has the text and the path")
check(not text.is_modified(here(s)), "a buffer just read is not modified")

-- The same file twice, written another way, is one buffer.
twice = commands.open_file("$folder/./a.kp", commands.open_file(b_path, s))
check(length(twice.buffers) == 3 and twice.current == 2, "the same file opened again goes to its buffer")
check(length(commands.open_file(a_path, s).buffers) == 2, "the same path again opens nothing")

-- Two buffers keep their own cursor and undo.
two = press.press(["C-n", "C-e", "x"], twice)
check(words_of(two) == "one\ntwox\n", "typing in the first file")
two = press.press(["C-x", "b"], two)
check(here(two).path == b_path, "next buffer")
two = press.press(["C-e", "y"], two)
check(words_of(two) == "beey\n", "typing in the second file")
two = press.press(["C-/"], two)
check(words_of(two) == "bee\n", "undo in the second buffer")
two = press.press(["C-x", "b", "C-x", "b"], two)
check(here(two).path == a_path and here(two).cursor == {line: 2, column: 4} and words_of(two) == "one\ntwox\n", "the first buffer kept its cursor and its text")
two = press.press(["C-/"], two)
check(words_of(two) == "one\ntwo\n", "undo in the first buffer")

-- Find file: the prompt starts with the folder of the current file, and Enter opens the answer.
asked = press.press(["C-x", "C-f"], commands.open_file(a_path, fresh()))
check(asked.prompt.answer == "$folder/", "the prompt starts with the folder")
opened = press.press(["b.kp", "enter"], asked)
check(here(opened).path == "$folder/b.kp" and is_missing(opened.prompt) and words_of(opened) == "bee\n", "Enter opens the file of the answer")

-- A file that doesn't exist opens as an empty buffer, and is created by the first save.
new_path = "$folder/new.kp"
made = commands.open_file(new_path, fresh())
check(words_of(made) == "" and here(made).path == new_path, "a missing file opens empty")
made = press.press(["h", "i", "C-x", "C-s"], made)
check(read(new_path) == "hi" and not text.is_modified(here(made)), "the first save creates the file")
check(contains("Saved", made.message), "the save says so")

-- A file that is not text is not opened, and the message says why.
write("$folder/bin.dat", "a$(from_bytes([0]))b")
bad = commands.open_file("$folder/bin.dat", fresh())
check(length(bad.buffers) == 1 and contains("not valid UTF-8", bad.message), "a file with a zero byte is refused")
check(length(commands.open_file(folder, fresh()).buffers) == 1, "a folder is refused")

-- Several files at the start: the empty buffer makes room and the first file is current.
all = commands.open_all([a_path, b_path], fresh())
check(length(all.buffers) == 2 and all.current == 1 and here(all).path == a_path, "open_all")
check(length(commands.open_all([], fresh()).buffers) == 1, "no file keeps the empty buffer")
check(length(commands.open_all(["$folder/none-1.kp"], fresh()).buffers) == 1 and words_of(commands.open_all(["$folder/none-1.kp"], fresh())) == "", "a missing file at the start opens empty")

-- Saving: C-x C-s writes the file, and the star goes.
edited = press.press(["C-e", "!", "C-x", "C-s"], commands.open_file(b_path, fresh()))
check(read(b_path) == "bee!\n" and not text.is_modified(here(edited)) and is_missing(edited.prompt), "C-x C-s writes the file")

-- Save as: a buffer with no path asks for one, and gets it only when the save works.
loose = press.press(["z", "C-x", "C-s"], fresh())
check(loose.prompt.label == "Save as: ", "a buffer with no path asks")
saved = press.press(["$folder/loose.kp", "enter"], loose)
check(read("$folder/loose.kp") == "z" and here(saved).path == "$folder/loose.kp" and not text.is_modified(here(saved)), "save as writes the file and names the buffer")
failed = press.press(["$folder/nodir/x.kp", "enter"], loose)
check(is_missing(here(failed).path) and text.is_modified(here(failed)) and failed.message != "", "a failed save as keeps the text modified, with a message")
empty_name = press.press(["enter"], loose)
check(is_missing(empty_name.prompt) and is_missing(here(empty_name).path), "an empty name saves nothing")
over = press.press(["$folder/a.kp", "enter"], loose)
check(over.prompt.label == "File changed on disk. Overwrite? (y or n)" and read(a_path) == "one\ntwo\n", "save as over a file asks")
over = press.press(["n"], over)
check(read(a_path) == "one\ntwo\n" and text.is_modified(here(over)) and is_missing(over.prompt), "n keeps the file")

-- A file changed on disk: the save asks, n leaves it, y writes over it.
mine = press.press(["C-e", "?"], commands.open_file(b_path, fresh()))
write(b_path, "theirs\n")
asked = press.press(["C-x", "C-s"], mine)
check(asked.prompt.label == "File changed on disk. Overwrite? (y or n)" and read(b_path) == "theirs\n", "a changed file asks before writing")
check(press.press(["q"], asked).prompt.label == asked.prompt.label, "another key does not answer")
refused = press.press(["n"], asked)
check(read(b_path) == "theirs\n" and text.is_modified(here(refused)) and is_missing(refused.prompt), "n keeps the file of the disk")
cancelled = press.press(["C-g"], asked)
check(read(b_path) == "theirs\n" and is_missing(cancelled.prompt), "C-g keeps the file of the disk")
forced = press.press(["y"], asked)
check(read(b_path) == "bee!?\n" and not text.is_modified(here(forced)), "y writes over the file")
again = press.press(["C-e", "1", "C-x", "C-s"], forced)
check(read(b_path) == "bee!?1\n" and is_missing(again.prompt), "after y the next save does not ask")

-- A save that fails keeps the text modified.
blocked = commands.open_file(a_path, fresh())
blocked.buffers[blocked.current].path = "$folder/nodir/a.kp"
blocked.buffers[blocked.current].disk = missing
blocked = press.press(["x", "C-x", "C-s"], blocked)
check(text.is_modified(here(blocked)) and blocked.message != "" and words_of(blocked) == "xone\ntwo\n", "a failed save keeps the text and says why")

-- Closing a modified buffer asks; a file buffer closes to its neighbour.
dirty = press.press(["x"], commands.open_file(a_path, commands.open_file(b_path, fresh())))
asked = press.press(["C-x", "k"], dirty)
check(length(asked.buffers) == 3 and asked.prompt.label == "Text not saved. Close anyway? (y or n)", "closing a modified file buffer asks")
closed = press.press(["y"], asked)
check(length(closed.buffers) == 2 and here(closed).path == b_path, "y closes it")

-- The title follows the current buffer.
check(commands.settled(commands.open_file(a_path, fresh())).title == "a.kp", "the title is the name of the file")

print("ok")
