(** Checks of src/git against the real git, in a repository made in a new folder under /tmp: the state and its letters, stage, unstage, a commit, the
    log, a commit shown, the diff of a file and the blame of a buffer not saved. A file named as an option and a message that reads as one stay a name and a
    message. It is a script, not a test file: it needs permissions. tests/run.sh runs it with cesia run --allow read,write,exec=git,exec=rm,env=PWD. It
    prints ok at the end and stops at the first failure. *)
use src/emacs
use src/git
use src/rope
use src/ui
use core/commands
use core/lists
use core/press
use core/text
use core/view
use std/bug
use std/dict
use std/io
use std/list
use std/result
use std/sys
use std/text as str
use std/value

defn expect(condition, words)
  (** Stops the script with the words if the condition is false. *)
  if not condition
    bug.Panic("FAILED: $words")
  end
end

look = ui.Look(ui.Dark, (words, font) -> value.Len(words) * 8, 19)
cell = {Width: 8, Height: 19}
gitConfig() = emacs.Config(() -> dict.Merge(emacs.Keys(), git.Keys()))
here(state) = state.Buffers[state.Current]
rows(state) = str.Lines(rope.Text(here(state).Rope))

defn run(args)
  (** git in the folder, which must work: its output. *)
  ran = result.Unwrap(sys.Run("git", list.Concat(["-C", folder], args)))
  expect(ran.Code == 0, "git $(str.Join(" ", args)): $(ran.Err)")
  ran.Out
end

folder = "/tmp/cemacs-git-check-$(value.Text(sys.Now()))"
result.Unwrap(sys.Mkdir(folder))
_ = run(["init", "-q", "-b", "main"])
_ = run(["config", "user.email", "t@example.com"])
_ = run(["config", "user.name", "Tester"])
result.Unwrap(sys.Write("$folder/a.ce", "x = 1\ny = 2\n"))
_ = run(["add", "a.ce"])
_ = run(["commit", "-q", "-m", "first"])
result.Unwrap(sys.Write("$folder/a.ce", "x = 1\ny = 3\n"))
result.Unwrap(sys.Write("$folder/--oops.ce", "z = 1\n"))

start = view.Start([text.Of("", missing)], look, cell, 800, 600)
start.Config = gitConfig
opened = commands.OpenFile("$folder/a.ce", start)

(* C-x g lists the branch with the letters, then the changed file and the new one. *)
status = press.Press(["C-x", "g"], opened)
expect(lists.IsList(here(status)) and value.Equal(list.Skip(1, rows(status)), ["changed   a.ce", "new       --oops.ce"]), "the state: $(rows(status)) $(status.Message)")
expect(str.StartsWith("On main    s stage", rows(status)[1]), "the first row: $(rows(status)[1])")
expect(press.Press(["x"], status).Message == "s stage  u unstage  c commit  d diff  l log  g refresh  Enter open", "another letter says them")

(* s stages the file of the row, a name that reads as an option too; u unstages it. *)
staged = press.Press(["down", "s", "down", "s"], status)
expect(value.Equal(list.Skip(1, rows(staged)), ["staged    --oops.ce", "staged    a.ce"]), "both staged: $(rows(staged)) $(staged.Message)")
back = press.Press(["up", "u"], staged)
expect(str.Contains("new       --oops.ce", rope.Text(here(back).Rope)), "unstaged: $(rows(back))")
again = press.Press(["down", "s"], back)

(* d shows the diff of the row; Enter on a line of the new side opens the file there. *)
diff = press.Press(["down", "down", "d"], again)
expect(lists.IsList(here(diff)) and "+y = 3" in rows(diff), "the diff: $(rows(diff)) $(diff.Message)")

(* c commits what is staged, with a message that reads as an option, then shows the state again. *)
committed = press.Press(["c", "--amend", "enter"], again)
expect(committed.Message == "Committed: --amend" and value.Len(rows(committed)) == 1, "committed: $(committed.Message) $(rows(committed))")
expect(str.Contains("--amend", run(["log", "--format=%s"])) and str.Contains("first", run(["log", "--format=%s"])), "two commits: $(run(["log", "--format=%s"]))")

(* l lists the log, Enter shows a commit. *)
log = press.Press(["l"], committed)
expect(value.Len(rows(log)) == 2 and str.EndsWith("Tester  --amend", rows(log)[1]), "the log: $(rows(log))")
shown = press.Press(["enter"], log)
expect(lists.IsList(here(shown)) and list.Any([str.Contains("--oops.ce", r) for r in rows(shown)]), "the commit: $(rows(shown))")

(* C-c g b: the blame of the buffer, its text not saved too; C-c g d: the diff of its file. *)
edited = opened
edited.Buffers[edited.Current] = text.InsertWords("w = 0\n", text.Place(1, 0, here(edited)))
blame = press.Press(["C-c", "g", "b"], edited)
expect(lists.IsList(here(blame)) and value.Len(rows(blame)) == 3 and str.StartsWith("00000000", rows(blame)[1]), "the blame: $(rows(blame)) $(blame.Message)")
expect(press.Press(["M-<", "enter"], blame).Message == "These lines aren't committed yet.", "a line not committed")
result.Unwrap(sys.Write("$folder/a.ce", "x = 9\ny = 3\n"))
fileDiff = press.Press(["C-c", "g", "d"], opened)
expect(lists.IsList(here(fileDiff)) and "+x = 9" in rows(fileDiff), "the diff of the file: $(rows(fileDiff)) $(fileDiff.Message)")

_ = sys.Run("rm", ["-rf", folder])
io.Print("ok")
