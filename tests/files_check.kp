-- Checks of files.kp against real files, in a new folder under /tmp. It is a script, not a test file: it needs permissions.
-- Run it with kepler run --allow read,write tests/files_check.kp. It prints ok at the end and stops at the first failure.
use sys
use "../files"

-- Stops the script with the words if the condition is false.
defn check(condition, words)
  if not condition
    panic("FAILED: $words")
  end
end

-- The kind of the error of a result, or "ok" for an Ok.
kind_of(r) = if is_err(r) r.error.kind else "ok" end

-- The names in the folder, in one text: lists compare element by element in Kepler, so a text is the way to compare them.
names(folder) = join(",", unwrap(sys.list(folder)))

-- Is there a folder at this path?
folder_at(path) = sys.exists(path) and unwrap(sys.stat(path)).is_dir

-- The bytes of a text, in one text.
byte_text(words) = join(",", [text(b) for b in bytes(words)])

folder = "/tmp/kemacs-files-check-$(text(sys.now()))"
check(is_ok(sys.mkdir(folder)), "the folder is made")
target = "$folder/a.kp"

-- A file that doesn't exist reads as "" with disk missing.
gone = files.read_file("$folder/none.kp")
check(is_ok(gone), "missing file is Ok")
check(unwrap(gone).words == "" and is_missing(unwrap(gone).disk), "missing file reads as empty with disk missing")

-- Save a new file, then read it back.
saved = files.save_file(target, "héllo\nworld\n", missing)
check(is_ok(saved), "saving a new file")
back = unwrap(files.read_file(target))
check(back.words == "héllo\nworld\n", "save then read gives the same words")
check(back.disk == unwrap(saved), "the disk after saving is the disk of a read")
check(names(folder) == "a.kp", "saving leaves no other file in the folder")

-- Saving a new file where a file has appeared in the meantime.
check(kind_of(files.save_file(target, "mine", missing)) == "changed", "a new file over a file that appeared is refused")
check(unwrap(sys.read(target)) == "héllo\nworld\n", "the file that appeared stays as it was")

-- A file changed after reading. A different size is a different disk even within one tick of the clock.
other = "$folder/b.kp"
unwrap(files.force_save(other, "one"))
read_b = unwrap(files.read_file(other))
unwrap(sys.write(other, "two2"))
refused = files.save_file(other, "mine", read_b.disk)
check(kind_of(refused) == "changed", "a file changed after reading gives Err of kind changed")
check(unwrap(sys.read(other)) == "two2", "the changed file stays as it was")
check(names(folder) == "a.kp,b.kp", "a refused save leaves no other file")

-- Saving with the right disk works, and gives the next disk.
ok_save = files.save_file(other, "fresh", unwrap(files.read_file(other)).disk)
check(is_ok(ok_save), "saving with the right disk")
check(unwrap(sys.read(other)) == "fresh", "the new words are in the file")
check(unwrap(ok_save) == unwrap(files.read_file(other)).disk, "the new disk is the one of the file")

-- A file removed after reading: saving is refused, force_save writes it again.
unwrap(sys.remove(other))
check(kind_of(files.save_file(other, "x", unwrap(ok_save))) == "changed", "a file that vanished is refused")
check(is_ok(files.force_save(other, "again")), "force_save writes over anything")
check(unwrap(sys.read(other)) == "again", "force_save wrote the words")

-- A failed write leaves the old file whole: here the target is in a folder that doesn't exist.
bad = "$folder/nodir/c.kp"
check(is_err(files.save_file(bad, "x", missing)), "saving in a folder that doesn't exist fails")
check(is_err(files.force_save(bad, "x")), "force_save in a folder that doesn't exist fails")
check(names(folder) == "a.kp,b.kp", "a failed save leaves nothing behind")

-- A failed rename leaves the old file whole: the target is a folder.
unwrap(sys.mkdir("$folder/sub"))
check(is_err(files.force_save("$folder/sub", "x")), "saving over a folder fails")
check(names(folder) == "a.kp,b.kp,sub", "a failed rename removes the new file")
check(is_err(files.read_file("$folder/sub")), "reading a folder fails")
check(is_err(files.save_file("$folder/sub", "x", missing)), "saving over a folder with disk missing fails")
unwrap(sys.remove("$folder/sub"))

-- A person's file named like the old temporary file is never touched, by a save, by a failed save or by the cleanup.
old_name = "$folder/a.kp.kemacs-new"
unwrap(sys.write(old_name, "precious"))
unwrap(files.force_save(target, "after"))
check(unwrap(sys.read(old_name)) == "precious", "a file named a.kp.kemacs-new keeps its content after a save")
check(names(folder) == "a.kp,a.kp.kemacs-new,b.kp", "a save leaves no new file")
unwrap(sys.mkdir("$folder/sub"))
unwrap(sys.write("$folder/sub.kemacs-new", "mine"))
check(is_err(files.force_save("$folder/sub", "x")), "saving over a folder fails again")
check(unwrap(sys.read("$folder/sub.kemacs-new")) == "mine", "a failed save removes nothing it didn't create")
check(names(folder) == "a.kp,a.kp.kemacs-new,b.kp,sub,sub.kemacs-new", "a failed save leaves nothing of its own")
unwrap(sys.remove("$folder/sub.kemacs-new"))
unwrap(sys.remove("$folder/sub"))
unwrap(sys.remove(old_name))
unwrap(sys.mkdir(old_name))
check(is_ok(files.force_save(target, "again2")), "an empty folder named like the old temporary file is no obstacle")
check(folder_at(old_name), "the empty folder is still there")
unwrap(sys.remove(old_name))

-- CRLF: read then save gives the same bytes.
crlf = "a\r\nb\r\n"
unwrap(sys.write(target, crlf))
r = unwrap(files.read_file(target))
check(r.words == crlf, "CRLF is read as it is")
unwrap(files.save_file(target, r.words, r.disk))
check(byte_text(unwrap(sys.read(target))) == byte_text(crlf), "CRLF: the same bytes after a save")

-- A file with a zero byte, and one that is not UTF-8, give an Err and are not touched.
zero = "$folder/zero"
unwrap(sys.write(zero, from_bytes([97, 0, 98])))
check(is_err(files.read_file(zero)), "a zero byte gives an Err")
latin = "$folder/latin"
unwrap(sys.write(latin, from_bytes([99, 97, 102, 233])))
check(is_err(files.read_file(latin)), "Latin-1 gives an Err")
check(byte_text(unwrap(sys.read(latin))) == "99,97,102,233", "the refused file stays as it was")

-- is_text.
check(files.is_text(""), "empty is text")
check(files.is_text("plain ascii\r\n"), "ascii is text")
check(files.is_text("é€😀"), "valid UTF-8 is text")
check(not files.is_text(from_bytes([97, 0])), "zero byte")
check(not files.is_text(from_bytes([255])), "0xff")
check(not files.is_text(from_bytes([0xc3])), "cut sequence at the end")
check(not files.is_text(from_bytes([0xc3, 0x41])), "lead followed by a letter")
check(not files.is_text(from_bytes([0x80])), "lone continuation")
check(not files.is_text(from_bytes([0xc0, 0x80])), "overlong two bytes")
check(not files.is_text(from_bytes([0xe0, 0x80, 0x80])), "overlong three bytes")
check(not files.is_text(from_bytes([0xed, 0xa0, 0x80])), "surrogate")
check(not files.is_text(from_bytes([0xf4, 0x90, 0x80, 0x80])), "above U+10FFFF")
check(not files.is_text(from_bytes([0xf8, 0x88, 0x80, 0x80, 0x80])), "five bytes")
check(files.is_text(from_bytes([0xf4, 0x8f, 0xbf, 0xbf])), "U+10FFFF")

-- normal.
check(files.normal("./a/../b.kp") == "b.kp", "normal of ./a/../b.kp")
check(files.normal("a//b/./c/") == "a/b/c", "normal of doubled and trailing slashes")
check(files.normal("/a/b/../../c") == "/c", "normal of an absolute path")
check(files.normal("../a/../../b") == "../../b", "normal keeps leading ..")
check(files.normal("/../a") == "/a", "normal drops .. above the root")
check(files.normal("a/..") == ".", "normal of nothing is a dot")
check(files.normal("/") == "/", "normal of the root")
check(files.normal("x.kp") == "x.kp", "normal of a plain name")

-- Clean up.
for name in unwrap(sys.list(folder))
  unwrap(sys.remove("$folder/$name"))
end
unwrap(sys.remove(folder))
check(not sys.exists(folder), "the folder is gone")
print("ok")
