(** Checks of files.ce against real files, in a new folder under /tmp. It is a script, not a test file: it needs permissions.
    Run it with cesia run --allow read,write,exec=mkfifo,exec=truncate tests/files-check.ce. It prints ok at the end and stops at the first failure. *)
use std/sys
use core/files
use std/text as str
use std/bug
use std/io
use std/result
use std/value

defn check(condition, words)
  (** Stops the script with the words if the condition is false. *)
  if not condition
    bug.Panic("FAILED: $words")
  end
end

kindOf(r) = if result.IsErr(r) r.Error.Kind else "ok" end   (** The kind of the error of a result, or "ok" for an Ok. *)

(** The names in the folder, in one text: lists compare element by element in Cesia, so a text is the way to compare them. *)
names(folder) = str.Join(",", result.Unwrap(sys.List(folder)))

(** Is there a folder at this path? *)
folderAt(path) = sys.Exists(path) and result.Unwrap(sys.Stat(path)).IsDir

byteText(words) = str.Join(",", [value.Text(b) for b in str.Bytes(words)])   (** The bytes of a text, in one text. *)

folder = "/tmp/cemacs-files-check-$(value.Text(sys.Now()))"
check(result.IsOk(sys.Mkdir(folder)), "the folder is made")
target = "$folder/a.ce"

(* A file that doesn't exist reads as "" with disk missing. *)
gone = files.ReadFile("$folder/none.ce")
check(result.IsOk(gone), "missing file is Ok")
check(result.Unwrap(gone).Words == "" and value.IsMissing(result.Unwrap(gone).Disk), "missing file reads as empty with disk missing")

(* Save a new file, then read it back. *)
saved = files.SaveFile(target, "héllo\nworld\n", missing)
check(result.IsOk(saved), "saving a new file")
back = result.Unwrap(files.ReadFile(target))
check(back.Words == "héllo\nworld\n", "save then read gives the same words")
check(back.Disk == result.Unwrap(saved), "the disk after saving is the disk of a read")
check(names(folder) == "a.ce", "saving leaves no other file in the folder")

(** Saving a new file where a file has appeared in the meantime. *)
check(kindOf(files.SaveFile(target, "mine", missing)) == "changed", "a new file over a file that appeared is refused")
check(result.Unwrap(sys.Read(target)) == "héllo\nworld\n", "the file that appeared stays as it was")

(* A file changed after reading. A different size is a different disk even within one tick of the clock. *)
other = "$folder/b.ce"
result.Unwrap(files.ForceSave(other, "one"))
readB = result.Unwrap(files.ReadFile(other))
result.Unwrap(sys.Write(other, "two2"))
refused = files.SaveFile(other, "mine", readB.Disk)
check(kindOf(refused) == "changed", "a file changed after reading gives Err of kind changed")
check(result.Unwrap(sys.Read(other)) == "two2", "the changed file stays as it was")
check(names(folder) == "a.ce,b.ce", "a refused save leaves no other file")

(* Saving with the right disk works, and gives the next disk. *)
okSave = files.SaveFile(other, "fresh", result.Unwrap(files.ReadFile(other)).Disk)
check(result.IsOk(okSave), "saving with the right disk")
check(result.Unwrap(sys.Read(other)) == "fresh", "the new words are in the file")
check(result.Unwrap(okSave) == result.Unwrap(files.ReadFile(other)).Disk, "the new disk is the one of the file")

result.Unwrap(sys.Remove(other))   (** A file removed after reading: saving is refused, force_save writes it again. *)
check(kindOf(files.SaveFile(other, "x", result.Unwrap(okSave))) == "changed", "a file that vanished is refused")
check(result.IsOk(files.ForceSave(other, "again")), "force_save writes over anything")
check(result.Unwrap(sys.Read(other)) == "again", "force_save wrote the words")

(* A failed write leaves the old file whole: here the target is in a folder that doesn't exist. *)
bad = "$folder/nodir/c.ce"
check(result.IsErr(files.SaveFile(bad, "x", missing)), "saving in a folder that doesn't exist fails")
check(result.IsErr(files.ForceSave(bad, "x")), "force_save in a folder that doesn't exist fails")
noFolder = files.ForceSave(bad, "x").Error.Message
check(str.Contains(bad, noFolder) and not str.Contains(".cemacs-", noFolder), "a failed write names the file, not the new one: $noFolder")
check(names(folder) == "a.ce,b.ce", "a failed save leaves nothing behind")

result.Unwrap(sys.Mkdir("$folder/sub"))   (** A failed rename leaves the old file whole: the target is a folder. *)
check(result.IsErr(files.ForceSave("$folder/sub", "x")), "saving over a folder fails")
overFolder = files.ForceSave("$folder/sub", "x").Error.Message
check(str.Contains("$folder/sub", overFolder) and not str.Contains(".cemacs-", overFolder), "a failed rename names the file, not the new one: $overFolder")
check(names(folder) == "a.ce,b.ce,sub", "a failed rename removes the new file")
check(result.IsErr(files.ReadFile("$folder/sub")), "reading a folder fails")
check(result.IsErr(files.SaveFile("$folder/sub", "x", missing)), "saving over a folder with disk missing fails")
result.Unwrap(sys.Remove("$folder/sub"))

(* A person's file named like the old temporary file is never touched, by a save, by a failed save or by the cleanup. *)
oldName = "$folder/a.ce.cemacs-new"
result.Unwrap(sys.Write(oldName, "precious"))
result.Unwrap(files.ForceSave(target, "after"))
check(result.Unwrap(sys.Read(oldName)) == "precious", "a file named a.ce.cemacs-new keeps its content after a save")
check(names(folder) == "a.ce,a.ce.cemacs-new,b.ce", "a save leaves no new file")
result.Unwrap(sys.Mkdir("$folder/sub"))
result.Unwrap(sys.Write("$folder/sub.cemacs-new", "mine"))
check(result.IsErr(files.ForceSave("$folder/sub", "x")), "saving over a folder fails again")
check(result.Unwrap(sys.Read("$folder/sub.cemacs-new")) == "mine", "a failed save removes nothing it didn't create")
check(names(folder) == "a.ce,a.ce.cemacs-new,b.ce,sub,sub.cemacs-new", "a failed save leaves nothing of its own")
result.Unwrap(sys.Remove("$folder/sub.cemacs-new"))
result.Unwrap(sys.Remove("$folder/sub"))
result.Unwrap(sys.Remove(oldName))
result.Unwrap(sys.Mkdir(oldName))
check(result.IsOk(files.ForceSave(target, "again2")), "an empty folder named like the old temporary file is no obstacle")
check(folderAt(oldName), "the empty folder is still there")
result.Unwrap(sys.Remove(oldName))

(* CRLF: read then save gives the same bytes. *)
crlf = "a\r\nb\r\n"
result.Unwrap(sys.Write(target, crlf))
r = result.Unwrap(files.ReadFile(target))
check(r.Words == crlf, "CRLF is read as it is")
result.Unwrap(files.SaveFile(target, r.Words, r.Disk))
check(byteText(result.Unwrap(sys.Read(target))) == byteText(crlf), "CRLF: the same bytes after a save")

(* A file with a zero byte, and one that is not UTF-8, give an Err and are not touched. *)
zero = "$folder/zero"
result.Unwrap(sys.Write(zero, str.FromBytes([97, 0, 98])))
check(result.IsErr(files.ReadFile(zero)), "a zero byte gives an Err")
latin = "$folder/latin"
result.Unwrap(sys.Write(latin, str.FromBytes([99, 97, 102, 233])))
check(result.IsErr(files.ReadFile(latin)), "Latin-1 gives an Err")
check(byteText(result.Unwrap(sys.Read(latin))) == "99,97,102,233", "the refused file stays as it was")

(* A file over 1 GiB is refused from its size alone, as an Err: reading one too large for memory would panic and lose the text of the other buffers.
   truncate makes it sparse, a size with no bytes on the disk. *)
large = "$folder/large"
check(result.Unwrap(sys.Run("truncate", ["-s", "1073741825", large])).Code == 0, "the large file is made")
tooLarge = files.ReadFile(large)
check(kindOf(tooLarge) == "large", "a file over the limit gives an Err of kind large")
check(str.Contains(large, tooLarge.Error.Message) and str.Contains("too large", tooLarge.Error.Message), "the message names the file and says why")
result.Unwrap(sys.Remove(large))

(* What isn't a regular file is refused from sys.Stat, before any read: reading a FIFO waits for a writer that never comes, and /dev/zero never ends and fills the memory. *)
fifo = "$folder/pipe"
check(result.Unwrap(sys.Run("mkfifo", [fifo])).Code == 0, "the FIFO is made")
pipe = files.ReadFile(fifo)
check(kindOf(pipe) == "special", "a FIFO gives an Err of kind special")
check(str.Contains(fifo, pipe.Error.Message) and str.Contains("not a regular file", pipe.Error.Message), "the message names the FIFO and says why")
device = files.ReadFile("/dev/zero")
check(kindOf(device) == "special", "a device gives an Err of kind special")
check(str.Contains("/dev/zero", device.Error.Message) and str.Contains("not a regular file", device.Error.Message), "the message names the device and says why")
check(kindOf(files.ReadFile(folder)) == "folder", "a folder keeps its own message")
result.Unwrap(sys.Remove(fifo))

check(files.IsText(""), "empty is text")   (** IsText. *)
check(files.IsText("plain ascii\r\n"), "ascii is text")
check(files.IsText("é€😀"), "valid UTF-8 is text")
check(not files.IsText(str.FromBytes([97, 0])), "zero byte")
check(not files.IsText(str.FromBytes([255])), "0xff")
check(not files.IsText(str.FromBytes([0xc3])), "cut sequence at the end")
check(not files.IsText(str.FromBytes([0xc3, 0x41])), "lead followed by a letter")
check(not files.IsText(str.FromBytes([0x80])), "lone continuation")
check(not files.IsText(str.FromBytes([0xc0, 0x80])), "overlong two bytes")
check(not files.IsText(str.FromBytes([0xe0, 0x80, 0x80])), "overlong three bytes")
check(not files.IsText(str.FromBytes([0xed, 0xa0, 0x80])), "surrogate")
check(not files.IsText(str.FromBytes([0xf4, 0x90, 0x80, 0x80])), "above U+10FFFF")
check(not files.IsText(str.FromBytes([0xf8, 0x88, 0x80, 0x80, 0x80])), "five bytes")
check(files.IsText(str.FromBytes([0xf4, 0x8f, 0xbf, 0xbf])), "U+10FFFF")

(* A character at each place around 1 MiB, and bad bytes far in a large text: IsText reads it whole, so no place in it may be skipped. *)
mib = 1048576
for k in 0..3
  check(files.IsText("$(str.Repeat(mib - k, "a"))😀$(str.Repeat(10, "b"))"), "a character of four bytes $k bytes before 1 MiB")
  check(files.IsText("$(str.Repeat(mib - k, "a"))é€"), "characters of two and three bytes $k bytes before 1 MiB")
  check(not files.IsText("$(str.Repeat(mib - k, "a"))$(str.FromBytes([0xf0, 0x9f, 0x98]))b"), "a cut character $k bytes before 1 MiB")
end
check(not files.IsText("$(str.Repeat(mib, "a"))$(str.FromBytes([0x80, 0x80, 0x80, 0x80]))"), "four continuation bytes after 1 MiB")
check(not files.IsText("$(str.Repeat(3 * mib, "a"))$(str.FromBytes([233]))"), "Latin-1 at the end of 3 MiB")
check(not files.IsText("$(str.Repeat(2 * mib + 5, "a"))$(str.FromBytes([0]))"), "a zero byte past 2 MiB")
check(files.IsText("$(str.Repeat(2 * mib, "é"))"), "two-byte characters over 4 MiB")

(* ReadFile of real files: valid text is read as it is; a lone bad byte, an overlong form, a surrogate, a zero byte, and a bad byte at the end of
   a file over 1 MiB are each an Err of kind text, and the file is not touched. *)
defn readsAs(name, words)
  (** The kind of ReadFile of a new file of these words, and whether the file kept its bytes. *)
  path = "$folder/$name"
  result.Unwrap(sys.Write(path, words))
  kind = kindOf(files.ReadFile(path))
  kept = result.Unwrap(sys.Read(path)) == words
  result.Unwrap(sys.Remove(path))
  if kept kind else "touched" end
end
valid = "héllo € 😀\r\n\tU+10FFFF: $(str.FromBytes([0xf4, 0x8f, 0xbf, 0xbf]))\n"
result.Unwrap(sys.Write("$folder/valid", valid))
check(result.Unwrap(files.ReadFile("$folder/valid")).Words == valid, "valid UTF-8 is read as it is")
result.Unwrap(sys.Remove("$folder/valid"))
check(readsAs("lone", "ab$(str.FromBytes([0xff]))cd") == "text", "a lone bad byte gives an Err of kind text")
check(readsAs("continuation", "ab$(str.FromBytes([0x80]))cd") == "text", "a lone continuation byte gives an Err of kind text")
check(readsAs("overlong", "a$(str.FromBytes([0xc0, 0xaf]))b") == "text", "the overlong form of / gives an Err of kind text")
check(readsAs("overlong3", "a$(str.FromBytes([0xe0, 0x80, 0xaf]))b") == "text", "an overlong form of three bytes gives an Err of kind text")
check(readsAs("surrogate", "a$(str.FromBytes([0xed, 0xa0, 0x80]))b") == "text", "a surrogate gives an Err of kind text")
check(readsAs("nul", "a$(str.FromBytes([0]))b") == "text", "a zero byte gives an Err of kind text")
check(readsAs("above", "a$(str.FromBytes([0xf4, 0x90, 0x80, 0x80]))b") == "text", "a code point above U+10FFFF gives an Err of kind text")
check(readsAs("large-bad", "$(str.Repeat(mib + 7, "a"))$(str.FromBytes([0xe2, 0x82]))") == "text", "a cut character at the end of a file over 1 MiB gives an Err of kind text")
check(readsAs("large-late", "$(str.Repeat(mib - 1, "a"))$(str.FromBytes([0xff]))$(str.Repeat(mib, "b"))") == "text", "a bad byte at the last byte of the first MiB gives an Err of kind text")
wide = "$(str.Repeat(mib - 1, "a"))😀$(str.Repeat(mib, "b"))"
result.Unwrap(sys.Write("$folder/large-good", wide))
check(result.Unwrap(files.ReadFile("$folder/large-good")).Words == wide,"a file over 1 MiB with a character across its first MiB is read as it is")
result.Unwrap(sys.Remove("$folder/large-good"))
message = files.ReadFile("$folder/latin").Error.Message
check(str.Contains("$folder/latin", message) and str.Contains("not valid UTF-8", message), "the message names the file and says why: $message")

check(files.Normal("./a/../b.ce") == "b.ce", "normal of ./a/../b.ce")   (** normal. *)
check(files.Normal("a//b/./c/") == "a/b/c", "normal of doubled and trailing slashes")
check(files.Normal("/a/b/../../c") == "/c", "normal of an absolute path")
check(files.Normal("../a/../../b") == "../../b", "normal keeps leading ..")
check(files.Normal("/../a") == "/a", "normal drops .. above the root")
check(files.Normal("a/..") == ".", "normal of nothing is a dot")
check(files.Normal("/") == "/", "normal of the root")
check(files.Normal("x.ce") == "x.ce", "normal of a plain name")

(* Clean up. *)
for name in result.Unwrap(sys.List(folder))
  result.Unwrap(sys.Remove("$folder/$name"))
end
result.Unwrap(sys.Remove(folder))
check(not sys.Exists(folder), "the folder is gone")
io.Print("ok")
