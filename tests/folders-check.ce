(** Checks of the folders app against real folders, in a new folder under /tmp, with the trash where XDG_DATA_HOME says. It is a script, not a test file: it
    needs permissions. tests/run.sh runs it with XDG_DATA_HOME in a new folder and cesia run --allow read,write,exec=cesia,exec=mkfifo,env=HOME,env=PWD,env=SHELL,
    env=XDG_DATA_HOME: cesia runs tools/folders.ce, which runs the shell, gzip, tar and git for !, &, Z, c and =. It prints ok at the end and stops at the first
    failure. *)
use src/buffers
use src/check as checker
use core/commands
use src/emacs
use src/folders
use core/lists
use core/panes
use core/press
use src/rope
use std/sys
use core/text
use src/ui
use core/view
use std/text as str
use std/bug
use std/dict
use std/io
use std/list
use std/result
use std/value
use std/date
use std/math

defn check(condition, words)
  (** Stops the script with the words if the condition is false. *)
  if not condition
    bug.Panic("FAILED: $words")
  end
end

look = ui.Look(ui.Dark, (words, font) -> value.Len(words) * 8, 19)
cell = {Width: 8, Height: 19}
(** The keys as src/cemacs.ce merges them, with the hooks of the check and of &, in the order src/cemacs.ce gives them: the check's takes the place of any. *)
withApps() = folders.Hooked(checker.Hooked(emacs.Config(() -> dict.Merge(dict.Merge(emacs.Keys(), buffers.Keys()), folders.Keys()))))
(** The same, with deletions for good. *)
forGood() = dict.Merge(withApps(), {DeleteToTrash: () -> false})
here(state) = state.Buffers[state.Current]   (** The current buffer. *)
(** The names the list shows, a folder with its slash. *)
names(state) = str.Join(",", [if i.IsDir "$(i.Name)/" else i.Name end for i in lists.Of(here(state)).Items])
(** The mark column of each row. *)
marks(state) = str.Join("", [str.Slice(1, 1, l) for l in str.Lines(rope.Text(here(state).Rope))])
nameOf(state) = view.BufferName(here(state))   (** The name of the current buffer: for a list, its folder. *)
read(path) = result.UnwrapOr("(none)", sys.Read(path))   (** The text of a file, or (none). *)
modeOf(path) = result.Unwrap(sys.Stat(path)).Mode   (** The mode of a file. *)
isLink(path) = result.IsOk(sys.ReadLink(path))   (** Is a path a symbolic link? *)
defn on(name, state)
  (** The state with the cursor of the list on the row of a name. *)
  k = list.IndexOf(name, [i.Name for i in lists.Of(here(state)).Items])
  check(not value.IsMissing(k), "$name is shown: $(names(state))")
  s = state
  s.Buffers[s.Current] = text.Place(k, 0, here(state))
  s
end

defn ticked(state, done)
  (** The state after ticks, as the window sends them, until done says so, for at most ten seconds. *)
  s = state
  for k in 1..200
    if done(s)
      return s
    end
    sys.Sleep(0.05)
    s = commands.Update({Kind: "tick", Seconds: 0.05}, s)
  end
  s
end

folder = "/tmp/cemacs-folders-check-$(value.Text(math.Floor(sys.Now() * 1000)))"
trash = "$(sys.Env("XDG_DATA_HOME"))/Trash"
check(not value.IsMissing(sys.Env("XDG_DATA_HOME")), "XDG_DATA_HOME is set")
check(result.IsOk(sys.Mkdir("$folder/sub")), "the folders are made")
check(result.IsOk(sys.Write("$folder/a.ce", "a")) and result.IsOk(sys.Write("$folder/.hidden", "")), "the files are made")
start = view.Start([text.Of("a", "$folder/a.ce")], look, cell, 800, 600)
start.Config = withApps

(* C-x d lists the folder of the current file: folders first, hidden names out; . and C-c . show them. *)
s = press.Press(["C-x", "d"], start)
check(nameOf(s) == folder, "the list is named by its folder: $(nameOf(s))")
check(names(s) == "sub/,a.ce", "folders first and hidden names out: $(names(s))")
check(names(press.Press(["."], s)) == "sub/,.hidden,a.ce", ". shows the hidden names")
check(names(press.Press(["C-c", ".", "C-c", "."], s)) == "sub/,a.ce", "C-c . again hides them")
check(str.StartsWith("  drwx", rope.Text(here(s).Rope)), "a row starts with its mark column and its mode: $(rope.Text(here(s).Rope))")

(* Enter opens a folder; in an empty one, C-c n makes a file, and the cursor goes to it. ^ goes up, onto the folder left. *)
s = press.Press(["enter"], s)
check(nameOf(s) == "$folder/sub", "enter opens the folder")
s = press.Press(["C-c", "n", "new.ce", "enter"], s)
check(sys.Exists("$folder/sub/new.ce") and names(s) == "new.ce", "C-c n makes a file")
s = press.Press(["^"], s)
check(nameOf(s) == folder and here(s).Cursor.Line == 1, "^ goes up, onto sub")

(* + makes a folder, and the cursor goes to it; C-c n with a slash too; a name that exists is refused. *)
s = press.Press(["+", "dir2", "enter"], s)
check(result.Unwrap(sys.Stat("$folder/dir2")).IsDir and names(s) == "dir2/,sub/,a.ce" and here(s).Cursor.Line == 1, "+ makes a folder: $(names(s))")
s = press.Press(["C-c", "n", "a.ce", "enter"], s)
check(s.Message == "a.ce already exists.", "an existing name is refused")

(* / filters: letters narrow the rows, Enter keeps the filter for the commands, C-g takes it away. / after a part of a folder's name goes into it, / alone
   to the root, ~/ to the home, and C-y to a pasted path. *)
check(names(press.Press(["/", "su"], s)) == "sub/", "/ then letters filter")
check(marks(press.Press(["/", "su", "enter", "m"], s)) == "*", "Enter keeps the filter, and m marks the row left")
check(names(press.Press(["/", "su", "C-g"], s)) == "dir2/,sub/,a.ce", "C-g takes the filter away")
check(nameOf(press.Press(["/", "su", "/"], s)) == "$folder/sub", "/ su / goes into sub")
check(nameOf(press.Press(["/", "/"], s)) == "/", "/ / goes to the root")
check(nameOf(press.Press(["/", "~", "/"], s)) == sys.Env("HOME"), "/ ~/ goes to the home")
check(nameOf(press.Press(["/", "backspace"], press.Press(["enter"], s))) == folder, "backspace with no filter goes up")
check(nameOf(press.Press(["backspace"], press.Press(["enter"], s))) == folder, "backspace goes to the folder above, as it always did")
check(nameOf(press.Press(["m", "backspace"], press.Press(["enter"], s))) == folder, "backspace goes up with a row marked too")
pasting = s
pasting.Clip = "$folder/sub/new.ce"
check(nameOf(press.Press(["C-y"], pasting)) == "$folder/sub" and names(press.Press(["C-y"], pasting)) == "new.ce", "C-y goes to the folder of a pasted file")

(* C copies a tree whole: folders made, files copied with their mode, links made again, never followed, a link to nothing too. *)
check(result.IsOk(sys.Mkdir("$folder/src/deep")) and result.IsOk(sys.Write("$folder/src/x.ce", "x")) and result.IsOk(sys.Write("$folder/src/deep/y.ce", "y")), "the tree is made")
check(result.IsOk(sys.Chmod("$folder/src/x.ce", 493)) and result.IsOk(sys.Symlink("x.ce", "$folder/src/l")) and result.IsOk(sys.Symlink("nowhere", "$folder/src/b")), "the links are made")
s = press.Press(["g"], s)
check(names(s) == "dir2/,src/,sub/,a.ce", "g reads the folder again: $(names(s))")
s = press.Press(["n", "C"], s)
check(s.Prompt.Label == "Copy src to: " and s.Prompt.Answer == "$folder/src", "C asks where to, from this folder: $(s.Prompt.Answer)")
s = press.Press(["backspace", "backspace", "backspace", "dst", "enter"], s)
check(read("$folder/dst/x.ce") == "x" and read("$folder/dst/deep/y.ce") == "y", "C copies the files of the tree: $(s.Message)")
check(modeOf("$folder/dst/x.ce") == 493, "C keeps the mode of a file")
check(result.UnwrapOr("", sys.ReadLink("$folder/dst/l")) == "x.ce" and result.UnwrapOr("", sys.ReadLink("$folder/dst/b")) == "nowhere", "C copies the links as links")
check(s.Message == "Copied src." and names(s) == "dir2/,dst/,src/,sub/,a.ce", "C says what it did, and the list shows the copy: $(s.Message)")

(* A folder can't be copied or moved into itself, and nothing is made for it. *)
t = press.Press(["C"], on("src", s))
t.Prompt.Answer = "$folder/src/inner/"
t = press.Press(["enter"], t)
check(str.Contains("into itself", t.Message) and not sys.Exists("$folder/src/inner"), "a copy into itself is refused: $(t.Message)")
t = press.Press(["R"], on("src", s))
t.Prompt.Answer = "$folder/src/deep"
t = press.Press(["enter"], t)
check(str.Contains("into itself", t.Message) and sys.Exists("$folder/src/x.ce"), "a move into itself is refused: $(t.Message)")

(* A path that goes while the folders ask whether it is a folder is no folder, never a failure that ends the editor: tests/blink-folder.ce makes it and
   removes it over and over while a copy asks, many times, where its file goes. *)
other = result.Unwrap(sys.Start("cesia", args = ["run", "--allow", "read,write", "tests/blink-folder.ce", "$folder/blink", "$folder/blink-stop"]))
waited = sys.Now()
while not sys.Exists("$folder/blink") and sys.Now() - waited < 10
  sys.Sleep(0.001)
end
answers = [result.Unwrap(folders.Destinations([{Name: "a.ce", IsDir: false}], folder, "blink"))[1].To for k in 1..3000]
check(result.IsOk(sys.Write("$folder/blink-stop", "")) and sys.WaitExit(other) == 0, "the folder stops blinking")
_ = sys.Remove("$folder/blink")
check(result.IsOk(sys.Remove("$folder/blink-stop")) and "$folder/blink/a.ce" in answers and "$folder/blink" in answers, "the answer was a folder at times and nothing at others")

(* A file there is replaced only after a yes. *)
check(result.IsOk(sys.Write("$folder/b.ce", "b")), "b.ce is made")
s = press.Press(["g"], s)
t = press.Press(["C"], on("a.ce", s))
t.Prompt.Answer = "$folder/b.ce"
t = press.Press(["enter"], t)
check(t.Prompt.Label == "b.ce exists. Replace it? (y or n) ", "a copy over a file asks first: $(value.Text(t.Prompt))")
check(read("$folder/b.ce") == "b" and read("$folder/b.ce") == read("$folder/b.ce"), "nothing is replaced before the answer")
check(read("$folder/b.ce") == "b" and press.Press(["n"], t).Message == "Nothing done.", "n leaves b.ce")
press.Press(["y"], t)
check(read("$folder/b.ce") == "a", "y replaces b.ce")

(* A copy never writes through a link at its target: where the copy has a folder and the target a link to another folder, nothing goes under it, and the
   copy stops there, as Emacs's copy-directory stops at the first failure, and says so. *)
check(result.IsOk(sys.Mkdir("$folder/elsewhere")) and result.IsOk(sys.Mkdir("$folder/dst2/src")) and result.IsOk(sys.Symlink("$folder/elsewhere", "$folder/dst2/src/deep")), "a link in the target is made")
t = press.Press(["C"], on("src", press.Press(["g"], s)))
t.Prompt.Answer = "$folder/dst2/"
t = press.Press(["enter"], t)
check(t.Prompt.Label == "src exists. Replace it? (y or n) ", "the folder there asks first: $(value.Text(t.Prompt))")
t = press.Press(["y"], t)
check(value.Len(result.Unwrap(sys.List("$folder/elsewhere"))) == 0 and isLink("$folder/dst2/src/deep"), "nothing goes through the link: $(t.Message)")
check(str.StartsWith("Copied 0 of 1; src: Can't copy $folder/src/deep to $folder/dst2/src/deep: ", t.Message) and str.EndsWith("The copy stopped there; what it copied before stays.", t.Message), "the link in the way is said, and the copy stopped: $(t.Message)")
(* A copy writes first at a name that no one can know before it is made, drawn anew each time, so that no one who can write the folder can take it first;
   a failure names the file, never that name. *)
check(result.IsOk(folders.Placed(t -> sys.Write(t, t), "$folder/placed")), "Placed writes a file")
first = read("$folder/placed")
check(result.IsOk(folders.Placed(t -> sys.Write(t, t), "$folder/placed")), "Placed writes it again")
second = read("$folder/placed")
check(str.StartsWith("$folder/.#cemacs-", first) and value.Len(first) == value.Len("$folder/.#cemacs-") + 32 and first != second, "the name of its own is drawn anew: $first, $second")
failed = folders.Placed(t -> result.Err({Kind: "io", Message: "Can't write $t: no space left on device."}), "$folder/placed")
check(failed.Error.Message == "Can't write $folder/placed: no space left on device.", "a failure names the file, not the name of its own: $(value.Text(failed))")
check(not sys.Exists(first) and not sys.Exists(second) and result.IsOk(sys.Remove("$folder/placed")), "the names of their own are gone")
(* The copy of a file makes its name of its own only new, as a save does: a link or a file put there first, as by someone who could know the name, is
   never written through and stays as it was, and another name is drawn. cesia run --seed gives the names a run draws: tests/fresh-act.ce, with the
   seed 7, tells them, then copies, its first two names taken. *)
check(result.IsOk(sys.Write("$folder/victim.txt", "victim")), "the file of another is made")
defn acted(args)
  (** tests/fresh-act.ce run with the seed 7: {Code, Out}. *)
  r = result.Unwrap(sys.Run("cesia", list.Concat(["run", "--seed", "7", "--allow", "read,write", "tests/fresh-act.ce"], args)))
  {Code: r.Code, Out: "$(r.Out)$(r.Err)"}
end
taken = str.Lines(acted(["names", "$folder/out.ce", "2"]).Out)
check(result.IsOk(sys.Symlink("$folder/victim.txt", taken[1])) and result.IsOk(sys.Write(taken[2], "planted")), "a link and a file are put at the names")
copied = acted(["copy", "$folder/a.ce", "$folder/out.ce"])
check(copied.Code == 0 and read("$folder/out.ce") == "a" and read("$folder/victim.txt") == "victim", "the copy goes to another name, never through the link: $(copied.Out)")
check(isLink(taken[1]) and read(taken[2]) == "planted", "the link and the file at the names stay as they were")
for gone in [taken[1], taken[2], "$folder/victim.txt", "$folder/out.ce"]
  result.Unwrap(sys.Remove(gone))
end
(* A file copied onto itself by another path stays whole. *)
check(result.IsOk(sys.Symlink(folder, "$folder/self")), "a link to the folder itself is made")
t = press.Press(["C"], on("b.ce", press.Press(["g"], s)))
t.Prompt.Answer = "$folder/self/b.ce"
t = press.Press(["enter", "y"], t)
check(read("$folder/b.ce") == "a" and value.Len([n for n in result.Unwrap(sys.List(folder)) if str.StartsWith(".#cemacs", n)]) == 0, "b.ce onto itself is still a: $(t.Message)")
(* A special file is never read, since reading one can wait for ever: in a tree, it stops the copy, which names it; alone, it is named and left. *)
check(result.IsOk(sys.Run("mkfifo", ["$folder/src/pipe"])), "a FIFO is made")
t = press.Press(["C"], on("src", press.Press(["g"], s)))
t.Prompt.Answer = "$folder/dst4"
t = press.Press(["enter"], t)
check(str.Contains("Can't copy $folder/src/pipe to $folder/dst4/pipe: ", t.Message) and str.Contains("The copy stopped there", t.Message) and not sys.Exists("$folder/dst4/pipe"), "a FIFO is not copied: $(t.Message)")
alone = folders.CopyTree("$folder/src/pipe", "$folder/pipe2")
check(result.IsErr(alone) and alone.Error == "pipe is a special file, as a FIFO or a device, which is not copied" and not sys.Exists("$folder/pipe2"), "a FIFO alone is not copied: $(value.Text(alone))")
(* A folder copied to a place whose folders aren't there yet gets them, as mkdir -p makes them. *)
check(result.IsOk(folders.CopyTree("$folder/src/deep", "$folder/dst5/a/b/deep")) and read("$folder/dst5/a/b/deep/y.ce") == "y", "the folders above the copy are made")
for gone in ["dst2", "dst4", "dst5", "elsewhere", "src/pipe"]
  result.Unwrap(sys.RemoveTree("$folder/$gone"))
end
_ = sys.Remove("$folder/self")
s = press.Press(["g"], s)

(* R renames a file, and the buffer of a file moved goes with it; with marks, R moves the files into a folder. *)
s = press.Press(["g"], s)
t = press.Press(["R"], on("b.ce", s))
t.Prompt.Answer = "$folder/c.ce"
s = press.Press(["enter"], t)
check(read("$folder/c.ce") == "a" and not sys.Exists("$folder/b.ce") and str.Contains("c.ce", names(s)), "R renames: $(s.Message)")
s = on("a.ce", s)
s = press.Press(["m"], on("c.ce", press.Press(["m"], s)))
check(marks(s) == "    **", "two files are marked: $(marks(s))")
check(lists.LabelOf(lists.Of(here(s))) == "$folder/  2 marked", "the line under the panes counts them: $(lists.LabelOf(lists.Of(here(s))))")
t = press.Press(["R"], s)
check(t.Prompt.Label == "Rename * [2 files] to: " and t.Prompt.Answer == "$folder/", "R of two files asks for a folder")
t.Prompt.Answer = "$folder/sub/"
s = press.Press(["enter"], t)
check(read("$folder/sub/a.ce") == "a" and read("$folder/sub/c.ce") == "a" and not sys.Exists("$folder/a.ce"), "R moves the marked files into sub: $(s.Message)")
moved = [b for b in s.Buffers if not lists.IsList(b) and value.IsText(b.Path)]
check(value.Len(moved) == 1 and moved[1].Path == "$folder/sub/a.ce", "the buffer of a.ce follows it: $(value.Text([b.Path for b in moved]))")
check(s.Message == "Moved 2 files.", "R says what it did: $(s.Message)")

(* D asks, then moves to the trash with its info; x deletes the rows flagged with d. *)
s = press.Press(["^"], press.Press(["enter"], on("sub", s)))
check(nameOf(s) == folder, "back in the folder")
t = press.Press(["D"], on("dst", s))
check(t.Prompt.Label == "Move dst to the trash? (y or n) ", "D asks first: $(value.Text(t.Prompt))")
check(sys.Exists("$folder/dst") and press.Press(["n"], t).Message == "Nothing deleted.", "n keeps it")
before = math.Floor(sys.Now())
s = press.Press(["y"], t)
after = math.Floor(sys.Now())
check(not sys.Exists("$folder/dst") and sys.Exists("$trash/files/dst/deep/y.ce"), "y moves the folder whole to the trash: $(s.Message)")
check(s.Message == "Moved to the trash dst.", "D says it moved to the trash: $(s.Message)")
info = result.Unwrap(sys.Read("$trash/info/dst.trashinfo"))
check(list.All([modeOf(p) == 448 for p in [trash, "$trash/files", "$trash/info"]]) and modeOf("$trash/info/dst.trashinfo") == 384, "the trash is the person's alone, 700, and its info 600")
clock(t) = str.Join("", list.Take(19, str.Chars(date.Format(date.Local(t)))))
check(list.Any([info == "[Trash Info]\nPath=$folder/dst\nDeletionDate=$(clock(k))\n" for k in before..after]), "the info of the trash, on the local clock: $info")
check(result.IsOk(sys.Write("$folder/old.ce~", "")) and result.IsOk(sys.Write("$folder/#auto#", "")), "a backup and an auto-save are made")
s = press.Press(["g", "~", "#"], s)
check(str.Contains("D", marks(s)) and lists.LabelOf(lists.Of(here(s))) == "$folder/  2 flagged", "~ and # flag them: $(marks(s))")
s = press.Press(["x", "y"], s)
check(not sys.Exists("$folder/old.ce~") and not sys.Exists("$folder/#auto#") and sys.Exists("$trash/files/old.ce~"), "x moves the flagged to the trash: $(s.Message)")

(* With DeleteToTrash false, D deletes for good after yes, and once more for each folder that holds something; a link in it is deleted, never followed. *)
check(result.IsOk(sys.Mkdir("$folder/keep")) and result.IsOk(sys.Write("$folder/keep/k.ce", "k")), "a folder outside is made")
check(result.IsOk(sys.Symlink("$folder/keep", "$folder/src/tokeep")), "a link to it is made inside src")
s.Config = forGood
s = press.Press(["g"], s)
t = press.Press(["D"], on("src", s))
check(t.Prompt.Label == "Delete src for good? (yes or no) ", "D asks yes or no: $(value.Text(t.Prompt))")
t = press.Press(["y", "enter"], t)
check(t.Message == "Nothing deleted." and sys.Exists("$folder/src"), "y is not yes")
t = press.Press(["D", "yes", "enter"], on("src", s))
check(t.Prompt.Label == "Delete folder src and everything in it? (yes or no) ", "a folder that holds something asks again: $(value.Text(t.Prompt))")
s = press.Press(["yes", "enter"], t)
check(not sys.Exists("$folder/src") and read("$folder/keep/k.ce") == "k", "src is deleted, and the folder its link pointed to is left: $(s.Message)")
check(s.Message == "Deleted src.", "D says it deleted: $(s.Message)")

(* A deletion for good walks by the folders it holds open: another person who can write the folder above, who swaps the folder for a link to another
   while it runs, leads it nowhere, and every file of that other folder is left. tests/swap-folder.ce is that person; a round where it came too late is
   run again. *)
raceFiles = 4000
defn raced()
  (** One round: {Swapped, Left, Moved, Message}: did the swap land while the deletion ran, how many files the other folder keeps and the folder
      renamed away still holds, and what D said. *)
  race = "$folder/race"
  check(result.IsOk(sys.Mkdir("$race/shared/big")) and result.IsOk(sys.Mkdir("$race/victim")), "the folders of the race are made")
  for k in 1..raceFiles
    result.Unwrap(sys.Write("$race/shared/big/f$k", ""))
    result.Unwrap(sys.Write("$race/victim/f$k", ""))
  end
  ready = "$race/ready"
  other = result.Unwrap(sys.Start("cesia", args = ["run", "--allow", "read,write", "tests/swap-folder.ce", "$race/shared/big", value.Text(raceFiles - 100), "$race/victim", ready]))
  waited = sys.Now()
  while not sys.Exists(ready) and sys.Now() - waited < 10
    sys.Sleep(0.01)
  end
  t = press.Press(["enter"], on("shared", press.Press(["enter"], on("race", press.Press(["g"], s)))))
  t.Config = forGood
  t = press.Press(["D", "yes", "enter", "yes", "enter"], on("big", t))
  code = sys.WaitExit(other)
  left = value.Len(result.UnwrapOr([], sys.List("$race/victim")))
  moved = value.Len(result.UnwrapOr([], sys.List("$race/shared/big.moved")))
  result.Unwrap(sys.RemoveTree(race))
  {Swapped: code == 0, Left: left, Moved: moved, Message: t.Message}
end
round = raced()
for k in 1..2
  if not round.Swapped
    round = raced()
  end
end
check(round.Swapped, "the other person swapped the folder for a link while the deletion ran")
check(round.Left == raceFiles, "the folder the link points to keeps its $raceFiles files: $(round.Left); $(round.Message)")
check(round.Moved == 0 and str.Contains("Can't remove", round.Message), "what the folder held is deleted, and the link put in its place is said: $(round.Message)")
s.Config = withApps

(* A copy walks both trees by the folders it holds open: another person who can write the folder above, who swaps a folder of the tree copied for a link to
   a folder of secrets, or the copy for a link to a folder of their victim, while it runs, leads no read and no write there. The copy goes on in the folder
   renamed away, whole, and every file of the other folder is left; a copy by paths took the secrets, or wrote over the victim's files. tests/swap-folder.ce
   is that person; a round where it came too late is run again. *)
copyFiles = 3000
defn copyRaced(side)
  (** One round, the tree copied swapped for side "from", the copy for "to": {Swapped, Leaked, Kept, Copied, Message}: did the swap land, how many
      files of the copy hold a secret, how many of the other folder's files still hold theirs, how many the copy made where it started, and what C said. *)
  race = "$folder/crace"
  check(result.IsOk(sys.Mkdir("$race/shared/tree/sub")) and result.IsOk(sys.Mkdir("$race/src/sub")) and result.IsOk(sys.Mkdir("$race/victim/sub")), "the folders of the copy race are made")
  for k in 1..copyFiles
    result.Unwrap(sys.Write("$race/shared/tree/sub/f$k", "x"))
    result.Unwrap(sys.Write("$race/src/sub/f$k", "x"))
    result.Unwrap(sys.Write("$race/victim/sub/f$k", "secret"))
  end
  ready = "$race/ready"
  swapped = if side == "from" ["$race/shared/tree/sub", "$race/victim/sub", "$race/out/tree/sub"] else ["$race/shared/out", "$race/victim", "$race/shared/out/sub"] end
  other = result.Unwrap(sys.Start("cesia", args = ["run", "--allow", "read,write", "tests/swap-folder.ce", swapped[1], "100", swapped[2], ready, swapped[3]]))
  waited = sys.Now()
  while not sys.Exists(ready) and sys.Now() - waited < 10
    sys.Sleep(0.01)
  end
  t = press.Press(["enter"], on("crace", press.Press(["g"], s)))
  t = if side == "from" press.Press(["C"], on("tree", press.Press(["enter"], on("shared", t)))) else press.Press(["C"], on("src", t)) end
  t.Prompt.Answer = if side == "from" "$race/out/tree" else "$race/shared/out" end
  t = press.Press(["enter"], t)
  code = sys.WaitExit(other)
  made = if side == "from" "$race/out/tree/sub" else "$race/shared/out.moved/sub" end
  copies = result.UnwrapOr([], sys.List(made))
  leaked = value.Len([n for n in copies if read("$made/$n") == "secret"])
  kept = value.Len([n for n in result.UnwrapOr([], sys.List("$race/victim/sub")) if read("$race/victim/sub/$n") == "secret"])
  result.Unwrap(sys.RemoveTree(race))
  {Swapped: code == 0, Leaked: leaked, Kept: kept, Copied: value.Len(copies), Message: t.Message}
end
for side in ["from", "to"]
  round = copyRaced(side)
  for k in 1..2
    if not round.Swapped
      round = copyRaced(side)
    end
  end
  check(round.Swapped, "the other person swapped the folder for a link while the copy ran, on the side $side")
  check(round.Leaked == 0 and round.Kept == copyFiles, "the copy took no secret and wrote over no file of the other folder, on the side $side: $(round.Leaked) taken, $(round.Kept) kept; $(round.Message)")
  check(round.Copied == copyFiles and str.StartsWith("Copied ", round.Message), "the copy went on whole where it started, on the side $side: $(round.Copied) files; $(round.Message)")
end

(* M gives a mode, in octal or as chmod writes it; T a time. *)
check(result.IsOk(sys.Write("$folder/run.sh", "")) and result.IsOk(sys.Chmod("$folder/run.sh", 420)), "run.sh is made")
s = press.Press(["g"], s)
t = press.Press(["M"], on("run.sh", s))
check(t.Prompt.Label == "Change mode of run.sh to: " and t.Prompt.Answer == "644", "M asks, the mode of the file first: $(t.Prompt.Answer)")
s = press.Press(["backspace", "backspace", "backspace", "u+x,o-r", "enter"], t)
check(modeOf("$folder/run.sh") == 480, "u+x,o-r gives rwxr-----: $(modeOf("$folder/run.sh")) $(s.Message)")
s = press.Press(["M", "backspace", "backspace", "backspace", "0600", "enter"], on("run.sh", s))
check(modeOf("$folder/run.sh") == 384, "0600 gives rw-------")
check(str.Contains("-rw-------", rope.Text(here(s).Rope)), "the row shows the new mode")
check(str.Contains("Not a mode", press.Press(["M", "u+q", "enter"], on("run.sh", s)).Message), "a wrong mode is said")
s = press.Press(["T", "2020-01-02 03:04", "enter"], on("run.sh", s))
check(result.Unwrap(sys.Stat("$folder/run.sh")).Modified == result.Unwrap(folders.TimeOf("2020-01-02 03:04", 0)), "T gives the time asked: $(s.Message)")
s = press.Press(["T", "enter"], on("run.sh", s))
check(sys.Now() - result.Unwrap(sys.Stat("$folder/run.sh")).Modified < 5, "T with no answer gives now")

(* S makes a link from the root, Y a relative one, H a hard link. *)
check(result.IsOk(sys.Write("$folder/f.ce", "f")), "f.ce is made")
s = press.Press(["g"], s)
t = press.Press(["S"], on("f.ce", s))
check(t.Prompt.Label == "Symlink f.ce from: ", "S asks for the link: $(t.Prompt.Label)")
t.Prompt.Answer = "$folder/abs"
s = press.Press(["enter"], t)
check(result.UnwrapOr("", sys.ReadLink("$folder/abs")) == "$folder/f.ce" and read("$folder/abs") == "f", "S links from the root: $(s.Message)")
t = press.Press(["Y"], on("f.ce", s))
t.Prompt.Answer = "$folder/sub/rel"
s = press.Press(["enter"], t)
check(result.UnwrapOr("", sys.ReadLink("$folder/sub/rel")) == "../f.ce" and read("$folder/sub/rel") == "f", "Y links with a relative path: $(s.Message)")
t = press.Press(["H"], on("f.ce", s))
t.Prompt.Answer = "$folder/hard.ce"
s = press.Press(["enter"], t)
check(read("$folder/hard.ce") == "f" and not isLink("$folder/hard.ce"), "H makes a hard link")
check(result.IsOk(sys.Write("$folder/hard.ce", "g")) and read("$folder/f.ce") == "g", "a hard link is the same file")
check(str.Contains("abs -> $folder/f.ce", rope.Text(here(s).Rope)), "a link shows its target")

(* C-x C-q makes the names a text: a swap of two names renames both, through names of their own. *)
check(result.IsOk(sys.Write("$folder/one", "1")) and result.IsOk(sys.Write("$folder/two", "2")), "one and two are made")
s = press.Press(["g"], s)
lines = str.Lines(rope.Text(press.Press(["C-x", "C-q"], s).Buffers[s.Current].Rope))
check("one" in lines and "two" in lines, "C-x C-q shows the names: $(value.Text(lines))")
w = press.Press(["C-x", "C-q"], s)
swapped = str.Join("\n", [if l == "one" "two" else if l == "two" "one" else l end for l in lines])
w.Buffers[w.Current] = text.Retyped(swapped, here(w))
t = press.Press(["C-c", "C-c"], w)
check(read("$folder/one") == "2" and read("$folder/two") == "1", "C-c C-c swaps one and two: $(t.Message)")
check(lists.IsList(here(t)) and t.Message == "Renamed 2 files.", "the list comes back: $(t.Message)")
check(value.Len([n for n in result.Unwrap(sys.List(folder)) if str.StartsWith(".#wdired", n)]) == 0, "no name of its own is left")
w = press.Press(["C-x", "C-q"], t)
w.Buffers[w.Current] = text.Retyped(str.Join("\n", [if l == "one" "f.ce" else l end for l in lines]), here(w))
check(str.Contains("Two lines are named f.ce", press.Press(["C-c", "C-c"], w).Message), "a name twice is refused")
w = press.Press(["C-x", "C-q"], t)
w.Buffers[w.Current] = text.Retyped(str.Join("\n", [if l == "one" ".hidden" else l end for l in lines]), here(w))
check(str.Contains(".hidden exists", press.Press(["C-c", "C-c"], w).Message) and read("$folder/one") == "2", "a name that is there is refused")
s = t

(* ! runs a command of the shell on the files, through tools/folders.ce; a name with a quote stays one word. *)
check(result.IsOk(sys.Write("$folder/it's.txt", "q")), "a name with a quote is made")
s = press.Press(["g"], s)
t = press.Press(["!", "cat", "enter"], on("it's.txt", s))
check(t.Message == "q", "! cat on it's.txt: $(t.Message)")
t = press.Press(["!", "echo * done", "enter"], press.Press(["m"], on("one", press.Press(["m"], on("two", s)))))
check(t.Message == "one two done", "! with * runs once on the marked: $(t.Message)")
check(press.Press(["!", "echo $0", "enter"], on("one", s)).Message == "/bin/sh one", "! runs in /bin/sh, whose quoting Quoted writes, whatever SHELL says")
t = press.Press(["!", "printf '%s\\n' x y z", "enter"], on("one", s))
check(str.Contains("lines in *Shell Command Output*", t.Message) and lists.IsList(here(t)), "a longer output goes beside the list: $(t.Message)")
out = [b for b in t.Buffers if dict.GetOr("Name", "", b) == "*Shell Command Output*"]
check(value.Len(out) == 1 and rope.Text(out[1].Rope) == "x\ny\nz\none\n", "the output buffer: $(value.Text([rope.Text(b.Rope) for b in out]))")
check(panes.Count(panes.Tree(t)) == 2, "the output shows in another pane")

(* & runs without waiting; its output comes at a tick. *)
t = press.Press(["&", "echo bg", "enter"], on("one", s))
check(str.Contains("background", t.Message), "& starts: $(t.Message)")
t = ticked(t, st -> value.Len([b for b in st.Buffers if dict.GetOr("Name", "", b) == "*Async Shell Command*"]) > 0)
bg = [b for b in t.Buffers if dict.GetOr("Name", "", b) == "*Async Shell Command*"]
check(value.Len(bg) == 1 and str.Contains("bg one", rope.Text(bg[1].Rope)), "& gives its output to *Async Shell Command*")
check(lists.IsList(here(t)), "the editing stays in the list")

(* Z compresses and uncompresses; c puts files in an archive. *)
s = press.Press(["Z", "y"], on("one", s))
check(sys.Exists("$folder/one.gz") and not sys.Exists("$folder/one"), "Z compresses one: $(s.Message)")
s = press.Press(["Z", "y"], on("one.gz", s))
check(read("$folder/one") == "2" and not sys.Exists("$folder/one.gz"), "Z uncompresses one.gz: $(s.Message)")
check(result.IsOk(sys.Mkdir("$folder/pack")) and result.IsOk(sys.Write("$folder/pack.tar.gz", "old")), "a folder and an archive of its name are made")
t = press.Press(["Z", "y"], on("pack", press.Press(["g"], s)))
check(read("$folder/pack.tar.gz") == "old" and str.Contains("exists already", t.Message), "Z never replaces an archive: $(t.Message)")
result.Unwrap(sys.RemoveTree("$folder/pack"))
_ = sys.Remove("$folder/pack.tar.gz")
s = press.Press(["g"], s)
s = press.Press(["c", "both.tar.gz", "enter"], press.Press(["m"], on("one", press.Press(["m"], on("two", press.Press(["U"], s))))))
check(sys.Exists("$folder/both.tar.gz") and here(s).Cursor.Line == list.IndexOf("both.tar.gz", [i.Name for i in lists.Of(here(s)).Items]), "c makes an archive: $(s.Message)")

(* = shows the diff of two files; Enter on a line opens it there. *)
s = press.Press(["U"], s)
t = press.Press(["="], on("one", s))
check(t.Prompt.Label == "Diff one with: ", "= asks: $(t.Prompt.Label)")
t.Prompt.Answer = "$folder/two"
t = press.Press(["enter"], t)
check(nameOf(t) == "Diff one two" and str.Contains("-2", rope.Text(here(t).Rope)) and str.Contains("+1", rope.Text(here(t).Rope)), "= lists the diff: $(t.Message) $(rope.Text(here(t).Rope))")

(* A lists the lines of the marked files that a pattern finds; Q replaces it in their buffers, left not saved. *)
check(result.IsOk(sys.Write("$folder/sub/s.ce", "x = 1\ny = 22\n")), "s.ce is written")
t = press.Press(["A", "[0-9]{2}", "enter"], on("sub", s))
check(nameOf(t) == "Search: [0-9]{2}" and rope.Text(here(t).Rope) == "sub/s.ce:2:5  y = 22", "A lists the places in the folder marked: $(rope.Text(here(t).Rope))")
t = press.Press(["enter"], t)
check(here(t).Path == "$folder/sub/s.ce" and here(t).Cursor.Line == 2 and here(t).Cursor.Column == 4, "Enter goes to the place")
t = press.Press(["Q", "[0-9]+", "enter", "n", "enter"], on("sub", s))
edited = [b for b in t.Buffers if b.Path == "$folder/sub/s.ce"]
check(value.Len(edited) == 1 and rope.Text(edited[1].Rope) == "x = n\ny = n\n" and text.IsModified(edited[1]), "Q replaces in the buffer, not saved: $(t.Message)")
check(read("$folder/sub/s.ce") == "x = 1\ny = 22\n" and t.Message == "Replaced 2 places in 1 file: its buffer is not saved.", "the file is as it was: $(t.Message)")
check(str.Contains("Bad pattern", press.Press(["A", "(", "enter"], on("sub", s)).Message), "a wrong pattern is said, and nothing stops")

(* o opens in the other pane; C-o shows a folder there and stays: a copy then goes to that folder first. *)
t = press.Press(["C-o"], on("sub", s))
check(panes.Count(panes.Tree(t)) == 2 and nameOf(t) == folder and folders.OtherFolder(t) == "$folder/sub", "C-o shows sub in the other pane and stays")
t = press.Press(["C"], on("f.ce", t))
check(t.Prompt.Answer == "$folder/sub/f.ce", "the copy goes to the folder of the other pane first: $(t.Prompt.Answer)")
t = press.Press(["enter"], t)
check(read("$folder/sub/f.ce") == "g", "C copies there")
other = t.Buffers[panes.At(2, panes.Tree(t)).Buffer]
check("f.ce" in [i.Name for i in lists.Of(other).Items], "the list of the other pane is read again")
t = press.Press(["o"], on("f.ce", s))
check(panes.Count(panes.Tree(t)) == 2 and here(t).Path == "$folder/f.ce" and lists.IsList(t.Buffers[panes.At(1, panes.Tree(t)).Buffer]), "o opens the file in the other pane")

(* Enter on a file opens it in a buffer, and the list closes; q closes it too. *)
s = press.Press(["enter"], on("f.ce", s))
check(here(s).Path == "$folder/f.ce", "enter opens the file")
check(value.Len(list.Filter(b -> lists.IsList(b), s.Buffers)) == 0, "the list is closed")
s = press.Press(["C-x", "d", "q"], s)
check(value.Len(list.Filter(b -> lists.IsList(b), s.Buffers)) == 0 and here(s).Path == "$folder/f.ce", "q goes back")

(* A name with a line end, as anyone who can write a folder can make one, stays one row, escaped as ls -b writes it, so that the row under the cursor is
   the file a command takes: the row of keep.txt deletes keep.txt, not the file under it. The prompt line shows such a name escaped too. *)
odd = "$folder/odd"
nl = str.FromBytes([10])
check(result.IsOk(sys.Mkdir(odd)) and result.IsOk(sys.Write("$odd/a$(nl)b", "x")) and result.IsOk(sys.Write("$odd/back\\slash", "s")), "the odd names are made")
for n in ["junk.txt", "keep.txt", "thesis.txt"]
  check(result.IsOk(sys.Write("$odd/$n", n)), "$n is made")
end
o = press.Press(["C-x", "d"], commands.OpenFile("$odd/junk.txt", start))
rows = str.Lines(rope.Text(here(o).Rope))
check(value.Len(rows) == 5 and value.Len(lists.Of(here(o)).Items) == 5, "five names, five rows: $(rows)")
check(list.Any([str.EndsWith("a\\nb", r) for r in rows]) and list.Any([str.EndsWith("back\\\\slash", r) for r in rows]), "the line end and the backslash are written as ls -b writes them: $(rows)")
for k in 1..value.Len(rows)
  check(str.EndsWith(folders.NameText(lists.Of(here(o)).Items[k].Name), rows[k]), "row $k is the name it takes: $(rows[k])")
end
k = list.IndexOf(true, [str.EndsWith("keep.txt", r) for r in rows])
o.Buffers[o.Current] = text.Place(k, 0, here(o))
asked = press.Press(["d", "x"], o)
check(asked.Prompt.Label == "Move keep.txt to the trash? (y or n) ", "the row of keep.txt asks for keep.txt: $(asked.Prompt.Label)")
gone = press.Press(["y"], asked)
check(not sys.Exists("$odd/keep.txt") and sys.Exists("$odd/thesis.txt") and sys.Exists("$odd/a$(nl)b"), "keep.txt goes, and only it: $(gone.Message)")
renaming = press.Press(["R"], on("a$(nl)b", gone))
check(list.Any([c.Kind == "text" and str.StartsWith("Rename a\\nb to: ", c.Text) for c in view.View(renaming)]), "the prompt line shows the name escaped")

(* The names to edit are written as the rows write them: a name with a line end last, as Wdired lost its line end, keeps it byte for byte after C-c C-c
   with no edit, and its line can't be edited; a backslash name is edited as written, \\ for one backslash. *)
check(result.IsOk(sys.Write("$odd/zz$(nl)", "z")), "a name that ends with a line end is made")
w = press.Press(["C-x", "C-q"], press.Press(["g"], gone))
done = press.Press(["C-c", "C-c"], w)
check(done.Message == "No name changed." and sys.Exists("$odd/zz$(nl)") and sys.Exists("$odd/a$(nl)b"), "no edit renames nothing: $(done.Message)")
w = press.Press(["C-x", "C-q"], done)
edits = str.Lines(rope.Text(here(w).Rope))
kz = list.IndexOf("zz\\n", edits)
kb = list.IndexOf("back\\\\slash", edits)
check(not value.IsMissing(kz) and not value.IsMissing(kb), "the names to edit are escaped: $(edits)")
edited = w
edited.Buffers[edited.Current] = text.InsertWords("x", text.Place(kz, 4, here(w)))
refused = press.Press(["C-c", "C-c"], edited)
check(str.Contains("holds a control character", refused.Message) and sys.Exists("$odd/zz$(nl)"), "a name with a control character can't be edited: $(refused.Message)")
w = press.Press(["C-x", "C-q"], done)
edited = w
edited.Buffers[edited.Current] = text.InsertWords("2", text.Place(kb, value.Len(edits[kb]), here(w)))
renamed = press.Press(["C-c", "C-c"], edited)
check(renamed.Message == "Renamed 1 file." and sys.Exists("$odd/back\\slash2") and not sys.Exists("$odd/back\\slash"), "a backslash name is renamed as written: $(renamed.Message)")

result.Unwrap(sys.RemoveTree(folder))
check(not sys.Exists(folder), "the folder is gone")
io.Print("ok")
