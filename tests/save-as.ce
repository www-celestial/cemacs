(** A save of tests/files-check.ce run in a user namespace, where unshare -r maps the person alone: files.ForceSave of the words given to the file given.
    It exits with 0 once the file is saved, else prints the error and exits with 1. Args: the file and the words. *)
use core/files
use std/io
use std/result
use std/sys
use std/value

saved = files.ForceSave(sys.Args[1], sys.Args[2])
if result.IsErr(saved)
  io.Print(value.Text(saved.Error))
  sys.Exit(1)
end
