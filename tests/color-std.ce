(** Every line of every package of the Cesia std goes through color.Tokens, keeping the state: no line may lose a character, and the states that
    ColoredTo gives, through StateAfter, are the ones of Tokens. The sources are those that the binary of Cesia carries, cesia.Libraries, so no
    clone of Cesia is needed. Run from the root of cemacs with: cesia run tests/color-std.ce *)
use std/cesia
use core/color
use std/text as str
use std/bug
use std/io
use std/list
use std/result
use std/value

defn lostIn(path, text)
  state = color.FirstState
  bad = []
  for line in str.Lines(text)
    r = color.Tokens(line, state)
    state = r.State
    if str.Join("", list.Map(t -> t[2], r.Tokens)) != line
      bad = list.Append("$(path): $(line)", bad)
    end
  end
  bad
end

defn statesDifferIn(path, text)
  (** The states at the start of every line given by colored_to must equal the ones given by reading every line with tokens. *)
  allLines = str.Lines(text)
  state = color.FirstState
  expected = [state]
  for line in allLines
    state = color.Tokens(line, state).State
    expected = list.Append(state, expected)
  end
  count = value.Len(allLines)
  if count == 0
    []
  else
    colors = color.ColoredTo(count, n -> allLines[n], color.BlankColors())
    got = [color.StartOf(n, colors) for n in 1..count]
    if value.Equal(got, list.Take(count, expected)) [] else ["$(path)"] end
  end
end

(** The packages of the std that Cesia carries, each {Name, Source}. None at all is a bug of the test. *)
defn libraries()
  found = cesia.Libraries()
  if value.Len(found) == 0
    bug.Panic("Cesia gives no package of its std")
  end
  found
end

bad = list.FlatMap(l -> lostIn(l.Name, l.Source), libraries())
if value.Len(bad) > 0
  bug.Panic("lines that lose a character:\n$(str.Join("\n", list.Take(5, bad)))")
end
differ = list.FlatMap(l -> statesDifferIn(l.Name, l.Source), libraries())
if value.Len(differ) > 0
  bug.Panic("colored_to differs from tokens in:\n$(str.Join("\n", differ))")
end
io.Print("ok")
