-- The colors of the code: a line is read in one pass, by states, and gives words with a role. Nothing here panics, whatever the line:
-- unfinished texts and comments only carry their state to the next line.

-- The role of a keyword: an index in the syntax colors of the theme.
keyword = 1
-- The role of a name that is called.
name = 2
-- The role of a text, interpolations included.
string = 3
-- The role of a number.
number = 4
-- The role of a comment.
comment = 5
-- The role of everything else.
plain = 6
-- The role of a name after a dot.
field = 7

-- The state at the start of a file: in no comment and in no text.
first_state = {comment: 0, text: false}

_keywords = ["if", "else", "end", "for", "in", "while", "break", "return", "defn", "match", "struct", "and", "or", "not", "then", "use", "true", "false", "missing"]

_is_digit(c) = c >= "0" and c <= "9"
_is_name_start(c) = c == "_" or (c >= "a" and c <= "z") or (c >= "A" and c <= "Z") or byte_length(c) > 1
_is_name(c) = _is_name_start(c) or _is_digit(c)
_is_space(c) = c == " " or c == "\t" or c == "\r"

-- Where a comment that holds depth openings ends: {at, depth}, at being the first character after what was read.
defn _comment_end(cs, from, n, depth)
  i = from
  while i <= n and depth > 0
    if cs[i] == "(" and cs[i + 1] == "*"
      depth += 1
      i += 2
    else if cs[i] == "*" and cs[i + 1] == ")"
      depth -= 1
      i += 2
    else
      i += 1
    end
  end
  {at: min(i, n + 1), depth: depth}
end

-- Where a text that is open ends: {at, open}, at being the first character after what was read. Escapes take two characters.
defn _text_end(cs, from, n)
  i = from
  closed = false
  while i <= n and not closed
    c = cs[i]
    if c == "\\" or (c == "\"" and cs[i + 1] == "\"") or (c == "$" and cs[i + 1] == "$")
      i += 2
    else if c == "\""
      closed = true
      i += 1
    else
      i += 1
    end
  end
  {at: min(i, n + 1), open: not closed}
end

-- The end of a number, which may hold letters, digits, underscores and dots followed by a digit.
defn _number_end(cs, from, n)
  i = from + 1
  while i <= n and (_is_name(cs[i]) or (cs[i] == "." and _is_digit(cs[i + 1])))
    i += 1
  end
  i
end

defn _name_end(cs, from, n)
  i = from + 1
  while i <= n and _is_name(cs[i])
    i += 1
  end
  i
end

defn _space_end(cs, from, n)
  i = from + 1
  while i <= n and _is_space(cs[i])
    i += 1
  end
  i
end

-- The role of a name, from the character before it and the one after it.
defn _name_role(word, before, after)
  if before == "."
    field
  else if word in _keywords
    keyword
  else if after == "("
    name
  else
    plain
  end
end

-- Adds a word to the tokens. Two plain words in a row make one.
defn _add(role, words, out)
  last = length(out)
  if role == plain and last > 0 and out[last][1] == plain
    concat(take(last - 1, out), [[plain, "$(out[last][2])$(words)"]])
  else
    push([role, words], out)
  end
end

-- Reads one line given the state at its start: the words with their roles, in order and with every character, and the state at its end.
--
--   tokens("defn f", first_state).tokens[1] --> [1, "defn"]
defn tokens(line, state)
  -- cs holds an empty text before and two after the characters, so that looking around never leaves the list.
  cs = concat([""], concat(chars(line), ["", ""]))
  n = length(cs) - 2
  out = []
  depth = state.comment
  in_text = state.text
  i = 2
  while i <= n
    start = i
    if depth > 0
      r = _comment_end(cs, i, n, depth)
      depth = r.depth
      i = r.at
      out = _add(comment, join("", cs[start:i - 1]), out)
    else if in_text
      r = _text_end(cs, i, n)
      in_text = r.open
      i = r.at
      out = _add(string, join("", cs[start:i - 1]), out)
    else
      c = cs[i]
      if c == "-" and cs[i + 1] == "-"
        i = n + 1
        out = _add(comment, join("", cs[start:n]), out)
      else if c == "(" and cs[i + 1] == "*"
        r = _comment_end(cs, i + 2, n, 1)
        depth = r.depth
        i = r.at
        out = _add(comment, join("", cs[start:i - 1]), out)
      else if c == "\""
        r = _text_end(cs, i + 1, n)
        in_text = r.open
        i = r.at
        out = _add(string, join("", cs[start:i - 1]), out)
      else if _is_digit(c)
        i = _number_end(cs, i, n)
        out = _add(number, join("", cs[start:i - 1]), out)
      else if _is_name_start(c)
        i = _name_end(cs, i, n)
        word = join("", cs[start:i - 1])
        out = _add(_name_role(word, cs[start - 1], cs[i]), word, out)
      else if _is_space(c)
        i = _space_end(cs, i, n)
        out = _add(plain, join("", cs[start:i - 1]), out)
      else
        i += 1
        out = _add(plain, c, out)
      end
    end
  end
  {tokens: out, state: {comment: depth, text: in_text}}
end

-- Nothing is known yet but the state at the start of the first line.
--
--   blank_colors().known --> 1
blank_colors() = {starts: [first_state], known: 1}

-- Can this line change the state? Only a quote or a comment mark can open or close a text or a comment.
_may_change(words) = contains("\"", words) or contains("(*", words) or contains("*)", words)

-- The state at the end of a line, given the one at its start. A line with no quote and no comment mark leaves it as it is, so it is not read.
_state_after(words, state) = if _may_change(words) tokens(words, state).state else state end

-- The state at the start of line number line, once the lines before it are known; line_of(n) gives the text of line n.
--
--   colored_to(2, n -> "(* a", blank_colors()).starts[2].comment --> 1
defn colored_to(line, line_of, colors)
  have = length(colors.starts)
  if line <= have
    {starts: colors.starts, known: have}
  else
    -- scan builds the whole array at once: pushing one state at a time copies the array each time, and a jump to line 19,000 takes seconds.
    later = scan((state, n) -> _state_after(line_of(n), state), colors.starts[have], range(have, line - 1))
    {starts: concat(colors.starts, later), known: line}
  end
end

-- The colors with only the lines before the given one still known, after an edit in it. The first line is always known.
--
--   forget_from(2, colored_to(5, n -> "x", blank_colors())).known --> 2
defn forget_from(line, colors)
  keep = max(1, line)
  if colors.known <= keep
    colors
  else
    {starts: take(keep, colors.starts), known: keep}
  end
end
