(** Tests of the folders: run with cesia test . Those that read and change real folders are in tests/folders-check.ce. *)
use src/buffers
use core/color
use src/emacs
use src/folders
use core/press
use std/rope
use core/text
use std/ui
use core/view
use std/text as str

look = ui.Look(ui.Dark, (words, font) -> Len(words) * 8, 19)
cell = {Width: 8, Height: 19}
(** The Emacs keys with the keys of the apps, as src/cemacs.ce merges them. *)
withApps() = emacs.Config(() -> Merge(Merge(emacs.Keys(), buffers.Keys()), folders.Keys()))
(** A folder of two files, a folder and a hidden folder, all changed 5 minutes ago but a.toml, 2 hours ago. *)
entries = [{Name: "b.ce", IsDir: false, Size: 3250, Modified: 1000.0}, {Name: ".git", IsDir: true, Size: 0, Modified: 1000.0},
  {Name: "src", IsDir: true, Size: 0, Modified: 1000.0}, {Name: "a.toml", IsDir: false, Size: 12, Modified: -6200.0}]
defn listed(hidden, at)
  (** The list of that folder, /p, opened from a file. *)
  s = view.Start([text.Of("x", "/p/x.ce")], look, cell, 800, 600)
  s.Config = withApps
  folders.Shown("/p", entries, hidden, at, 1300.0, s)
end
here(state) = state.Buffers[state.Current]
wordsOf(state) = rope.Text(here(state).Rope)
played(items) = press.Press(items, listed(false, missing))

isKeyBound() = folders.Keys()["C-x d"] == folders.Open
isNamedByItsFolder() = view.BufferName(here(listed(false, missing))) == "/p"
isFoldersFirstHiddenOut() = wordsOf(listed(false, missing)) == "src/             5 min\nb.ce     3.3 kB  5 min\na.toml     12 B  2 h"
isHiddenShown() = Lines(wordsOf(listed(true, missing)))[1] == ".git/            5 min"
isCursorOnTheName() = here(listed(false, "a.toml")).Cursor.Line == 3
isFilterOnTheNameOnly() = wordsOf(played(["m"])) == "a.toml     12 B  2 h"
isBackspaceTakesTheFilterBack() = Len(Lines(wordsOf(played(["m", "backspace"])))) == 3
(** The parts of a row, joined, are its words. *)
partsWords(r) = Join("", Map(p -> p[2], r.Parts))
isPartsAreTheWords() = Len(Filter(r -> partsWords(r) != r.Words, folders.Rows(entries, true, 1300.0))) == 0
roles(r) = Join(",", Map(p -> Text(p[1]), r.Parts))
isFolderAName() = folders.Rows(entries, false, 1300.0)[1].Parts[1][1] == color.Name
isHiddenAComment() = folders.Rows(entries, true, 1300.0)[1].Parts[1][1] == color.Comment
isCodeAString() = folders.Rows(entries, false, 1300.0)[2].Parts[1][1] == color.String
isSettingsAKeyword() = folders.Rows(entries, false, 1300.0)[3].Parts[1][1] == color.Keyword
isSizeANumberAgeAComment() = folders.Rows(entries, false, 1300.0)[2].Parts[3][1] == color.Number and folders.Rows(entries, false, 1300.0)[2].Parts[5][1] == color.Comment
isPathInTheFilterLine() = "/p/m" in Map(c -> c.Text, Filter(c -> c.Kind == "text", view.View(played(["m"]))))
isListReadOnly() = wordsOf(played(["C-k"])) == wordsOf(listed(false, missing))
