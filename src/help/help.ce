(** The keys of a pair: C-x ? lists every key that starts with C-x, with the command it runs and what that command does, and so for each first key of a pair.
    Typing filters them, and enter runs the one under the cursor. *)
use color
use commands
use lists

defn WithHelp(keys)
  (** The keys, with for each first key of a pair its second key ? that lists the pair: C-x ? for C-x. src/cemacs.ce gives it every key of the editor. *)
  firsts = Dict([{Key: Split(" ", k)[1], Value: true} for k in Filter(k -> Contains(" ", k), Keys(keys))])
  Merge(keys, Dict([{Key: "$first ?", Value: s -> Show(first, s)} for first in Keys(firsts)]))
end

defn about(f)
  (** The name of a function and the first sentence of its doc, as cesia doc shows them; a function without a name, as s -> ..., has neither. *)
  doc = Doc(f)
  if IsMissing(doc)
    return {Name: "(a function)", Text: ""}
  end
  parts = Split("\n\n", doc)
  name = Split("(", parts[1])[1]
  text = if Len(parts) > 1 Split("\n", parts[2])[1] else "" end
  {Name: name, Text: text}
end

defn Show(first, state)
  (** Opens the list of the keys that start with first, but this one. Each row shows the key, the name of its command and what it does, in colors. *)
  bindings = commands.Bindings(state)
  wanted = Sort(Filter(k -> StartsWith("$first ", k) and k != "$first ?", Keys(bindings)))
  known = Map(k -> {Key: k, About: about(bindings[k])}, wanted)
  keyWidth = Reduce((w, r) -> Max(w, Len(r.Key)), 0, known)
  nameWidth = Reduce((w, r) -> Max(w, Len(r.About.Name)), 0, known)
  rows = Map(r -> rowOf(r, keyWidth, nameWidth), known)
  commands.ShowList("$first ?", rows, () -> {"enter": run}, state)
end

defn rowOf(r, keyWidth, nameWidth)
  (** The row of a key: the key, the name of its command, and what it does. *)
  parts = [[color.Keyword, PadRight(keyWidth, " ", r.Key)], [color.Plain, "  "], [color.Name, PadRight(nameWidth, " ", r.About.Name)], [color.Plain, "  "],
    [color.Comment, r.About.Text]]
  {Words: Trim(Join("", Map(p -> p[2], parts))), Parts: parts, Item: r.Key}
end

defn run(key, state)
  (** Enter: the list closes, and the command of the key under the cursor runs, as if the key were pressed. *)
  f = commands.Bindings(state)[key]
  f(commands.ToBuffer(lists.Of(state.Buffers[state.Current]).Back, state))
end
