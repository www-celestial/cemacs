(** Tests of the keys of a pair: run with cesia test . *)
use commands
use emacs
use help
use press
use pkg/rope
use text
use pkg/ui
use view

look = ui.Look(ui.Dark, (words, font) -> Len(words) * 8, 19)
cell = {Width: 8, Height: 19}
(** The Emacs keys with the help of every pair, as src/cemacs.ce gives them. *)
withHelp() = emacs.Config(() -> help.WithHelp(emacs.Keys()))
defn twoFiles()
  (** Two files, the first one current. *)
  s = view.Start([text.Of("a", "/p/x.ce"), text.Of("b", "/p/y.ce")], look, cell, 800, 600)
  s.Config = withHelp
  s
end
here(state) = state.Buffers[state.Current]
wordsOf(state) = rope.Text(here(state).Rope)
(** What SDL sends for ? on a US keyboard: the key / with Shift, then the text ?. *)
question = [{Kind: "key", Key: "/", Ctrl: false, Alt: false, Shift: true, Super: false}, {Kind: "text", Text: "?"}]
updated(events, state) = Reduce((s, e) -> commands.Update(e, s), state, events)   (** The state after these events. *)
listed() = updated(question, press.Press(["C-x"], twoFiles()))   (** C-x then ?, as the window sends them. *)

isEveryPairHasHelp() = Has("C-x ?", help.WithHelp(emacs.Keys())) and Has("C-c ?", help.WithHelp(emacs.Keys())) and not Has("C-f ?", help.WithHelp(emacs.Keys()))
isListNamedByThePair() = view.BufferName(here(listed())) == "C-x ?"
isListHasThePairs() = Contains("C-x C-s", wordsOf(listed())) and Contains("Save", wordsOf(listed())) and not Contains("C-c c", wordsOf(listed()))
isHelpNotListed() = not Contains("C-x ?", wordsOf(listed()))
isEnterRunsTheKey() = press.Press(["nextbuf", "enter"], listed()).Current == 2
