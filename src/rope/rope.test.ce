use src/rope
use src/history
use std/num
use std/list
use std/math
use std/text
use std/value

big = text.Join("\n", ["line $k" for k in 1..2000])

isOf() = rope.Text(rope.Of("abc")) == "abc" and rope.Size(rope.Of("abc")) == 3
isBig() = rope.Text(rope.Of(big)) == big and rope.LineCount(rope.Of(big)) == 2000
isBalanced() = rope.Of(big).Height < 8
isInsert() = rope.Text(rope.Insert(1, "XY", rope.Of("abc"))) == "aXYbc"
isInsertEnds() = rope.Text(rope.Insert(0, "<", rope.Insert(3, ">", rope.Of("abc")))) == "<abc>"
isDelete() = rope.Text(rope.Delete(1, 3, rope.Of("abcd"))) == "ad"
isSlice() = rope.Slice(1, 3, rope.Of("abcd")) == "bc"
isLine() = rope.Line(2, rope.Of("a\nbc\nd")) == "bc" and rope.Line(3, rope.Of("a\nbc\nd")) == "d"
isBigLine() = rope.Line(1500, rope.Of(big)) == "line 1500"
isLineStart() = rope.LineStart(3, rope.Of("a\nbc\nd")) == 5 and rope.LineStart(1, rope.Of("x")) == 0
isLineOf() = rope.LineOf(0, rope.Of("a\nb")) == 1 and rope.LineOf(2, rope.Of("a\nb")) == 2 and rope.LineOf(1, rope.Of("a\nb")) == 1
isEmpty() = rope.Text(rope.Of("")) == "" and rope.LineCount(rope.Of("")) == 1 and rope.Line(1, rope.Of("")) == ""
isKeepsTheOriginal() = kept() == "abc"

defn kept()
  r = rope.Of("abc")
  rope.Insert(1, "X", r)
  rope.Text(r)
end

defn isAgainstAModel()
  (** Random edits against a plain text. *)
  r = rope.Of(big)
  model = big
  dice = num.Uniform(3000)
  for k in 1..1000
    n = text.ByteLength(model)
    at = math.Floor(dice[3 * k - 2] * n)
    if dice[3 * k - 1] < 0.6
      piece = if math.Mod(k, 7) == 0 "new\nline" else "ab" end
      r = rope.Insert(at, piece, r)
      before = if at == 0 "" else text.ByteSlice(1, at, model) end
      after = if at == n "" else text.ByteSlice(at + 1, n, model) end
      model = "$before$piece$after"
    else
      to = list.Min(at + math.Floor(dice[3 * k] * 40), n)
      r = rope.Delete(at, to, r)
      before = if at == 0 "" else text.ByteSlice(1, at, model) end
      after = if to == n "" else text.ByteSlice(to + 1, n, model) end
      model = "$before$after"
    end
    (* The count of lines only moves by steps, so a drift stays visible at the next check. *)
    if r.Size != text.ByteLength(model) or (math.Mod(k, 50) == 0 and r.Lines != value.Len(text.Split("\n", model)) - 1)
      return false
    end
  end
  rope.Text(r) == model and rope.Line(rope.LineCount(r), r) == text.Split("\n", model)[rope.LineCount(r)]
end

isHistory() = history.Current(history.Undo(history.Record(2, history.Of(1)))) == 1
isRedo() = history.Current(history.Redo(history.Undo(history.Record(2, history.Of(1))))) == 2
isRecordClearsRedo() = not history.CanRedo(history.Record(3, history.Undo(history.Record(2, history.Of(1)))))
isUndoAtStart() = history.Current(history.Undo(history.Of(1))) == 1 and history.Current(history.Redo(history.Of(1))) == 1
isLimit() = value.Len(list.Reduce((h, x) -> history.Record(x, h), history.Of(0, limit = 3), [1, 2, 3, 4, 5]).Past) == 3

defn balanced(r)
  (** Do the two sides of every node differ in height by at most one, as in an AVL tree, with the height and the counts right? *)
  if value.IsMissing(r.Left)
    return r.Height == 0 and r.Size == text.ByteLength(r.Text) and text.ByteLength(r.Text) <= 1024
  end
  counted = r.Size == r.Left.Size + r.Right.Size and r.Lines == r.Left.Lines + r.Right.Lines
  balanced(r.Left) and balanced(r.Right) and math.Abs(r.Left.Height - r.Right.Height) <= 1 and r.Height == 1 + list.Max(r.Left.Height, r.Right.Height) and counted
end

(** A rope made of a text of every size around a power of two of leaves is an AVL tree, with the text and its lines whole. *)
isOfBalanced() = list.All([whole(text.ByteSlice(1, n, text.Repeat(70, big))) for n in [1025, 2048, 2049, 3073, 5000, 9216, 33793, 65537, 200000]])

whole(s) = balanced(rope.Of(s)) and rope.Text(rope.Of(s)) == s and rope.LineCount(rope.Of(s)) == value.Len(text.Split("\n", s))   (** Balanced, and the same text. *)

(** A text of 200,000 bytes with the word "needle" at a place: Find and FindBefore must see it from every side, across the windows of 64 KiB and
    more, and in either case with fold. *)
withNeedle(at) = "$(text.Repeat(at, "x"))needle$(text.Repeat(200000 - at, "y"))"
defn isFindEverywhere()
  for at in [0, 1, 65530, 65531, 65535, 65536, 131071, 196600, 200000]
    r = rope.Of(withNeedle(at))
    if rope.Find("needle", 0, r) != at or rope.Find("needle", at, r) != at or not value.IsMissing(rope.Find("needle", at + 1, r))
      return false
    end
    if rope.FindBefore("needle", at + 1, r) != at or not value.IsMissing(rope.FindBefore("needle", at, r)) or rope.FindBefore("needle", rope.Size(r) + 1, r) != at
      return false
    end
    if rope.Find("needle", 0, rope.Of(text.Upper(withNeedle(at))), fold = true) != at or not value.IsMissing(rope.Find("needle", 0, rope.Of(text.Upper(withNeedle(at)))))
      return false
    end
  end
  true
end

isFindLastOfMany() = rope.FindBefore("ab", 9, rope.Of("ab ab ab ab")) == 6 and rope.Find("ab", 1, rope.Of("ab ab ab ab")) == 3   (** The nearest place either way. *)
