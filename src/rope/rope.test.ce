use src/rope
use src/history
use std/num
use std/list
use std/math
use std/text
use std/value
use std/gen
use std/test

big = text.Join("\n", ["line $k" for k in 1..2000])

isOf() = rope.Text(rope.Of("abc")) == "abc" and rope.Size(rope.Of("abc")) == 3
isBig() = rope.Text(rope.Of(big)) == big and rope.LineCount(rope.Of(big)) == 2000
isBalanced() = rope.Of(big).Height < 8
isInsert() = rope.Text(rope.Insert(1, "XY", rope.Of("abc"))) == "aXYbc"
isInsertEnds() = rope.Text(rope.Insert(0, "<", rope.Insert(3, ">", rope.Of("abc")))) == "<abc>"
isDelete() = rope.Text(rope.Delete(1, 3, rope.Of("abcd"))) == "ad"
isSlice() = rope.Slice(1, 3, rope.Of("abcd")) == "bc"
isLine() = rope.Line(2, rope.Of("a\nbc\nd")) == "bc" and rope.Line(3, rope.Of("a\nbc\nd")) == "d"
isBigLine() = rope.Line(1500, rope.Of(big)) == "line 1500"
isLineStart() = rope.LineStart(3, rope.Of("a\nbc\nd")) == 5 and rope.LineStart(1, rope.Of("x")) == 0
isLineOf() = rope.LineOf(0, rope.Of("a\nb")) == 1 and rope.LineOf(2, rope.Of("a\nb")) == 2 and rope.LineOf(1, rope.Of("a\nb")) == 1
isEmpty() = rope.Text(rope.Of("")) == "" and rope.LineCount(rope.Of("")) == 1 and rope.Line(1, rope.Of("")) == ""
isKeepsTheOriginal() = kept() == "abc"

defn kept()
  r = rope.Of("abc")
  rope.Insert(1, "X", r)
  rope.Text(r)
end

defn isAgainstAModel()
  (** Random edits against a plain text. *)
  r = rope.Of(big)
  model = big
  dice = num.Uniform(3000)
  for k in 1..1000
    n = text.ByteLength(model)
    at = math.Floor(dice[3 * k - 2] * n)
    if dice[3 * k - 1] < 0.6
      piece = if math.Mod(k, 7) == 0 "new\nline" else "ab" end
      r = rope.Insert(at, piece, r)
      before = if at == 0 "" else text.ByteSlice(1, at, model) end
      after = if at == n "" else text.ByteSlice(at + 1, n, model) end
      model = "$before$piece$after"
    else
      to = list.Min(at + math.Floor(dice[3 * k] * 40), n)
      r = rope.Delete(at, to, r)
      before = if at == 0 "" else text.ByteSlice(1, at, model) end
      after = if to == n "" else text.ByteSlice(to + 1, n, model) end
      model = "$before$after"
    end
    (* The count of lines only moves by steps, so a drift stays visible at the next check. *)
    if r.Size != text.ByteLength(model) or (math.Mod(k, 50) == 0 and r.Lines != value.Len(text.Split("\n", model)) - 1)
      return false
    end
  end
  rope.Text(r) == model and rope.Line(rope.LineCount(r), r) == text.Split("\n", model)[rope.LineCount(r)]
end

isHistory() = history.Current(history.Undo(history.Record(2, history.Of(1)))) == 1
isRedo() = history.Current(history.Redo(history.Undo(history.Record(2, history.Of(1))))) == 2
isRecordClearsRedo() = not history.CanRedo(history.Record(3, history.Undo(history.Record(2, history.Of(1)))))
isUndoAtStart() = history.Current(history.Undo(history.Of(1))) == 1 and history.Current(history.Redo(history.Of(1))) == 1
isLimit() = value.Len(list.Reduce((h, x) -> history.Record(x, h), history.Of(0, limit = 3), [1, 2, 3, 4, 5]).Past) == 3

defn balanced(r)
  (** Do the two sides of every node differ in height by at most one, as in an AVL tree, with the height and the counts right? A leaf views at most 16 KiB
      of its text, and counts the line ends it views. *)
  if value.IsMissing(r.Left)
    viewed = if r.Size == 0 "" else text.ByteSlice(r.Start + 1, r.Start + r.Size, r.Text) end
    return r.Height == 0 and r.Start >= 0 and r.Start + r.Size <= text.ByteLength(r.Text) and r.Size <= 16384 and r.Lines == text.Count("\n", viewed)
  end
  counted = r.Size == r.Left.Size + r.Right.Size and r.Lines == r.Left.Lines + r.Right.Lines
  balanced(r.Left) and balanced(r.Right) and math.Abs(r.Left.Height - r.Right.Height) <= 1 and r.Height == 1 + list.Max(r.Left.Height, r.Right.Height) and counted
end

(** A rope made of a text of every size around a power of two of leaves is an AVL tree, with the text and its lines whole. *)
isOfBalanced() = list.All([whole(text.ByteSlice(1, n, text.Repeat(70, big))) for n in [1025, 2048, 2049, 3073, 5000, 9216, 33793, 65537, 200000]])

whole(s) = balanced(rope.Of(s)) and rope.Text(rope.Of(s)) == s and rope.LineCount(rope.Of(s)) == value.Len(text.Split("\n", s))   (** Balanced, and the same text. *)

(** A text of 200,000 bytes with the word "needle" at a place: Find and FindBefore must see it from every side, across the windows of 64 KiB and
    more, and in either case with fold. *)
withNeedle(at) = "$(text.Repeat(at, "x"))needle$(text.Repeat(200000 - at, "y"))"
defn isFindEverywhere()
  for at in [0, 1, 65530, 65531, 65535, 65536, 131071, 196600, 200000]
    r = rope.Of(withNeedle(at))
    if rope.Find("needle", 0, r) != at or rope.Find("needle", at, r) != at or not value.IsMissing(rope.Find("needle", at + 1, r))
      return false
    end
    if rope.FindBefore("needle", at + 1, r) != at or not value.IsMissing(rope.FindBefore("needle", at, r)) or rope.FindBefore("needle", rope.Size(r) + 1, r) != at
      return false
    end
    if rope.Find("needle", 0, rope.Of(text.Upper(withNeedle(at))), fold = true) != at or not value.IsMissing(rope.Find("needle", 0, rope.Of(text.Upper(withNeedle(at)))))
      return false
    end
  end
  true
end

isFindLastOfMany() = rope.FindBefore("ab", 9, rope.Of("ab ab ab ab")) == 6 and rope.Find("ab", 1, rope.Of("ab ab ab ab")) == 3   (** The nearest place either way. *)

(* ---- Views of a large text: random edits against a plain text, with long deletes across views, and the lines read at random places. *)
large = text.Join("\n", ["line $k of the large text" for k in 1..8000])

defn isViewsAgainstAModel()
  r = rope.Of(large)
  model = large
  dice = num.Uniform(4000)
  for k in 1..800
    n = text.ByteLength(model)
    at = math.Floor(dice[5 * k - 4] * n)
    if dice[5 * k - 3] < 0.5
      piece = if math.Mod(k, 5) == 0 "new\nline\n" else "ab" end
      r = rope.Insert(at, piece, r)
      model = "$(text.ByteSlice(1, at, model))$piece$(text.ByteSlice(at + 1, n, model))"
    else
      to = list.Min(at + math.Floor(dice[5 * k - 2] * (if math.Mod(k, 9) == 0 40000 else 60 end)), n)
      r = rope.Delete(at, to, r)
      model = "$(text.ByteSlice(1, at, model))$(text.ByteSlice(to + 1, n, model))"
    end
    lines = text.Split("\n", model)
    line = 1 + math.Floor(dice[5 * k - 1] * value.Len(lines))
    place = math.Floor(dice[5 * k] * (text.ByteLength(model) + 1))
    if r.Size != text.ByteLength(model) or rope.Line(line, r) != lines[line] or rope.LineOf(place, r) != value.Len(text.Split("\n", text.ByteSlice(1, place, model)))
      return false
    end
  end
  rope.Text(r) == model and balanced(r)
end

defn isJoinOfTouchingViews()
  (** Two views that touch in one text join back into one view, and the text of a rope whose views cover one text whole is that text. *)
  r = rope.Of(large)
  parts = rope.SplitAt(100000, r)
  again = rope.JoinRopes(parts[1], parts[2])
  halves = rope.SplitAt(50, rope.Of(text.ByteSlice(1, 10000, large)))
  one = rope.JoinRopes(halves[1], halves[2])
  rope.Text(again) == large and value.IsMissing(one.Left) and one.Size == 10000 and balanced(again)
end

(* ---- Search over runs of views: a text of 100 KB edited at a few places, so that the rope holds runs that view the end of the file, runs that
   don't, and typed texts between; Find and FindBefore against a plain search of the same text, both cases, with and without fold. *)
defn plainFind(part, from, s, fold)
  (** The first place, from 0, of part at or after from in s, read byte by byte, or missing. *)
  m = text.ByteLength(part)
  n = text.ByteLength(s)
  p = if fold text.Lower(part) else part end
  for at in list.Max(0, from)..(n - m)
    piece = text.ByteSlice(at + 1, at + m, s)
    if (if fold text.Lower(piece) else piece end) == p
      return at
    end
  end
  missing
end

defn plainFindBefore(part, before, s, fold)
  (** The last place, from 0, of part that starts before the position before, or missing. *)
  last = missing
  at = plainFind(part, 0, s, fold)
  while not value.IsMissing(at) and at < before
    last = at
    at = plainFind(part, at + 1, s, fold)
  end
  last
end

searched = text.Join("", ["$(if math.Mod(k, 97) == 0 "AbBa\n" else "aabb " end)" for k in 1..20000])

defn editedForSearch()
  (** The text, and a rope of it with three inserts and a delete: {Rope, Model}. *)
  r = rope.Of(searched)
  model = searched
  for step in [[30000, "baBA"], [70000, "Abba"], [99990, "zz"]]
    r = rope.Insert(step[1], step[2], r)
    model = "$(text.ByteSlice(1, step[1], model))$(step[2])$(text.ByteSlice(step[1] + 1, text.ByteLength(model), model))"
  end
  r = rope.Delete(50000, 50010, r)
  model = "$(text.ByteSlice(1, 50000, model))$(text.ByteSlice(50011, text.ByteLength(model), model))"
  {Rope: r, Model: model}
end

searchCase = gen.Of({Part: gen.Pick(["abba", "baba", "Abba", "zz", "a\naa", "bAbA", "ba", "AbBa\naa", "b baBAa", "b aAbbaab", "aazzbb", "aabb aabb a"]), From: gen.Int(0, 100010), Fold: gen.Bool()})
isFindAsPlain() = test.ForAll(c -> rope.Find(c.Part, c.From, editedForSearch().Rope, fold = c.Fold) == plainFind(c.Part, c.From, editedForSearch().Model, c.Fold), searchCase, cases = 60)
isFindBeforeAsPlain() = test.ForAll(c -> rope.FindBefore(c.Part, c.From, editedForSearch().Rope, fold = c.Fold) == plainFindBefore(c.Part, c.From, editedForSearch().Model, c.Fold), searchCase, cases = 30)
isFindAcrossAnEdit() = list.All([rope.Find(p, 0, editedForSearch().Rope) == plainFind(p, 0, editedForSearch().Model, false) and not value.IsMissing(plainFind(p, 0, editedForSearch().Model, false)) for p in ["b baBAa", "b aAbbaab", "aazzbb"]])
