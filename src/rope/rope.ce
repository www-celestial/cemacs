(** A persistent text: a balanced tree of pieces, each a view {Text, Start, Size} of a text kept by reference, as a piece table keeps its spans
    (Crowley 1998) and VS Code's piece tree its chunks (Lyu 2018). Opening a file cuts its one text into views without copying a byte, an edit copies the
    path to its leaf and stays logarithmic, and a copy is free. Positions count bytes from 0, and lines count from 1. *)
use std/list
use std/math
use std/text
use std/value

chunk = 1024

(** The size of the views that Of cuts, in bytes, and the largest view that a join makes of two that touch. A function: a variable added under --watch
    is read before it has a value. *)
piece() = 16384

(* The size of the blocks in which a view's line ends are counted: a slice under 2 KiB is made in OCaml's minor heap and dies young. *)
block() = 2048

newlines(s) = text.Count("\n", s)   (** The line ends of a text, counted by Cesia eight bytes at a time. *)

defn countIn(t, start, size)
  (** The line ends of the size bytes of t from position start, counted a block at a time. *)
  k = 0
  at = start
  last = start + size
  while at < last
    upTo = list.Min(at + block(), last)
    k += newlines(text.ByteSlice(at + 1, upTo, t))
    at = upTo
  end
  k
end

view(t, start, size, lines) = {Left: missing, Right: missing, Text: t, Start: start, Size: size, Lines: lines, Height: 0}   (** A leaf: a view of t. *)
leaf(s) = view(s, 0, text.ByteLength(s), newlines(s))   (** A leaf that is a whole text. *)
isLeaf(r) = value.IsMissing(r.Left)
(** The bytes of a leaf: its text itself when the view covers it whole, else a copy of the part it views. *)
leafText(r) = if r.Start == 0 and r.Size == text.ByteLength(r.Text) r.Text else text.ByteSlice(r.Start + 1, r.Start + r.Size, r.Text) end
(** Do two leaves view one text, the second starting where the first ends? The places are compared first: comparing two texts reads them. *)
touching(a, b) = a.Start + a.Size == b.Start and a.Text == b.Text

defn node(a, b)
  {Left: a, Right: b, Text: "", Start: 0, Size: a.Size + b.Size, Lines: a.Lines + b.Lines, Height: 1 + list.Max(a.Height, b.Height)}
end

defn balance(a, b)
  if a.Height > b.Height + 1
    if a.Left.Height >= a.Right.Height
      node(a.Left, node(a.Right, b))
    else
      node(node(a.Left, a.Right.Left), node(a.Right.Right, b))
    end
  else if b.Height > a.Height + 1
    if b.Right.Height >= b.Left.Height
      node(node(a, b.Left), b.Right)
    else
      node(node(a, b.Left.Left), node(b.Left.Right, b.Right))
    end
  else
    node(a, b)
  end
end

defn JoinRopes(a, b)
  (** Both ropes, one after the other.

        Text(JoinRopes(Of("ab"), Of("cd"))) --> "abcd" *)
  if a.Size == 0
    b
  else if b.Size == 0
    a
  else if isLeaf(a) and isLeaf(b) and a.Size + b.Size <= piece() and touching(a, b)
    view(a.Text, a.Start, a.Size + b.Size, a.Lines + b.Lines)
  else if isLeaf(a) and isLeaf(b) and a.Size + b.Size <= chunk
    leaf("$(leafText(a))$(leafText(b))")
  else if a.Height > b.Height + 1
    balance(a.Left, JoinRopes(a.Right, b))
  else if b.Height > a.Height + 1
    balance(JoinRopes(a, b.Left), b.Right)
  else
    node(a, b)
  end
end

defn Of(s)
  (** A rope holding a text: views of piece() bytes of it cut one after the other, with no copy of a byte, then put under nodes two by two, level by
      level, into a balanced tree. A file of 99.9 MB is 6,097 views and as many nodes: Cesia makes a record in a few hundred nanoseconds, so fewer and
      larger leaves open a file faster, and views of it cost no second copy of its bytes.

        Text(Of("ab")) --> "ab" *)
  n = text.ByteLength(s)
  if n <= piece()
    return leaf(s)
  end
  level = []
  at = 0
  while at < n
    m = list.Min(piece(), n - at)
    level = list.Append(view(s, at, m, countIn(s, at, m)), level)
    at += m
  end
  while value.Len(level) > 1
    level = paired(level)
  end
  level[1]
end

defn paired(level)
  (** The level above: the ropes put under a node two by two, and an odd last one joined to the last pair, which JoinRopes keeps in balance. A node, not
      JoinRopes, holds the first pairs: two views that touch would become one. *)
  out = []
  k = 1
  n = value.Len(level)
  while k < n
    out = list.Append(node(level[k], level[k + 1]), out)
    k += 2
  end
  if k == n
    out[value.Len(out)] = JoinRopes(out[value.Len(out)], level[k])
  end
  out
end

defn SplitAt(at, r)
  (** The bytes before a position, and the others. *)
  if at <= 0
    [leaf(""), r]
  else if at >= r.Size
    [r, leaf("")]
  else if isLeaf(r)
    first = countIn(r.Text, r.Start, at)
    [view(r.Text, r.Start, at, first), view(r.Text, r.Start + at, r.Size - at, r.Lines - first)]
  else if at < r.Left.Size
    parts = SplitAt(at, r.Left)
    [parts[1], JoinRopes(parts[2], r.Right)]
  else
    parts = SplitAt(at - r.Left.Size, r.Right)
    [JoinRopes(r.Left, parts[1]), parts[2]]
  end
end

(** The size of the rope in bytes.

      Size(Of("ab")) --> 2 *)
Size(r) = r.Size
(** The number of lines: one more than the line ends.

      LineCount(Of("a\nb")) --> 2 *)
LineCount(r) = r.Lines + 1

defn Insert(at, s, r)
  (** A rope with a text inserted before the byte at a position.

        Text(Insert(1, "X", Of("ab"))) --> "aXb" *)
  parts = SplitAt(at, r)
  JoinRopes(JoinRopes(parts[1], Of(s)), parts[2])
end

defn Delete(from, to, r)
  (** A rope without the bytes from position from up to, but not including, position to.

        Text(Delete(1, 2, Of("abc"))) --> "ac" *)
  parts = SplitAt(from, r)
  JoinRopes(parts[1], SplitAt(to - from, parts[2])[2])
end

defn collected(from, to, r, acc)
  (** acc with the texts of the leaves between the positions from and to, the first and the last cut to them, in order. No node is made: a slice
      only reads the tree. *)
  if from >= to or to <= 0 or from >= r.Size
    acc
  else if isLeaf(r)
    list.Append(if from <= 0 and to >= r.Size leafText(r) else text.ByteSlice(r.Start + list.Max(from, 0) + 1, r.Start + list.Min(to, r.Size), r.Text) end, acc)
  else
    collected(from - r.Left.Size, to - r.Left.Size, r.Right, collected(from, to, r.Left, acc))
  end
end

defn Text(r)
  (** The whole text of the rope: the text itself, with no copy, when the leaves view one text from its first byte to its last, as after an open or an
      undo back to it.

        Text(Of("hi")) --> "hi" *)
  same = sameText(r, missing)
  if not value.IsMissing(same) and same.At == r.Size and text.ByteLength(same.Text) == r.Size
    return same.Text
  end
  whole(collected(0, r.Size, r, []))
end

defn sameText(r, acc)
  (** {Text, At} when the leaves of r, after those that acc stands for, view one text from position 0, each starting where the one before ended; else
      missing. *)
  if isLeaf(r)
    if r.Size == 0
      acc
    else if value.IsMissing(acc)
      if r.Start == 0 {Text: r.Text, At: r.Size} else missing end
    else
      if r.Start == acc.At and r.Text == acc.Text {Text: r.Text, At: acc.At + r.Size} else missing end
    end
  else
    left = sameText(r.Left, acc)
    if value.IsMissing(left) and r.Left.Size > 0
      missing
    else
      sameText(r.Right, left)
    end
  end
end

(** The text of the bytes from position from up to, but not including, position to.

      Slice(1, 3, Of("hello")) --> "el" *)
Slice(from, to, r) = whole(collected(from, to, r, []))

(** The parts joined, or the one part itself, which needs no copy. *)
whole(parts) = if value.Len(parts) == 1 parts[1] else text.Join("", parts) end

defn afterNewline(n, r)
  (** The position of the first byte after the nth newline. *)
  if n <= 0
    0
  else if isLeaf(r)
    nthIn(n, r)
  else if n <= r.Left.Lines
    afterNewline(n, r.Left)
  else
    r.Left.Size + afterNewline(n - r.Left.Lines, r.Right)
  end
end

defn nthIn(n, r)
  (** The position after the nth line end of a leaf: its blocks are counted until the one that holds it, then that block alone is searched, so that a
      view of piece() bytes takes at most 8 counts and a search of one block, each on a small text. *)
  at = r.Start
  last = r.Start + r.Size
  left = n
  while at < last
    upTo = list.Min(at + block(), last)
    part = text.ByteSlice(at + 1, upTo, r.Text)
    c = newlines(part)
    if c >= left
      found = 0
      for k in 1..left
        found = text.ByteFind("\n", found + 1, part)
      end
      return at + found - r.Start
    end
    left -= c
    at = upTo
  end
  r.Size
end

(** The position of the first byte of line n.

      LineStart(2, Of("ab\ncd")) --> 3 *)
LineStart(n, r) = afterNewline(n - 1, r)

defn LineEnd(n, r)
  (** The position of the end of line n, before its line end.

        LineEnd(1, Of("ab\ncd")) --> 2 *)
  if n >= LineCount(r) r.Size else LineStart(n + 1, r) - 1 end
end

(** The text of line n, without its line end.

      Line(2, Of("ab\ncd")) --> "cd" *)
Line(n, r) = Slice(LineStart(n, r), LineEnd(n, r), r)

defn LineOf(at, r)
  (** The line of a position. *)
  if at <= 0
    1
  else if at >= r.Size
    r.Lines + 1
  else if isLeaf(r)
    countIn(r.Text, r.Start, at) + 1
  else if at <= r.Left.Size
    LineOf(at, r.Left)
  else
    r.Left.Lines + LineOf(at - r.Left.Size, r.Right)
  end
end

(* A search reads the text a window at a time: 64 KiB first, each next window twice as large, up to 1 MiB, so that a place near the start costs little
   and a far one a few large reads. Functions, as a variable added under --watch would be read before it has a value. *)
firstWindow() = 65536
lastWindow() = 1048576

defn Find(part, from, r, fold = false)
  (** The position of the first place of part that starts at or after the position from, or missing. With fold, the ASCII letters of the text count
      in either case, and part is written in lower case. Each window overlaps the one before by the length of part less one, so that a place across
      two windows is found.

        Find("b", 0, Of("abcb")) --> 1
        Find("b", 2, Of("abcb")) --> 3
        Find("b", 0, Of("aBc"), fold = true) --> 1 *)
  m = text.ByteLength(part)
  at = list.Max(0, from)
  size = list.Max(firstWindow(), 2 * m)
  while at + m <= r.Size
    last = list.Min(at + size, r.Size)
    found = text.ByteFind(part, 1, looked(Slice(at, last, r), fold))
    if not value.IsMissing(found)
      return at + found - 1
    end
    if last == r.Size
      return missing
    end
    at = last - m + 1
    size = list.Min(2 * size, list.Max(lastWindow(), 2 * m))
  end
  missing
end

defn FindBefore(part, before, r, fold = false)
  (** The position of the last place of part that starts before the position before, or missing, with fold as for Find. The windows go back from
      there, each overlapping the one after it by the length of part less one.

        FindBefore("b", 4, Of("abcb")) --> 3
        FindBefore("b", 3, Of("abcb")) --> 1
        FindBefore("b", 1, Of("abcb")) --> missing *)
  m = text.ByteLength(part)
  high = list.Min(before - 1 + m, r.Size)
  size = list.Max(firstWindow(), 2 * m)
  while m > 0 and high >= m
    low = list.Max(0, high - size)
    found = lastIn(part, looked(Slice(low, high, r), fold))
    if not value.IsMissing(found)
      return low + found - 1
    end
    if low == 0
      return missing
    end
    high = low + m - 1
    size = list.Min(2 * size, list.Max(lastWindow(), 2 * m))
  end
  missing
end

looked(s, fold) = if fold text.Lower(s) else s end   (** A window as a search reads it: in lower case when it folds. *)

defn lastIn(part, s)
  (** The byte position, from 1, of the last place of part in s, or missing. *)
  last = missing
  at = text.ByteFind(part, 1, s)
  while not value.IsMissing(at)
    last = at
    at = text.ByteFind(part, at + 1, s)
  end
  last
end
