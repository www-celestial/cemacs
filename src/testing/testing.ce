(** The tests for src/ide: what C-c t t tests, the test function the cursor is in, in a .test.ce file, or else the folder of the file, its package; and
    the failures that cesia test wrote, as marks for the lines of their files. tools/testing.ce runs it for each question, with the read permission, so that
    none of it loads at the start of the editor; the tests themselves run through cesia test, as a program of the editor runs, with the permissions that
    [test] of cesia.toml gives them and no more. *)
use std/dict
use std/list
use std/regex
use std/text as str
use std/value

defn TestAt(lines, line)
  (** The test function of a file that a line is in: the name of the nearest definition at the top of the file, at the line or above it, when it is a test,
      is and a capital; or missing.

        TestAt(["isA() = true", "defn isB()", "  x", "end"], 3) --> "isB"
        TestAt(["defn helper()", "  1", "end"], 2) --> missing *)
  k = list.Min(line, value.Len(lines))
  while k >= 1
    m = regex.Find("^(defn +)?([A-Za-z][A-Za-z0-9]*)\\(", lines[k])
    if not value.IsMissing(m)
      return if regex.Test("^is[A-Z]", m.Groups[2]) m.Groups[2] else missing end
    end
    k -= 1
  end
  missing
end

defn Relative(p, pwd)
  (** A path from the folder Cemacs started in, where cesia test runs, when it is inside it.

        Relative("/p/src/a.ce", "/p") --> "src/a.ce"
        Relative("/q/a.ce", "/p") --> "/q/a.ce" *)
  if str.StartsWith("$pwd/", p) str.Slice(value.Len(pwd) + 2, value.Len(p), p) else p end
end

defn TargetOf(p, words, line, pwd)
  (** What C-c t t tests for a file at the path p, of these words, the cursor on a line: path:isName for the test function the cursor is in, in a .test.ce
      file, or else the folder of the file, the package with its tests, from the folder pwd; missing for a file that isn't one of Cesia.

        TargetOf("/p/src/a/a.test.ce", "isA() = true", 1, "/p") --> "src/a/a.test.ce:isA"
        TargetOf("/p/src/a/a.ce", "x = 1", 1, "/p") --> "src/a"
        TargetOf("/p/a.ce", "x = 1", 1, "/p") --> "." *)
  if not str.EndsWith(".ce", p)
    return missing
  end
  name = if str.EndsWith(".test.ce", p) TestAt(str.Split("\n", words), line) else missing end
  if not value.IsMissing(name)
    return "$(Relative(p, pwd)):$name"
  end
  dir = str.Join("/", list.DropLast(1, str.Split("/", p)))
  if dir == pwd "." else Relative(dir, pwd) end
end

defn Failures(lines, pwd)
  (** The failures in the output of cesia test, run from the folder pwd, each {Path, Line, Message}: a line that starts with the path of a file of Cesia and
      a line, and its words, with the first two lines under it that tell more.

        Failures(["src/a.test.ce:4: isA failed", "  f(1) == 2", "  | f(1) = 3", "  more", "1 passed, 1 failed"], "/p") --> [{Path: "/p/src/a.test.ce", Line: 4, Message: "isA failed  f(1) == 2  | f(1) = 3"}] *)
  out = []
  for k in 1..value.Len(lines)
    m = regex.Find("^([^ :][^:]*[.]ce):([0-9]+): (.*)$", lines[k])
    if not value.IsMissing(m)
      more = list.TakeWhile(l -> str.StartsWith("  ", l), list.Take(2, list.Skip(k, lines)))
      p = if str.StartsWith("/", m.Groups[1]) m.Groups[1] else "$pwd/$(m.Groups[1])" end
      out = list.Append({Path: p, Line: str.Number(m.Groups[2]), Message: str.Join("  ", list.Prepend(m.Groups[3], [str.Trim(l) for l in more]))}, out)
    end
  end
  out
end

(* ---- Questions, in the words of src/ide *)

defn Answered(q)
  (** The answer to a question of src/ide: Do here and all ask src/ide to run cesia test, on the target of the cursor or on the whole project, and to send
      its output, once it ends, with Do ended, whose answer marks each failure and says the count. *)
  if not value.IsDict(q) or not value.IsText(dict.GetOr("Do", missing, q)) or not value.IsText(dict.GetOr("Pwd", missing, q))
    return {Error: "A question needs Do and a Pwd."}
  end
  ended = {Program: "testing", Do: "ended"}
  if q.Do == "here"
    target = if value.IsText(dict.GetOr("Path", missing, q)) TargetOf(q.Path, value.Text(dict.GetOr("Text", "", q)), dict.GetOr("Line", 1, q), q.Pwd) else missing end
    return if value.IsMissing(target) {Say: "Tests are those of a file of Cesia."} else {Run: {Args: ["test", target], Words: "Testing: cesia test $target", Then: ended}} end
  else if q.Do == "all"
    return {Run: {Args: ["test"], Words: "Testing: cesia test", Then: ended}}
  else if q.Do == "ended"
    lines = [value.Text(l) for l in if value.IsArray(dict.GetOr("Lines", missing, q)) q.Lines else [] end]
    counted = list.Last([l for l in lines if regex.Test("^[0-9]+ passed, [0-9]+ failed", l)])
    return {Marks: Failures(lines, q.Pwd), Say: if value.IsMissing(counted) "The tests ended without their count." else counted end}
  end
  {Error: "Unknown question: $(q.Do)."}
end
