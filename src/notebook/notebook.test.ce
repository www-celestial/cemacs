(** Tests of the checks of a scene from the session, which is input: wrong shapes and sizes past the limits are refused before anything is made. And
    of the sliders and the other inputs of a form, without a session: drawn from the text, changed by an edit of their value that is checked first, by
    the keys and by the mouse. *)
use core/commands
use core/text
use core/view
use src/emacs
use src/notebook
use src/rope
use src/sdl
use src/ui
use std/cells as nb
use std/dict
use std/fiber
use std/gen
use std/list
use std/math
use std/result
use std/sys
use std/test
use std/text as str
use std/value

scene(items) = {Width: 640, Height: 400, Items: items}   (** A scene of these items. *)

isSaneSceneAccepted() = value.IsMissing(notebook.SceneFault(scene([{Kind: "line", Xs: [1.0, 2.0, missing], Ys: [3.0, 4.0, missing], Width: 1.5, Dash: missing, Color: "ink"}])))
isHugeSceneRefused() = value.IsSome(notebook.SceneFault({Width: 100000, Height: 400, Items: []}))
isTooManyMarksRefused() = str.StartsWith("a marks has", notebook.SceneFault(scene([{Kind: "marks", Xs: list.Fill(1.0, 250001), Ys: list.Fill(1.0, 250001), Size: 6, Shape: "circle", Color: "#000000"}])))
isTextPointRefused() = value.IsSome(notebook.SceneFault(scene([{Kind: "area", Xs: [1.0, "x"], Ys: [1.0, 2.0], Color: "#000000"}])))
isCellsWithoutColorsRefused() = value.IsSome(notebook.SceneFault(scene([{Kind: "cells", Xs: [0.0, 1.0, 2.0], Ys: [0.0, 1.0], Colors: ["#000000"]}])))
isUnknownKindRefused() = value.IsSome(notebook.SceneFault(scene([{Kind: "polygon"}])))
(* A dash-dot line of std/plot has four lengths, on, off, on, off; three, or a length below half a pixel, is no dash. *)
isDashDotAccepted() = value.IsMissing(notebook.SceneFault(scene([{Kind: "line", Xs: [1.0, 2.0], Ys: [3.0, 4.0], Width: 1, Dash: [6.4, 1.6, 1.0, 1.6], Color: "ink"}]))) and value.IsSome(notebook.SceneFault(scene([{Kind: "line", Xs: [1.0, 2.0], Ys: [3.0, 4.0], Width: 1, Dash: [6.4, 1.6, 1.0], Color: "ink"}]))) and value.IsSome(notebook.SceneFault(scene([{Kind: "line", Xs: [1.0, 2.0], Ys: [3.0, 4.0], Width: 1, Dash: [0.1, 1.6], Color: "ink"}])))
(* The colours of the theme: "ink" for the axes, the texts and the layers without a colour, "grid" for the grid, "paper", the ground of the code, behind
   the box of a note; a colour of the data stays. *)
isThemed() = value.Equal([x.Color for x in themed([{Kind: "rect", Color: "paper"}, {Kind: "line", Color: "grid"}, {Kind: "text", Color: "ink"}, {Kind: "marks", Color: 0xd55e00}], ui.Light)], [ui.Light.Code, ui.Light.Line, ui.Light.Ink, 0xd55e00])
(* The texts of a graph are drawn in the font of the code, JetBrains Mono, as std/plot measures them, and the characters it lacks in Noto Sans. *)
isGraphFontTheCode() = value.Equal(notebook.Prepared({Width: 100, Height: 80, Items: []}, "/c"), {Scene: {Width: 100, Height: 80, Items: []}, Font: "/c/fonts/JetBrainsMono-Regular.ttf", Fallback: "/c/fonts/NotoSans-Medium.ttf"})
isTooManyVerticesRefused() = str.Contains("vertices", notebook.SceneFault(scene(list.Fill({Kind: "line", Xs: list.Fill(1.0, 900000), Ys: list.Fill(1.0, 900000), Width: 1}, 2))))

(* Sliders. A run whose session is busy with each slider keeps a move as its Pending, so that nothing starts a session here. *)
look = ui.Look(ui.Dark, (w, f) -> value.Len(w) * 8, 19)
cell = {Width: 8, Height: 19}
source = "use std/cells\n\n(* %% Parameters *)\nrho = cells.Slider(28.0, 0.0, 50.0, step = 0.5)\nn = cells.Slider(3, 0, 10)\n\n(* %% Use *)\nrho * n\n"
before = "rho = cells.Slider(28.0, 0.0, 50.0, step = 0.5)"

(** A window on the file of sliders after its first tick, which draws them from its text. *)
opened() = notebook.Hooked({}).Idle(view.Start([text.Of(source, "nb.ce")], look, cell, 1280, 720))

defn busy(state)
  (** The state whose run has a session busy with each slider: a move only keeps its number as Pending. *)
  s = state
  r = s.Buffers[1].CellRun
  r.Session = "a session"
  r.Moves = {"rho": {Busy: true, Pending: missing, Left: [3], Since: 0.0, Took: missing}, "n": {Busy: true, Pending: missing, Left: [3], Since: 0.0, Took: missing}}
  s.Buffers[1].CellRun = r
  s
end

sliders(s) = [x for x in text.BlocksOf(s.Buffers[1]) if dict.Has("Slider", x)]   (** The blocks of the sliders. *)
words(x) = [c.Text for c in x.Draw(1000, look) if c.Kind == "text"]   (** The words a block draws. *)
line(s, n) = rope.Line(n, s.Buffers[1].Rope)   (** Line n of the file. *)
undone(s) = rope.Line(4, text.Undo(s.Buffers[1]).Rope)   (** Line 4 once the last step is undone. *)
rho(s) = list.FindFirst(x -> x.Slider == "rho", sliders(s))   (** The block of the slider rho. *)
thumb(x) = [c.X for c in x.Draw(1000, look) if c.Kind == "rect" and c.Width == 8][1]   (** Where a slider's thumb is drawn. *)
moved(s, x, how) = notebook.Edited(1, "rho", nb.Snap(s.Buffers[1].CellRun.Analysis[2].Sliders[1], x), how, s)   (** rho moved to a number. *)

isDrawnBeforeRun() = value.Equal([words(x) for x in sliders(opened())], [["rho", "28.0"], ["n", "3"]])
isUnderItsLine() = value.Equal([x.Line for x in sliders(opened())], [4, 5])
isMoveWrites() = line(moved(opened(), 31.4, "keys"), 4) == "rho = cells.Slider(31.5, 0.0, 50.0, step = 0.5)"
isThumbFollows() = thumb(rho(moved(opened(), 50.0, "keys"))) > thumb(rho(opened()))
isNumberDrawn() = words(rho(moved(opened(), 31.4, "keys")))[2] == "31.5"
isSameNumberNoEdit() = moved(opened(), 28.1, "keys").Buffers[1].Version == opened().Buffers[1].Version
isDragOneUndo() = undone(moved(moved(moved(opened(), 30.0, "press"), 31.0, "drag"), 32.0, "drag")) == before
isPressNewStep() = undone(moved(moved(opened(), 30.0, "press"), 31.0, "press")) == "rho = cells.Slider(30.0, 0.0, 50.0, step = 0.5)"
isKeysAloneNewStep() = undone(moved(moved(opened(), 28.5, "keys"), 29.0, "keys")) == "rho = cells.Slider(28.5, 0.0, 50.0, step = 0.5)"
isDragAfterKeysNewStep() = undone(moved(moved(opened(), 28.5, "keys"), 29.0, "drag")) == "rho = cells.Slider(28.5, 0.0, 50.0, step = 0.5)"

defn corrupted(f)
  (** The window with the slider rho of its analysis changed by f, as if the text had changed under it unseen. *)
  s = opened()
  r = s.Buffers[1].CellRun
  r.Analysis[2].Sliders[1] = f(r.Analysis[2].Sliders[1])
  s.Buffers[1].CellRun = r
  s
end
refused(s) = s.Buffers[1].Version == 0 and line(s, 4) == before and str.Contains("isn't where its number was", s.Message)   (** Was the move refused? *)
isRefusedOutOfItsCell() = refused(moved(corrupted(x -> dict.Put("Line", 8, x)), 31.0, "keys"))
isRefusedOtherNumber() = refused(moved(corrupted(x -> dict.Put("Value", 29.0, x)), 31.0, "keys"))
isRefusedPastTheLine() = refused(moved(corrupted(x -> dict.Put("End", 200, x)), 31.0, "keys"))
isRefusedBeforeTheLine() = refused(moved(corrupted(x -> dict.Put("Column", 0, x)), 31.0, "keys"))
(* The number written is checked again, whatever gives it: a finite number, the one of its own text, within the slider. *)
wrote(at) = notebook.Edited(1, "rho", at, "keys", opened())   (** rho moved to a position given as it is. *)
refusedNumber(s) = s.Buffers[1].Version == 0 and line(s, 4) == before and str.Contains("takes numbers from 0.0 to 50.0", s.Message)   (** Was the number refused? *)
isRefusedNoNumber() = refusedNumber(wrote({Value: 31.0, Text: "31.0\nx = 1"})) and refusedNumber(wrote({Value: 31.0, Text: "x"}))
isRefusedOtherText() = refusedNumber(wrote({Value: 32.0, Text: "31.0"}))
isRefusedOutOfRange() = refusedNumber(wrote({Value: 60.0, Text: "60.0"})) and refusedNumber(wrote({Value: -0.5, Text: "-0.5"}))
isRefusedInfinite() = refusedNumber(wrote({Value: 1e400, Text: "1e400"}))

defn focused()
  (** The window busy with each slider, the cursor in the cell of the sliders, after C-c e f. *)
  s = busy(opened())
  s.Buffers[1] = text.Place(5, 0, s.Buffers[1])
  notebook.FocusControl(s)
end
press(chord, s) = commands.FocusOf(s).Keys[chord](s)   (** A key of the slider that has the keys. *)
isFocusFirstSlider() = commands.FocusOf(focused()).Slider == "rho" and value.Len(commands.FocusOf(focused()).Hints) == 5
isFocusRing() = value.Len(rho(focused()).Draw(1000, look)) == value.Len(rho(opened()).Draw(1000, look)) + 4
isRightAStep() = line(press("right", focused()), 4) == "rho = cells.Slider(28.5, 0.0, 50.0, step = 0.5)"
isDownAStep() = line(press("down", focused()), 4) == "rho = cells.Slider(27.5, 0.0, 50.0, step = 0.5)"
isPageTenSteps() = line(press("pagedown", focused()), 4) == "rho = cells.Slider(23.0, 0.0, 50.0, step = 0.5)"
isEnd() = line(press("end", focused()), 4) == "rho = cells.Slider(50.0, 0.0, 50.0, step = 0.5)"
isHome() = line(press("home", focused()), 4) == "rho = cells.Slider(0.0, 0.0, 50.0, step = 0.5)"
isKeysJoin() = undone(press("right", press("right", focused()))) == before
isLeaveEndsStep() = undone(press("right", notebook.FocusControl(press("C-g", press("right", focused()))))) == "rho = cells.Slider(28.5, 0.0, 50.0, step = 0.5)"
isLatestPending() = press("right", press("right", focused())).Buffers[1].CellRun.Moves["rho"].Pending == 29.0
isTabRound() = commands.FocusOf(press("tab", focused())).Slider == "n" and commands.FocusOf(press("tab", press("tab", focused()))).Slider == "rho"
isIntSlider() = line(press("up", press("tab", focused())), 5) == "n = cells.Slider(4, 0, 10)"
isCgLeaves() = value.IsMissing(commands.FocusOf(press("C-g", focused()))) and value.Len(rho(press("C-g", focused())).Draw(1000, look)) == value.Len(rho(opened()).Draw(1000, look))
isNoControlHere() = notebook.FocusControl(opened()).Message == "This cell has no control: an input, as name = cells.Slider(value, min, max) or name = cells.Choice(value, options) on a line of a cell of inputs, an animation of plot.Frames, a 3D graph of plot.Surface or plot.Line3, a table or a graph."

defn atSlider(name, s)
  (** The block of a slider on the screen with a point inside it, as the mouse finds it. *)
  for y in 0..719
    hit = view.BlockAt(200, y, s)
    if value.IsSome(hit) and dict.GetOr("Slider", "", hit.Block) == name
      return dict.Put("Y", y + 5, hit)
    end
  end
  missing
end

defn trackX(fraction, s)
  (** The x of a point on the track of rho, at a fraction of its length. *)
  hit = atSlider("rho", s)
  p = notebook.SliderPlaces(hit.Width, 3, cell)
  hit.Left + p.Track + 4 + math.Div(math.Floor(fraction * (p.Wide - 8)), 1)
end

(** A press on the track of rho at a fraction of its length. *)
clicked(fraction, s) = commands.Press({Kind: "mouse", Action: "down", X: trackX(fraction, s), Y: atSlider("rho", s).Y, Button: 1}, s)
isPressSetsValue() = line(clicked(0.5, busy(opened())), 4) == "rho = cells.Slider(25.0, 0.0, 50.0, step = 0.5)"
isPressFocuses() = commands.FocusOf(clicked(0.5, busy(opened()))).Slider == "rho"
isPressKeepsCursor() = clicked(0.5, busy(opened())).Buffers[1].Cursor.Line == 1

defn isDragFollows()
  s = clicked(0.5, busy(opened()))
  x = trackX(1.0, s) + 30
  s = commands.Drag({Kind: "mouse", Action: "move", X: x, Y: atSlider("rho", s).Y + 40, Button: 0}, s)
  s = commands.Release({Kind: "mouse", Action: "up", X: x, Y: 0, Button: 1}, s)
  line(s, 4) == "rho = cells.Slider(50.0, 0.0, 50.0, step = 0.5)" and undone(s) == before
end

isTextClickLeaves() = value.IsMissing(commands.FocusOf(commands.Press({Kind: "mouse", Action: "down", X: 200, Y: 10, Button: 1}, focused())))
isWheelNoMove() = line(commands.Wheel({Kind: "mouse", Action: "wheel", X: 200, Y: atSlider("rho", opened()).Y, Button: 0, Amount: -1.0}, opened()), 4) == before
isClearKeepsSliders() = value.Len(sliders(notebook.ClearResults(opened()))) == 2
(* A file may hold numbers that a slider can't count: the window opens it and draws no slider for them. *)
wide = "use std/cells\n\n(* %% Parameters *)\nrho = cells.Slider(0.0, -1e308, 1e308)\nn = cells.Slider(0, -4611686018427387903, 4611686018427387903)\nt = cells.Slider(0.0, 0.0, 1e-299)\n"
isUncountableNoSlider() = value.Len(sliders(notebook.Hooked({}).Idle(view.Start([text.Of(wide, "nb.ce")], look, cell, 1280, 720)))) == 0
(* A slider of Floats whose Int min lies far from its Float max: its thumb is placed in Floats, past what 63 bits hold. *)
far = "use std/cells\n\n(* %% Parameters *)\na = cells.Slider(3, -4611686018427387903, 1e308)\n"
defn isFarSliderDrawn()
  shown = sliders(notebook.Hooked({}).Idle(view.Start([text.Of(far, "nb.ce")], look, cell, 1280, 720)))
  value.Len(shown) == 1 and value.Len(shown[1].Draw(1000, look)) > 0
end

(* The other inputs of a form, without a session: drawn from the text under their lines, before any run; changed by their keys and by the mouse, each
   change written in place of the old value, one step of undo, a text in quotes that the file never reads as code; and every key does what it did
   while no input has the keys. *)
form = "use std/cells\n\n(* %% Place and day *)\nyear = cells.Choice(2026, [2025, 2026, 2027])\nzone = cells.Choice(\"GMT-5\", [\"GMT-6\", \"GMT-5\", \"GMT-4\"])\nday = cells.Date(\"2026-11-23\")\nplace = cells.Field(\"40.76, -73.984\")\nhigh = cells.Field(50)\nrho = cells.Slider(28.0, 0.0, 50.0, step = 0.5)\nbold = cells.Check(false, label = \"Bold line\")\n\n(* %% Use *)\nyear\n"
(** A window on the form after its first tick, which draws its inputs from its text. *)
formOpened() = notebook.Hooked({}).Idle(view.Start([text.Of(form, "form.ce")], look, cell, 1280, 720))
boxes(s) = [x for x in text.BlocksOf(s.Buffers[1]) if dict.Has("Input", x)]   (** The blocks of the inputs other than sliders. *)
box(name, s) = list.FindFirst(x -> x.Input == name, boxes(s))   (** The block of an input. *)
names = ["year", "zone", "day", "place", "high", "rho", "bold"]

defn busyForm(state)
  (** The state whose run has a session busy with each input: a change only keeps its value as Pending. *)
  s = state
  r = s.Buffers[1].CellRun
  r.Session = "a session"
  r.Moves = dict.Zipmap(names, [{Busy: true, Pending: missing, Left: [3], Since: 0.0, Took: missing} for n in names])
  s.Buffers[1].CellRun = r
  s
end

defn formFocused(n)
  (** The busy form after C-c e f in its cell, then n presses of Tab. *)
  s = busyForm(formOpened())
  s.Buffers[1] = text.Place(5, 0, s.Buffers[1])
  s = notebook.FocusControl(s)
  for k in 1..n
    s = press("tab", s)
  end
  s
end
typedIn(t, s) = commands.FocusOf(s).Typed(t, s)   (** A text typed while an input has the keys. *)
undoneAt(s, n) = rope.Line(n, text.Undo(s.Buffers[1]).Rope)   (** Line n once the last step is undone. *)
focusName(s) = dict.GetOr("Input", dict.GetOr("Slider", "", commands.FocusOf(s)), commands.FocusOf(s))   (** The input that has the keys. *)
readBack(s) = nb.Analyse(nb.Parse(rope.Text(s.Buffers[1].Rope)))[2]   (** The inputs and the errors of the form, as the text says now. *)

isBoxesBeforeRun() = value.Equal([[x.Input, x.Line] for x in boxes(formOpened())], [["year", 4], ["zone", 5], ["day", 6], ["place", 7], ["high", 8], ["bold", 10]]) and value.Len(sliders(formOpened())) == 1
isBoxWords() = value.Equal([words(box(n, formOpened())) for n in ["zone", "day", "place", "high", "bold"]], [["zone", "GMT-5", "v"], ["day", "2026-11-23", "v"], ["place", "40.76, -73.984"], ["high", "50"], ["[ ] Bold line"]])
isBoxInInkOnPaper() = list.All([c.Color == look.Theme.Ink for c in box("zone", formOpened()).Draw(1000, look) if c.Kind == "text"]) and list.Any([c.Kind == "rect" and c.Color == look.Theme.Code for c in box("zone", formOpened()).Draw(1000, look)])
isBoxesLineUp() = [c.X for c in box("zone", formOpened()).Draw(1000, look) if c.Kind == "rect"][1] == notebook.SliderPlaces(1000, 5, cell).Track
isFirstInputFocused() = focusName(formFocused(0)) == "year" and value.Len(commands.FocusOf(formFocused(0)).Hints) == 4
isTabOrder() = value.Equal([focusName(formFocused(k)) for k in 0..7], ["year", "zone", "day", "place", "high", "rho", "bold", "year"])
isBackTab() = focusName(press("S-tab", formFocused(0))) == "bold"
isFocusRingBox() = value.Len(box("zone", formFocused(1)).Draw(1000, look)) == value.Len(box("zone", formOpened()).Draw(1000, look)) + 4
isCgLeavesInput() = value.IsMissing(commands.FocusOf(press("C-g", formFocused(1))))

(* A choice: Enter opens its list, the arrows move in it, Enter chooses. *)
isEnterOpens() = commands.FocusOf(press("enter", formFocused(0))).Open and box("year", press("enter", formFocused(0))).Rows == 4
isListDrawn() = value.Equal(words(box("year", press("enter", formFocused(0)))), ["year", "2026", "v", "2025", "2026", "2027"])
isChoose() = line(press("enter", press("down", press("enter", formFocused(0)))), 4) == "year = cells.Choice(2027, [2025, 2026, 2027])"
isChooseShuts() = not commands.FocusOf(press("enter", press("down", press("enter", formFocused(0))))).Open
isChooseOneUndo() = undoneAt(press("enter", press("down", press("enter", formFocused(0)))), 4) == "year = cells.Choice(2026, [2025, 2026, 2027])"
isChooseText() = line(press("enter", press("up", press("enter", formFocused(1)))), 5) == "zone = cells.Choice(\"GMT-6\", [\"GMT-6\", \"GMT-5\", \"GMT-4\"])"
isListClamped() = commands.FocusOf(press("down", press("end", formFocused(0)))).At == 3 and commands.FocusOf(press("up", press("home", formFocused(0)))).At == 1
isListShutByCg() = value.IsSome(commands.FocusOf(press("C-g", press("enter", formFocused(0))))) and not commands.FocusOf(press("C-g", press("enter", formFocused(0)))).Open
isSameChoiceNoEdit() = press("enter", press("enter", formFocused(0))).Buffers[1].Version == formFocused(0).Buffers[1].Version
isPendingChoice() = press("enter", press("down", press("enter", formFocused(0)))).Buffers[1].CellRun.Moves["year"].Pending == 2027

(* A date: Left and Right pick its part, Up and Down change it, Enter sets it. *)
isDayUp() = line(press("enter", press("up", formFocused(2))), 6) == "day = cells.Date(\"2026-11-24\")"
isMonthUp() = line(press("enter", press("up", press("left", formFocused(2)))), 6) == "day = cells.Date(\"2026-12-23\")"
isMonthRound() = line(press("enter", press("up", press("up", press("left", formFocused(2))))), 6) == "day = cells.Date(\"2026-01-23\")"
isYearDown() = line(press("enter", press("down", press("left", press("left", formFocused(2))))), 6) == "day = cells.Date(\"2025-11-23\")"
isDateWaitsForEnter() = line(press("up", formFocused(2)), 6) == "day = cells.Date(\"2026-11-23\")" and words(box("day", press("up", formFocused(2))))[2] == "2026-11-24"
isDatePartDrawn() = list.Any([c.Kind == "text" and c.Text == "23" and c.Color == look.Theme.Code for c in box("day", formFocused(2)).Draw(1000, look)])

(* A field: what is typed goes in its box, Enter sets it; a field of a number takes only a number. *)
isFieldTyped() = line(press("enter", typedIn("!", formFocused(3))), 7) == "place = cells.Field(\"40.76, -73.984!\")"
isFieldWaitsForEnter() = line(typedIn("x", formFocused(3)), 7) == "place = cells.Field(\"40.76, -73.984\")" and words(box("place", typedIn("x", formFocused(3))))[2] == "40.76, -73.984x"
isFieldErased() = words(box("place", press("backspace", formFocused(3))))[2] == "40.76, -73.98" and words(box("place", press("delete", press("home", formFocused(3)))))[2] == "0.76, -73.984"
isFieldCaret() = line(press("enter", typedIn("+", press("home", formFocused(3)))), 7) == "place = cells.Field(\"+40.76, -73.984\")"
isFieldOneUndo() = undoneAt(press("enter", typedIn("!", formFocused(3))), 7) == "place = cells.Field(\"40.76, -73.984\")"
defn isFieldHostile()
  (** A text with quotes, \, $(...) and <script> typed in a field is written in quotes, escaped, and reads back as itself, and as no code. *)
  t = "\" \\ $$(io.Print(1)) $$x <script>"
  s = press("enter", typedIn(t, press("backspace", formFocused(3))))
  a = readBack(s)
  line(s, 7) == "place = cells.Field(\"40.76, -73.98\\\" \\\\ $$$$(io.Print(1)) $$$$x <script>\")" and a.Inputs[4].Value == "40.76, -73.98$t" and value.Len(a.Errors) == 0
end
defn isNumberFieldRefuses()
  s = press("enter", typedIn("abc", press("backspace", press("backspace", formFocused(4)))))
  line(s, 8) == "high = cells.Field(50)" and s.Message == "high takes a number: abc is none."
end
isNumberField() = line(press("enter", typedIn("62.5", press("backspace", press("backspace", formFocused(4))))), 8) == "high = cells.Field(62.5)"

(* A check box: Space checks it or not. *)
isCheckSpace() = line(press("space", formFocused(6)), 10) == "bold = cells.Check(true, label = \"Bold line\")" and value.Equal(words(box("bold", press("space", formFocused(6)))), ["[x] Bold line"])
isCheckOneUndo() = undoneAt(press("space", formFocused(6)), 10) == "bold = cells.Check(false, label = \"Bold line\")"
isCheckTwice() = line(press("space", press("space", formFocused(6))), 10) == "bold = cells.Check(false, label = \"Bold line\")"

(* Every key does what it did while no input has the keys, and any key an input doesn't take leaves it. *)
keyEvent(k) = {Kind: "key", Key: k, Ctrl: false, Alt: false, Shift: false, Super: false}   (** A key without a modifier. *)
(** A state with the keys of Emacs and of the cells, as Cemacs has them. *)
defn keyed(state)
  s = state
  s.Config = () -> emacs.Config(() -> dict.Merge(emacs.Keys(), notebook.Keys()))
  s
end
defn isEnterStillANewLine()
  s = keyed(busyForm(formOpened()))
  s.Buffers[1] = text.Place(5, 0, s.Buffers[1])
  t = commands.Update(keyEvent("enter"), s)
  value.IsMissing(commands.FocusOf(t)) and line(t, 6) == "zone = cells.Choice(\"GMT-5\", [\"GMT-6\", \"GMT-5\", \"GMT-4\"])" and line(t, 5) == ""
end
defn isSpaceStillTyped()
  s = busyForm(formOpened())
  s.Buffers[1] = text.Place(10, 0, s.Buffers[1])
  t = commands.Update({Kind: "text", Text: " "}, commands.Update({Kind: "key", Key: "space", Ctrl: false, Alt: false, Shift: false, Super: false}, s))
  line(t, 10) == " bold = cells.Check(false, label = \"Bold line\")"
end
isTypedNotInBuffer() = line(commands.Update({Kind: "text", Text: "x"}, formFocused(3)), 7) == "place = cells.Field(\"40.76, -73.984\")"
defn isOtherKeyLeaves()
  t = commands.Update({Kind: "key", Key: "f", Ctrl: true, Alt: false, Shift: false, Super: false}, keyed(formFocused(3)))
  value.IsMissing(commands.FocusOf(t)) and t.Buffers[1].Cursor.Column == 1
end

(* The mouse: a press gives an input the keys, checks a box, opens a list and chooses in it. *)
defn atInput(name, s)
  (** The block of an input on the screen, its first row, as the mouse finds it. *)
  for y in 0..719
    hit = view.BlockAt(200, y, s)
    if value.IsSome(hit) and dict.GetOr("Input", "", hit.Block) == name
      return dict.Put("Y", y + 2, hit)
    end
  end
  missing
end
defn clickedOn(name, dx, row, s)
  (** A press on the block of an input, dx pixels right of its box, on a row of it, from 0. *)
  hit = atInput(name, s)
  x = hit.Left + notebook.SliderPlaces(hit.Width, 5, cell).Track + dx
  commands.Press({Kind: "mouse", Action: "down", X: x, Y: hit.Y + row * cell.Height, Button: 1}, s)
end
isClickChecks() = line(clickedOn("bold", -40, 0, busyForm(formOpened())), 10) == "bold = cells.Check(true, label = \"Bold line\")"
isClickOpens() = commands.FocusOf(clickedOn("zone", 10, 0, busyForm(formOpened()))).Open
isClickShuts() = not commands.FocusOf(clickedOn("zone", 10, 0, clickedOn("zone", 10, 0, busyForm(formOpened())))).Open
isClickChooses() = line(clickedOn("zone", 10, 1, clickedOn("zone", 10, 0, busyForm(formOpened()))), 5) == "zone = cells.Choice(\"GMT-6\", [\"GMT-6\", \"GMT-5\", \"GMT-4\"])"
isClickField() = focusName(clickedOn("place", 10, 0, busyForm(formOpened()))) == "place" and commands.FocusOf(clickedOn("place", 3 * cell.Width + 2, 0, clickedOn("place", 10, 0, busyForm(formOpened())))).Caret == 2
isClickDatePart() = commands.FocusOf(clickedOn("day", 7 * cell.Width, 0, clickedOn("day", 10, 0, busyForm(formOpened())))).Part == 2
isClickTextLeaves() = value.IsMissing(commands.FocusOf(commands.Press({Kind: "mouse", Action: "down", X: 200, Y: 10, Button: 1}, formFocused(1))))
isClearKeepsBoxes() = value.Len(boxes(notebook.ClearResults(formOpened()))) == 6

(* The place of a value is checked before it is written: one that holds no value of the input's kind any more is refused. *)
defn isChangeRefusedElsewhere()
  s = busyForm(formOpened())
  r = s.Buffers[1].CellRun
  r.Analysis[2].Inputs[2] = dict.Put("Column", 1, r.Analysis[2].Inputs[2])
  s.Buffers[1].CellRun = r
  t = notebook.Changed(1, "zone", "GMT-4", s)
  line(t, 5) == "zone = cells.Choice(\"GMT-5\", [\"GMT-6\", \"GMT-5\", \"GMT-4\"])" and str.Contains("isn't where its value was", t.Message)
end
isNoSessionNoRun() = notebook.Changed(1, "bold", true, formOpened()).Message == "bold is true in the text: C-c e a runs the cells with it."

(* Animations, without a session: the block of a cell whose graph is an animation of 3 frames, at key 7, draws its bar; C-c e f, its keys and the mouse
   play it, pause it and move it; a frame that the session sent, faked here, comes ahead and shows when it is due, and none is asked while it rests. *)
animSource = "use std/plot\n\n(* %% Wave *)\nplot.Frames([plot.Line([1, 2], [k, k]) for k in 1..3])\n"
(** The scene of frame k of the animation, as wide as the pane draws graphs. *)
frameScene(k, width) = {Width: width, Height: 400, Items: [{Kind: "text", X: 10, Y: 20, Text: "frame $k", Size: 12, Color: "ink", Anchor: "start", Angle: 0, Width: 40, Role: "title"}], Dropped: 0, Frames: 3, Fps: 30}

(* A graph keeps the shape of its own size: one narrower than the pane, asked at the pane's width, isn't asked again at each tick; one asked at another
   width is; its block is as high as its scene, a polar graph's square. *)
defn isNarrowGraphKept()
  s = notebook.Hooked({}).Idle(view.Start([text.Of(animSource, "anim.ce")], look, cell, 1280, 720))
  want = notebook.GraphWidth(s)
  narrow = dict.Merge(notebook.Prepared({Width: 300, Height: 300, Items: [], Dropped: 0}, "."), {Key: 7, Asked: want})
  at = (g) -> text.WithBlocks([dict.Merge(notebook.Block(4, [], cell, graph = g), {Cell: 2, Base: [], Inputs: {}, Status: missing})], s.Buffers[1])
  value.IsMissing(stale(at(narrow), s)) and value.IsSome(stale(at(dict.Put("Asked", want - 100, narrow)), s)) and notebook.Block(4, [], cell, graph = narrow).Rows == math.Div(300 + 8 + cell.Height - 1, cell.Height)
end

defn animated(out = missing)
  (** The window once cell 2 showed the first frame of the animation, paused, as a run gives it; with out, under the label of its result on a row of
      its own, as Out[2]: when the cell's last value is the animation. *)
  s = notebook.Hooked({}).Idle(view.Start([text.Of(animSource, "anim.ce")], look, cell, 1280, 720))
  g = dict.Merge(notebook.Prepared(frameScene(1, notebook.GraphWidth(s)), "."), {Key: 7, Frames: 3, Fps: 30, Frame: 1, Playing: false, Due: 0.0, Times: [], Want: missing})
  s.Buffers[1] = text.WithBlocks([dict.Merge(notebook.Block(4, [], cell, graph = g, out = out), {Cell: 2, Base: [], Inputs: {}, Status: missing})], s.Buffers[1])
  (* C-c e f then C-g draw the block again, as the cells make it: its bar takes the mouse. *)
  s.Buffers[1] = text.Place(4, 0, s.Buffers[1])
  s = commands.Unfocused(notebook.FocusControl(s))
  s.Buffers[1] = text.Place(1, 0, s.Buffers[1])
  s
end
anim(s) = list.FindFirst(x -> dict.GetOr("Cell", 0, x) == 2, text.BlocksOf(s.Buffers[1]))   (** The block of the animation. *)
barWords(s) = [c.Text for c in anim(s).Draw(1000, look) if c.Kind == "text" and c.Font == "code"]   (** The words of its bar. *)
defn barSign(s)
  (** The point of the window at the middle of the ▶ of the animation's bar, where the bar draws it. *)
  for y in 0..719
    hit = view.BlockAt(200, y, s)
    if value.IsSome(hit) and dict.GetOr("Cell", 0, hit.Block) == 2
      sign = list.FindFirst(c -> c.Kind == "text" and c.Font == "code" and str.StartsWith("▶", c.Text), hit.Block.Draw(hit.Width, look))
      return {X: hit.Left + sign.X + math.Div(cell.Width, 2), Y: hit.Top + sign.Y + math.Div(cell.Height, 2)}
    end
  end
  missing
end
clickedSign(s) = commands.Press({Kind: "mouse", Action: "down", X: barSign(s).X, Y: barSign(s).Y, Button: 1}, s)   (** A press on the ▶ of the bar. *)
isSignClickPlays() = anim(clickedSign(animated())).Graph.Playing
isSignClickPlaysUnderOut() = anim(clickedSign(animated(out = "Out[2]:"))).Graph.Playing   (** The bar under the label of a result takes the press on its ▶, not a row above. *)
isRowAboveSignLeaves() = not anim(commands.Press({Kind: "mouse", Action: "down", X: barSign(animated(out = "Out[2]:")).X, Y: barSign(animated(out = "Out[2]:")).Y - cell.Height, Button: 1}, animated(out = "Out[2]:"))).Graph.Playing

defn onBar(state)
  (** The window after C-c e f, the cursor in the cell of the animation. *)
  s = state
  s.Buffers[1] = text.Place(4, 0, s.Buffers[1])
  notebook.FocusControl(s)
end

defn sent(frame, s)
  (** The window as if the session had sent a frame, asked at the pane's width, for the next tick to take. *)
  out = s
  r = s.Buffers[1].CellRun
  scene = frameScene(frame, notebook.GraphWidth(s))
  r.Framing = {Task: fiber.Spawn(() -> result.Ok(scene)), Key: 7, Frame: frame, Width: notebook.GraphWidth(s)}
  out.Buffers[1].CellRun = r
  (* The fiber answers once this one waits: here, at once. *)
  sys.Sleep(0.001)
  out
end
ticked(s) = notebook.Hooked({}).Idle(s)   (** The window after a tick. *)

defn sessioned(state)
  (** The window as if its cells had a session: Moving asks for ticks only with one, as no frame would come without it. *)
  s = state
  r = s.Buffers[1].CellRun
  r.Session = "a session"
  s.Buffers[1].CellRun = r
  s
end
title(s) = [i.Text for i in [c for c in anim(s).Draw(1000, look) if c.Kind == "graph"][1].Items if i.Kind == "text"][1]   (** The title the graph shows. *)

isBarDrawn() = value.Equal(barWords(animated()), ["▶ 1 / 3", "30/s"]) and anim(animated()).Rows == 23
isNoTicksAtRest() = not notebook.Moving(animated())
isFocusBar() = commands.FocusOf(onBar(animated())).Bar == 7 and value.Len(commands.FocusOf(onBar(animated())).Hints) == 5 and value.Len(anim(onBar(animated())).Draw(1000, look)) == value.Len(anim(animated()).Draw(1000, look)) + 4
isSpacePlays() = anim(press("space", onBar(animated()))).Graph.Playing and barWords(press("space", onBar(animated())))[1] == "‖ 1 / 3"
typed(s) = commands.Update({Kind: "text", Text: " "}, s)   (** The window after a space typed. *)
isSpaceTyped() = anim(typed(onBar(animated()))).Graph.Playing and line(typed(onBar(animated())), 4) == "plot.Frames([plot.Line([1, 2], [k, k]) for k in 1..3])"
isSpaceAgainPauses() = not anim(press("space", press("space", onBar(animated())))).Graph.Playing
isRightAsksNext() = anim(press("right", onBar(animated()))).Graph.Want == 2 and anim(press("right", press("right", onBar(animated())))).Graph.Want == 3
isEndLast() = anim(press("end", onBar(animated()))).Graph.Want == 3 and value.IsMissing(anim(press("home", onBar(animated()))).Graph.Want)
isStepPauses() = not anim(press("right", press("space", onBar(animated())))).Graph.Playing
isCgLeavesBar() = value.IsMissing(commands.FocusOf(press("C-g", onBar(animated())))) and value.Len(anim(press("C-g", onBar(animated()))).Draw(1000, look)) == value.Len(anim(animated()).Draw(1000, look))
defn isSoughtFrameShows()
  s = ticked(sent(2, press("right", onBar(animated()))))
  anim(s).Graph.Frame == 2 and value.IsMissing(anim(s).Graph.Want) and barWords(s)[1] == "▶ 2 / 3" and title(s) == "frame 2"
end

defn isDueFrameShows()
  (* Playing, frame 2 comes at once but waits for its time, a thirtieth of a second after the press; then it shows, and the bar keeps the beat. *)
  s = ticked(sent(2, press("space", onBar(animated()))))
  early = anim(s).Graph.Frame
  sys.Sleep(0.05)
  s = ticked(s)
  early == 1 and anim(s).Graph.Frame == 2 and anim(s).Graph.Playing and notebook.Moving(sessioned(s)) and title(s) == "frame 2"
end

defn isLoops()
  (* From the last frame, the next is the first. *)
  s = press("space", press("end", onBar(animated())))
  s = ticked(sent(3, s))
  s = press("space", s)
  s = ticked(sent(1, s))
  sys.Sleep(0.05)
  s = ticked(s)
  anim(s).Graph.Frame == 1
end

defn isOffScreenStill()
  (* Scrolled away, a playing animation takes no tick. *)
  s = press("space", onBar(animated()))
  s.Buffers[1].Top = 40
  anim(s).Graph.Playing and not notebook.Moving(sessioned(s)) and notebook.Moving(sessioned(press("space", onBar(animated())))) and not notebook.Moving(sessioned(press("space", press("space", onBar(animated())))))
end
isNoSessionStill() = not notebook.Moving(press("space", onBar(animated())))   (** Without a session, a playing animation takes no tick. *)

defn isBadFrameStops()
  (* A frame that isn't sane pauses the animation, which says why. *)
  s = press("space", onBar(animated()))
  r = s.Buffers[1].CellRun
  r.Framing = {Task: fiber.Spawn(() -> result.Ok({Width: notebook.GraphWidth(s), Height: 400, Items: [], Frames: 301, Fps: 30})), Key: 7, Frame: 2, Width: notebook.GraphWidth(s)}
  s.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  s = ticked(s)
  not anim(s).Graph.Playing and str.Contains("frame 2 can't be drawn", s.Message)
end

defn atBar(s)
  (** A point on the bar of the animation on the screen, its block found as the mouse finds it: {X, Y, Left, Width}. *)
  for y in 0..719
    hit = view.BlockAt(200, y, s)
    if value.IsSome(hit) and dict.GetOr("Cell", 0, hit.Block) == 2
      return {Y: hit.Top + (anim(s).Rows - 1) * cell.Height + 5, Left: hit.Left, Width: hit.Width}
    end
  end
  missing
end
pressAt(x, y, s) = commands.Press({Kind: "mouse", Action: "down", X: x, Y: y, Button: 1}, s)   (** A press of the mouse. *)
defn isPressPlays()
  b = atBar(animated())
  s = pressAt(b.Left + 24, b.Y, animated())
  anim(s).Graph.Playing and commands.FocusOf(s).Bar == 7
end
defn isPressTrackSeeks()
  s = animated()
  b = atBar(s)
  p = notebook.BarPlaces(b.Width, 3, cell)
  s = pressAt(b.Left + p.Track + p.Wide - 4, b.Y, s)
  anim(s).Graph.Want == 3 and not anim(s).Graph.Playing
end
defn isPressGraphNothing()
  b = atBar(animated())
  s = pressAt(b.Left + 24, b.Y - 100, animated())
  not anim(s).Graph.Playing and value.IsMissing(anim(s).Graph.Want)
end

defn isStillSceneStops()
  (* A scene without a count of frames, for an animation, is no frame of it: the animation pauses. *)
  s = press("space", onBar(animated()))
  r = s.Buffers[1].CellRun
  r.Framing = {Task: fiber.Spawn(() -> result.Ok(dict.Drop("Fps", dict.Drop("Frames", frameScene(2, notebook.GraphWidth(s)))))), Key: 7, Frame: 2, Width: notebook.GraphWidth(s)}
  s.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  s = ticked(s)
  not anim(s).Graph.Playing and str.Contains("as it is no frame of an animation", s.Message)
end

isFrameSceneAccepted() = value.IsMissing(notebook.SceneFault(frameScene(1, 640)))
isTooManyFramesRefused() = value.IsSome(notebook.SceneFault(dict.Put("Frames", 301, frameScene(1, 640)))) and value.IsSome(notebook.SceneFault(dict.Put("Frames", 2.5, frameScene(1, 640))))
isBadRateRefused() = value.IsSome(notebook.SceneFault(dict.Put("Fps", 0, frameScene(1, 640)))) and value.IsSome(notebook.SceneFault(dict.Put("Fps", 61, frameScene(1, 640)))) and value.IsSome(notebook.SceneFault(dict.Drop("Fps", frameScene(1, 640))))

(* 3D graphs, without a session: the block of a cell whose graph is a surface, at key 9, draws the line of its view; C-c e f, its keys and the mouse
   aim it at another view, which its line says at once; a view that the session sent, faked here, is drawn once it comes, and the latest wins. *)
solidSource = "use std/plot\n\n(* %% Hill *)\nplot.Surface([1, 2; 3, 4])\n"
(** A scene of a surface of 2 by 2 quads, at a view, as wide as the pane draws graphs. *)
solidScene(v, width) = {Width: width, Height: 400, Items: [{Kind: "mesh", Rows: 2, Columns: 2, Xs: [10.0, 20.0, 30.0, 10.0, 20.0, 30.0, 10.0, 20.0, 30.0], Ys: [10.0, 10.0, 10.0, 20.0, 20.0, 20.0, 30.0, 30.0, 30.0],
  Palette: ["#440154", "#21918c", "#fde725"], Colors: [0, 1, 2, -1], Order: [1, -1], Clip: [0, 0, 100, 100], Role: "data"}, {Kind: "text", X: 10, Y: 20, Text: "$(v[1])", Size: 12, Color: "ink", Anchor: "start", Angle: 0, Width: 40, Role: "title"}],
  Dropped: 0, View: v}

defn solided(out = missing)
  (** The window once cell 2 showed the surface at the view of its code, as a run gives it; with out, under the label of its result on a row of its
      own. *)
  s = notebook.Hooked({}).Idle(view.Start([text.Of(solidSource, "hill.ce")], look, cell, 1280, 720))
  g = dict.Merge(notebook.Prepared(solidScene([-37.5, 30.0], notebook.GraphWidth(s)), "."), {Key: 9, View: [-37.5, 30.0], Code: [-37.5, 30.0], Aim: [-37.5, 30.0]})
  s.Buffers[1] = text.WithBlocks([dict.Merge(notebook.Block(4, [], cell, graph = g, out = out), {Cell: 2, Base: [], Inputs: {}, Status: missing})], s.Buffers[1])
  s.Buffers[1] = text.Place(4, 0, s.Buffers[1])
  s = commands.Unfocused(notebook.FocusControl(s))
  s.Buffers[1] = text.Place(1, 0, s.Buffers[1])
  s
end
hill(s) = list.FindFirst(x -> dict.GetOr("Cell", 0, x) == 2, text.BlocksOf(s.Buffers[1]))   (** The block of the surface. *)
viewLine(s) = [c.Text for c in hill(s).Draw(1000, look) if c.Kind == "text" and c.Font == "code"][1]   (** The line of its view. *)
defn onHill(state)
  (** The window after C-c e f, the cursor in the cell of the surface. *)
  s = state
  s.Buffers[1] = text.Place(4, 0, s.Buffers[1])
  notebook.FocusControl(s)
end

isViewLineDrawn() = viewLine(solided()) == "view −37.5°, 30°" and hill(solided()).Rows == 23 and not notebook.Moving(solided())
isFocusHill() = commands.FocusOf(onHill(solided())).Turn == 9 and value.Len(commands.FocusOf(onHill(solided())).Hints) == 4 and value.Len(hill(onHill(solided())).Draw(1000, look)) == value.Len(hill(solided()).Draw(1000, look)) + 4
isRightTurnsEye() = value.Equal(hill(press("right", onHill(solided()))).Graph.Aim, [-27.5, 30.0]) and viewLine(press("right", onHill(solided()))) == "view −27.5°, 30° (code −37.5°, 30°)"
defn pressed(chord, n, state)
  (** The window after a key of the control that has the keys, n times. *)
  s = state
  for k in 1..n
    s = press(chord, s)
  end
  s
end
isUpRaisesEye() = value.Equal(hill(press("up", onHill(solided()))).Graph.Aim, [-37.5, 40.0]) and value.Equal(hill(pressed("up", 7, onHill(solided()))).Graph.Aim, [-37.5, 90.0])
isAzRounds() = value.Equal(hill(pressed("left", 15, onHill(solided()))).Graph.Aim, [172.5, 30.0])
isHomeCode() = value.Equal(hill(press("home", press("right", onHill(solided())))).Graph.Aim, [-37.5, 30.0]) and viewLine(press("home", press("right", onHill(solided())))) == "view −37.5°, 30°"
isCgLeavesHill() = value.IsMissing(commands.FocusOf(press("C-g", onHill(solided())))) and value.Len(hill(press("C-g", onHill(solided()))).Draw(1000, look)) == value.Len(hill(solided()).Draw(1000, look))
isAimTicks() = notebook.Moving(sessioned(press("right", onHill(solided())))) and not notebook.Moving(press("right", onHill(solided())))

defn atHill(s)
  (** The top left of the graph of the surface on the screen, its block found as the mouse finds it. *)
  for y in 0..719
    hit = view.BlockAt(200, y, s)
    if value.IsSome(hit) and dict.GetOr("Cell", 0, hit.Block) == 2
      return {X: hit.Left + 2 * cell.Width, Y: hit.Top + hit.Block.Under}
    end
  end
  missing
end
moveTo(x, y, s) = commands.Drag({Kind: "mouse", Action: "move", X: x, Y: y, Button: 0}, s)   (** A move of the mouse, its button held. *)
defn isDragTurns()
  (* 20 pixels right and 10 down turn it as if held: the front goes right, the top comes nearer: az -10, el +5. *)
  at = atHill(solided())
  s = pressAt(at.X + 50, at.Y + 50, solided())
  focused = commands.FocusOf(s).Turn == 9
  s = moveTo(at.X + 70, at.Y + 60, s)
  aimed = value.Equal(hill(s).Graph.Aim, [-47.5, 35.0])
  s = commands.Release({Kind: "mouse", Action: "up", X: at.X + 70, Y: at.Y + 60, Button: 1}, s)
  s = moveTo(at.X + 200, at.Y + 60, s)
  focused and aimed and value.Equal(hill(s).Graph.Aim, [-47.5, 35.0])
end
defn isPressLowUnderOutTurns()
  (* Under the label of a result, the graph is a row lower: a press on its last rows takes it, one under it doesn't. *)
  at = atHill(solided(out = "Out[2]:"))
  high = hill(solided(out = "Out[2]:")).Graph.Scene.Height
  commands.FocusOf(pressAt(at.X + 50, at.Y + high - 5, solided(out = "Out[2]:"))).Turn == 9 and value.IsMissing(commands.FocusOf(pressAt(at.X + 50, at.Y + high + 2, solided(out = "Out[2]:"))))
end
isPressBesideNothing() = value.IsMissing(commands.FocusOf(pressAt(atHill(solided()).X - 10, atHill(solided()).Y + 50, solided())))

defn turnSent(v, s)
  (** The window as if the session had sent the scene of a view asked for the surface, for the next tick to take. *)
  out = s
  r = s.Buffers[1].CellRun
  scene = solidScene(v, notebook.GraphWidth(s))
  r.Turning = {Task: fiber.Spawn(() -> result.Ok(scene)), Buffer: 1, Key: 9, View: v}
  out.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  out
end
hillTitle(s) = [i.Text for i in [c for c in hill(s).Draw(1000, look) if c.Kind == "graph"][1].Items if i.Kind == "text"][1]   (** The title the graph shows. *)
defn isTurnLands()
  s = ticked(turnSent([-27.5, 30.0], press("right", onHill(solided()))))
  value.Equal(hill(s).Graph.View, [-27.5, 30.0]) and hillTitle(s) == "-27.5" and value.IsMissing(dict.GetOr("Turning", missing, s.Buffers[1].CellRun)) and not notebook.Moving(sessioned(s))
end
defn isLatestWins()
  (* Two presses while the first view is asked: once it comes, the latest view is asked, not the one between. *)
  s = turnSent([-27.5, 30.0], press("right", onHill(solided())))
  s = press("right", press("right", s))
  s = ticked(sessioned(s))
  value.Equal(hill(s).Graph.View, [-27.5, 30.0]) and value.Equal(s.Buffers[1].CellRun.Turning.View, [-7.5, 30.0])
end
defn isBadViewStays()
  s = press("right", onHill(solided()))
  r = s.Buffers[1].CellRun
  r.Turning = {Task: fiber.Spawn(() -> result.Ok(dict.Put("View", [0.0, 100.0], solidScene([0.0, 100.0], 640)))), Buffer: 1, Key: 9, View: [-27.5, 30.0]}
  s.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  s = ticked(s)
  value.Equal(hill(s).Graph.View, [-37.5, 30.0]) and value.Equal(hill(s).Graph.Aim, [-37.5, 30.0]) and str.Contains("doesn't turn", s.Message)
end

(* The checks of a mesh and of a view, which come from the session: each part at its edges. *)
mesh = solidScene([0.0, 30.0], 640).Items[1]
meshFault(f) = notebook.SceneFault(scene([f(mesh)]))   (** What SceneFault says of the mesh changed by f. *)
isMeshAccepted() = value.IsMissing(meshFault(m -> m)) and value.IsMissing(notebook.SceneFault(solidScene([10.0, -90.0], 640)))
isMeshCountsRefused() = value.IsSome(meshFault(m -> dict.Put("Rows", 0, m))) and value.IsSome(meshFault(m -> dict.Put("Columns", 201, m))) and value.IsSome(meshFault(m -> dict.Put("Rows", 2.0, m)))
isMeshPlacesRefused() = value.IsSome(meshFault(m -> dict.Put("Xs", list.Take(8, m.Xs), m))) and value.IsSome(meshFault(m -> dict.Put("Ys", list.Append(1.0, m.Ys), m))) and value.IsSome(meshFault(m -> dict.Put("Xs", list.Fill(1e7, 9), m))) and value.IsSome(meshFault(m -> dict.Put("Xs", [1.0, 2.0, 3.0, "x", 5.0, 6.0, 7.0, 8.0, 9.0], m))) and value.IsSome(meshFault(m -> dict.Put("Ys", list.Fill(1.0 / 0.0, 9), m)))
isMeshColorsRefused() = value.IsSome(meshFault(m -> dict.Put("Colors", [0, 1, 3, -1], m))) and value.IsSome(meshFault(m -> dict.Put("Colors", [0, 1, -2, 0], m))) and value.IsSome(meshFault(m -> dict.Put("Colors", [0, 1, 2], m))) and value.IsSome(meshFault(m -> dict.Put("Colors", [0.0, 1.0, 2.0, 0.0], m)))
isMeshPaletteRefused() = value.IsSome(meshFault(m -> dict.Put("Palette", [], m))) and value.IsSome(meshFault(m -> dict.Put("Palette", ["red", "#21918c", "#fde725"], m))) and value.IsSome(meshFault(m -> dict.Put("Palette", list.Fill("#000000", 257), m)))
isMeshOrderRefused() = value.IsSome(meshFault(m -> dict.Put("Order", [1, 0], m))) and value.IsSome(meshFault(m -> dict.Put("Order", [1], m))) and value.IsSome(meshFault(m -> dict.Put("Order", [1.0, 1], m)))
isViewRefused() = value.IsSome(notebook.SceneFault(solidScene([0.0, 91.0], 640))) and value.IsSome(notebook.SceneFault(solidScene([0.0 / 0.0, 30.0], 640))) and value.IsSome(notebook.SceneFault(solidScene([1.0], 640)))

(* The quads drawn: the far rows first, by the order, holes left out, two triangles each, and four vertices of the color of their place. *)
parts = sdl.MeshParts(dict.Put("Palette", [1, 2, 3], mesh))
isMeshPartsOrder() = parts.NV == 12 and parts.NI == 18 and value.Equal(parts.Gather[1..8], [7.0, 8.0, 9.0, 10.0, 15.0, 16.0, 13.0, 14.0])
isMeshPartsColors() = parts.Colors[1] == 0.0 and parts.Colors[3] == 3.0 / 255.0 and parts.Colors[17] == 0.0 and parts.Colors[19] == 1.0 / 255.0

defn faultHolds(c)
  (** SceneFault answers any mesh, and one it accepts makes as many quads as are no holes, each with its four corners among its points. *)
  item = {Kind: "mesh", Rows: c.Rows, Columns: c.Columns, Xs: c.Xs, Ys: c.Ys, Palette: c.Palette, Colors: c.Colors, Order: c.Order, Clip: missing, Role: "data"}
  fault = notebook.SceneFault(scene([item]))
  if value.IsSome(fault)
    return value.IsText(fault)
  end
  p = sdl.MeshParts(notebook.Prepared(scene([item]), ".").Scene.Items[1])
  p.NV == 4 * list.Count(k -> k >= 0, c.Colors) and (p.NV == 0 or list.Max(p.Gather) <= 2 * value.Len(c.Xs))
end
meshes = gen.Of({Rows: gen.Int(-1, 4), Columns: gen.Int(-1, 4), Xs: gen.List(gen.Float(-10, 10), min = 0, max = 30), Ys: gen.List(gen.Float(-10, 10), min = 0, max = 30),
  Palette: gen.List(gen.Pick(["#000000", "#ffffff", "#21918c", "red", "#12345"]), min = 0, max = 4), Colors: gen.List(gen.Int(-2, 4), min = 0, max = 20),
  Order: gen.List(gen.Pick([1, -1, 0, 2]), min = 1, max = 3)})
isFaultFuzz() = test.ForAll(faultHolds, meshes, cases = 400)

(* The triangles of meshes, which come from the session: each part checked at its edges; drawn three vertices a triangle and four an edge, each edge
   after the triangle it follows. *)
tri = {Kind: "triangles", Xs: [0.0, 10.0, 0.0, 10.0], Ys: [0.0, 0.0, 10.0, 10.0], Triangles: [1, 2, 3, 2, 4, 3], Colors: [0xFF0000, 0x00FF00], Lines: [1, 2, 2, 4],
  After: [1, 2], LineColors: [0, 0x101010], Width: 1.0, Clip: missing, Role: "data"}
triFault(f) = notebook.SceneFault(scene([f(tri)]))   (** What SceneFault says of the triangles changed by f. *)
isTrianglesAccepted() = value.IsMissing(triFault(t -> t)) and value.IsMissing(triFault(t -> dict.Merge(t, {Triangles: [], Colors: [], Lines: [], After: [], LineColors: []})))
isTrianglesPlacesRefused() = value.IsSome(triFault(t -> dict.Put("Ys", [0.0, 0.0, 10.0], t))) and value.IsSome(triFault(t -> dict.Put("Xs", [0.0, 1e7, 0.0, 1.0], t))) and value.IsSome(triFault(t -> dict.Put("Xs", [0.0, 1.0 / 0.0, 0.0, 1.0], t)))
isTrianglesCornersRefused() = value.IsSome(triFault(t -> dict.Put("Triangles", [1, 2, 5, 2, 4, 3], t))) and value.IsSome(triFault(t -> dict.Put("Triangles", [0, 2, 3, 2, 4, 3], t))) and value.IsSome(triFault(t -> dict.Put("Triangles", [1, 2, 3, 2, 4], t))) and value.IsSome(triFault(t -> dict.Put("Triangles", [1.0, 2, 3, 2, 4, 3], t)))
isTrianglesColorsRefused() = value.IsSome(triFault(t -> dict.Put("Colors", [0xFF0000], t))) and value.IsSome(triFault(t -> dict.Put("Colors", [-1, 0], t))) and value.IsSome(triFault(t -> dict.Put("Colors", [0x1000000, 0], t))) and value.IsSome(triFault(t -> dict.Put("Colors", ["#ff0000", 0], t)))
isTrianglesEdgesRefused() = value.IsSome(triFault(t -> dict.Put("After", [2, 1], t))) and value.IsSome(triFault(t -> dict.Put("After", [1, 3], t))) and value.IsSome(triFault(t -> dict.Put("Lines", [1, 2, 2, 9], t))) and value.IsSome(triFault(t -> dict.Put("LineColors", [0], t))) and value.IsSome(triFault(t -> dict.Put("Width", 99, t)))
isTooManyTrianglesRefused() = str.StartsWith("triangles have not three", triFault(t -> dict.Merge(t, {Triangles: list.Fill(1, 3 * 400001), Colors: list.Fill(0, 400001)})))
triParts = sdl.TriangleParts(tri)
(* Two triangles of three vertices and two edges of four; triangle 1, then edge 1, then triangle 2, then edge 2, six indices each. *)
isTrianglePartsOrder() = triParts.NV == 14 and triParts.NI == 24 and value.Equal(triParts.Index[1..6], [0, 1, 2, 2, 2, 2]) and value.Equal(triParts.Index[7..12], [6, 7, 8, 6, 8, 9]) and value.Equal(triParts.Index[13..18], [3, 4, 5, 5, 5, 5]) and value.Equal(triParts.Index[19..24], [10, 11, 12, 10, 12, 13])
isTrianglePartsColors() = triParts.Colors[1] == 1.0 and triParts.Colors[2] == 0.0 and triParts.Colors[14] == 1.0 and triParts.Colors[4 * 12 + 1] == 16.0 / 255.0
(* An edge from (0, 0) to (10, 0), 1 pixel wide: a strip from -0.5 to 10.5 along it and from -0.5 to 0.5 across. *)
isTrianglePartsStrip() = value.Equal(triParts.XY[13..20], [-0.5, 0.5, 10.5, 0.5, 10.5, -0.5, -0.5, -0.5])
defn trianglesHold(c)
  (** SceneFault answers any triangles, and those it accepts make three vertices a triangle and four an edge, each index among them. *)
  item = {Kind: "triangles", Xs: c.Xs, Ys: c.Xs, Triangles: c.T, Colors: c.Colors, Lines: c.Lines, After: c.After, LineColors: c.Colors, Width: 1.0}
  fault = notebook.SceneFault(scene([item]))
  if value.IsSome(fault)
    return value.IsText(fault)
  end
  p = sdl.TriangleParts(item)
  p.NV == value.Len(c.T) + 2 * value.Len(c.Lines) and (p.NI == 0 or list.Max(p.Index) < p.NV)
end
triangleCases = gen.Of({Xs: gen.List(gen.Float(-10, 10), min = 0, max = 6), T: gen.List(gen.Int(0, 7), min = 0, max = 9), Colors: gen.List(gen.Int(-1, 3), min = 0, max = 4),
  Lines: gen.List(gen.Int(0, 7), min = 0, max = 4), After: gen.List(gen.Int(0, 4), min = 0, max = 2)})
isTrianglesFuzz() = test.ForAll(trianglesHold, triangleCases, cases = 400)

(* Tables: a table that a run showed is drawn from its first rows, without a session; its keys move, sort, filter and copy, its rows and the points of
   a marked graph that a session sends are checked before use, and the wheel over it scrolls it. A session's answers are faked as fibers that answer at
   once, as the anim tests do. *)
tableSource = "use std/frame\n\n(* %% Day *)\nhours\n"
dayRows = [["06:52:10", "-0.833", "116.59"], ["7:00:00", "0.48", "117.87"], ["8:00:00", "9.99", "128.27"], ["12:00:00", "28.66", "184.7"]]
(** The value of a table of four rows of the day, as a run gives it, its key 5.1. *)
dayValue = {Kind: "table", Columns: ["heure", "elevation", "azimuth"], Rows: dayRows, Count: 4, Key: "5.1"}

(** The window once cell 2 showed a value as a table, and a graph of key 5 under it, as a run gives them; its session busy, so that nothing asks. *)
tabled(v) = tabledIn(tableSource, v)

defn tabledIn(source, v)
  (** The window on a source once its cell 2 showed a value as a table, and a graph of key 5 under it: see tabled. *)
  s = notebook.Hooked({}).Idle(view.Start([text.Of(source, "day.ce")], look, cell, 1280, 720))
  r = s.Buffers[1].CellRun
  r.Session = "a session"
  r.Task = "a cell runs"
  s.Buffers[1].CellRun = r
  g = dict.Merge(notebook.Prepared({Width: 400, Height: 300, Items: [], Dropped: 0}, "."), {Key: 5, Asked: notebook.GraphWidth(s)})
  s.Buffers[1] = text.WithBlocks([dict.Merge(notebook.Block(4, [], cell, table = notebook.TableOf(v)), {Cell: 2, Base: [], Inputs: {}, Status: missing, Part: 1}),
    dict.Merge(notebook.Block(4, [], cell, graph = g), {Cell: 2, Base: [], Inputs: {}, Status: missing, Part: 2})], s.Buffers[1])
  s.Buffers[1] = text.Place(4, 0, s.Buffers[1])
  s = commands.Unfocused(notebook.FocusControl(s))
  s.Buffers[1] = text.Place(1, 0, s.Buffers[1])
  s
end
(** The block of the table, and of the graph. *)
tableOf(s) = list.FindFirst(x -> value.IsSome(dict.GetOr("Table", missing, x)), text.BlocksOf(s.Buffers[1]))
graphOf(s) = list.FindFirst(x -> value.IsSome(dict.GetOr("Graph", missing, x)), text.BlocksOf(s.Buffers[1]))
defn onTable(state)
  (** The window after C-c e f in the cell of the table. *)
  s = state
  s.Buffers[1] = text.Place(4, 0, s.Buffers[1])
  notebook.FocusControl(s)
end
textIn(words, s) = commands.Update({Kind: "text", Text: words}, s)   (** A text typed, as the editor gives it. *)
(** The texts a block draws in a font. *)
textsIn(x, font) = [c for c in x.Draw(1000, look) if c.Kind == "text" and c.Font == font]

isTableValueKinds() = notebook.IsTableValue(dayValue) and notebook.IsTableValue({Kind: "array", Shape: [3, 2], Rows: [["1", "2"]]}) and not notebook.IsTableValue({Kind: "array", Shape: [1, 4], Rows: [["1"]]}) and not notebook.IsTableValue({Kind: "text", Text: "1"})
(* Its rows, its header in the strong font and its note under it; the numbers on the right, their decimal points in one column; the texts on the left. *)
isTableDrawn() = tableOf(tabled(dayValue)).Rows == 6 and value.Equal([c.Text for c in textsIn(tableOf(tabled(dayValue)), "strong")], ["heure", "elevation", "azimuth"]) and
  list.Last(textsIn(tableOf(tabled(dayValue)), "code")).Text == "4 rows"
defn isDecimalPointsInLine()
  numbers = [c for c in textsIn(tableOf(tabled(dayValue)), "code") if c.Text in ["-0.833", "0.48", "9.99", "28.66"]]
  dots = [c.X + (str.Find(".", c.Text) - 1) * cell.Width for c in numbers]
  texts = [c.X for c in textsIn(tableOf(tabled(dayValue)), "code") if c.Text in ["06:52:10", "7:00:00"]]
  value.Len(numbers) == 4 and list.Min(dots) == list.Max(dots) and texts[1] == texts[2]
end
isLongCellCut() = notebook.TableOf(dict.Put("Rows", [[str.Repeat(100, "x"), "1", "2"]], dict.Put("Count", 1, dayValue))).Rows[1][1] == "$(str.Repeat(39, "x"))…"
isMatrixAskedWhole() = notebook.TableOf({Kind: "array", Shape: [30, 12], Rows: [["1"]], Key: 3}).Stale and not notebook.TableOf({Kind: "array", Shape: [3, 2], Rows: [["1", "2"], ["3", "4"], ["5", "6"]], Key: 3}).Stale
isOldTableFixed() = notebook.TableOf(dict.Drop("Key", dayValue)).Fixed and not notebook.TableOf(dayValue).Fixed

(* The keys: C-c e f, the arrows choose a row, which the graph of the cell wants marked; s sorts and asks the rows again; / types a filter; M-w copies. *)
isFocusTable() = commands.FocusOf(onTable(tabled(dayValue))).Table == "5.1" and value.Len(tableOf(onTable(tabled(dayValue))).Draw(1000, look)) == value.Len(tableOf(tabled(dayValue)).Draw(1000, look)) + 16
isDownChooses() = tableOf(press("down", press("down", onTable(tabled(dayValue))))).Table.Selected == 3 and value.Equal(graphOf(press("down", press("down", onTable(tabled(dayValue))))).Graph.Wants, [3, 4])
isRowReversed() = list.Any([c.Kind == "rect" and c.Color == ui.Dark.Ink and c.Height == cell.Height for c in tableOf(press("down", onTable(tabled(dayValue)))).Draw(1000, look)])
isEndLastRow() = tableOf(press("end", onTable(tabled(dayValue)))).Table.Row == 4 and tableOf(press("home", press("end", onTable(tabled(dayValue))))).Table.Row == 1
defn isSortCycles()
  s = press("right", onTable(tabled(dayValue)))
  one = tableOf(textIn("s", s)).Table
  two = tableOf(textIn("s", textIn("s", s))).Table
  three = tableOf(textIn("s", textIn("s", textIn("s", s)))).Table
  value.Equal(one.Sort, {Column: "elevation", Descending: false}) and one.Stale and two.Sort.Descending and value.IsMissing(three.Sort)
end
defn isSortKeepsChosen()
  t = tableOf(textIn("s", press("right", press("down", onTable(tabled(dayValue)))))).Table
  t.Find == 2 and value.Len(t.Rows) == 0
end
defn isFilterTyped()
  s = textIn("j", textIn("/", onTable(tabled(dayValue))))
  t = tableOf(s).Table
  kept = tableOf(press("enter", s)).Table
  back = tableOf(press("escape", s)).Table
  t.Draft == "j" and t.Filter == "j" and t.Stale and value.IsMissing(kept.Draft) and kept.Filter == "j" and back.Filter == "" and
    list.Last(textsIn(tableOf(s), "code")).Text == "filter: j▏"
end
isFilterBackspace() = tableOf(press("backspace", textIn("j", textIn("/", onTable(tabled(dayValue)))))).Table.Filter == ""
isCopyCell() = commands.Clipboard(press("M-w", press("right", press("down", onTable(tabled(dayValue)))))) == "0.48"
isCopyRow() = commands.Clipboard(press("M-w", press("C-u", press("down", onTable(tabled(dayValue)))))) == "7:00:00\t0.48\t117.87"
isPrefixEnds() = commands.Clipboard(press("M-w", press("down", press("C-u", onTable(tabled(dayValue)))))) == "7:00:00"
isEscapeLeavesTable() = value.IsMissing(commands.FocusOf(press("escape", onTable(tabled(dayValue))))) and value.IsMissing(commands.FocusOf(press("C-g", onTable(tabled(dayValue)))))
(* No key changes while no table has the keys: s and / are typed in the buffer, M-w copies as it did. *)
defn isKeysUnchangedWithoutFocus()
  s = keyed(tabled(dayValue))
  t = commands.Update({Kind: "text", Text: "/"}, commands.Update({Kind: "text", Text: "s"}, s))
  value.IsMissing(commands.FocusOf(t)) and line(t, 1) == "s/use std/frame" and value.IsMissing(tableOf(t).Table.Sort)
end
isFixedRefusesSort() = value.IsMissing(tableOf(textIn("s", onTable(tabled(dict.Drop("Key", dayValue))))).Table.Sort)
isCopyFixedTable() = str.StartsWith("heure,elevation,azimuth\n06:52:10,-0.833,116.59\n", commands.Clipboard(notebook.CopyTable(onTable(tabled(dict.Drop("Key", dayValue))))))

(* An edit of a value: a table written in the file, frame.Of of lists, edited at the cursor by Enter, e or a double click; what is typed takes the place
   of the old value in the file, one step of undo, checked for the kind of its column, and the cell runs again; Escape takes it back; a table that comes
   from code is refused. *)
writtenSource = "use std/frame\n\n(* %% Day *)\nhours = frame.Of({heure: [\"06:52:10\", \"7:00:00\", \"8:00:00\", \"12:00:00\"], elevation: [-0.833, 0.48, 9.99, 28.66], azimuth: [116.59, 117.87, 128.27, 184.7]})\nhours\n"
written() = onTable(tabledIn(writtenSource, dayValue))   (** The window with the keys on the table that the file writes. *)
editing() = press("enter", press("right", press("down", written())))   (** The value 0.48 being edited. *)
(** What is typed in the value being edited, after erasing it. *)
retyped(words, s) = textIn(words, press("backspace", press("backspace", press("backspace", press("backspace", s)))))
isEditStarts() = tableOf(editing()).Table.Edit.Draft == "0.48" and tableOf(editing()).Table.Edit.Caret == 4 and dict.Has("delete", commands.FocusOf(editing()).Keys) and
  tableOf(press("e", press("right", press("down", written())))).Table.Edit.Position == 2
defn isEditWrites()
  s = press("enter", retyped("12.5", editing()))
  r = s.Buffers[1].CellRun
  str.Contains("elevation: [-0.833, 12.5, 9.99, 28.66]", line(s, 4)) and value.IsMissing(tableOf(s).Table.Edit) and dict.Has("s", commands.FocusOf(s).Keys) and
    value.Equal(r.Queue, [2]) and r.Carry.Cell == 2 and r.Carry.At == 2 and line(commands.Undo(s), 4) == line(written(), 4)
end
isEditWholeWritten() = str.Contains("elevation: [-0.833, 3.0, 9.99", line(press("enter", retyped("3", editing())), 4))
defn isEditTextWritten()
  s = press("enter", textIn(" \"x\"", press("enter", written())))
  str.Contains("heure: [\"06:52:10 \\\"x\\\"\", \"7:00:00\"", line(s, 4))
end
defn isEditWrongKindRefused()
  s = press("enter", retyped("abc", editing()))
  s.Message == "elevation takes a number: abc is none." and tableOf(s).Table.Edit.Draft == "abc" and line(s, 4) == line(written(), 4)
end
isEditEscape() = value.IsMissing(tableOf(press("escape", retyped("1", editing()))).Table.Edit) and line(press("escape", retyped("1", editing())), 4) == line(written(), 4)
isEditSameWritesNothing() = press("enter", editing()).Buffers[1].Version == written().Buffers[1].Version
isEditCaretMoves() = tableOf(textIn("9", press("home", editing()))).Table.Edit.Draft == "90.48" and tableOf(press("delete", press("left", editing()))).Table.Edit.Draft == "0.4"
isEditFromCodeRefused() = str.StartsWith("Only a table written in the file as values is edited here", press("enter", onTable(tabled(dayValue))).Message)
defn isEditDoubleClick()
  s = written()
  x = tableOf(s)
  c = list.FindFirst(i -> i.Kind == "text" and i.Text == "0.48", x.Draw(1000, look))
  at = {X: c.X + 1, Y: c.Y + 1, Width: 1000, Clicks: 2}
  t = x.Mouse("down", at, s)
  tableOf(t).Table.Edit.Draft == "0.48" and value.IsMissing(dict.GetOr("Edit", missing, tableOf(x.Mouse("down", dict.Put("Clicks", 1, at), s)).Table))
end
defn isEditDrawn()
  items = tableOf(textIn("7", editing())).Draw(1000, look)
  list.Any([i.Kind == "text" and i.Text == "0.487" for i in items]) and "edit: Enter writes it in the file, Escape takes it back" in [c.Text for c in textsIn(tableOf(editing()), "code")]
end

(* The width of a column: < and > a character narrower or wider, = as wide as the values shown, the border of its header dragged, a double click there.
   A column narrower than its values cuts them and its header with …. *)
handOn(s) = tableOf(s).Table.Hand[1]
isWider() = handOn(press(">", written())) == 9 and handOn(press(">", press(">", written()))) == 10
defn isNarrower()
  s = written()
  for k in 1..20
    s = press("<", s)
  end
  texts = [c.Text for c in tableOf(s).Draw(1000, look) if c.Kind == "text" and c.Font == "code" and c.X == 3 * cell.Width]
  handOn(s) == 1 and list.All([t == "…" for t in texts]) and value.Len(texts) == 4
end
isHeadCut() = list.Any([c.Text == "he…" for c in textsIn(tableOf(press("<", press("<", press("<", press("<", press("<", written())))))), "strong")])
isFitColumn() = handOn(press("=", press(">", press(">", written())))) == 8
defn isBorderDragged()
  s = written()
  x = tableOf(s)
  edge = 2 * cell.Width + 10 * cell.Width
  down = x.Mouse("down", {X: edge + 1, Y: 5, Width: 1000}, s)
  moved = tableOf(down).Mouse("move", {X: edge + 40, Y: 5, Width: 1000}, down)
  up = tableOf(moved).Mouse("up", {X: edge + 40, Y: 5, Width: 1000}, moved)
  fit = tableOf(up).Mouse("down", {X: edge + 40, Y: 5, Width: 1000, Clicks: 2}, up)
  tableOf(down).Table.Drag.Column == 1 and handOn(moved) == 13 and value.IsMissing(tableOf(up).Table.Drag) and handOn(fit) == 8 and value.IsMissing(tableOf(down).Table.Sort)
end

(* The totals row: t shows it, its sums, then means, least, greatest and counts, then none; the totals that the session sends are checked, and drawn
   under the rows with the decimals of their column; the line under the table says what they count. *)
totaled(s) = tableOf(s).Table.Totals   (** The totals row of the table. *)
defn isTotalsTurn()
  s = written()
  stats = []
  for k in 1..6
    s = textIn("t", s)
    stats = list.Append(if value.IsMissing(totaled(s)) "none" else totaled(s).Stat end, stats)
  end
  value.Equal(stats, ["sum", "mean", "min", "max", "count", "none"]) and notebook.TableHeight(tableOf(textIn("t", written())).Table) == 7 and tableOf(textIn("t", written())).Rows == 7
end
dayTotals = {Count: 4, Total: 4, Columns: [{Name: "heure", Count: 4, Missing: 0, Sum: missing, Mean: missing, Min: missing, Max: missing},
  {Name: "elevation", Count: 4, Missing: 0, Sum: 38.297000000000004, Mean: 9.574250000000001, Min: -0.833, Max: 28.66}, {Name: "azimuth", Count: 3, Missing: 1, Sum: 362.73, Mean: 120.91, Min: 116.59, Max: 128.27}]}
defn totalsSent(state, answer)
  (** The window as if the session had sent the totals of the table, for the next tick to take. *)
  s = textIn("t", state)
  r = s.Buffers[1].CellRun
  r.Task = missing
  r.Totaling = {Task: fiber.Spawn(() -> answer), Buffer: 1, Key: "5.1", Filter: ""}
  s.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  ticked(s)
end
defn isTotalsDrawn()
  s = totalsSent(written(), result.Ok(dayTotals))
  texts = [c.Text for c in textsIn(tableOf(s), "code")]
  mean = [c.Text for c in textsIn(tableOf(textIn("t", s)), "code")]
  "38.297" in texts and "4 values" in texts and "362.73" in texts and list.Last(texts) == "4 rows · Σ of 4 rows, 1 missing in azimuth skipped" and "9.57425" in mean and
    not notebook.Moving(s)
end
isTotalsFaultSaid() = str.Contains("totals: they don't count", list.Last(textsIn(tableOf(totalsSent(written(), result.Ok(dict.Put("Columns", [], dayTotals)))), "code")).Text)
isTotalsErrSaid() = str.Contains("totals: gone", list.Last(textsIn(tableOf(totalsSent(written(), result.Err({Kind: "cells", Message: "gone"}))), "code")).Text)
isTotalsFaultRefuses() = value.IsSome(notebook.TotalsFault({Count: 1, Total: 1, Columns: [{Name: "a", Count: 1, Missing: 0, Sum: "2"}]}, {Columns: ["a"]})) and
  value.IsSome(notebook.TotalsFault({Count: 2, Total: 1, Columns: []}, {Columns: []})) and value.IsSome(notebook.TotalsFault("x", {Columns: []}))
isTotalsWithoutSession() = notebook.TableHeight(tableOf(textIn("t", onTable(tabled(dict.Drop("Key", dayValue))))).Table) == 6

(* A table of a thousand rows scrolls: the wheel over it moves it three rows a notch, and gives the screen the wheel at its first row. *)
bigValue = {Kind: "table", Columns: ["i"], Rows: [["$k"] for k in 1..20], Count: 1000, Key: "6"}
defn atTable(s)
  (** A point of the table on the screen, as the mouse finds it. *)
  for y in 0..719
    hit = view.BlockAt(100, y, s)
    if value.IsSome(hit) and value.IsSome(dict.GetOr("Table", missing, hit.Block))
      return {X: 100, Y: y + 2 * cell.Height + 4}
    end
  end
  missing
end
wheelAt(at, amount, s) = commands.Wheel({Kind: "mouse", Action: "wheel", X: at.X, Y: at.Y, Button: 0, Amount: amount}, s)   (** The wheel at a point. *)
isWheelScrollsTable() = tableOf(wheelAt(atTable(tabled(bigValue)), -1.0, tabled(bigValue))).Table.Top == 4 and tabled(bigValue).Buffers[1].Top == wheelAt(atTable(tabled(bigValue)), -1.0, tabled(bigValue)).Buffers[1].Top
isWheelAtTopScrollsScreen() = tableOf(wheelAt(atTable(tabled(bigValue)), 1.0, tabled(bigValue))).Table.Top == 1
isPageAsks() = notebook.TableOf(bigValue).Stale == false and tableOf(press("pagedown", onTable(tabled(bigValue)))).Table.Top == 21 and tableOf(press("pagedown", onTable(tabled(bigValue)))).Table.Row == 21
defn isRowsLand()
  (* The rows asked come in a tick, put in place; rows that are not sane leave the table as it was, and asking no more. *)
  s = press("pagedown", onTable(tabled(bigValue)))
  r = s.Buffers[1].CellRun
  r.Task = missing
  r.Paging = {Task: fiber.Spawn(() -> result.Ok({Columns: ["i"], Rows: [["$k"] for k in 1..100], Count: 1000, Total: 1000, Positions: [k for k in 1..100]})), Buffer: 1, Key: "6", First: 1, Sort: missing, Filter: "", Find: missing}
  s.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  t = tableOf(ticked(s)).Table
  bad = s
  r.Paging = {Task: fiber.Spawn(() -> result.Ok({Columns: ["i"], Rows: [["<script>"] for k in 1..2], Count: 1000, Total: 1000, Positions: [0, 2000]})), Buffer: 1, Key: "6", First: 1, Sort: missing, Filter: "", Find: missing}
  bad.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  u = tableOf(ticked(bad)).Table
  value.Len(t.Rows) == 100 and t.Rows[21][1] == "21" and u.Fixed and value.Len(u.Rows) == 20
end
isRowsFaultRefuses() = value.IsSome(notebook.RowsFault({Columns: ["a"], Rows: [["1", "2"]], Count: 1, Total: 1, Positions: [1]}, {})) and value.IsSome(notebook.RowsFault({Columns: ["a"], Rows: [[str.Repeat(201, "x")]], Count: 1, Total: 1, Positions: [1]}, {})) and
  value.IsSome(notebook.RowsFault({Columns: ["a"], Rows: list.Fill(["1"], 1001), Count: 1001, Total: 1001, Positions: list.Fill(1, 1001)}, {})) and value.IsSome(notebook.RowsFault({Columns: ["a"], Rows: [["1"]], Count: 2, Total: 1, Positions: [1]}, {}))

(* A row and its point: a marked scene that the session sent shows in the graph with the places of its points; a click on one chooses its row. *)
defn markSent(state, points)
  (** The window as if the session had sent the scene of the graph marked at row 2 of 4, with these points, for the next tick to take. *)
  s = press("down", onTable(state))
  r = s.Buffers[1].CellRun
  r.Task = missing
  r.Marking = {Task: fiber.Spawn(() -> result.Ok({Width: 400, Height: 300, Items: [], Dropped: 0, Points: points})), Cell: 2, Key: 5, Mark: [2, 4], Width: 400}
  s.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  ticked(s)
end
layer = [{Layer: 1, Kind: "line", Label: missing, At: [1, 2, 3, 4], Xs: [10.0, 100.0, 200.0, 300.0], Ys: [250.0, 200.0, 100.0, 50.0]}]
isMarkLands() = value.Equal(graphOf(markSent(tabled(dayValue), layer)).Graph.Mark, [2, 4]) and value.Len(graphOf(markSent(tabled(dayValue), layer)).Graph.Points) == 1
isNoLayerNotLinked() = value.IsMissing(dict.GetOr("Mark", missing, graphOf(markSent(tabled(dayValue), [])).Graph)) and value.Equal(graphOf(markSent(tabled(dayValue), [])).Graph.Unlinked, [4])
isBadPointsRefused() = value.IsMissing(dict.GetOr("Mark", missing, graphOf(markSent(tabled(dayValue), [{At: [1, 2], Xs: [1.0], Ys: [1.0, 2.0]}])).Graph)) and
  value.IsSome(notebook.PointsFault([{At: [0], Xs: [1.0], Ys: [1.0]}]))
(** A click at a point of a block: its press, then its release. *)
clickAt(point, x, s) = x.Mouse("up", point, x.Mouse("down", point, s))
defn isClickPointChooses()
  s = markSent(tabled(dayValue), layer)
  g = graphOf(s)
  t = clickAt({X: 2 * cell.Width + 201, Y: g.Under + 99, Width: 1000}, g, s)
  far = clickAt({X: 2 * cell.Width + 150, Y: g.Under + 150, Width: 1000}, g, s)
  tableOf(t).Table.Selected == 3 and value.Equal(graphOf(t).Graph.Wants, [3, 4]) and tableOf(far).Table.Selected == 2
end

(* 2D graphs with the mouse and the keys, without a session: a graph of key 8 whose points and axes the session sent, as for the mouse; its session
   busy with a cell, so that nothing else is asked. The line a has four points, the points b two; the axes put x from 0 to 5 on 0 to 500 pixels and y
   from 0 to 35 on 350 to 0. *)
graphSource = "use std/plot\n\n(* %% Wave *)\nwave\n"
wavePoints = [{Layer: 1, Kind: "line", Label: "a", Count: 4, At: [1, 2, 3, 4], Xs: [100.0, 200.0, 300.0, 400.0], Ys: [250.0, 150.0, 100.0, 50.0], Values: {X: [1.0, 2.0, 3.0, 4.0], Y: [10.0, 20.0, 25.0, 30.0]}},
  {Layer: 2, Kind: "points", Label: "b", Count: 2, At: [1, 2], Xs: [100.0, 300.0], Ys: [200.0, 200.0], Values: {X: [1.0, 3.0], Y: [15.0, 15.0]}}]
waveAxes = {X: {Scale: "linear", Low: 0.0, High: 5.0, From: 0.0, To: 500.0}, Y: {Scale: "linear", Low: 0.0, High: 35.0, From: 350.0, To: 0.0}}

defn pointsSent(state, answer, live = true)
  (** The window once the session sent this answer to the question of the points of the graph of key 8 and a tick took it; then busy again with a
      cell, so that nothing more is asked. *)
  s = state
  r = s.Buffers[1].CellRun
  r.Task = missing
  r.Marking = {Task: fiber.Spawn(() -> answer), Cell: 2, Key: 8, Mark: missing, Zoom: missing, Points: live, Width: notebook.GraphWidth(s)}
  s.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  t = ticked(s)
  r = t.Buffers[1].CellRun
  r.Task = "a cell runs"
  t.Buffers[1].CellRun = r
  t
end

defn plain(live = true)
  (** The window once cell 2 showed the graph of key 8, as a run gives it, with no point yet; live when the mouse came over it. *)
  s = notebook.Hooked({}).Idle(view.Start([text.Of(graphSource, "wave.ce")], look, cell, 1280, 720))
  r = s.Buffers[1].CellRun
  r.Session = "a session"
  r.Task = "a cell runs"
  s.Buffers[1].CellRun = r
  g = dict.Merge(notebook.Prepared({Width: 500, Height: 350, Items: [], Dropped: 0}, "."), {Key: 8, Asked: notebook.GraphWidth(s), Live: live})
  s.Buffers[1] = text.WithBlocks([dict.Merge(notebook.Block(4, [], cell, graph = g), {Cell: 2, Base: [], Inputs: {}, Status: missing, Part: 1})], s.Buffers[1])
  s
end

(** The window once the points of the graph came. *)
graphed() = pointsSent(plain(), result.Ok({Width: 500, Height: 350, Items: [], Dropped: 0, Points: wavePoints, Axes: waveAxes}))
(** The block of the graph, and its graph. *)
waveOf(s) = list.FindFirst(x -> value.IsSome(dict.GetOr("Graph", missing, x)), text.BlocksOf(s.Buffers[1]))
waveGraph(s) = waveOf(s).Graph
(** A place of the scene of the graph as a point of its block. *)
inWave(x, y, s) = {X: 2 * cell.Width + x, Y: waveOf(s).Under + y, Width: 1000}
(** The mouse over a place of the graph; a click there; the wheel there. *)
hoverWave(x, y, s) = waveOf(s).Hover(inWave(x, y, s), s)
clickWave(x, y, s) = clickAt(inWave(x, y, s), waveOf(s), s)
wheelWave(x, y, amount, s) = waveOf(s).Wheel(amount, inWave(x, y, s), s)
(** The texts and the boxes drawn over the graph. *)
boxWords(s) = list.Flatten([[i.Text for i in c.Items] for c in list.Skip(1, [c for c in waveOf(s).Draw(1000, look) if c.Kind == "graph"])])
(** The window with the keys on the graph, through C-c e f in its cell. *)
defn waveFocused(s)
  t = s
  t.Buffers[1] = text.Place(4, 0, t.Buffers[1])
  notebook.FocusControl(t)
end

isPointsLand() = waveGraph(graphed()).Pointed and value.Equal(waveGraph(graphed()).Axes, waveAxes) and value.Len(waveGraph(graphed()).Near.X) == 6 and value.Equal(waveGraph(graphed()).Own, {X: [0.0, 5.0], Y: [0.0, 35.0]})
(* The mouse over the graph: the point nearest, within 12 pixels, shows a thin cross and its values, named by its layer as the graph has two; none
   past 12 pixels; and none once the mouse leaves. *)
isHoverNearest() = value.Equal(waveGraph(hoverWave(203, 148, graphed())).Hover, {Layer: 1, J: 2}) and value.Equal(boxWords(hoverWave(203, 148, graphed())), ["a: x = 2  y = 20"])
isHoverNoneFar() = value.IsMissing(dict.GetOr("Hover", missing, waveGraph(hoverWave(150, 300, graphed())))) and value.Equal(boxWords(hoverWave(150, 300, graphed())), [])
isHoverLeaves() = value.IsMissing(waveGraph(waveOf(hoverWave(203, 148, graphed())).Hover(missing, hoverWave(203, 148, graphed()))).Hover) and
  value.Equal(boxWords(waveOf(hoverWave(203, 148, graphed())).Hover(missing, hoverWave(203, 148, graphed()))), [])
defn isHoverCross()
  rects = [c for c in waveOf(hoverWave(203, 148, graphed())).Draw(1000, look) if c.Kind == "rect" and (c.Width == 13 or c.Height == 13)]
  value.Len(rects) == 2 and rects[1].X == 2 * cell.Width + 200 - 6 and rects[2].Y == waveOf(graphed()).Under + 150 - 6
end
(* The first time the mouse comes over a graph, it asks the session its points, once; a move asks nothing more. *)
defn isFirstHoverAsks()
  s = pointsSent(plain(live = false), result.Ok({Width: 500, Height: 350, Items: [], Dropped: 0}), live = false)
  r = s.Buffers[1].CellRun
  r.Task = missing
  s.Buffers[1].CellRun = r
  t = waveOf(s).Hover(inWave(100, 100, s), s)
  m = t.Buffers[1].CellRun.Marking
  waveGraph(t).Live and m.Points and m.Key == 8 and value.IsMissing(m.Mark)
end
(* Points or axes that aren't sane are refused: the graph shows no values, and asks them no more. *)
defn isBadPointsNoValues()
  bad = pointsSent(plain(), result.Ok({Width: 500, Height: 350, Items: [], Dropped: 0, Points: [dict.Put("Values", {X: ["<b>", 2.0, 3.0, 4.0], Y: [1.0, 2.0, 3.0, 4.0]}, wavePoints[1])], Axes: waveAxes}))
  axes = pointsSent(plain(), result.Ok({Width: 500, Height: 350, Items: [], Dropped: 0, Points: wavePoints, Axes: {X: waveAxes.X, Y: dict.Put("Low", 35.0, waveAxes.Y)}}))
  waveGraph(bad).Pointed and value.IsMissing(dict.GetOr("Near", missing, waveGraph(bad))) and value.IsMissing(dict.GetOr("Axes", missing, waveGraph(axes))) and value.IsMissing(dict.GetOr("Hover", missing, waveGraph(hoverWave(203, 148, bad))))
end
(* A grid of graphs has no axes: it shows no values, and says nothing; the wheel over it moves the screen. *)
defn isGridNoValues()
  s = pointsSent(plain(), result.Ok({Width: 500, Height: 350, Items: [], Dropped: 0}))
  g = waveGraph(s)
  g.Pointed and value.Len(g.Points) == 0 and value.IsMissing(dict.GetOr("Axes", missing, g)) and s.Message == "" and value.IsMissing(wheelWave(250, 175, 1.0, waveFocused(s)))
end
(* A mark asked with the points of a graph that has none, as a grid, leaves it as it is and isn't asked again. *)
defn isMarkOnGridLeft()
  s = plain()
  r = s.Buffers[1].CellRun
  r.Task = missing
  r.Marking = {Task: fiber.Spawn(() -> result.Ok({Width: 500, Height: 350, Items: [], Dropped: 0})), Cell: 2, Key: 8, Mark: [2, 4], Zoom: missing, Points: true, Width: notebook.GraphWidth(s)}
  s.Buffers[1].CellRun = r
  sys.Sleep(0.001)
  g = waveGraph(ticked(s))
  value.Equal(g.Unlinked, [4]) and value.IsMissing(dict.GetOr("Mark", missing, g))
end
isPointsFaults() = value.IsSome(notebook.PointsFault([dict.Put("Count", 2, wavePoints[1])], full = true)) and value.IsSome(notebook.PointsFault([dict.Put("Label", str.Repeat(201, "x"), wavePoints[1])], full = true)) and
  value.IsSome(notebook.PointsFault(list.Fill(wavePoints[1], 65))) and value.IsMissing(notebook.PointsFault(wavePoints, full = true)) and
  value.IsSome(notebook.AxesFault({X: waveAxes.X, Y: {Scale: "log", Low: -1.0, High: 2.0, From: 0.0, To: 10.0}})) and value.IsSome(notebook.AxesFault({X: dict.Put("Scale", "time", waveAxes.X), Y: waveAxes.Y}))
(* The buckets find the point that a measure of every point finds, on random clouds. *)
defn nearestHolds(c)
  points = [{At: [j for j in 1..value.Len(c.Xs)], Xs: c.Xs, Ys: c.Ys}]
  near = notebook.NearOf(points)
  got = notebook.NearestIn(near, c.X, c.Y)
  ds = [(c.Xs[j] - c.X) * (c.Xs[j] - c.X) + (c.Ys[j] - c.Y) * (c.Ys[j] - c.Y) for j in 1..value.Len(c.Xs)]
  least = list.Min(ds)
  if least > 144.0 value.IsMissing(got) else value.IsSome(got) and ds[got.J] == least end
end
clouds = gen.Then(n -> gen.Of({Xs: gen.List(gen.Float(0, 200), min = n, max = n), Ys: gen.List(gen.Float(0, 200), min = n, max = n), X: gen.Float(-20, 220), Y: gen.Float(-20, 220)}), gen.Int(1, 60))
isNearestFuzz() = test.ForAll(nearestHolds, clouds, cases = 300)

(* A click on a point pins its values, and gives the graph the keys; again, unpins them; several pins stay together. A press above the graph goes to the
   text. *)
isClickPins() = value.Len(waveGraph(clickWave(301, 101, graphed())).Pins) == 1 and value.Equal(commands.FocusOf(clickWave(301, 101, graphed())).Graph, 8) and value.Equal(boxWords(clickWave(301, 101, graphed())), ["a: x = 3  y = 25"])
isClickAgainUnpins() = value.Len(waveGraph(clickWave(301, 101, clickWave(301, 101, graphed()))).Pins) == 0
isTwoPins() = value.Equal(list.Sort(boxWords(clickWave(99, 199, clickWave(301, 101, graphed())))), ["a: x = 3  y = 25", "b: x = 1  y = 15"])
isPressAboveGivesText() = value.IsMissing(waveOf(graphed()).Mouse("down", {X: 2 * cell.Width + 10, Y: waveOf(graphed()).Under - 3, Width: 1000}, graphed()))
(* The keys after C-c e f: the arrows go from point to point, along a layer and to the next; Space pins; M-w copies x and y; Escape unpins, then leaves. *)
isFocusGraph() = value.Equal(commands.FocusOf(waveFocused(graphed())).Graph, 8) and value.Len([c for c in waveOf(waveFocused(graphed())).Draw(1000, look) if c.Kind == "rect" and c.Color == ui.Dark.Accent]) >= 8
isArrowsWalk() = waveGraph(press("right", press("right", waveFocused(graphed())))).Spot.At == 2 and value.Equal(boxWords(press("right", press("right", waveFocused(graphed())))), ["a: x = 2  y = 20"])
isDownNextLayer() = value.Equal(waveGraph(press("down", press("right", press("right", press("right", waveFocused(graphed())))))).Spot, {Layer: 2, At: 2})
isArrowsStayInside() = waveGraph(press("left", press("left", waveFocused(graphed())))).Spot.At == 1 and waveGraph(press("up", press("right", waveFocused(graphed())))).Spot.Layer == 1
isSpacePins() = value.Len(waveGraph(press("space", press("right", waveFocused(graphed())))).Pins) == 1
isCopyPoint() = commands.Clipboard(press("M-w", press("right", press("right", waveFocused(graphed()))))) == "2.0\t20.0"
isCopyPins() = commands.Clipboard(press("M-w", clickWave(99, 199, clickWave(301, 101, graphed())))) == "3.0\t25.0\n1.0\t15.0"
isEscapeUnpinsThenLeaves() = value.IsSome(commands.FocusOf(press("escape", clickWave(301, 101, graphed())))) and value.Len(waveGraph(press("escape", clickWave(301, 101, graphed()))).Pins) == 0 and
  value.IsMissing(commands.FocusOf(press("escape", press("escape", clickWave(301, 101, graphed())))))
(* The wheel: without the keys, the graph gives it to the screen; with them, it zooms about the mouse, the value under it staying there; 0 goes back. *)
isWheelWithoutKeys() = value.IsMissing(wheelWave(250, 175, 1.0, graphed()))
defn isWheelZooms()
  z = waveGraph(wheelWave(250, 175, 1.0, waveFocused(graphed()))).Zoom
  near = (a, b) -> math.Abs(a[1] - b[1]) < 1e-9 and math.Abs(a[2] - b[2]) < 1e-9
  near(z.X, [0.5, 4.5]) and near(z.Y, [3.5, 31.5])
end
isZeroBack() = value.IsMissing(waveGraph(textIn("0", wheelWave(250, 175, 1.0, waveFocused(graphed())))).Zoom)
defn isDragMoves()
  s = waveFocused(graphed())
  d = waveOf(s).Mouse("down", inWave(250, 175, s), s)
  m = waveOf(d).Mouse("move", inWave(300, 175, d), d)
  z = waveGraph(m).Zoom
  math.Abs(z.X[1] + 0.5) < 1e-9 and math.Abs(z.X[2] - 4.5) < 1e-9 and math.Abs(z.Y[1]) < 1e-9 and value.Len(dict.GetOr("Pins", [], waveGraph(waveOf(m).Mouse("up", inWave(300, 175, m), m)))) == 0
end
defn isDragWithoutKeysStays()
  s = graphed()
  d = waveOf(s).Mouse("down", inWave(250, 175, s), s)
  value.IsMissing(dict.GetOr("Zoom", missing, waveGraph(waveOf(d).Mouse("move", inWave(300, 175, d), d))))
end
defn isZoomOnLog()
  s = pointsSent(plain(), result.Ok({Width: 500, Height: 350, Items: [], Dropped: 0, Points: [], Axes: {X: {Scale: "log", Low: 1.0, High: 100.0, From: 0.0, To: 500.0}, Y: waveAxes.Y}}))
  z = waveGraph(wheelWave(250, 175, 1.0, waveFocused(s))).Zoom
  math.Abs(z.X[1] - 10.0 ^ 0.2) < 1e-9 and math.Abs(z.X[2] - 10.0 ^ 1.8) < 1e-9
end
defn isZoomPolarRadius()
  s = pointsSent(plain(), result.Ok({Width: 500, Height: 350, Items: [], Dropped: 0, Points: [], Axes: {Center: [250.0, 175.0], Y: {Scale: "linear", Low: 90.0, High: 0.0, From: 0.0, To: 150.0}}}))
  z = waveGraph(wheelWave(250, 100, 1.0, waveFocused(s))).Zoom
  value.IsMissing(z.X) and math.Abs(z.Y[1] - 81.0) < 1e-9 and math.Abs(z.Y[2] - 9.0) < 1e-9
end
(* A zoom of many notches asks one scene at a time: the notches that come while one is asked change only the ranges wanted, which the next question
   asks once the answer came. *)
defn isZoomCoalesced()
  s = waveFocused(graphed())
  alive = fiber.Channel()
  fiber.Close(alive)
  r = s.Buffers[1].CellRun
  r.Session = {Path: "wave.ce", Alive: alive}
  r.Task = missing
  s.Buffers[1].CellRun = r
  one = wheelWave(250, 175, 1.0, s)
  three = wheelWave(250, 175, 1.0, wheelWave(250, 175, 1.0, one))
  asked = one.Buffers[1].CellRun.Marking
  value.IsSome(asked) and value.Equal(three.Buffers[1].CellRun.Marking.Zoom, asked.Zoom) and not value.Equal(waveGraph(three).Zoom, asked.Zoom) and
    math.Abs(waveGraph(three).Zoom.X[2] - waveGraph(three).Zoom.X[1] - 5.0 * 0.8 ^ 3) < 1e-9
end
isZoomBounded() = value.Equal(waveGraph(list.Reduce((t, j) -> wheelWave(250, 175, 5.0, t), waveFocused(graphed()), 1..20)).Zoom.X[2] - waveGraph(list.Reduce((t, j) -> wheelWave(250, 175, 5.0, t), waveFocused(graphed()), 1..20)).Zoom.X[1] >= 5e-6, true)
(* No key of the buffer changes while no graph has the keys: 0 is typed, M-w copies as it did. *)
isKeysOfBufferKept() = value.IsMissing(commands.FocusOf(textIn("0", graphed()))) and line(textIn("0", graphed()), 1) == "0use std/plot"
(* Tab goes from the table of a cell to its graph and back. *)
isTabTableGraph() = value.Equal(commands.FocusOf(press("tab", onTable(tabled(dayValue)))).Graph, 5) and commands.FocusOf(press("tab", press("tab", onTable(tabled(dayValue))))).Table == "5.1"
(* A box stays inside the plot: at the right edge, it goes to the left of its point. *)
isBoxInsidePlot() = list.All([c.X + c.Width <= 2 * cell.Width + 500 for c in waveOf(clickWave(401, 51, graphed())).Draw(1000, look) if c.Kind == "box"])
isSvgPathStaysBeside() = notebook.SvgPath("/a/b/sun.ce", "x/../../etc", 2, 1) == "/a/b/sun-x-etc.svg" and notebook.SvgPath("sun.ce", "Été 2026 : élévation", 2, 3) == "sun-ete-2026-elevation-3.svg"

(* C-c e r: the code it runs, a line, a block, a selection, or nothing for a line that is blank or a comment. *)
ceAt(line, words) = text.Place(line, 0, text.Of(words, "a.ce"))
codeAt(line, words) = notebook.CodeAt(ceAt(line, words))
isCodeLine() = value.Equal(codeAt(2, "x = 1\ny = x + 1\nz"), {Code: "y = x + 1", Line: 3})
isCodeBlock() = value.Equal(codeAt(1, "defn f(x)\n  x + 1\nend\nf(1)"), {Code: "defn f(x)\n  x + 1\nend", Line: 4})
isCodeIf() = value.Equal(codeAt(1, "if a\n  b\nelse\n  c\nend\nd"), {Code: "if a\n  b\nelse\n  c\nend", Line: 6})
isCodeCall() = value.Equal(codeAt(1, "xs = list.Map(x ->\n  x * 2, ys)\nzs"), {Code: "xs = list.Map(x ->\n  x * 2, ys)", Line: 3})
isCodeNeverEnds() = value.Equal(codeAt(1, "defn f(x)\n  x"), {Code: "defn f(x)", Line: 2})
isCodeEmpty() = value.IsMissing(codeAt(2, "x\n   \ny")) and value.IsMissing(codeAt(1, "(* a note *)\nx")) and value.IsMissing(codeAt(1, "  (* a *) (* b *)"))
isCodeNotComment() = value.Equal(codeAt(1, "x (* a note *)"), {Code: "x (* a note *)", Line: 2})
isCodeSelection() = value.Equal(notebook.CodeAt(text.Place(1, 5, text.SetMark(text.Place(1, 4, text.Of("x = 1 + 2", "a.ce"))))), {Code: "1", Line: missing})
isRunInReplOtherBuffer() = str.StartsWith("*repl* runs in the session of a buffer of Cesia", notebook.RunInRepl(view.Start([text.Of("x", "notes.md")], look, cell, 800, 600)).Message)

(* C-c e t: the file of cells as a small app, its code hidden: the titles of the cells that show something, and what they show. *)
(** The file of sliders with a session that is busy, so that nothing starts one, and the cell Use showing words when given. *)
defn appFile(words = missing)
  s = busy(opened())
  if value.IsSome(words) withBlock(1, 3, words, s) else s end
end
(** The texts that a state draws, its screens followed. *)
appTexts(s) = [c.Text for c in view.View(view.FollowState(0, s)) if c.Kind == "text"]
(** Does a state draw any line of the code of the file? Each draws its number in the gutter, left of the text, where no title and no block draws. *)
showsCode(s) = list.Any([c.Kind == "text" and c.X < view.Gutter and c.Y < 670 and value.IsSome(str.Number(c.Text)) for c in view.View(view.FollowState(0, s))])
isAppKey() = notebook.Keys()["C-c e t"] == notebook.ToggleCode
isAppHidesCode() = (s -> not showsCode(s) and "Parameters" in appTexts(s) and "Use" in appTexts(s) and list.Any([str.Contains("84.0", t) for t in appTexts(s)]) and "rho" in appTexts(s))(notebook.ToggleCode(appFile(words = [{Role: "value", Words: "84.0"}])))
isAppShowsCodeBefore() = showsCode(appFile(words = [{Role: "value", Words: "84.0"}]))
isAppCellWithNothingGone() = (s -> not ("Use" in appTexts(s)) and "Parameters" in appTexts(s) and not showsCode(s))(notebook.ToggleCode(appFile()))
isAppErrorShows() = (s -> "Use" in appTexts(s) and list.Any([str.Contains("boom", t) for t in appTexts(s)]) and not showsCode(s))(notebook.ToggleCode(appFile(words = [{Role: "error", Words: "boom"}])))
isAppRunningShows() = (s -> "Use" in appTexts(s) and list.Any([str.Contains("running", t) for t in appTexts(s)]) and not showsCode(s))(notebook.ToggleCode(appFile(words = running(0.0))))
isAppUntitledCell() = (s -> "Cell 1" in appTexts(s))(notebook.ToggleCode(withBlock(1, 2, [{Role: "value", Words: "1"}], busy(notebook.Hooked({}).Idle(view.Start([text.Of("x = 0\n(* %% *)\nx + 1\n", "nb.ce")], look, cell, 1280, 720))))))
isAppSaysHidden() = notebook.ToggleCode(appFile()).Message == "The code is hidden: C-c e t shows it."
isAppCursorOnTitle() = notebook.ToggleCode((s -> dict.Put("Buffers", [text.Place(5, 3, s.Buffers[1])], s))(appFile())).Buffers[1].Cursor.Line == 3
(** From the head of the file, the cursor goes to the first title shown; from a cell that shows nothing, to the next title, or else the one before. *)
isAppCursorNextShown() = notebook.ToggleCode(appFile()).Buffers[1].Cursor.Line == 3 and notebook.ToggleCode((s -> dict.Put("Buffers", [text.Place(8, 0, s.Buffers[1])], s))(appFile())).Buffers[1].Cursor.Line == 3
defn isAppOffSame()
  (** C-c e t twice gives back the same frame, the cursor on the marker of its cell, on the same row of the screen. *)
  s = view.FollowState(0, (t -> dict.Put("Buffers", [text.Place(3, 0, t.Buffers[1])], t))(appFile(words = [{Role: "value", Words: "84.0"}])))
  back = view.FollowState(0, notebook.ToggleCode(view.FollowState(0, notebook.ToggleCode(s))))
  back.Message = ""
  value.IsMissing(text.FoldOf(back.Buffers[1])) and value.Equal(view.View(back), view.View(s)) and back.Buffers[1].CellRun.App == false
end
isAppTypingRefused() = (s -> s.Buffers[1].Version == 0 and s.Message == "The code is hidden: C-c e t shows it.")(commands.Update({Kind: "text", Text: "x"}, notebook.ToggleCode(appFile())))
isAppNoCell() = notebook.ToggleCode(view.Start([text.Of("x = 1", "a.ce")], look, cell, 800, 600)).Message == "This buffer has no cell: (* %% Title *) on a line of a .ce file starts one, and C-c e i writes it."
defn isAppReplUnchanged()
  (** In *repl* or *variables*, C-c e t says there is no cell and changes nothing. *)
  s = view.Start([text.Of(source, "nb.ce"), newRepl("nb.ce")], look, cell, 800, 600)
  s.Current = 2
  t = notebook.ToggleCode(s)
  str.StartsWith("This buffer has no cell", t.Message) and value.Equal(t.Buffers, s.Buffers)
end

(* The fold of an app follows the file, before each frame: an input's write, a table's that adds a line, a file read again, a cell that shows something
   or no longer. *)
(** A state of the app with the hooks of the editor and of the cells, as src/cemacs.ce has them. *)
appEditor(s) = dict.Put("Config", () -> notebook.Hooked(emacs.Config(emacs.Keys)), s)
(** A key pressed in the editor. *)
appKey(chord, s) = commands.Update({Kind: "key", Key: chord, Ctrl: false, Alt: false, Shift: false, Super: false}, s)
(** The window of the app on the file of sliders, Use showing 84.0, rho with the keys. *)
appFocused() = notebook.FocusControl(appEditor(notebook.ToggleCode(appFile(words = [{Role: "value", Words: "84.0"}]))))
isAppSliderKey() = (s -> line(s, 4) == "rho = cells.Slider(28.5, 0.0, 50.0, step = 0.5)" and s.Buffers[1].CellRun.Moves["rho"].Pending == 28.5 and not showsCode(s) and
  "Parameters" in appTexts(s) and s.Message == "")(appKey("right", appFocused()))
isAppTypingAfterWrite() = (s -> line(s, 4) == "rho = cells.Slider(28.5, 0.0, 50.0, step = 0.5)" and s.Message == "The code is hidden: C-c e t shows it.")(commands.Update({Kind: "text", Text: "x"}, commands.Unfocused(appKey("right", appFocused()))))
isAppUndoAfterWrite() = (s -> line(s, 4) == "rho = cells.Slider(28.5, 0.0, 50.0, step = 0.5)" and s.Message == "The code is hidden: C-c e t shows it.")(commands.Update({Kind: "key", Key: "/", Ctrl: true, Alt: false, Shift: false, Super: false}, commands.Unfocused(appKey("right", appFocused()))))
defn isAppLineAdded()
  (** A write of the app that adds a line to a cell, as a table's value that grows: the fold is made again, Use's title one line further, no code shown. *)
  s = appEditor(notebook.ToggleCode(appFile(words = [{Role: "value", Words: "84.0"}])))
  grown = text.Replaced([{Line: 5, Column: 0, End: 0, Text: "m = 1\n"}], s.Buffers[1])
  s.Buffers[1] = text.WithFold(dict.Put("Written", grown.Version, text.FoldOf(grown)), grown)
  t = commands.Settled(s)
  not showsCode(t) and dict.Has("8", text.FoldOf(t.Buffers[1]).Titles) and not dict.Has("7", text.FoldOf(t.Buffers[1]).Titles) and "Use" in appTexts(t)
end
defn isAppFileReadAgain()
  (** The file read again with a cell added outside: the fold follows the new text, no code shown, and the new cell's title comes once it shows something. *)
  s = appEditor(notebook.ToggleCode(appFile(words = [{Role: "value", Words: "84.0"}])))
  b = s.Buffers[1]
  last = rope.LineCount(b.Rope)
  s.Buffers[1] = text.MarkSaved(missing, text.Replaced([{Line: last, Column: 0, End: 0, Text: "\n(* %% Later *)\nrho + n\n"}], b))
  t = commands.Settled(s)
  u = commands.Settled(withBlock(1, 4, [{Role: "value", Words: "31.0"}], fresh(1, t)))
  not showsCode(t) and not ("Later" in appTexts(t)) and not showsCode(u) and "Later" in appTexts(u) and "Use" in appTexts(u)
end
isAppClearedTitleGoes() = (s -> not ("Use" in appTexts(s)) and "Parameters" in appTexts(s) and not showsCode(s))(commands.Settled(notebook.ClearResults(appEditor(notebook.ToggleCode(appFile(words = [{Role: "value", Words: "84.0"}]))))))
