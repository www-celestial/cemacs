(** Cells: a file of Cesia cut by (* %% Title *) comments runs as a notebook, its results drawn under its cells, as blocks of the buffer: never typed,
    never saved. C-c e e runs the cell of the cursor and the cells that read what it defines, C-c e a every cell from the top; each cell file has a session
    of std/cells, a Cesia process that keeps the names its cells defined. `*variables*` lists them beside, `*repl*` below runs code in the same session, and
    C-c e h writes the page of the file. A cell of sliders, name = cells.Slider(28.0, 0.0, 50.0), draws a slider under each line, which the mouse and C-c e f
    move: the number is written in the buffer, and only the cells that read it run again. The other inputs of a form, cells.Choice, cells.Check,
    cells.Field and cells.Date, draw their boxes under their lines and change the same way. An animation of plot.Frames shows its first frame over a bar,
    ▶ 1 / 120, that Space plays after C-c e f, or the mouse; its frames come from the session one at a time. A 3D graph of plot.Surface or plot.Line3
    turns when dragged, or with the arrows after C-c e f: the session draws each view, and the code keeps its own. A frame, a matrix or a list of maps
    or structs draws as a table, with thin borders, its header and its numbers aligned, 20 rows at a time, scrolled by the wheel or by its keys after
    C-c e f or a click: its rows come from the session a screen at a time, sorted by s and filtered by / there; the row chosen marks its point on the
    graphs of its cell that have as many points, and a click on such a point chooses its row. The work is std/cells': runs wait
    in fibers, and each tick takes their results, so that typing never waits.
    src/cemacs.ce adds the hooks of Hooked to the config and these Keys. *)
use core/commands
use core/files
use core/lists
use core/panes
use core/run
use core/text
use core/view
use src/rope
use std/cells as nb
use std/cesia
use std/columns as col
use std/csv
use std/date
use std/debug
use std/dict
use std/fiber
use std/list
use std/math
use std/result
use std/sys
use std/text as str
use std/value

(** The keys of the cells, in their group of C-c: e for execute. M-p and M-n go through the history in `*repl*`, and Enter there runs what was typed. *)
Keys() = {"C-c e": "execute", "C-c e e": RunCell, "C-c e a": RunAll, "C-c e i": InsertCell, "C-c e v": ShowVariables, "C-c e r": OpenRepl,
  "C-c e s": StopCell, "C-c e h": WriteHtml, "C-c e k": ClearResults, "C-c e f": FocusControl, "C-c e c": CopyTable, "enter": Enter, "S-enter": Enter,
  "M-p": HistoryBack, "M-n": HistoryOn}

(** The most lines of a result drawn under a cell: its output, then its value, each cut there with a line that says how many more. *)
MaxLines() = 40

(* ---- The run of a buffer: {Session, Cells, Analysis, Queue, Task, Index, Started, Stopping, Html, Vars, Version}. *)

defn runOf(b)
  (** The cells run of a buffer, or missing: a buffer from before this field has none. *)
  match b
    {CellRun: r} -> r
    else -> missing
  end
end

(** Does the text of a buffer have a cell marker? A file of cells is a file of Cesia with one. *)
IsCells(b) = not lists.IsList(b) and not value.IsMissing(b.Path) and str.EndsWith(".ce", b.Path) and value.Len(nb.Parse(rope.Text(b.Rope))) > 1

defn withRun(k, r, state)
  (** The state with the cells run of buffer k. *)
  s = state
  s.Buffers[k].CellRun = r
  s
end

defn allowOf(path)
  (** The permissions of the task of cesia.toml that runs the file at path, as C-c c r gives them, or none. *)
  read = files.ReadFile("cesia.toml")
  if result.IsErr(read) or read.Value.Words == ""
    return []
  end
  name = run.TaskFor(read.Value.Words, path, sys.Env("PWD"))
  tables = cesia.Toml(read.Value.Words)
  if value.IsMissing(name) or result.IsErr(tables)
    return []
  end
  for t in tables.Value
    if value.Len(t.Path) == 2 and t.Path[1] == "tasks" and t.Path[2] == name
      for e in t.Entries
        if e.Key == "allow" and value.IsArray(e.Value)
          return e.Value
        end
      end
    end
  end
  []
end

defn session(k, state)
  (** The run of buffer k with a session, started if it had none: an Ok, or an Err that says why it can't start. *)
  b = state.Buffers[k]
  r = runOf(b)
  if not value.IsMissing(r) and not value.IsMissing(r.Session)
    return result.Ok(r)
  end
  s = nb.Session(b.Path, allow = allowOf(b.Path))?
  (* A run without a session, as the sliders and a page make one, keeps its cells and its analysis. *)
  out = if value.IsMissing(r) newRun() else r end
  out.Session = s
  out.Values = {}
  (* A new session numbers its outputs from 1, as a new kernel of Jupyter. *)
  out.Runs = 0
  result.Ok(out)
end

defn analysed(k, r, state)
  (** The run with the cells and the analysis of the text of buffer k now, with its unsaved changes: the cells run what the buffer shows. *)
  b = state.Buffers[k]
  out = r
  if r.Version != b.Version
    out.Cells = nb.Parse(rope.Text(b.Rope))
    out.Analysis = nb.Analyse(out.Cells)
    out.Version = b.Version
  end
  out
end

defn CellAt(line, cells)
  (** The index of the cell that holds a line.

        CellAt(3, nb.Parse("use std/io\n(* %% A *)\nx = 1")) --> 2 *)
  found = 1
  for i in 1..value.Len(cells)
    if cells[i].From <= line
      found = i
    end
  end
  found
end

defn anchor(cell, b)
  (** The line under which the result of a cell is drawn: its last line that isn't blank, or its marker. *)
  n = list.Min(cell.To, rope.LineCount(b.Rope))
  while n > cell.From and str.Trim(rope.Line(n, b.Rope)) == ""
    n = n - 1
  end
  list.Max(1, n)
end

(* ---- Results, drawn. *)

(** A row of a block: words in a color, at a row from 0. *)
rowText(k, words, paint, cell) = {Kind: "text", X: 0, Y: k * cell.Height, Text: words, Color: paint, Font: "code"}

(** The words cut to the columns of a width. *)
fitted(words, width, cell) = if value.Len(words) * cell.Width <= width words else str.Join("", list.Take(list.Max(0, math.Div(width, cell.Width) - 1), str.Chars(words))) end

defn TableLines(columns, rows)
  (** A table as lines of text, each column as wide as its widest text, numbers on the right.

        TableLines(["a", "name"], [["10", "x"], ["2", "yz"]]) --> ["a   name", "10  x   ", " 2  yz  "] *)
  all = list.Prepend(columns, rows)
  widths = [list.Max([value.Len(r[j]) for r in all]) for j in 1..value.Len(columns)]
  pad = (t, j) -> if value.IsSome(str.Number(t)) str.PadLeft(widths[j], " ", t) else str.PadRight(widths[j], " ", t) end
  [str.Join("  ", [pad(r[j], j) for j in 1..value.Len(columns)]) for r in all]
end

defn valueLines(v)
  (** What a value shows, as lines, each with a role: "value", or "note" for a count. *)
  if value.IsMissing(v) or v.Kind == "graph"
    []
  else if v.Kind == "table"
    rows = [{Role: "value", Words: l} for l in TableLines(v.Columns, v.Rows)]
    list.Append({Role: "note", Words: if v.Count > value.Len(v.Rows) "$(value.Len(v.Rows)) of $(v.Count) rows" else "$(v.Count) rows" end}, rows)
  else if v.Kind == "array"
    shape = str.Join(" × ", ["$n" for n in v.Shape])
    list.Prepend({Role: "note", Words: shape}, [{Role: "value", Words: l} for l in TableLines(["" for c in v.Rows[1]], v.Rows) if str.Trim(l) != ""])
  else
    [{Role: "value", Words: l} for l in str.Lines(v.Text)]
  end
end

defn capped(lines)
  (** At most MaxLines() lines, the last saying how many were left out. *)
  if value.Len(lines) <= MaxLines()
    lines
  else
    list.Append({Role: "note", Words: "… $(value.Len(lines) - MaxLines() + 1) more lines"}, list.Take(MaxLines() - 1, lines))
  end
end

defn resultLines(done)
  (** The lines of a result: the errors of the analysis, or what the cell printed then its value or its error. *)
  if value.Len(done.Errors) > 0
    return [{Role: "error", Words: "line $(e.Line): $(e.Message)"} for e in done.Errors]
  end
  printed = [{Role: "output", Words: l} for l in done.Output]
  shown = if value.IsSome(done.Error) [{Role: "error", Words: l} for l in str.Lines(done.Error.Text)] else valueLines(done.Value) end
  list.Concat(capped(printed), capped(shown))
end

defn colorOf(role, th)
  (** The color of a line of a result. *)
  if role == "error"
    view.ErrorColor
  else if role == "output"
    th.Ink
  else if role == "note"
    th.Faint
  else
    th.Muted
  end
end

defn Block(line, lines, cell, graph = missing, focused = false, out = missing, at = 0, table = missing)
  (** A block of lines under a line, each {Role, Words}, with a thin bar on its left: drawn at the width of the pane, cut to it. A graph, {Key,
      Scene, Font}, comes under the lines, its scene drawn by sdl at its own size, which keeps the shape of the graph: the width of the pane or the
      graph's own when it is less, a polar graph square; an animation's has its bar under it, see BarItems,
      and a 3D graph the line of its view, see ViewItems, each with a ring when focused; a 2D graph the values of its points under the mouse, pinned
      or chosen by the keys, and its ring when focused, see GraphOverlay. A table comes there instead, see TableItems, with its ring when
      focused. Out, a label as Out[3]:, marks a result as Jupyter does: the
      lines after the first at ones, which are its status and its note, start after it, on its row, and the others under them; a result with no line
      gives the label a row of its own, above its graph. Under is how far down the block its graph or its table starts, in pixels.

        Block(3, [{Role: "value", Words: "42"}], {Width: 8, Height: 19}).Rows --> 1 *)
  alone = value.IsSome(out) and value.Len(lines) <= at
  rowed = if alone list.Append({Role: "note", Words: out}, lines) else lines end
  pad = if value.IsMissing(out) or alone 0 else value.Len(out) + 1 end
  label = if value.IsMissing(out) or alone [] else [{At: at, Words: out}] end
  high = if value.IsSome(table) TableHeight(table) else if value.IsMissing(graph) 0 else math.Div(graph.Scene.Height + 8 + cell.Height - 1, cell.Height) end
  bar = if isAnimation(graph) or isTurning(graph) 1 else 0 end
  rows = list.Max(1, value.Len(rowed) + high + bar)
  top = value.Len(rowed) * cell.Height + (if value.IsSome(table) 0 else 4 end)
  under = (value.Len(rowed) + high) * cell.Height
  shown = (width, look) -> if value.IsSome(table) TableItems(table, focused, width, top, cell, look.Theme, look) else if value.IsMissing(graph) [] else list.Prepend({Kind: "graph", X: 2 * cell.Width, Y: top, Width: graph.Scene.Width, Height: graph.Scene.Height, Items: themed(graph.Scene.Items, look.Theme), Font: graph.Font, Fallback: graph.Fallback}, if isFlat(graph) GraphOverlay(graph, focused, top, cell, look.Theme) else [] end) end
  draw = (width, look) -> list.Concat(list.Concat(list.Concat(list.Prepend({Kind: "rect", X: 0, Y: 2, Width: 2, Height: rows * cell.Height - 4, Color: look.Theme.Line},
    [lineText(k, rowed[k], if k > at pad else 0 end, width, look, cell) for k in 1..value.Len(rowed)]),
    [rowText(l.At, "  $(l.Words)", colorOf("note", look.Theme), cell) for l in label]),
    shown(width, look)),
    if bar == 0 [] else if isAnimation(graph) BarItems(graph, focused, width, under, cell, look.Theme) else ViewItems(graph, focused, top, under, cell, look.Theme) end)
  {Line: line, Rows: rows, Draw: draw, Cell: 0, Graph: graph, Table: table, Lines: lines, Out: out, Under: top}
end

(** Line k of a block, {Role, Words}, pad columns after the bar's margin, cut to the width. *)
lineText(k, l, pad, width, look, cell) = rowText(k - 1, "  $(str.Repeat(pad, " "))$(fitted(l.Words, width - (2 + pad) * cell.Width, cell))", colorOf(l.Role, look.Theme), cell)

(** Is a graph of a block an animation, with its bar? *)
isAnimation(graph) = value.IsSome(graph) and dict.Has("Frames", graph)

(** The value of a byte that is a hexadecimal digit, 0 to 15, in either case; -1 for any other. *)
hexDigit(b) = if b >= 48 and b <= 57 b - 48 else if b >= 97 and b <= 102 b - 87 else if b >= 65 and b <= 70 b - 55 else -1 end

defn hexColor(color)
  (** A color of a scene, "#rrggbb", as 0xRRGGBB, read byte by byte, a byte that is no digit as 0; "ink" and "grid", the colors of the theme, stay
      for the draw. *)
  if not value.IsText(color) or str.ByteLength(color) != 7 or not str.StartsWith("#", color)
    return color
  end
  n = 0
  for k in 2..7
    n = n * 16 + list.Max(0, hexDigit(str.Byte(k, color)))
  end
  n
end

(* ---- A scene comes from the session, another process: it is input, checked before anything is made of it. *)

(** The most vertices that the shapes of one scene may make, and the most items, cells and marks, frames of an animation and quads of a surface
    each way: past them a scene is refused, not drawn. *)
SceneLimits() = {Vertices: 4000000, Items: 20000, Cells: 4194304, Edges: 8193, Marks: 250000, Points: 1000000, Text: 1000, Frames: 300, Quads: 200}

(** Is every element of an array a number, or missing where a gap is allowed? *)
numbers(xs, gaps) = value.IsArray(xs) and list.All([value.IsNumber(x) or (gaps and value.IsMissing(x)) for x in xs])

(** Is a value a number from low to high? *)
within(x, low, high) = value.IsNumber(x) and x >= low and x <= high

defn places(xs, n)
  (** Is a value n places on the screen, each a number from -1,000,000 to 1,000,000: checked by whole arrays when JSON gave numbers alone, where
      their sum, which can't grow past 10^12, is finite only when each is. *)
  if not value.IsArray(xs) or value.Len(xs) != n or n == 0
    return false
  end
  if not (col.Kind(xs) in ["float", "int"])
    return numbers(xs, false) and list.All([x >= -1000000 and x <= 1000000 for x in xs])
  end
  total = list.Sum(xs)
  total - total == 0 and list.Min(xs) >= -1000000 and list.Max(xs) <= 1000000
end

(** Is a value a color "#rrggbb"? *)
isHex(x) = value.IsText(x) and str.ByteLength(x) == 7 and str.StartsWith("#", x) and list.All([hexDigit(str.Byte(k, x)) >= 0 for k in 2..7])

defn meshFault(item, lim)
  (** What is wrong with the quads of a surface, or missing: their counts, the places of their points, their palette, a color of it for each, or -1
      for a hole, and their order; with the vertices they make when they are right. *)
  rows = dict.GetOr("Rows", missing, item)
  cols = dict.GetOr("Columns", missing, item)
  if not (value.IsInt(rows) and within(rows, 1, lim.Quads) and value.IsInt(cols) and within(cols, 1, lim.Quads))
    return {Fault: "a mesh has no count of quads from 1 to $(lim.Quads) each way"}
  end
  n = (rows + 1) * (cols + 1)
  if not (places(dict.GetOr("Xs", missing, item), n) and places(dict.GetOr("Ys", missing, item), n))
    return {Fault: "a mesh has not the $n places of its points, from -1000000 to 1000000"}
  end
  palette = dict.GetOr("Palette", missing, item)
  if not (value.IsArray(palette) and within(value.Len(palette), 1, 256) and list.All([isHex(x) for x in palette]))
    return {Fault: "a mesh has no palette of 1 to 256 colors"}
  end
  colors = dict.GetOr("Colors", missing, item)
  if not (value.IsArray(colors) and value.Len(colors) == rows * cols and col.Kind(colors) == "int" and list.Min(colors) >= -1 and list.Max(colors) < value.Len(palette))
    return {Fault: "a mesh has not a color of its palette, or -1, for each quad"}
  end
  order = dict.GetOr("Order", missing, item)
  if not (value.IsArray(order) and value.Len(order) == 2 and list.All([value.IsInt(x) and (x == 1 or x == -1) for x in order]))
    return {Fault: "a mesh has no order of 1 or -1 for its rows and its columns"}
  end
  {Vertices: rows * cols * 4}
end

defn itemFault(item, lim)
  (** What is wrong with an item of a scene, or missing; with the vertices it makes when it is right. *)
  if not value.IsDict(item) or not dict.Has("Kind", item)
    return {Fault: "an item is no shape"}
  end
  clip = dict.GetOr("Clip", missing, item)
  if value.IsSome(clip) and not (value.IsArray(clip) and value.Len(clip) == 4 and numbers(clip, false))
    return {Fault: "a clip is no rectangle"}
  end
  color = dict.GetOr("Color", missing, item)
  if value.IsSome(color) and not value.IsText(color)
    return {Fault: "a color is no text"}
  end
  k = item.Kind
  if k == "line" or k == "area" or k == "marks"
    n = value.Len(dict.GetOr("Xs", [], item))
    most = if k == "marks" lim.Marks else lim.Points end
    if n > most or not numbers(dict.GetOr("Xs", missing, item), k == "line") or not numbers(dict.GetOr("Ys", missing, item), k == "line") or value.Len(item.Ys) != n
      return {Fault: "a $k has no points, or more than $most, or not as many y as x"}
    end
    if k == "line" and not within(dict.GetOr("Width", missing, item), 0, 50)
      return {Fault: "a line is no width from 0 to 50"}
    end
    dash = dict.GetOr("Dash", missing, item)
    if k == "line" and value.IsSome(dash) and not (value.IsArray(dash) and (value.Len(dash) == 2 or value.Len(dash) == 4) and list.All([within(d, 0.5, 1000) for d in dash]))
      return {Fault: "a dash is no two or four lengths"}
    end
    if k == "marks" and not within(dict.GetOr("Size", missing, item), 0, 100)
      return {Fault: "marks have no size from 0 to 100"}
    end
    return {Vertices: if k == "line" n * 4 else if k == "marks" n * 9 else n end}
  end
  if k == "rect"
    if not numbers([dict.GetOr("X", missing, item), dict.GetOr("Y", missing, item), dict.GetOr("W", missing, item), dict.GetOr("H", missing, item)], false)
      return {Fault: "a rectangle has no place"}
    end
    return {Vertices: 4}
  end
  if k == "cells"
    xs = dict.GetOr("Xs", missing, item)
    ys = dict.GetOr("Ys", missing, item)
    if not numbers(xs, false) or not numbers(ys, false) or value.Len(xs) < 2 or value.Len(ys) < 2 or value.Len(xs) > lim.Edges or value.Len(ys) > lim.Edges
      return {Fault: "cells have no grid of 2 to $(lim.Edges) edges a side"}
    end
    count = (value.Len(xs) - 1) * (value.Len(ys) - 1)
    colors = dict.GetOr("Colors", missing, item)
    if count > lim.Cells or not value.IsArray(colors) or value.Len(colors) != count or not list.All([value.IsText(x) or value.IsMissing(x) for x in colors])
      return {Fault: "cells have more than $(lim.Cells) cells, or not a color each"}
    end
    return {Vertices: count * 4}
  end
  if k == "text"
    words = dict.GetOr("Text", missing, item)
    if not value.IsText(words) or value.Len(words) > lim.Text or not within(dict.GetOr("Size", missing, item), 4, 96) or not numbers([dict.GetOr("X", missing, item), dict.GetOr("Y", missing, item), dict.GetOr("Width", missing, item)], false)
      return {Fault: "a text has no words, no size from 4 to 96 or no place"}
    end
    if not (dict.GetOr("Anchor", "start", item) in ["start", "middle", "end"]) or not (dict.GetOr("Angle", 0, item) in [0, -90])
      return {Fault: "a text has an anchor or an angle std/plot never gives"}
    end
    return {Vertices: 0}
  end
  if k == "mesh"
    return meshFault(item, lim)
  end
  {Fault: "an item of kind $(k) is unknown"}
end

defn SceneFault(scene)
  (** What is wrong with a scene that the session sent, or missing: its size, a frame's count and rate, a 3D graph's view, its items and, for all of
      them, the vertices they would make, checked against SceneLimits() before any memory is taken for it.

        SceneFault({Width: 100, Height: 80, Items: [{Kind: "rect", X: 0, Y: 0, W: 10, H: 10, Color: "#ff0000"}]}) --> missing
        SceneFault({Width: 100, Height: 80, Items: [{Kind: "line", Xs: [1, 2], Ys: [1], Width: 1}]}) --> "a line has no points, or more than 1000000, or not as many y as x" *)
  lim = SceneLimits()
  if not value.IsDict(scene) or not within(dict.GetOr("Width", missing, scene), 100, 8192) or not within(dict.GetOr("Height", missing, scene), 80, 4096)
    return "it is no scene from 100 by 80 to 8192 by 4096 pixels"
  end
  frames = dict.GetOr("Frames", missing, scene)
  fps = dict.GetOr("Fps", missing, scene)
  if value.IsSome(frames) != value.IsSome(fps) or (value.IsSome(frames) and not (value.IsInt(frames) and within(frames, 1, lim.Frames) and within(fps, 1, 60)))
    return "it is no frame of 1 to $(lim.Frames), at 1 to 60 a second"
  end
  turn = dict.GetOr("View", missing, scene)
  if value.IsSome(turn) and not (value.IsArray(turn) and value.Len(turn) == 2 and within(turn[1], -1000000, 1000000) and within(turn[2], -90, 90))
    return "its view is no [az, el] in degrees, el from -90 to 90"
  end
  items = dict.GetOr("Items", missing, scene)
  if not value.IsArray(items) or value.Len(items) > lim.Items
    return "it has no items, or more than $(lim.Items)"
  end
  total = 0
  for item in items
    f = itemFault(item, lim)
    if dict.Has("Fault", f)
      return f.Fault
    end
    total = total + f.Vertices
    if total > lim.Vertices
      return "its shapes would make more than $(lim.Vertices) vertices"
    end
  end
  missing
end

defn Prepared(scene, home)
  (** A scene of std/plot ready for the screen: its colors as numbers, once, an Id for each item, by which sdl knows that the item it drew is the
      same, and the font its texts are measured in, JetBrains Mono, the font of the code, from Cemacs's folder, with Noto Sans Medium as its Fallback
      for the characters it lacks.

        Prepared({Width: 100, Height: 80, Items: [{Kind: "rect", Color: "#ff0000"}]}, ".").Scene.Items[1].Color --> 16711680 *)
  items = []
  stamp = sys.Now()
  for k in 1..value.Len(scene.Items)
    item = scene.Items[k]
    one = dict.Put("Color", hexColor(dict.GetOr("Color", missing, item)), item)
    one.Id = "$stamp/$k"
    if item.Kind == "cells"
      one.Colors = [if value.IsMissing(x) missing else hexColor(x) end for x in item.Colors]
    end
    if item.Kind == "mesh"
      one.Palette = [hexColor(x) for x in item.Palette]
    end
    items = list.Append(one, items)
  end
  out = scene
  out.Items = items
  {Scene: out, Font: "$home/fonts/JetBrainsMono-Regular.ttf", Fallback: "$home/fonts/NotoSans-Medium.ttf"}
end

defn themed(items, th)
  (** The items with the colors of the theme in place of "ink", for the axes, the texts and the layers without a colour, "grid", for the grid, and
      "paper", the ground of the code, behind the box of a note. *)
  [if value.IsText(x.Color) dict.Put("Color", if x.Color == "grid" th.Line else if x.Color == "paper" th.Code else th.Ink end, x) else x end for x in items]
end

(** The width that a graph under a cell takes in the pane being edited, in pixels: the pane's text width, past the bar of the block. *)
GraphWidth(state) = list.Max(200, view.LayoutOf(state).Code.Width - view.Gutter - 8 - 2 * state.Cell.Width)

defn resultBlock(k, i, line, lines, graph, state, out = missing, at = 0, table = missing)
  (** The block of the result of cell i of buffer k under a line: its lines and its graph or its table, and its label out after its first at lines, see
      Block; an animation's bar, a 3D graph, a table and a 2D graph of a cell take the mouse, and have a ring while they have the keys; a table takes the
      wheel too, and a 2D graph the moves of the mouse, see graphHover, and the wheel while it has the keys. *)
  look = dict.GetOr("Look", missing, state)
  measuredHeads = if value.IsSome(table) and value.IsSome(look) and value.Len(dict.GetOr("Heads", [], table)) != value.Len(table.Columns) dict.Put("Heads", [look.Width(c, "strong") for c in table.Columns], table) else table end
  made = dict.Merge(Block(line, lines, state.Cell, graph = graph, focused = barFocused(k, graph, state) or turnFocused(k, graph, state) or tableFocused(k, table, state) or graphFocused(k, graph, state), out = out, at = at, table = measuredHeads), {Cell: i})
  if value.IsSome(table)
    key = table.Key
    return dict.Merge(made, {Mouse: (action, point, st) -> tableMouse(key, action, point, st), Wheel: (amount, point, st) -> tableWheel(key, amount, st), Keeps: true})
  end
  if isFlat(graph) and i > 0
    key = graph.Key
    return dict.Merge(made, {Mouse: (action, point, st) -> graphMouse(k, key, action, point, st), Hover: (point, st) -> graphHover(k, key, point, st),
      Wheel: (amount, point, st) -> graphWheel(k, key, amount, point, st), Keeps: true})
  end
  if not (isAnimation(graph) or isTurning(graph))
    return made
  end
  key = graph.Key
  dict.Put("Mouse", if isAnimation(graph) (action, point, st) -> barMouse(key, action, point, st) else (action, point, st) -> turnMouse(key, action, point, st) end, made)
end

(** The state with one block for cell i of buffer k, its lines and its graph, in place of those it had: see withParts. *)
withBlock(k, i, lines, state, graph = missing, inputs = {}, status = missing) = withParts(k, i, [{Lines: lines, Graph: graph}], state, inputs = inputs, status = status)

defn withParts(k, i, parts, state, inputs = {}, status = missing, out = missing)
  (** The state with the blocks of cell i of buffer k in place of those it had: one for each part of its result, {Lines, Graph}, one under the other
      in their order, each numbered by its Part, or none for a cell that printed nothing and shows no value. Inputs are the sliders its result was
      computed with, by name, and their numbers: while the file writes another number, a note says so above the first part. A status, a line as waiting
      or running…, goes there too, above the result, which stays. Out, a label as Out[3]:, marks the first part, after them. *)
  b = state.Buffers[k]
  r = runOf(b)
  kept = [x for x in text.BlocksOf(b) if dict.GetOr("Cell", 0, x) != i]
  note = if value.Len(inputs) == 0 missing else staleNote(inputs, r) end
  head = [x for x in [status, note] if value.IsSome(x)]
  at = anchor(r.Cells[i], b)
  made = []
  for j in 1..value.Len(parts)
    lines = if j == 1 list.Concat(head, parts[j].Lines) else parts[j].Lines end
    table = dict.GetOr("Table", missing, parts[j])
    if value.Len(lines) > 0 or value.IsSome(parts[j].Graph) or value.IsSome(table)
      first = j == 1
      label = if first out else missing end
      made = list.Append(dict.Merge(resultBlock(k, i, at, lines, parts[j].Graph, state, out = label, at = if first value.Len(head) else 0 end, table = table), {Base: parts[j].Lines, Inputs: if first inputs else {} end,
        Status: if first status else missing end, Part: j}), made)
    end
  end
  s = state
  s.Buffers[k] = text.WithBlocks(list.SortBy(x -> x.Line, list.Concat(kept, made)), b)
  s
end

(** The blocks of cell i of buffer k, in the order of their parts. *)
partsOf(k, i, state) = list.SortBy(x -> dict.GetOr("Part", 1, x), [x for x in text.BlocksOf(state.Buffers[k]) if dict.GetOr("Cell", 0, x) == i])

defn withStatus(k, i, status, state)
  (** The state with the blocks of cell i of buffer k showing a status above its result, or none: in a slider's rerun, a cell waits and runs with its
      last result and its graphs in sight, which the new ones replace. *)
  old = partsOf(k, i, state)
  if value.Len(old) == 0
    return withBlock(k, i, [], state, status = status)
  end
  parts = [{Lines: dict.GetOr("Base", x.Lines, x), Graph: dict.GetOr("Graph", missing, x), Table: dict.GetOr("Table", missing, x)} for x in old]
  withParts(k, i, parts, state, inputs = dict.GetOr("Inputs", {}, old[1]), status = status, out = dict.GetOr("Out", missing, old[1]))
end

(** Are two blocks the same part of the same cell? *)
samePart(x, y) = dict.GetOr("Cell", 0, x) == dict.GetOr("Cell", 0, y) and dict.GetOr("Part", 1, x) == dict.GetOr("Part", 1, y)

defn rebuilt(k, x, graph, state, table = missing)
  (** The state with block x of buffer k drawn again with another graph, or another table, in its place among the parts of its cell: its lines, its
      status and its note as they were. *)
  b = state.Buffers[k]
  base = dict.GetOr("Base", x.Lines, x)
  made = dict.Merge(resultBlock(k, x.Cell, x.Line, x.Lines, graph, state, out = dict.GetOr("Out", missing, x), at = value.Len(x.Lines) - value.Len(base), table = if value.IsSome(table) table else dict.GetOr("Table", missing, x) end), {Base: base, Inputs: dict.GetOr("Inputs", {}, x),
    Status: dict.GetOr("Status", missing, x), Part: dict.GetOr("Part", 1, x)})
  s = state
  s.Buffers[k] = text.WithBlocks([if samePart(y, x) made else y end for y in text.BlocksOf(b)], b)
  s
end

(** Does cell i run again for a slider, its last result kept in sight? *)
keeps(i, r) = i in dict.GetOr("Keeping", [], r)

defn resultParts(ran, state, asked = missing)
  (** The parts of the result of a run, each {Lines, Graph, Table}, in the order they came: what the cell printed and what cells.Show showed, then its
      value or its error; each graph and each table ends a part. Each text is cut at MaxLines() lines. A graph that isn't drawn says why on an error line,
      and a run that failed is its message alone. *)
  if result.IsErr(ran)
    return [{Lines: [{Role: "error", Words: ran.Error.Message}], Graph: missing}]
  end
  done = ran.Value
  printed = (first, last) -> capped([{Role: "output", Words: l} for l in done.Output[first..last]])
  out = []
  lines = []
  from = 1
  for p in dict.GetOr("Shown", [], done)
    lines = list.Concat(lines, printed(from, p.After))
    from = list.Max(from, p.After + 1)
    g = graphFrom(p.Value, state, asked = asked)
    if p.Value.Kind == "error"
      lines = list.Concat(lines, [{Role: "error", Words: l} for l in str.Lines(p.Value.Text)])
    else if value.IsSome(g) and dict.Has("Fault", g)
      lines = list.Append({Role: "error", Words: g.Fault}, lines)
    else if value.IsSome(g)
      out = list.Append({Lines: lines, Graph: g}, out)
      lines = []
    else if IsTableValue(p.Value)
      out = list.Append({Lines: lines, Graph: missing, Table: TableOf(p.Value)}, out)
      lines = []
    else
      lines = list.Concat(lines, capped(valueLines(p.Value)))
    end
  end
  lines = list.Concat(lines, printed(from, value.Len(done.Output)))
  if value.IsSome(done.Error)
    return list.Append({Lines: list.Concat(lines, [{Role: "error", Words: l} for l in str.Lines(done.Error.Text)]), Graph: missing}, out)
  end
  g = graphFrom(done.Value, state, asked = asked)
  if value.IsSome(g) and dict.Has("Fault", g)
    return list.Append({Lines: list.Append({Role: "error", Words: g.Fault}, lines), Graph: missing}, out)
  end
  if IsTableValue(done.Value)
    return list.Append({Lines: lines, Graph: missing, Table: TableOf(done.Value)}, out)
  end
  list.Append({Lines: list.Concat(lines, capped(valueLines(done.Value))), Graph: g}, out)
end

defn graphFrom(v, state, asked = missing)
  (** A graph that a run shows, ready for the screen, or missing for a value that is no graph; a scene that isn't sane gives its Fault. Asked is the
      width the session was asked to draw it at, the pane's when the run started: the scene may be narrower, a graph is never drawn past its own width. *)
  if value.IsMissing(v) or v.Kind != "graph"
    return missing
  end
  fault = SceneFault(dict.GetOr("Scene", missing, v))
  if value.IsSome(fault)
    return {Fault: "This graph isn't drawn: $fault."}
  end
  g = dict.Merge(Prepared(v.Scene, commands.Home(state)), {Key: v.Key, Asked: if value.IsMissing(asked) GraphWidth(state) else asked end})
  (* An animation starts paused on its first frame, as at each run of its cell; a 3D graph at the view of its code. *)
  if dict.Has("View", v.Scene)
    seen = clampedView(v.Scene.View)
    return dict.Merge(g, {View: seen, Code: seen, Aim: seen})
  end
  if dict.Has("Frames", v.Scene) dict.Merge(g, {Frames: v.Scene.Frames, Fps: v.Scene.Fps, Frame: 1, Playing: false, Due: 0.0, Times: [], Want: missing}) else g end
end

(** The words of a cell that runs, with the seconds so far. *)
running(seconds) = [{Role: "note", Words: "running… $(str.Decimals(1, seconds)) s"}]

(* ---- Running cells, one at a time, from a queue. *)

defn next(k, state)
  (** The state with the next cell of the queue of buffer k started, if none runs: a cell with errors of the analysis shows them and the queue goes on. *)
  r = runOf(state.Buffers[k])
  s = state
  (* While a slider's Set runs, no cell starts: those after it run with its number. *)
  while value.IsMissing(r.Task) and value.Len(r.Queue) > 0 and value.IsMissing(dict.GetOr("Setting", missing, r))
    i = r.Queue[1]
    r.Queue = list.Skip(1, r.Queue)
    errors = r.Analysis[i].Errors
    if value.Len(errors) > 0
      s = answeredCell(k, i, withBlock(k, i, resultLines({Errors: errors}), withRun(k, r, s)))
    else if str.Trim(r.Cells[i].Source) != ""
      cell = r.Cells[i]
      one = r.Session
      width = GraphWidth(s)
      r = heldBy(i, r)
      r.Inputs = inputsOf(i, r)
      r.Task = fiber.Spawn(() -> nb.Run(one, cell, width = width))
      r.Asked = width
      r.Index = i
      r.Started = sys.Now()
      s = if keeps(i, r) withStatus(k, i, running(0.0)[1], withRun(k, r, s)) else withBlock(k, i, running(0.0), withRun(k, r, s)) end
    else
      s = answeredCell(k, i, withBlock(k, i, [], withRun(k, r, s)))
    end
    r = runOf(s.Buffers[k])
  end
  withRun(k, r, s)
end

defn queued(k, order, state, again = false)
  (** The state with the cells of order queued after the one that runs, in buffer k, each shown as waiting; with again, the one that runs too, as it
      ran with a slider's number before the last one. *)
  r = runOf(state.Buffers[k])
  r.Queue = list.Concat([i for i in r.Queue if not (i in order)], [i for i in order if again or i != r.Index or value.IsMissing(r.Task)])
  if again
    r.Keeping = list.Unique(list.Concat(dict.GetOr("Keeping", [], r), order))
  end
  s = withRun(k, r, state)
  for i in r.Queue
    s = if keeps(i, r) withStatus(k, i, {Role: "note", Words: "waiting"}, s) else withBlock(k, i, [{Role: "note", Words: "waiting"}], s) end
  end
  next(k, s)
end

defn started(order, state)
  (** Runs cells of the current buffer, in a session started if needed: order gives them from the analysis. *)
  k = state.Current
  b = state.Buffers[k]
  if not IsCells(b)
    return commands.Say("This buffer has no cell: (* %% Title *) on a line of a .ce file starts one, and C-c e i writes it.", state)
  end
  got = session(k, state)
  if result.IsErr(got)
    return commands.Say("No session for $(b.Path): $(got.Error.Message)", state)
  end
  r = analysed(k, got.Value, state)
  queued(k, order(r), withRun(k, r, state))
end

(** C-c e e: runs the cell of the cursor, then the cells that read, directly or not, what it defines. *)
RunCell(state) = started(r -> nb.ToRun(r.Analysis, CellAt(state.Buffers[state.Current].Cursor.Line, r.Cells)), state)

(** C-c e a: runs every cell, from the top. *)
RunAll(state) = started(r -> [i for i in 1..value.Len(r.Cells)], state)

defn taken(k, state)
  (** The state after a tick for buffer k: the result of the cell that ran, if it ended, and the next one started; the time of the one that runs. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Task)
    return state
  end
  got = fiber.Wait(r.Task, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    seconds = sys.Now() - r.Started
    if value.Len(text.BlocksOf(state.Buffers[k])) == 0
      return state
    end
    return if keeps(r.Index, r) withStatus(k, r.Index, running(seconds)[1], state) else withBlock(k, r.Index, running(seconds), state) end
  end
  i = r.Index
  r.Task = missing
  r.Index = 0
  ran = if result.IsOk(got) got.Value else got end
  (* A cell queued again while it ran keeps its result in sight for its next run. *)
  r.Keeping = [j for j in dict.GetOr("Keeping", [], r) if j != i or j in r.Queue]
  (* Each result is numbered as Jupyter numbers its outputs: the runs of the session so far, this one counted. *)
  r.Runs = dict.GetOr("Runs", 0, r) + 1
  s = withParts(k, i, resultParts(ran, state, asked = dict.GetOr("Asked", missing, r)), withRun(k, r, state), inputs = dict.GetOr("Inputs", {}, r), out = "Out[$(r.Runs)]:")
  if result.IsErr(ran)
    r = dropped(r)
    r.Session = missing
    r.Queue = []
    r.Values = {}
    return commands.Say("The session of $(state.Buffers[k].Path) has ended: C-c e a starts a new one.", withRun(k, r, s))
  end
  s = next(k, answeredCell(k, i, s, started = r.Started))
  r = runOf(s.Buffers[k])
  if value.IsMissing(r.Task) and not asking(r)
    (* The names for *variables* are asked in a fiber, so that the result shows at once; the next tick takes them. *)
    one = r.Session
    r.Varying = fiber.Spawn(() -> nb.Variables(one))
    sys.Sleep(0)
    s = withRun(k, r, s)
  end
  s
end

defn varied(k, state)
  (** The state at a tick for buffer k: the names of its session for *variables*, once they came. *)
  r = runOf(state.Buffers[k])
  v = if value.IsMissing(r) missing else dict.GetOr("Varying", missing, r) end
  if value.IsMissing(v)
    return state
  end
  got = fiber.Wait(v, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  r.Varying = missing
  vars = if result.IsOk(got) got.Value else got end
  r.Vars = if result.IsOk(vars) vars.Value else [] end
  withRun(k, r, state)
end

defn stopped(k, state)
  (** The state once the stop asked in buffer k answered: with a new session, the cells run again from the top. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Stopping)
    return state
  end
  got = fiber.Wait(r.Stopping, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  r.Stopping = missing
  answer = if result.IsOk(got) got.Value else got end
  if result.IsErr(answer)
    r.Session = missing
    return commands.Say("The session can't stop: $(answer.Error.Message)", withRun(k, r, state))
  end
  r.Session = answer.Value
  if answer.Value.Restarted
    r = dropped(r)
    r.Values = {}
    r.Runs = 0
    r.Task = missing
    r.Queue = []
    s = withRun(k, r, state)
    return commands.Say("The cell didn't stop within 2 s: a new session runs the cells from the top.", queued(k, [i for i in 1..value.Len(r.Cells)], s))
  end
  commands.Say("Stopped.", withRun(k, r, state))
end

defn StopCell(state)
  (** C-c e s: stops the cell that runs; the cells after it in the queue don't run. *)
  k = state.Current
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Task)
    return commands.Say("No cell is running.", state)
  end
  one = r.Session
  waited = [i for i in r.Queue if keeps(i, r)]
  r = dropped(r)
  r.Queue = []
  r.Keeping = [i for i in dict.GetOr("Keeping", [], r) if i == r.Index]
  r.Stopping = fiber.Spawn(() -> nb.Stop(one))
  s = withRun(k, r, state)
  for i in waited
    s = withStatus(k, i, missing, s)
  end
  commands.Say("Stopping the cell.", s)
end

defn ClearResults(state)
  (** C-c e k: the results drawn under the cells cleared; the session keeps its names. *)
  s = state
  s.Buffers[state.Current] = text.WithBlocks([x for x in text.BlocksOf(state.Buffers[state.Current]) if isInputBlock(x)], state.Buffers[state.Current])
  commands.Say("Results cleared.", s)
end

defn InsertCell(state)
  (** C-c e i: a cell marker above the line of the cursor, the cursor where its title goes. *)
  b = state.Buffers[state.Current]
  line = b.Cursor.Line
  s = state
  s.Buffers[state.Current] = text.Place(line, 6, text.InsertWords("(* %%  *)\n", text.Place(line, 0, b)))
  s
end

defn moved(k, state)
  (** The blocks of buffer k put back under the last lines of their cells, after edits moved them, once the text rests. *)
  b = state.Buffers[k]
  r = runOf(b)
  blocks = text.BlocksOf(b)
  if value.IsMissing(r) or value.Len(blocks) == 0 or r.Version == b.Version or value.IsSome(r.Task)
    return state
  end
  r = analysed(k, r, state)
  out = []
  for x in blocks
    if not isInputBlock(x)
      i = CellAt(x.Line, r.Cells)
      out = list.Append(dict.Merge(x, {Line: anchor(r.Cells[i], b), Cell: i}), out)
    end
  end
  s = withRun(k, r, state)
  s.Buffers[k] = text.WithBlocks(list.SortBy(x -> x.Line, out), b)
  restaled(k, laid(k, s))
end

(* ---- Graphs drawn again at the width of their pane. *)

defn stale(b, state)
  (** The first block of a buffer whose graph wasn't asked at the width of the pane, or missing: a graph narrower than the pane, as wide as it is
      itself, is asked again only when the pane changes. *)
  want = GraphWidth(state)
  for x in text.BlocksOf(b)
    g = dict.GetOr("Graph", missing, x)
    if value.IsSome(g) and dict.GetOr("Cell", 0, x) > 0 and not dict.GetOr("Fixed", false, g) and math.Abs(dict.GetOr("Asked", g.Scene.Width, g) - want) > 2
      return x
    end
  end
  missing
end

defn widened(k, state)
  (** The state at a tick for buffer k: the scene of a graph asked again at the width of its pane once that width changed, and put in place
      once it came, the text above it as it was. One at a time, and never while a cell runs. *)
  b = state.Buffers[k]
  r = runOf(b)
  pending = if value.IsMissing(r) missing else dict.GetOr("Rescene", missing, r) end
  if value.IsMissing(r) or value.IsMissing(r.Session) or value.IsSome(r.Task) or (value.IsMissing(pending) and asking(r))
    return state
  end
  if value.IsSome(pending)
    got = fiber.Wait(pending.Task, timeout = 0)
    if result.IsErr(got) and got.Error.Kind == "timeout"
      return state
    end
    r.Rescene = missing
    s = withRun(k, r, state)
    scene = if result.IsOk(got) got.Value else got end
    old = list.FindFirst(x -> dict.GetOr("Cell", 0, x) == pending.Cell and value.IsSome(dict.GetOr("Graph", missing, x)) and value.Equal(x.Graph.Key, pending.Key),
      text.BlocksOf(s.Buffers[k]))
    if value.IsMissing(old)
      return s
    end
    if result.IsErr(scene) or value.IsSome(SceneFault(scene.Value))
      (* A graph the session no longer holds, or a scene that isn't sane, keeps its width. *)
      return rebuilt(k, old, dict.Put("Fixed", true, old.Graph), s)
    end
    fresh = dict.Merge(old.Graph, dict.Put("Asked", pending.Width, Prepared(scene.Value, commands.Home(s))))
    fresh.Hover = missing
    if dict.GetOr("Pointed", false, old.Graph) and value.IsMissing(PointsFault(dict.GetOr("Points", [], scene.Value), full = true)) and (not dict.Has("Axes", scene.Value) or value.IsMissing(AxesFault(scene.Value.Axes)))
      return rebuilt(k, old, pointed(fresh, scene.Value), s)
    end
    if dict.GetOr("Pointed", false, old.Graph)
      (* Points that aren't sane at the new width: the graph shows no values, and asks none again. *)
      fresh.Near = missing
      fresh.Axes = missing
    end
    return rebuilt(k, old, if value.IsSome(dict.GetOr("Mark", missing, old.Graph)) dict.Put("Points", dict.GetOr("Points", [], scene.Value), fresh) else fresh end, s)
  end
  x = stale(b, state)
  if value.IsMissing(x)
    return state
  end
  one = r.Session
  key = x.Graph.Key
  width = GraphWidth(state)
  frame = dict.GetOr("Frame", 1, x.Graph)
  turn = if isTurning(x.Graph) x.Graph.View else missing end
  mark = dict.GetOr("Mark", missing, x.Graph)
  shown = dict.GetOr("Shown", missing, x.Graph)
  xlim = if value.IsMissing(shown) missing else dict.GetOr("X", missing, shown) end
  ylim = if value.IsMissing(shown) missing else dict.GetOr("Y", missing, shown) end
  points = dict.GetOr("Pointed", false, x.Graph)
  flat = isFlat(x.Graph) and (value.IsSome(mark) or value.IsSome(shown) or points)
  task = if flat fiber.Spawn(() -> nb.Scene(one, key, width, mark = mark, xlim = xlim, ylim = ylim, points = points)) else fiber.Spawn(() -> nb.Scene(one, key, width, frame = frame, view = turn)) end
  r.Rescene = {Task: task, Cell: x.Cell, Key: key, Width: width}
  withRun(k, r, state)
end

(* ---- The page of a file. *)

defn WriteHtml(state)
  (** C-c e h: runs every cell of the file as saved in a new session, and writes its page beside it, the same name ending in .html; a file or a link
      there already is asked about first, as a copy asks, since a folder from elsewhere can bring one. *)
  k = state.Current
  b = state.Buffers[k]
  if not IsCells(b)
    return commands.Say("This buffer has no cell to export.", state)
  end
  page = HtmlPath(b.Path)
  if sys.Exists(page) or result.IsOk(sys.ReadLink(page))
    return commands.Confirm("$(list.Last(str.Split("/", page))) exists. Replace it? (y or n) ", (yes, s) -> if yes == "y" exporting(k, s) else commands.Say("Nothing done.", s) end, state)
  end
  exporting(k, state)
end

defn exporting(k, state)
  (** The run of every cell of the file of buffer k, as saved, in a new session, for its page. *)
  b = state.Buffers[k]
  path = b.Path
  allow = allowOf(path)
  r = runOf(b)
  r = if value.IsMissing(r) newRun() else r end
  r.Html = fiber.Spawn(() -> nb.Html(path, allow = allow))
  how = if text.IsModified(b) " as saved, without the changes here" else "" end
  commands.Say("Running every cell of $path$how for its page.", withRun(k, r, state))
end

(** The path of the page of a file of cells.

      HtmlPath("notes/sim.ce") --> "notes/sim.html" *)
HtmlPath(path) = "$(str.Slice(1, value.Len(path) - 3, path)).html"

defn exported(k, state)
  (** The state once the page asked in buffer k is made: written, and said. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Html)
    return state
  end
  got = fiber.Wait(r.Html, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  r.Html = missing
  s = withRun(k, r, state)
  page = if result.IsOk(got) got.Value else got end
  if result.IsErr(page)
    return commands.Say("No page: $(page.Error.Message)", s)
  end
  path = HtmlPath(state.Buffers[k].Path)
  wrote = files.Replace(path, page.Value)
  commands.Say(if result.IsErr(wrote) and wrote.Error.Kind != "saved" "Can't write $path: $(wrote.Error.Message)" else "Wrote $path." end, s)
end

(* ---- `*variables*`: the names of the session beside the file; Enter on one shows its rows. *)

defn ownerOf(state)
  (** The buffer of cells that the current one belongs to: itself, or the one a list or `*repl*` came from, or 0. *)
  b = state.Buffers[state.Current]
  p = replOf(b)
  path = if lists.IsList(b) dict.GetOr("Owner", missing, lists.Of(b)) else if value.IsSome(p) p.Owner else missing end
  if value.IsMissing(path)
    return if IsCells(b) state.Current else 0 end
  end
  indexOf(path, state)
end

indexOf(path, state) = list.Reduce((found, k) -> if found == 0 and state.Buffers[k].Path == path k else found end, 0, 1..value.Len(state.Buffers))   (** The buffer of a path, or 0. *)

defn varRows(path, state)
  (** One row for each name of the session of the file at path, standing for its name. *)
  k = indexOf(path, state)
  r = if k == 0 missing else runOf(state.Buffers[k]) end
  vars = if value.IsMissing(r) [] else r.Vars end
  width = list.Reduce((w, v) -> list.Max(w, value.Len(v.Name)), 4, vars)
  kinds = list.Reduce((w, v) -> list.Max(w, value.Len(v.Type)), 4, vars)
  sizes = list.Reduce((w, v) -> list.Max(w, value.Len(v.Size)), 4, vars)
  [{Words: "$(str.PadRight(width, " ", v.Name))  $(str.PadRight(kinds, " ", v.Type))  $(str.PadRight(sizes, " ", v.Size))  $(v.Preview)", Item: v.Name} for v in vars]
end

defn ShowVariables(state)
  (** C-c e v: opens `*variables*` beside the file of cells: the names its cells defined, each with its type, its size and the start of its value. *)
  k = ownerOf(state)
  if k == 0
    return commands.Say("The variables are those of a file of cells: run one with C-c e e first.", state)
  end
  path = state.Buffers[k].Path
  s = commands.NextPane(commands.SplitRight(commands.ToBuffer(k, state)))
  s = commands.ShowList("*variables*", st -> varRows(path, st), () -> {"enter": (name, st) -> viewOf(path, name, st)}, s)
  l = lists.Of(s.Buffers[s.Current])
  l.Owner = path
  s.Buffers[s.Current].List = l
  s
end

(** The rows a viewer fetches at a time. *)
Chunk() = 200

defn viewRows(path, name, state)
  (** The rows of a viewer: those fetched so far of the value of name. *)
  b = state.Buffers[state.Current]
  got = dict.GetOr("Fetched", [], lists.Of(b))
  [{Words: got[i], Item: i} for i in 1..value.Len(got)]
end

defn fetched(k, upto, state)
  (** The viewer in buffer k with its rows fetched up to row upto, a chunk at a time: only what the screen shows comes from the session. *)
  l = lists.Of(state.Buffers[k])
  have = value.Len(l.Fetched) - 1
  if have >= upto or have >= l.Count
    return state
  end
  owner = indexOf(l.Owner, state)
  r = if owner == 0 missing else runOf(state.Buffers[owner]) end
  if value.IsMissing(r) or value.IsMissing(r.Session) or value.IsSome(r.Task) or asking(r)
    return state
  end
  got = nb.Rows(r.Session, l.Value, have + 1, have + Chunk())
  if result.IsErr(got)
    return state
  end
  lines = TableLines(list.Prepend("", got.Value.Columns), [list.Prepend("$(have + i)", got.Value.Rows[i]) for i in 1..value.Len(got.Value.Rows)])
  l.Fetched = if have < 0 lines else list.Concat(l.Fetched, list.Skip(1, lines)) end
  l.Count = got.Value.Count
  s = state
  s.Buffers[k].List = l
  s
end

defn viewOf(path, name, state)
  (** Enter on a row of `*variables*`: a viewer of the value of that name, a frame or a matrix in full, its rows fetched as the screen reaches them. *)
  s = commands.ShowList("*$name*", st -> viewRows(path, name, st), () -> {}, state)
  l = lists.Of(s.Buffers[s.Current])
  l.Owner = path
  l.Value = name
  l.Fetched = []
  l.Count = 1
  s.Buffers[s.Current].List = l
  s = fetched(s.Current, Chunk(), s)
  if value.Len(lists.Of(s.Buffers[s.Current]).Fetched) == 0
    return commands.Say("$name has no rows to show: it is no frame, matrix or list.", s)
  end
  s
end

defn viewing(state)
  (** At a tick: the viewer in the current buffer fetches the rows that its screen nears. *)
  b = state.Buffers[state.Current]
  l = lists.Of(b)
  if value.IsMissing(l) or not dict.Has("Fetched", l)
    return state
  end
  fetched(state.Current, b.Top + 2 * Chunk(), state)
end

(* ---- `*repl*`: a prompt in the session of a file of cells. *)

Prompt = "> "   (** The prompt of `*repl*`, before the code typed. *)
More = ". "   (** The start of a line of `*repl*` that goes on with the code above it. *)

defn replOf(b)
  (** The prompt of a buffer, {Owner, History, At, Task}, or missing: only `*repl*` has one. *)
  match b
    {Repl: p} -> p
    else -> missing
  end
end

defn OpenRepl(state)
  (** C-c e r: opens `*repl*` below the file of cells, a prompt in its session: an expression shows its value. *)
  k = ownerOf(state)
  if k == 0
    return commands.Say("*repl* runs in the session of a file of cells: open one first.", state)
  end
  path = state.Buffers[k].Path
  s = commands.ToBuffer(k, state)
  for j in 1..value.Len(s.Buffers)
    p = replOf(s.Buffers[j])
    if value.IsSome(p) and p.Owner == path
      return commands.NextPane(commands.SplitBelow(commands.ToBuffer(j, s)))
    end
  end
  b = text.Of(Prompt, missing)
  b = text.Place(1, 2, b)
  b.Repl = {Owner: path, History: [], At: 0, Task: missing}
  b.Name = "*repl*"
  s.Buffers = list.Append(b, s.Buffers)
  s = commands.NextPane(commands.SplitBelow(s))
  commands.ToBuffer(value.Len(s.Buffers), s)
end

defn typedCode(b)
  (** The code typed after the last prompt of `*repl*`, its lines without their prompts. *)
  all = str.Lines(rope.Text(b.Rope))
  k = value.Len(all)
  while k > 1 and not str.StartsWith(Prompt, all[k])
    k = k - 1
  end
  str.Join("\n", [str.Slice(3, value.Len(l), l) for l in list.Skip(k - 1, all) if value.Len(l) >= 2])
end

(** The buffer with words at its end, the cursor after them. *)
appended(words, b) = text.ToFileEnd(text.InsertWords(words, text.ToFileEnd(b)))

defn refused(code, path, state)
  (** Why the code typed can't run, or missing: a definition of a name that a cell defines, as the file then would lie (D9). *)
  k = indexOf(path, state)
  r = if k == 0 missing else runOf(state.Buffers[k]) end
  defs = cesia.Definitions(code)
  if value.IsMissing(r) or result.IsErr(defs)
    return missing
  end
  for d in defs.Value
    for i in 1..value.Len(r.Analysis)
      if d.Name in r.Analysis[i].Defines
        title = if r.Cells[i].Title == "" "the cell at line $(list.Max(1, r.Cells[i].From))" else "the cell \"$(r.Cells[i].Title)\"" end
        return "$(d.Name) is defined by $title: change it there."
      end
    end
  end
  missing
end

defn replEnter(state)
  (** Enter in `*repl*`: what was typed runs in the session when it is whole, and the next line goes on with ". " when it isn't. *)
  b = state.Buffers[state.Current]
  p = replOf(b)
  if value.IsSome(p.Task)
    return commands.Say("The code before still runs.", state)
  end
  code = typedCode(b)
  s = state
  if not debug.IsComplete(code)
    s.Buffers[state.Current] = appended("\n$More", b)
    return s
  end
  k = indexOf(p.Owner, state)
  r = if k == 0 missing else runOf(state.Buffers[k]) end
  if value.IsMissing(r) or value.IsMissing(r.Session)
    s.Buffers[state.Current] = appended("\nNo session: C-c e e in $(p.Owner) runs a cell first.\n$Prompt", b)
    return s
  end
  no = refused(code, p.Owner, state)
  p.History = if str.Trim(code) == "" p.History else list.Append(code, p.History) end
  p.At = 0
  if value.IsSome(no)
    b.Repl = p
    s.Buffers[state.Current] = appended("\n$no\n$Prompt", b)
    return s
  end
  one = r.Session
  width = GraphWidth(state)
  p.Task = fiber.Spawn(() -> nb.Run(one, {Title: "", From: 0, To: 0, Source: code}, width = width))
  b.Repl = p
  s.Buffers[state.Current] = appended("\n", b)
  s
end

(** Enter: in `*repl*` it runs what was typed; anywhere else it is a new line, as always. *)
Enter(state) = if value.IsSome(replOf(state.Buffers[state.Current])) replEnter(state) else commands.NewLine(state) end

defn answered(k, state)
  (** The state after a tick for `*repl*` in buffer k: the answer of its code, once it came, then a new prompt. *)
  b = state.Buffers[k]
  p = replOf(b)
  if value.IsMissing(p) or value.IsMissing(p.Task)
    return state
  end
  got = fiber.Wait(p.Task, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  p.Task = missing
  ran = if result.IsOk(got) got.Value else got end
  b.Repl = p
  s = state
  after = b
  for part in resultParts(ran, state)
    (* *repl* writes a table as lines of text, as the cells did before they drew tables. *)
    t = dict.GetOr("Table", missing, part)
    shownLines = if value.IsMissing(t) part.Lines else list.Concat(part.Lines, list.Append({Words: NoteWords(t)}, [{Words: l} for l in TableLines(t.Columns, t.Rows)])) end
    words = str.Join("", ["$(l.Words)\n" for l in shownLines])
    graph = part.Graph
    if isAnimation(graph)
      (* *repl* shows the first frame of an animation: a cell plays it, with its bar. *)
      words = "$(words)an animation of $(graph.Frames) frames at $(rateText(graph.Fps)) a second: its first; a cell plays it\n"
      graph = {Scene: graph.Scene, Font: graph.Font, Fallback: graph.Fallback, Key: graph.Key}
    end
    after = appended(words, after)
    if value.IsSome(graph)
      (* Each graph under the last line of the answer so far, in the order of the parts: a 3D graph turns there too. *)
      under = rope.LineCount(after.Rope) - 1
      after = text.WithBlocks(list.Append(resultBlock(k, 0, under, [], graph, state), text.BlocksOf(after)), after)
    end
  end
  after = appended(Prompt, after)
  s.Buffers[k] = after
  owner = indexOf(p.Owner, s)
  r = if owner == 0 missing else runOf(s.Buffers[owner]) end
  if value.IsSome(r) and value.IsSome(r.Session) and not asking(r)
    vars = nb.Variables(r.Session)
    r.Vars = if result.IsOk(vars) vars.Value else r.Vars end
    s = withRun(owner, r, s)
  end
  s
end

defn historyMoved(by, state)
  (** M-p and M-n in `*repl*`: the code typed before, or after, in place of what follows the last prompt. *)
  b = state.Buffers[state.Current]
  p = replOf(b)
  if value.IsMissing(p) or value.Len(p.History) == 0
    return state
  end
  at = list.Max(0, list.Min(value.Len(p.History), p.At + by))
  code = if at == 0 "" else p.History[value.Len(p.History) - at + 1] end
  all = str.Lines(rope.Text(b.Rope))
  k = value.Len(all)
  while k > 1 and not str.StartsWith(Prompt, all[k])
    k = k - 1
  end
  before = str.Join("", ["$(l)\n" for l in list.Take(k - 1, all)])
  fresh = text.Of("$(before)$(Prompt)$(str.Replace("\n", "\n$More", code))", missing)
  p.At = at
  fresh.Repl = p
  fresh.Name = b.Name
  s = state
  s.Buffers[state.Current] = text.ToFileEnd(fresh)
  s
end

HistoryBack(state) = historyMoved(1, state)   (** M-p: the code typed before. *)
HistoryOn(state) = historyMoved(-1, state)   (** M-n: the code typed after. *)

(* ---- Sliders: each line name = cells.Slider(...) of a cell of sliders draws a slider under it, from the analysis alone, before any run. The mouse
   and the keys move it: the new number is written in the buffer, in place of the old one, the session gets it in place with cells.Set, and only the
   cells that read the name run again. One Set and its cells run at a time for a slider; a move meanwhile waits as Pending, and the latest wins. *)

(** The moves of the sliders of a run, by name: each {Busy, Pending, Left, Since, Took}, Busy while its Set or its cells run, Pending the last
    position not yet set, Left the cells of its rerun not yet answered, Since when its Set started and Took the seconds of its last rerun. *)
movesOf(r) = dict.GetOr("Moves", {}, r)

(** The move of a slider in a run, or a still one. *)
moveOf(name, r) = dict.GetOr(name, {Busy: false, Pending: missing, Left: [], Since: 0.0, Took: missing}, movesOf(r))

defn withMove(name, m, r)
  (** The run with the move of a slider. *)
  out = r
  out.Moves = dict.Put(name, m, movesOf(r))
  out
end

defn sliderAt(name, r)
  (** The slider of a name in the analysis of a run, with its cell and its place in that cell: {Slider, Cell, Index}, or missing. *)
  for i in 1..value.Len(r.Analysis)
    all = dict.GetOr("Sliders", [], r.Analysis[i])
    for j in 1..value.Len(all)
      if all[j].Name == name
        return {Slider: all[j], Cell: i, Index: j}
      end
    end
  end
  missing
end

defn readersOf(analysis, cell, name)
  (** The cells that read a slider's name, directly or through other cells, as cells.ToRun gives them for its cell defining that name alone. *)
  a = analysis
  a[cell].Defines = [name]
  list.Skip(1, nb.ToRun(a, cell))
end

defn inputsOf(i, r)
  (** The inputs that cell i reads, directly or not, sliders among them, with the value the session holds for each: what its result is computed with. *)
  out = {}
  held = dict.GetOr("Values", {}, r)
  for c in 2..value.Len(r.Analysis)
    for s in inputsIn(c, r)
      if dict.Has(s.Name, held) and i in readersOf(r.Analysis, c, s.Name)
        out[s.Name] = held[s.Name]
      end
    end
  end
  out
end

defn heldBy(i, r)
  (** The run once cell i starts: the session will hold the values that the inputs of cell i write, if it has any. *)
  out = r
  held = dict.GetOr("Values", {}, r)
  for s in inputsIn(i, r)
    held = dict.Put(s.Name, s.Value, held)
  end
  out.Values = held
  out
end

(** The value of an input written in the buffer now, a slider's number, or missing. *)
written(name, r) = if value.IsMissing(inputAt(name, r)) missing else inputAt(name, r).Input.Value end

defn staleNote(inputs, r)
  (** The note of a result computed with other values than those the file writes now, or missing: stale: computed with rho = 28.0. *)
  off = [n for n in list.Sort(dict.Keys(inputs)) if value.IsSome(written(n, r)) and differs(written(n, r), inputs[n])]
  if value.Len(off) == 0 missing else {Role: "note", Words: "stale: computed with $(str.Join(", ", ["$n = $(shownOf(inputs[n]))" for n in off]))"} end
end

(** Are two values of an input different: numbers as numbers, 3 and 3.0 the same, the others as values, a date as its fields? *)
differs(a, b) = if value.IsNumber(a) and value.IsNumber(b) a != b else not value.Equal(a, b) end

defn restaled(k, state)
  (** The state with each result of buffer k that reads a slider drawn again with its note when the file now writes another number than the one it
      was computed with, and without it once they agree again. *)
  b = state.Buffers[k]
  r = runOf(b)
  if value.IsMissing(r)
    return state
  end
  out = []
  changed = false
  for x in text.BlocksOf(b)
    inputs = dict.GetOr("Inputs", {}, x)
    if value.Len(inputs) == 0
      out = list.Append(x, out)
    else
      note = staleNote(inputs, r)
      lines = list.Concat([y for y in [dict.GetOr("Status", missing, x), note] if value.IsSome(y)], x.Base)
      if value.Equal([l.Words for l in lines], [l.Words for l in x.Lines])
        out = list.Append(x, out)
      else
        changed = true
        label = dict.GetOr("Out", missing, x)
        out = list.Append(dict.Merge(resultBlock(k, x.Cell, x.Line, lines, x.Graph, state, out = label, at = value.Len(lines) - value.Len(x.Base), table = dict.GetOr("Table", missing, x)), {Base: x.Base, Inputs: inputs, Status: dict.GetOr("Status", missing, x),
          Part: dict.GetOr("Part", 1, x)}), out)
      end
    end
  end
  if not changed
    return state
  end
  s = state
  s.Buffers[k] = text.WithBlocks(out, b)
  s
end

(* -- Drawing a slider and taking the mouse. *)

defn SliderPlaces(width, columns, cell)
  (** The places of the parts of a slider in its block, in pixels from its left, for a block width pixels wide whose names take columns: {Name,
      Track, Wide, Value}, the name, the track and its width, and the value after it, then the time of the last rerun.

        SliderPlaces(1000, 3, {Width: 8, Height: 19}).Track --> 56 *)
  name = 2 * cell.Width
  track = name + (columns + 2) * cell.Width
  wide = list.Max(80, list.Min(480, width - track - 28 * cell.Width))
  {Name: name, Track: track, Wide: wide, Value: track + wide + 2 * cell.Width}
end

(** Where the thumb of a slider starts on its track, in pixels from the track's left: the thumb is 8 pixels wide. *)
thumbAt(s, wide) = math.Div(math.Floor(list.Max(0.0, list.Min(1.0, (s.Value - s.Min) / (s.Max - s.Min))) * (wide - 8) + 0.5), 1)

defn SliderItems(s, words, took, focused, width, columns, cell, th)
  (** What draws a slider under its line: its name, its track in the color of lines, its thumb in ink, 8 pixels wide, its number as the file writes
      it, the time its last rerun took in muted ink, and a ring of 2 pixels in the accent color around it while it has the keys.

        value.Len(SliderItems({Name: "a", Value: 1.0, Min: 0.0, Max: 2.0}, "1.0", missing, false, 800, 1, {Width: 8, Height: 19}, {Ink: 1, Line: 2, Muted: 3, Accent: 4})) --> 4 *)
  p = SliderPlaces(width, columns, cell)
  mid = math.Div(cell.Height, 2)
  x = p.Track + thumbAt(s, p.Wide)
  out = [{Kind: "text", X: p.Name, Y: 0, Text: s.Name, Color: th.Ink, Font: "code"},
    {Kind: "rect", X: p.Track, Y: mid - 1, Width: p.Wide, Height: 2, Color: th.Line},
    {Kind: "rect", X: x, Y: 3, Width: 8, Height: cell.Height - 6, Color: th.Ink},
    {Kind: "text", X: p.Value, Y: 0, Text: words, Color: th.Ink, Font: "code"}]
  if value.IsSome(took)
    out = list.Append({Kind: "text", X: p.Value + (value.Len(words) + 2) * cell.Width, Y: 0, Text: "rerun $(math.Div(math.Floor(took * 1000.0 + 0.5), 1)) ms", Color: th.Muted, Font: "code"}, out)
  end
  if focused
    left = p.Track - 6
    wide = p.Wide + 12
    out = list.Concat(out, [{Kind: "rect", X: left, Y: 0, Width: wide, Height: 2, Color: th.Accent}, {Kind: "rect", X: left, Y: cell.Height - 2, Width: wide, Height: 2, Color: th.Accent},
      {Kind: "rect", X: left, Y: 0, Width: 2, Height: cell.Height, Color: th.Accent}, {Kind: "rect", X: left + wide - 2, Y: 0, Width: 2, Height: cell.Height, Color: th.Accent}])
  end
  out
end

(** The columns that the names of the inputs of cell i take, sliders among them, so that their tracks and boxes line up. *)
nameColumns(i, r) = list.Max(1, list.Reduce((w, s) -> list.Max(w, value.Len(s.Name)), 0, inputsIn(i, r)))

(** The words of a slider's number as the buffer writes it: its span on its line. *)
wordsOf(s, b) = str.Slice(s.Column, s.End, rope.Line(s.Line, b.Rope))

defn sliderBlock(s, i, b, r, state)
  (** The block of a slider under its line: drawn from the analysis, it takes the mouse. *)
  words = wordsOf(s, b)
  took = moveOf(s.Name, r).Took
  focus = commands.FocusOf(state)
  focused = value.IsSome(focus) and dict.GetOr("Slider", "", focus) == s.Name and dict.GetOr("Buffer", 0, focus) == state.Current
  columns = nameColumns(i, r)
  cell = state.Cell
  name = s.Name
  {Line: s.Line, Rows: 1, Cell: 0, Slider: name, Draw: (width, look) -> SliderItems(s, words, took, focused, width, columns, cell, look.Theme),
    Mouse: (action, point, st) -> sliderMouse(name, action, point, st)}
end

defn laid(k, state)
  (** The state with the inputs of buffer k drawn again from its analysis, each under its line: sliders, and the boxes of the others. *)
  b = state.Buffers[k]
  r = runOf(b)
  kept = [x for x in text.BlocksOf(b) if not isInputBlock(x)]
  if value.IsMissing(r)
    return if value.Len(kept) == value.Len(text.BlocksOf(b)) state else withBlocksOf(k, kept, state) end
  end
  made = []
  for i in 1..value.Len(r.Analysis)
    for s in dict.GetOr("Sliders", [], r.Analysis[i])
      if s.Line <= rope.LineCount(b.Rope) and s.End <= value.Len(rope.Line(s.Line, b.Rope))
        made = list.Append(sliderBlock(s, i, b, r, state), made)
      end
    end
    for x in inputsIn(i, r)
      if x.Kind != "slider" and x.Line <= rope.LineCount(b.Rope) and x.End <= value.Len(rope.Line(x.Line, b.Rope))
        made = list.Append(inputBlock(x, i, r, state), made)
      end
    end
  end
  withBlocksOf(k, list.SortBy(x -> x.Line, list.Concat(kept, made)), state)
end

defn withBlocksOf(k, blocks, state)
  (** The state with these blocks in buffer k. *)
  s = state
  s.Buffers[k] = text.WithBlocks(blocks, state.Buffers[k])
  s
end

defn sliderMouse(name, action, point, state)
  (** A press, a move or a release of the mouse on the block of a slider: a press gives it the keys and, on its track, sets the value under the point,
      as a single pointer does (WCAG 2.5.7); a move with the button held drags it; a release ends the drag, one step of undo. *)
  k = state.Current
  r = runOf(state.Buffers[k])
  found = if value.IsMissing(r) missing else sliderAt(name, r) end
  if value.IsMissing(found)
    return state
  end
  s = state
  if action == "down"
    s = focusedOn(k, name, state)
    r = runOf(s.Buffers[k])
    r.Drag = missing
    s = withRun(k, r, s)
  end
  p = SliderPlaces(point.Width, nameColumns(found.Cell, r), s.Cell)
  onTrack = point.X >= p.Track - 6 and point.X <= p.Track + p.Wide + 6
  if action == "up"
    r.Drag = missing
    return withRun(k, r, s)
  end
  if action == "move" and dict.GetOr("Drag", missing, r) != name
    return s
  end
  if action == "down" and not onTrack
    return s
  end
  f = list.Max(0.0, list.Min(1.0, (point.X - p.Track - 4) / list.Max(1, p.Wide - 8)))
  sl = found.Slider
  at = nb.Snap(sl, sl.Min + f * (sl.Max - sl.Min))
  s = Moved(k, name, at, if action == "down" "press" else "drag" end, s)
  r = runOf(s.Buffers[k])
  r.Drag = name
  withRun(k, r, s)
end

(* -- Keys: C-c e f gives the keys to the first slider of the cursor's cell, as WAI-ARIA's slider pattern has them. *)

defn stepped(by)
  (** The command that moves the slider with the keys by some steps: whole ones, or to its min or its max for a huge number of them. *)
  state -> keyed(by, state)
end

defn keyed(by, state)
  (** The slider that has the keys moved by some steps. *)
  f = commands.FocusOf(state)
  k = f.Buffer
  r = runOf(state.Buffers[k])
  found = if value.IsMissing(r) missing else sliderAt(f.Slider, r) end
  if value.IsMissing(found)
    return commands.Unfocused(state)
  end
  s = found.Slider
  Moved(k, s.Name, nb.Snap(s, s.Value, steps = by), "keys", state)
end

defn tabbed(by, state)
  (** The keys to the next input of the cell, or the previous one, round, sliders and the others in the order of their lines. *)
  f = commands.FocusOf(state)
  r = runOf(state.Buffers[f.Buffer])
  found = if value.IsMissing(r) missing else inputAt(dict.GetOr("Slider", dict.GetOr("Input", "", f), f), r) end
  if value.IsMissing(found)
    return commands.Unfocused(state)
  end
  all = inputsIn(found.Cell, r)
  next = all[math.Mod(found.Index - 1 + by, value.Len(all)) + 1]
  controlOn(f.Buffer, next, state)
end

(** The state with the keys on an input of buffer k, a slider or another. *)
controlOn(k, x, state) = if x.Kind == "slider" focusedOn(k, x.Name, state) else inputFocusedOn(k, x.Name, state) end

(** The rows of the band while a slider has the keys. *)
FocusHints() = [{Key: "← →", Name: "a step", Group: false}, {Key: "PgUp PgDn", Name: "ten steps", Group: false}, {Key: "Home End", Name: "its min, its max", Group: false},
  {Key: "Tab S-Tab", Name: "the next input, the previous one", Group: false}, {Key: "C-g", Name: "leave", Group: false}]

(** The keys of a slider that has them: the arrows a step, the pages ten, Home and End its min and its max, Tab and S-Tab the next input of the cell
    and the previous one, C-g leaves. *)
SliderKeys() = {"right": stepped(1), "up": stepped(1), "left": stepped(-1), "down": stepped(-1), "pageup": stepped(10), "pagedown": stepped(-10),
  "home": stepped(-2000000), "end": stepped(2000000), "tab": st -> tabbed(1, st), "S-tab": st -> tabbed(-1, st), "C-g": commands.Unfocused}

defn focusedOn(k, name, state)
  (** The state with the keys on the slider of a name in buffer k, drawn with its ring, and the one that had them without. *)
  s = commands.Unfocused(state)
  s.Focus = {Keys: SliderKeys(), Hints: FocusHints(), Leave: st -> laid(k, unjoined(k, st)), Buffer: k, Slider: name}
  laid(k, s)
end

defn unjoined(k, state)
  (** The state where the next move of a slider of buffer k starts a new step of undo. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r)
    return state
  end
  r.Joinable = missing
  withRun(k, r, state)
end

defn FocusControl(state)
  (** C-c e f: gives the keys to the first control of the cell of the cursor. A slider: the arrows move it a step, the pages ten, Home and End to its
      min and its max, Tab and S-Tab go to the next input of the cell and the previous one. A choice: Enter opens its list, the arrows move in it, Enter
      chooses. A check box: Space checks it or not. A field: what is typed goes in its box, Enter sets it. A date: Left and Right pick its year, its
      month or its day, Up and Down change it, Enter sets it. The bar of an animation: Space plays it or pauses it, the
      arrows go a frame back or on, the pages ten, Home and End to the first frame and the last. A 3D graph: the arrows move the eye 10°, Right and
      Left round it, Up and Down higher and lower, and Home back to the view of the code. A table: the arrows move a cell, s sorts, / filters, M-w copies;
      see TableKeys. A 2D graph, when the cell has no other control: the arrows go from point to point, the wheel zooms, M-w copies, C-c e s saves it;
      see GraphKeys. C-g, a click in the text or any other key leaves it. *)
  k = state.Current
  b = state.Buffers[k]
  if not IsCells(b)
    return commands.Say("This buffer has no cell: C-c e f gives the keys to a slider or an animation of a cell.", state)
  end
  s = fresh(k, state)
  r = runOf(s.Buffers[k])
  i = CellAt(b.Cursor.Line, r.Cells)
  all = inputsIn(i, r)
  if value.Len(all) > 0
    return controlOn(k, all[1], s)
  end
  bar = list.FindFirst(x -> dict.GetOr("Cell", 0, x) == i and isAnimation(dict.GetOr("Graph", missing, x)), text.BlocksOf(s.Buffers[k]))
  if value.IsSome(bar)
    return barFocusedOn(k, bar.Graph.Key, s)
  end
  solid = list.FindFirst(x -> dict.GetOr("Cell", 0, x) == i and isTurning(dict.GetOr("Graph", missing, x)), text.BlocksOf(s.Buffers[k]))
  if value.IsSome(solid)
    return turnFocusedOn(k, solid.Graph.Key, s)
  end
  table = list.FindFirst(x -> value.IsSome(dict.GetOr("Table", missing, x)), partsOf(k, i, s))
  if value.IsSome(table)
    return tableFocusedOn(k, table.Table, s)
  end
  flat = list.FindFirst(x -> isFlat(dict.GetOr("Graph", missing, x)), partsOf(k, i, s))
  if value.IsSome(flat)
    return graphFocusedOn(k, flat.Graph.Key, s)
  end
  commands.Say("This cell has no control: an input, as name = cells.Slider(value, min, max) or name = cells.Choice(value, options) on a line of a cell of inputs, an animation of plot.Frames, a 3D graph of plot.Surface or plot.Line3, a table or a graph.", s)
end

(* -- A move: the number written in the buffer, then the session told, the latest value winning. *)

defn fresh(k, state)
  (** The state with a run for buffer k whose cells and analysis are those of its text now, and its sliders drawn: made when there is none. *)
  b = state.Buffers[k]
  r = runOf(b)
  r = if value.IsMissing(r) newRun() else r end
  if r.Version == b.Version
    return withRun(k, r, state)
  end
  laid(k, withRun(k, analysed(k, r, state), state))
end

(** A run of a buffer with no session yet. *)
newRun() = {Session: missing, Cells: [], Analysis: [], Queue: [], Task: missing, Index: 0, Started: 0.0, Stopping: missing, Html: missing, Vars: [],
  Version: -1}

defn Moved(k, name, at, how, state)
  (** The state after a move of the slider of a name in buffer k to a position of cells.Snap, {Value, Text}, by "press", "drag" or "keys": the number
      written in the buffer as Edited writes it, then the session told, the latest number winning. *)
  s = Edited(k, name, at, how, state)
  if s.Buffers[k].Version == state.Buffers[k].Version s else pushed(k, name, at.Value, s) end
end

defn Edited(k, name, at, how, state)
  (** The state after a move of the slider of a name in buffer k to a position of cells.Snap, {Value, Text}, by "press", "drag" or "keys", in the
      buffer only: the number written in place of the old one, if that place lies on a line of the slider's cell and still holds the number the
      analysis read; one step of undo for a drag, from its press, or for keys in a row; the slider drawn at once, and the results that the new number
      makes stale noted. A position that writes the same text changes nothing. *)
  s = fresh(k, state)
  b = s.Buffers[k]
  r = runOf(b)
  found = sliderAt(name, r)
  if value.IsMissing(found)
    return s
  end
  sl = found.Slider
  cell = r.Cells[found.Cell]
  line = if sl.Line <= rope.LineCount(b.Rope) rope.Line(sl.Line, b.Rope) else "" end
  (* The edit is checked first: the number's place must lie on a line of the slider's own cell and still hold the number the analysis read. *)
  if sl.Line < cell.From or sl.Line > cell.To or sl.Column < 1 or sl.End > value.Len(line) or str.Number(str.Slice(sl.Column, sl.End, line)) != sl.Value
    return commands.Say("The slider $name isn't where its number was: the cells are read again at the next key.", s)
  end
  (* The number written is one of the slider's: finite, from its min to its max, and the number of its own text. *)
  wrote = str.Number(at.Text)
  if value.IsMissing(wrote) or wrote != at.Value or wrote < sl.Min or wrote > sl.Max
    return commands.Say("The slider $name takes numbers from $(sl.Min) to $(sl.Max).", s)
  end
  if str.Slice(sl.Column, sl.End, line) == at.Text
    return s
  end
  join = dict.GetOr("Joinable", missing, r)
  edited = text.Replaced([{Line: sl.Line, Column: sl.Column - 1, End: sl.End, Text: at.Text}], b)
  (* Keys join while the slider keeps the keys, as typing does until another command: leaving it ends the step. *)
  holder = commands.FocusOf(state)
  held = how != "keys" or (value.IsSome(holder) and dict.GetOr("Slider", "", holder) == name)
  joins = value.IsSome(join) and join.Name == name and join.Version == b.Version and how != "press" and join.How == (if how == "keys" "keys" else "drag" end) and held
  edited = if joins text.JoinSteps(edited) else edited end
  moved = sl
  moved.Value = at.Value
  moved.End = sl.Column + value.Len(at.Text) - 1
  r.Analysis[found.Cell].Sliders[found.Index] = moved
  (* Inputs lists the slider too: it says the same. *)
  same = inputAt(name, r)
  if value.IsSome(same) and dict.Has("Inputs", r.Analysis[same.Cell])
    r.Analysis[same.Cell].Inputs[same.Index] = dict.Merge(same.Input, {Value: moved.Value, End: moved.End})
  end
  r.Cells[found.Cell].Source = str.Join("\n", [rope.Line(n, edited.Rope) for n in cell.From..cell.To])
  r.Version = edited.Version
  r.Joinable = {Name: name, Version: edited.Version, How: if how == "keys" "keys" else "drag" end}
  (* The analysis says what the text says: the cells are not read again at rest for this edit. *)
  edited.CellsSeen = edited.Version
  s.Buffers[k] = edited
  restaled(k, laid(k, withRun(k, r, s)))
end

defn pushed(k, name, number, state)
  (** The state once an input changed to a value, a slider to a number: its Set started if none of its own runs, else the value kept as Pending, the
      latest winning. Without a session, the value stays written in the buffer and nothing runs: the code of a file runs only after C-c e e or C-c e a,
      which the person asks for, never from a press of the mouse on a file opened from elsewhere. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Session)
    return commands.Say("$name is $(shownOf(number)) in the text: C-c e a runs the cells with it.", state)
  end
  m = moveOf(name, r)
  if m.Busy or asking(r)
    m.Pending = number
    return withRun(k, withMove(name, m, r), state)
  end
  setting(k, name, number, state)
end

(** Does a question to the session other than a run wait for its answer, a Set, a scene, a frame or a view: one at a time, so that each gets its
    own. *)
asking(r) = value.IsSome(dict.GetOr("Setting", missing, r)) or value.IsSome(dict.GetOr("Rescene", missing, r)) or value.IsSome(dict.GetOr("Framing", missing, r)) or
  value.IsSome(dict.GetOr("Turning", missing, r)) or value.IsSome(dict.GetOr("Paging", missing, r)) or value.IsSome(dict.GetOr("Marking", missing, r)) or
  value.IsSome(dict.GetOr("Varying", missing, r)) or
  copyAsked(dict.GetOr("Copying", missing, r)) or copyAsked(dict.GetOr("Saving", missing, r))

(** Does the copy of a table hold the session: has it asked its rows? *)
copyAsked(c) = value.IsSome(c) and dict.Has("Task", c)

defn setting(k, name, number, state)
  (** The state with the Set of a slider's number running in a fiber: no cell starts until it answers, so that the cells run with the number set. *)
  r = runOf(state.Buffers[k])
  m = moveOf(name, r)
  one = r.Session
  analysis = r.Analysis
  r.Setting = {Task: fiber.Spawn(() -> nb.Set(one, analysis, name, number)), Name: name, Number: number, Dropped: false}
  m.Busy = true
  m.Pending = missing
  m.Since = sys.Now()
  m.Left = []
  withRun(k, withMove(name, m, r), state)
end

defn setAnswered(k, state)
  (** The state at a tick once the Set that runs in buffer k answered: its cells queued, even one that runs now, which ran with the number before; or,
      when the session has no value for the name yet, the slider's cell and its readers, the usual way. *)
  r = runOf(state.Buffers[k])
  set = dict.GetOr("Setting", missing, r)
  if value.IsMissing(set)
    return state
  end
  got = fiber.Wait(set.Task, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  answer = if result.IsOk(got) got.Value else got end
  r.Setting = missing
  if result.IsOk(answer)
    (* The session holds the number now, even after a stop dropped the rerun. *)
    r.Values = dict.Put(set.Name, answer.Value.Value, dict.GetOr("Values", {}, r))
  end
  m = moveOf(set.Name, r)
  found = inputAt(set.Name, r)
  if set.Dropped or value.IsMissing(found)
    m.Busy = false
    m.Pending = missing
    return withRun(k, withMove(set.Name, m, r), state)
  end
  order = if result.IsOk(answer) answer.Value.ToRun else nb.ToRun(r.Analysis, found.Cell) end
  m.Left = order
  m.Ready = sys.Now()
  s = withRun(k, withMove(set.Name, m, r), state)
  s = if value.Len(order) == 0 finished(k, set.Name, s) else queued(k, order, s, again = true) end
  pendingSet(k, s)
end

defn finished(k, name, state)
  (** The state once the rerun of a slider ended: its time kept and drawn, and its Pending number, if any, set. *)
  r = runOf(state.Buffers[k])
  m = moveOf(name, r)
  m.Busy = false
  m.Left = []
  m.Took = sys.Now() - m.Since
  s = laid(k, withRun(k, withMove(name, m, r), state))
  pendingSet(k, s)
end

defn pendingSet(k, state)
  (** The state with the Set of the first slider that waits with a Pending number started, when no Set runs. *)
  r = runOf(state.Buffers[k])
  if asking(r) or value.IsMissing(r.Session)
    return state
  end
  for name in dict.Keys(movesOf(r))
    m = moveOf(name, r)
    if not m.Busy and value.IsSome(m.Pending)
      return setting(k, name, m.Pending, state)
    end
  end
  state
end

defn answeredCell(k, i, state, started = missing)
  (** The state once cell i left the queue of buffer k, run or not: the slider reruns that waited for it, and those that end with it. A run that
      started before a slider's Set answered ran with the number before: the rerun still waits for the cell. *)
  r = runOf(state.Buffers[k])
  s = state
  for name in dict.Keys(movesOf(r))
    m = moveOf(name, r)
    if m.Busy and i in m.Left and (value.IsMissing(started) or started >= dict.GetOr("Ready", 0.0, m))
      m.Left = [j for j in m.Left if j != i]
      s = withRun(k, withMove(name, m, runOf(s.Buffers[k])), s)
      if value.Len(m.Left) == 0
        s = finished(k, name, s)
      end
    end
  end
  s
end

defn dropped(r)
  (** A run whose slider reruns are dropped, by a stop or the end of its session: no Pending, nothing busy, and the Set that runs queues nothing. *)
  out = r
  out.Moves = dict.MapValues(m -> dict.Merge(m, {Busy: false, Pending: missing, Left: []}), movesOf(r))
  set = dict.GetOr("Setting", missing, r)
  if value.IsSome(set)
    set.Dropped = true
    out.Setting = set
  end
  out
end

(* ---- The other inputs of a form: each line name = cells.Choice(...), cells.Check(...), cells.Field(...) or cells.Date(...) of a cell of inputs draws
   its box under it, from the analysis alone, before any run, as a slider does. A click or C-c e f gives it the keys: Enter opens a choice's list, the
   arrows move in it and Enter chooses; Space checks a box or not; a field takes what is typed and sets it at Enter, a field of a number only a number;
   a date's Left and Right pick its year, its month or its day, Up and Down change it, and Enter sets it. The new value, as cells.Snap writes it, takes
   the place of the old one in the buffer, one step of undo, then cells.Set gives it to the session and only the cells that read it run again, as after
   a slider's move. No key is taken while no input has the keys: every key does what it did. *)

(** The inputs of cell i of the analysis of a run, sliders among them, in the order of their lines: a Cesia whose Analyse gives no Inputs has its
    sliders alone. *)
inputsIn(i, r) = if dict.Has("Inputs", r.Analysis[i]) r.Analysis[i].Inputs else [dict.Put("Kind", "slider", x) for x in dict.GetOr("Sliders", [], r.Analysis[i])] end

defn inputAt(name, r)
  (** The input of a name in the analysis of a run, a slider or another, with its cell and its place among the inputs of that cell: {Input, Cell,
      Index}, or missing. *)
  for i in 1..value.Len(r.Analysis)
    all = inputsIn(i, r)
    for j in 1..value.Len(all)
      if all[j].Name == name
        return {Input: all[j], Cell: i, Index: j}
      end
    end
  end
  missing
end

(** Is a block the drawing of an input, a slider or a box, which the analysis draws again, and which C-c e k leaves? *)
isInputBlock(x) = dict.Has("Slider", x) or dict.Has("Input", x)

defn shownOf(x)
  (** A value of an input as its box shows it: a text as it is, its ends of line, tabs and carriage returns as \n, \t and \r, so that it stays on its
      row; a date as 2026-11-23; a number, true or false as Cesia writes them.

        shownOf("a\nb") --> "a\\nb"
        shownOf(28.0) --> "28.0" *)
  if value.IsText(x)
    str.Replace("\t", "\\t", str.Replace("\r", "\\r", str.Replace("\n", "\\n", x)))
  else if value.IsStruct(x) and not value.IsDict(x)
    date.FormatDate(x)
  else
    "$x"
  end
end

defn BoxColumns(x)
  (** The columns of the box of an input inside its edges: its longest option and its v for a choice, a day and its v for a date, at least 24 for a
      field.

        BoxColumns({Kind: "choice", Options: ["GMT-5", "GMT-10"]}) --> 10 *)
  if x.Kind == "choice"
    list.Max(8, list.Reduce((w, o) -> list.Max(w, value.Len(shownOf(o))), 0, x.Options) + 4)
  else if x.Kind == "date"
    14
  else
    list.Max(24, value.Len(shownOf(x.Value)) + 2)
  end
end

(** The rows of the open list of a choice, at most 8: the others scroll. *)
ListRows() = 8

(** The first option a list of n shows, from 1, so that the option at stays in its 8 rows. *)
listTop(at, n) = list.Max(1, list.Min(at - math.Div(ListRows(), 2), n - ListRows() + 1))

(** The columns of the parts of a date in its box, from 0: the year, the month, the day. *)
dayParts = [{From: 0, To: 3}, {From: 5, To: 6}, {From: 8, To: 9}]

defn edged(x, y, w, h, color)
  (** The edges of a box, 1 pixel wide. *)
  [{Kind: "rect", X: x, Y: y, Width: w, Height: 1, Color: color}, {Kind: "rect", X: x, Y: y + h - 1, Width: w, Height: 1, Color: color},
    {Kind: "rect", X: x, Y: y, Width: 1, Height: h, Color: color}, {Kind: "rect", X: x + w - 1, Y: y, Width: 1, Height: h, Color: color}]
end

defn ringed(x, w, cell, th)
  (** The ring of 2 pixels in the accent color round a control that has the keys, as a slider's. *)
  left = x - 6
  wide = w + 12
  [{Kind: "rect", X: left, Y: 0, Width: wide, Height: 2, Color: th.Accent}, {Kind: "rect", X: left, Y: cell.Height - 2, Width: wide, Height: 2, Color: th.Accent},
    {Kind: "rect", X: left, Y: 0, Width: 2, Height: cell.Height, Color: th.Accent}, {Kind: "rect", X: left + wide - 2, Y: 0, Width: 2, Height: cell.Height, Color: th.Accent}]
end

(** A text of the code font. *)
inkText(x, y, t, color) = {Kind: "text", X: x, Y: y, Text: t, Color: color, Font: "code"}

defn InputItems(x, f, took, width, columns, cell, th)
  (** What draws an input other than a slider under its line, in the code font, in the ink and on the paper, the ground of the code, of the theme: a
      check box as [ ] or [x] then its label, or its name; another input as its name, then its box, its edges 1 pixel wide in ink, its value inside,
      and a v at its right for a choice and a date. While it has the keys, f, the edges of its box, or a ring round a check box, take the accent
      color, 2 pixels wide: a field shows what is typed and its cursor, a date its part under the cursor in reverse, and a choice's open list hangs
      under its box, its option under the cursor in reverse. The time of its last rerun follows, in muted ink.

        value.Len(InputItems({Name: "on", Kind: "check", Value: true, Label: "Bold"}, missing, missing, 800, 2, {Width: 8, Height: 19}, {Ink: 1, Line: 2, Muted: 3, Accent: 4, Code: 5})) --> 1 *)
  p = SliderPlaces(width, columns, cell)
  focused = value.IsSome(f)
  after = (at, out) -> if value.IsSome(took) list.Append(inkText(at, 0, "rerun $(math.Div(math.Floor(took * 1000.0 + 0.5), 1)) ms", th.Muted), out) else out end
  if x.Kind == "check"
    label = "$(if x.Value "[x]" else "[ ]" end) $(shownOf(if value.IsText(dict.GetOr("Label", missing, x)) x.Label else x.Name end))"
    wide = value.Len(label) * cell.Width
    out = [inkText(p.Name, 0, label, th.Ink)]
    out = if focused list.Concat(out, ringed(p.Name, wide, cell, th)) else out end
    return after(p.Name + wide + 2 * cell.Width, out)
  end
  cols = list.Max(4, list.Min(BoxColumns(x), math.Div(width - p.Track, cell.Width) - 2))
  w = cols * cell.Width
  h = cell.Height
  chevron = x.Kind == "choice" or x.Kind == "date"
  room = cols - (if chevron 4 else 2 end)
  shown = if focused and dict.Has("Draft", f) f.Draft else if focused and dict.Has("Day", f) date.FormatDate(f.Day) else shownOf(x.Value) end
  inside = p.Track + cell.Width
  first = if focused and dict.Has("Caret", f) list.Max(0, f.Caret - room + 1) else 0 end
  (* The box fills its row, as the text in it does: its edges take the accent color, 2 pixels wide, while it has the keys. *)
  edges = if focused list.Concat(edged(p.Track, 0, w, h, th.Accent), edged(p.Track + 1, 1, w - 2, h - 2, th.Accent)) else edged(p.Track, 0, w, h, th.Ink) end
  out = list.Concat([inkText(p.Name, 0, x.Name, th.Ink), {Kind: "rect", X: p.Track, Y: 0, Width: w, Height: h, Color: th.Code}], edges)
  out = list.Append(inkText(inside, 0, str.Join("", list.Take(room, list.Skip(first, str.Chars(shown)))), th.Ink), out)
  if chevron
    out = list.Append(inkText(p.Track + (cols - 2) * cell.Width, 0, "v", th.Ink), out)
  end
  if focused and dict.Has("Caret", f)
    out = list.Append({Kind: "rect", X: inside + (f.Caret - first) * cell.Width, Y: 2, Width: 2, Height: h - 4, Color: th.Ink}, out)
  end
  if focused and dict.Has("Part", f)
    part = dayParts[f.Part]
    out = list.Concat(out, [{Kind: "rect", X: inside + part.From * cell.Width, Y: 1, Width: (part.To - part.From + 1) * cell.Width, Height: h - 2, Color: th.Ink},
      inkText(inside + part.From * cell.Width, 0, str.Slice(part.From + 1, part.To + 1, shown), th.Code)])
  end
  if focused and dict.GetOr("Open", false, f)
    n = value.Len(x.Options)
    top = listTop(f.At, n)
    for k in top..list.Min(n, top + ListRows() - 1)
      y = (k - top + 1) * cell.Height
      lit = k == f.At
      out = list.Concat(out, [{Kind: "rect", X: p.Track, Y: y, Width: w, Height: h, Color: if lit th.Ink else th.Code end}, inkText(inside, y, str.Join("", list.Take(room, str.Chars(shownOf(x.Options[k])))), if lit th.Code else th.Ink end)])
    end
    out = list.Concat(out, edged(p.Track, cell.Height, w, (list.Min(n, top + ListRows() - 1) - top + 1) * cell.Height, th.Ink))
  end
  after(p.Track + w + 2 * cell.Width, out)
end

defn inputFocus(name, k, state)
  (** The control that has the keys when it is the input of a name in buffer k, or missing. *)
  f = commands.FocusOf(state)
  if value.IsSome(f) and dict.GetOr("Input", "", f) == name and dict.GetOr("Buffer", 0, f) == k f else missing end
end

defn inputBlock(x, i, r, state)
  (** The block of an input other than a slider under its line: drawn from the analysis, it takes the mouse, and keeps the keys at a press, which it
      gives or keeps itself; a choice whose list is open has a row for each option it shows. *)
  f = inputFocus(x.Name, state.Current, state)
  took = moveOf(x.Name, r).Took
  columns = nameColumns(i, r)
  cell = state.Cell
  name = x.Name
  open = value.IsSome(f) and dict.GetOr("Open", false, f)
  rows = if open 1 + list.Min(ListRows(), value.Len(x.Options)) else 1 end
  {Line: x.Line, Rows: rows, Cell: 0, Input: name, Keeps: true, Draw: (width, look) -> InputItems(x, f, took, width, columns, cell, look.Theme),
    Mouse: (action, point, st) -> inputMouse(name, action, point, st)}
end

(* -- The keys of an input, which C-c e f or a click gives it. *)

defn InputHints(kind)
  (** The rows of the band while an input other than a slider has the keys. *)
  tab = {Key: "Tab S-Tab", Name: "the next input, the previous one", Group: false}
  leave = {Key: "C-g", Name: "leave", Group: false}
  match kind
    "choice" -> [{Key: "Enter", Name: "open the list, choose", Group: false}, {Key: "↑ ↓", Name: "an option", Group: false}, tab, leave]
    "check" -> [{Key: "Space", Name: "check or not", Group: false}, tab, leave]
    "date" -> [{Key: "← →", Name: "the year, the month, the day", Group: false}, {Key: "↑ ↓", Name: "change it", Group: false}, {Key: "Enter", Name: "set", Group: false}, tab, leave]
    else -> [{Key: "Enter", Name: "set what is typed", Group: false}, tab, leave]
  end
end

defn InputKeys(kind)
  (** The keys of an input other than a slider that has them: Tab and S-Tab go to the next input of the cell and the previous one, C-g and Escape close
      a list, or leave; a choice's Enter opens its list and chooses, the arrows move in it, Home and End to its first and its last option, the pages 8
      options; a check box's Space checks it or not; a field's Enter sets what is typed, Backspace and Delete erase, Left, Right, Home and End move the
      cursor; a date's Left and Right pick its part, Up and Down change it, Enter sets it. *)
  common = {"tab": st -> tabbed(1, st), "S-tab": st -> tabbed(-1, st), "C-g": closedOrLeft, "escape": closedOrLeft}
  own = match kind
    "choice" -> {"enter": chosen, "up": st -> listMoved(-1, st), "down": st -> listMoved(1, st), "pageup": st -> listMoved(-ListRows(), st),
      "pagedown": st -> listMoved(ListRows(), st), "home": st -> listMoved(-1000000, st), "end": st -> listMoved(1000000, st)}
    "check" -> {"space": checked}
    "date" -> {"enter": daySet, "left": st -> partMoved(-1, st), "right": st -> partMoved(1, st), "up": st -> dayMoved(1, st), "down": st -> dayMoved(-1, st)}
    else -> {"enter": fieldSet, "backspace": st -> erased(-1, st), "delete": st -> erased(0, st), "left": st -> caretMoved(-1, st), "right": st -> caretMoved(1, st),
      "home": st -> caretMoved(-1000000, st), "end": st -> caretMoved(1000000, st)}
  end
  dict.Merge(common, own)
end

defn inputFocusedOn(k, name, state, at = missing)
  (** The state with the keys on the input of a name in buffer k, drawn with its ring, and the one that had them without: a choice with its list shut,
      a field with what the file writes and its cursor at its end, or at a column for a click, a date with its day picked. *)
  s = commands.Unfocused(state)
  r = runOf(s.Buffers[k])
  found = if value.IsMissing(r) missing else inputAt(name, r) end
  if value.IsMissing(found)
    return s
  end
  x = found.Input
  f = {Keys: InputKeys(x.Kind), Hints: InputHints(x.Kind), Leave: st -> laid(k, st), Buffer: k, Input: name, Kind: x.Kind}
  f = match x.Kind
    "choice" -> dict.Merge(f, {Open: false, At: orFirst(list.FindFirst(j -> x.Options[j] == x.Value, 1..value.Len(x.Options)))})
    "date" -> dict.Merge(f, {Day: x.Value, Part: if value.IsMissing(at) 3 else partAt(at) end})
    "field" -> dict.Merge(f, {Draft: shownOf(x.Value), Caret: list.Min(value.Len(shownOf(x.Value)), if value.IsMissing(at) 1000000 else at end), Typed: typedIn})
    else -> f
  end
  s.Focus = f
  laid(k, s)
end

(** A place found, or the first one. *)
orFirst(at) = if value.IsMissing(at) 1 else at end

(** The part of a date under a column of its box, from 0: its year, its month or its day. *)
partAt(column) = if column <= 4 1 else if column <= 7 2 else 3 end

defn withFocus(f, state)
  (** The state with the control f that has the keys, drawn again. *)
  s = state
  s.Focus = f
  laid(f.Buffer, s)
end

defn focusedInput(state)
  (** The input that has the keys in its buffer as the analysis reads it now, {Focus, Input}, or missing when it is gone. *)
  f = commands.FocusOf(state)
  if value.IsMissing(f) or not dict.Has("Input", f)
    return missing
  end
  s = fresh(f.Buffer, state)
  found = inputAt(f.Input, runOf(s.Buffers[f.Buffer]))
  if value.IsMissing(found) missing else {Focus: f, Input: found.Input, State: s} end
end

defn closedOrLeft(state)
  (** C-g or Escape: an open list shuts, else the input leaves the keys. *)
  f = commands.FocusOf(state)
  if dict.GetOr("Open", false, f)
    f.Open = false
    return withFocus(f, state)
  end
  commands.Unfocused(state)
end

defn listMoved(by, state)
  (** The arrows of a choice: its list opens, and the option under the cursor moves by some, within the first and the last. *)
  got = focusedInput(state)
  if value.IsMissing(got)
    return commands.Unfocused(state)
  end
  f = got.Focus
  f.Open = true
  f.At = list.Max(1, list.Min(value.Len(got.Input.Options), f.At + by))
  withFocus(f, got.State)
end

defn chosen(state)
  (** Enter on a choice: its list opens; in the open list, the option under the cursor is chosen and the list shuts. *)
  got = focusedInput(state)
  if value.IsMissing(got)
    return commands.Unfocused(state)
  end
  f = got.Focus
  if not f.Open
    f.Open = true
    return withFocus(f, got.State)
  end
  f.Open = false
  Changed(f.Buffer, f.Input, got.Input.Options[f.At], withFocus(f, got.State))
end

defn checked(state)
  (** Space on a check box: the other value, true for false. *)
  got = focusedInput(state)
  if value.IsMissing(got) commands.Unfocused(state) else Changed(got.Focus.Buffer, got.Focus.Input, not got.Input.Value, got.State) end
end

defn typedIn(typed, state)
  (** A text typed in the field that has the keys, at its cursor. *)
  f = commands.FocusOf(state)
  cs = str.Chars(f.Draft)
  f.Draft = str.Join("", list.Concat(list.Concat(list.Take(f.Caret, cs), [typed]), list.Skip(f.Caret, cs)))
  f.Caret = f.Caret + value.Len(typed)
  withFocus(f, state)
end

defn erased(by, state)
  (** Backspace, by -1, erases the character before the cursor of the field, Delete, by 0, the one after it. *)
  f = commands.FocusOf(state)
  cs = str.Chars(f.Draft)
  at = f.Caret + by
  if at < 0 or at >= value.Len(cs)
    return state
  end
  f.Draft = str.Join("", list.Concat(list.Take(at, cs), list.Skip(at + 1, cs)))
  f.Caret = at
  withFocus(f, state)
end

defn caretMoved(by, state)
  (** The cursor of the field moved by some characters, within its text. *)
  f = commands.FocusOf(state)
  f.Caret = list.Max(0, list.Min(value.Len(f.Draft), f.Caret + by))
  withFocus(f, state)
end

defn fieldSet(state)
  (** Enter in a field: what is typed is its new value, a number for a field of a number, which refuses anything else. *)
  got = focusedInput(state)
  if value.IsMissing(got)
    return commands.Unfocused(state)
  end
  f = got.Focus
  x = got.Input
  if value.IsText(x.Value)
    if f.Draft == shownOf(x.Value)
      return got.State
    end
    return Changed(f.Buffer, f.Input, f.Draft, got.State)
  end
  n = str.Number(str.Trim(f.Draft))
  if value.IsMissing(n) or n - n != 0
    return commands.Say("$(f.Input) takes a number: $(f.Draft) is none.", got.State)
  end
  Changed(f.Buffer, f.Input, n, got.State)
end

defn partMoved(by, state)
  (** Left and Right on a date: the part under the cursor, its year, its month or its day. *)
  f = commands.FocusOf(state)
  f.Part = list.Max(1, list.Min(3, f.Part + by))
  withFocus(f, state)
end

defn dayMoved(by, state)
  (** Up and Down on a date: its part under the cursor one more or one less, the month round the year, the day kept within its month, the year within
      0 to 9999. *)
  f = commands.FocusOf(state)
  d = f.Day
  y = d.Year
  m = d.Month
  if f.Part == 1
    y = list.Max(0, list.Min(9999, y + by))
  else if f.Part == 2
    m = math.Mod(m - 1 + by, 12) + 1
  end
  last = date.DaysInMonth(y, m)
  day = if f.Part == 3 math.Mod(list.Min(d.Day, last) - 1 + by, last) + 1 else list.Min(d.Day, last) end
  f.Day = date.Date(y, m, day)
  withFocus(f, state)
end

defn daySet(state)
  (** Enter on a date: the day in its box is its new value. *)
  got = focusedInput(state)
  if value.IsMissing(got) commands.Unfocused(state) else Changed(got.Focus.Buffer, got.Focus.Input, got.Focus.Day, got.State) end
end

(* -- The mouse. *)

defn inputMouse(name, action, point, state)
  (** A press of the mouse on the block of an input: it gives the input the keys. On a check box it checks it or not; on a choice's box it opens its
      list, or shuts it, and on an option of the open list it chooses it; on a field it puts the cursor under the point; on a date it picks the part
      under the point. Moves and releases do nothing. *)
  k = state.Current
  r = runOf(state.Buffers[k])
  found = if value.IsMissing(r) missing else inputAt(name, r) end
  if action != "down" or value.IsMissing(found)
    return state
  end
  x = found.Input
  cell = state.Cell
  p = SliderPlaces(point.Width, nameColumns(found.Cell, r), cell)
  column = math.Div(point.X - p.Track, cell.Width) - 1
  held = inputFocus(name, k, state)
  if x.Kind == "check"
    s = if value.IsSome(held) state else inputFocusedOn(k, name, state) end
    return Changed(k, name, not x.Value, s)
  end
  if x.Kind == "choice" and value.IsSome(held) and dict.GetOr("Open", false, held) and point.Y >= cell.Height
    f = held
    f.At = list.Min(value.Len(x.Options), listTop(f.At, value.Len(x.Options)) + math.Div(point.Y, cell.Height) - 1)
    f.Open = false
    return Changed(k, name, x.Options[f.At], withFocus(f, state))
  end
  if x.Kind == "choice"
    s = if value.IsSome(held) state else inputFocusedOn(k, name, state) end
    f = commands.FocusOf(s)
    f.Open = not (value.IsSome(held) and dict.GetOr("Open", false, held))
    return withFocus(f, s)
  end
  if x.Kind == "field" and value.IsSome(held)
    f = held
    f.Caret = list.Max(0, list.Min(value.Len(f.Draft), column))
    return withFocus(f, state)
  end
  if x.Kind == "date" and value.IsSome(held)
    f = held
    f.Part = partAt(column)
    return withFocus(f, state)
  end
  inputFocusedOn(k, name, state, at = list.Max(0, column))
end

(* -- A change: the value written in the buffer, then the session told, as a slider's move. *)

defn plausible(held, x)
  (** Do the columns of an input hold a value of its kind as the file writes it: a text in quotes, true or false, the number of its value, or its day
      in quotes? *)
  if x.Kind == "check"
    held == "$(x.Value)"
  else if x.Kind == "date"
    held == nb.Snap(x, x.Value).Text
  else if value.IsText(x.Value)
    value.Len(held) >= 2 and str.StartsWith("\"", held) and str.EndsWith("\"", held)
  else
    str.Number(held) == x.Value
  end
end

defn Changed(k, name, x, state)
  (** The state after the input of a name in buffer k, other than a slider, is given the value x: its text as cells.Snap writes it, a text in quotes
      that the file never reads as code, written in the buffer in place of the old one, if that place lies on a line of the input's cell and still holds
      a value of its kind, one step of undo; the box drawn again at once, and the results that the new value makes stale noted; then the session told,
      as a slider's move. A value that writes the same text changes nothing. *)
  s = fresh(k, state)
  b = s.Buffers[k]
  r = runOf(b)
  found = inputAt(name, r)
  if value.IsMissing(found) or found.Input.Kind == "slider"
    return s
  end
  x0 = found.Input
  cell = r.Cells[found.Cell]
  line = if x0.Line <= rope.LineCount(b.Rope) rope.Line(x0.Line, b.Rope) else "" end
  if x0.Line < cell.From or x0.Line > cell.To or x0.Column < 1 or x0.End > value.Len(line) or not plausible(str.Slice(x0.Column, x0.End, line), x0)
    return commands.Say("The input $name isn't where its value was: the cells are read again at the next key.", s)
  end
  at = nb.Snap(x0, x)
  if str.Slice(x0.Column, x0.End, line) == at.Text
    return s
  end
  edited = text.Replaced([{Line: x0.Line, Column: x0.Column - 1, End: x0.End, Text: at.Text}], b)
  moved = dict.Merge(x0, {Value: at.Value, End: x0.Column + value.Len(at.Text) - 1})
  r.Analysis[found.Cell].Inputs[found.Index] = moved
  r.Cells[found.Cell].Source = str.Join("\n", [rope.Line(n, edited.Rope) for n in cell.From..cell.To])
  r.Version = edited.Version
  r.Joinable = missing
  (* The analysis says what the text says: the cells are not read again at rest for this edit. *)
  edited.CellsSeen = edited.Version
  s.Buffers[k] = edited
  (* A field and a date that keep the keys show the value set. *)
  f = inputFocus(name, k, s)
  if value.IsSome(f) and dict.Has("Draft", f)
    f.Draft = shownOf(at.Value)
    f.Caret = list.Min(f.Caret, value.Len(f.Draft))
    s.Focus = f
  else if value.IsSome(f) and dict.Has("Day", f)
    f.Day = at.Value
    s.Focus = f
  end
  pushed(k, name, at.Value, restaled(k, laid(k, withRun(k, r, s))))
end

(* ---- Animations: a graph of plot.Frames shows one frame at a time, over a bar, ▶ 12 / 120, that plays it at its rate. Its frames come from the
   session one at a time, cells.Scene with the frame: the next one is asked while one shows and kept ahead until its time, so that an animation never
   crosses whole and at most two of its frames are in memory. No frame is skipped: one late to come shows late, and the bar says the rate it plays
   at. An animation starts paused on its first frame, as at each run of its cell, and plays only while it is on the screen. Its state is in its graph,
   {Frames, Fps, Frame, Playing, Due, Times, Want}: the frame shown, when the next one is due, when the last ones showed, and a frame asked for. *)

defn BarPlaces(width, frames, cell)
  (** The places of the parts of an animation's bar in its block, in pixels from its left, for a block width pixels wide: {Label, Track, Wide, Rate},
      the label ▶ 12 / 120, the track and its width, and the rate after it.

        BarPlaces(1000, 120, {Width: 8, Height: 19}).Track --> 120 *)
  label = 2 * cell.Width
  track = label + (2 * value.Len("$frames") + 7) * cell.Width
  wide = list.Max(80, list.Min(480, width - track - 16 * cell.Width))
  {Label: label, Track: track, Wide: wide, Rate: track + wide + 2 * cell.Width}
end

(** A rate as the bar writes it: 30, 30 for 30.0 too, or 7.25. *)
rateText(fps) = if value.IsFloat(fps) and fps == math.Floor(fps) "$(math.Div(fps, 1))" else "$fps" end

defn RateWords(graph)
  (** What the bar of an animation says of its rate: its own, 30/s, or, while it plays slower, the rate of the frames it showed in the last second,
      18/s of 30.

        RateWords({Fps: 30, Playing: true, Times: [0.0, 0.1, 0.2, 0.3]}) --> "10/s of 30" *)
  ts = graph.Times
  n = value.Len(ts)
  if graph.Playing and n >= 3 and ts[n] > ts[1]
    real = (n - 1) / (ts[n] - ts[1])
    if real < graph.Fps * 0.95
      return "$(math.Div(math.Round(real), 1))/s of $(rateText(graph.Fps))"
    end
  end
  "$(rateText(graph.Fps))/s"
end

defn BarItems(graph, focused, width, top, cell, th)
  (** What draws the bar of an animation, top pixels down its block: ▶ while it is paused or ‖ while it plays, the frame shown and their count, a track
      in the color of lines with its thumb in ink at the frame, the rate, and a ring of 2 pixels in the accent color while it has the keys.

        value.Len(BarItems({Frame: 1, Frames: 3, Fps: 30, Playing: false, Times: []}, false, 800, 0, {Width: 8, Height: 19}, {Ink: 1, Line: 2, Muted: 3, Accent: 4})) --> 4 *)
  p = BarPlaces(width, graph.Frames, cell)
  mid = math.Div(cell.Height, 2)
  at = if graph.Frames <= 1 0 else math.Div((graph.Frame - 1) * (p.Wide - 8), graph.Frames - 1) end
  sign = if graph.Playing "‖" else "▶" end
  out = [{Kind: "text", X: p.Label, Y: top, Text: "$sign $(graph.Frame) / $(graph.Frames)", Color: th.Ink, Font: "code"},
    {Kind: "rect", X: p.Track, Y: top + mid - 1, Width: p.Wide, Height: 2, Color: th.Line},
    {Kind: "rect", X: p.Track + at, Y: top + 3, Width: 8, Height: cell.Height - 6, Color: th.Ink},
    {Kind: "text", X: p.Rate, Y: top, Text: RateWords(graph), Color: th.Muted, Font: "code"}]
  if not focused
    return out
  end
  left = p.Label - 6
  wide = p.Track + p.Wide + 6 - left
  list.Concat(out, [{Kind: "rect", X: left, Y: top, Width: wide, Height: 2, Color: th.Accent}, {Kind: "rect", X: left, Y: top + cell.Height - 2, Width: wide, Height: 2, Color: th.Accent},
    {Kind: "rect", X: left, Y: top, Width: 2, Height: cell.Height, Color: th.Accent}, {Kind: "rect", X: left + wide - 2, Y: top, Width: 2, Height: cell.Height, Color: th.Accent}])
end

(** Does the bar of the animation of a graph in buffer k have the keys? *)
barFocused(k, graph, state) = isAnimation(graph) and value.IsSome(commands.FocusOf(state)) and dict.GetOr("Bar", missing, commands.FocusOf(state)) == graph.Key and dict.GetOr("Buffer", 0, commands.FocusOf(state)) == k

(** The block of buffer k that shows the animation of a key, or missing. *)
animOf(k, key, state) = list.FindFirst(x -> dict.GetOr("Cell", 0, x) > 0 and isAnimation(dict.GetOr("Graph", missing, x)) and x.Graph.Key == key, text.BlocksOf(state.Buffers[k]))

(** The state with the block x of buffer k showing a graph, its lines as they were. *)
withGraph(k, x, graph, state) = rebuilt(k, x, graph, state)

(** Where the bar of an animation's block starts, in pixels down the block: under its lines and its graph. *)
barTop(x, cell) = (value.Len(x.Lines) + math.Div(x.Graph.Scene.Height + 8 + cell.Height - 1, cell.Height)) * cell.Height

defn onScreen(k, x, state)
  (** Is the block x of buffer k on the screen: its buffer shown in a pane, and its line among those the window has room for from the pane's top? *)
  tree = panes.Tree(state)
  rows = math.Div(state.Height, state.Cell.Height)
  for j in 1..panes.Count(tree)
    leaf = panes.At(j, tree)
    active = j == panes.Active(state)
    if (if active state.Current else leaf.Buffer end) == k
      top = if active or value.IsMissing(leaf.View) state.Buffers[k].Top else leaf.View.Top end
      if x.Line >= top and x.Line <= top + rows
        return true
      end
    end
  end
  false
end

defn playing(k, state)
  (** Does an animation of buffer k need ticks: one plays on the screen, or a frame asked for isn't shown yet? Not without a session, which no frame
      would come from. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Session)
    return false
  end
  for x in text.BlocksOf(state.Buffers[k])
    if dict.GetOr("Cell", 0, x) > 0 and isAnimation(dict.GetOr("Graph", missing, x)) and ((x.Graph.Playing and onScreen(k, x, state)) or value.IsSome(x.Graph.Want))
      return true
    end
  end
  false
end

defn played(k, state)
  (** The state at a tick for the animations of buffer k: the frame asked of the session kept ahead once it came, and each animation moved on when its
      next frame is due, or to the frame asked for. *)
  s = landed(k, state)
  r = runOf(s.Buffers[k])
  shown = [x.Graph.Key for x in text.BlocksOf(s.Buffers[k]) if dict.GetOr("Cell", 0, x) > 0 and isAnimation(dict.GetOr("Graph", missing, x))]
  aheads = dict.GetOr("Ahead", {}, r)
  if value.Len(aheads) > 0
    (* The frames ahead of an animation that a run or a clear took away go. *)
    kept = {}
    for name in dict.Keys(aheads)
      if aheads[name].Key in shown
        kept[name] = aheads[name]
      end
    end
    r.Ahead = kept
    s = withRun(k, r, s)
  end
  for key in shown
    s = advanced(k, key, s)
  end
  s
end

defn landed(k, state)
  (** The state once the frame asked in buffer k came: kept ahead of its animation, at the width it was drawn at. A frame that can't come, or isn't
      sane, pauses its animation, which says why. *)
  r = runOf(state.Buffers[k])
  f = dict.GetOr("Framing", missing, r)
  if value.IsMissing(f)
    return state
  end
  got = fiber.Wait(f.Task, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  r.Framing = missing
  s = withRun(k, r, state)
  scene = if result.IsOk(got) got.Value else got end
  x = animOf(k, f.Key, s)
  if value.IsMissing(x)
    return s
  end
  why = if result.IsErr(scene) scene.Error.Message else SceneFault(scene.Value) end
  count = if value.IsMissing(why) dict.GetOr("Frames", missing, scene.Value) else missing end
  if value.IsMissing(why) and count != x.Graph.Frames
    why = if value.IsMissing(count) "it is no frame of an animation" else "it has $count frames, not $(x.Graph.Frames)" end
  end
  if value.IsSome(why)
    g = x.Graph
    g.Playing = false
    g.Want = missing
    return commands.Say("This animation stops: its frame $(f.Frame) can't be drawn, as $why. C-c e e runs its cell again.", withGraph(k, x, g, s))
  end
  r.Ahead = dict.Put("$(f.Key)", {Key: f.Key, Frame: f.Frame, Width: f.Width, Graph: Prepared(scene.Value, commands.Home(s))}, dict.GetOr("Ahead", {}, r))
  withRun(k, r, s)
end

defn advanced(k, key, state)
  (** The state with the animation of a key in buffer k moved on: to its next frame once it is due, if it plays and shows, or to the frame asked for;
      shown from the frame ahead when it is that one at the pane's width, else asked of the session. *)
  x = animOf(k, key, state)
  if value.IsMissing(x)
    return state
  end
  g = x.Graph
  want = if g.Playing math.Mod(g.Frame, g.Frames) + 1 else g.Want end
  if value.IsMissing(want)
    return state
  end
  r = runOf(state.Buffers[k])
  width = GraphWidth(state)
  aheads = dict.GetOr("Ahead", {}, r)
  ahead = dict.GetOr("$key", missing, aheads)
  if value.IsMissing(ahead) or ahead.Frame != want or ahead.Width != width
    return asked(k, key, want, width, state)
  end
  ng = dict.Merge(g, ahead.Graph)
  ng.Frame = want
  if g.Playing
    now = sys.Now()
    if now < g.Due or not onScreen(k, x, state)
      return state
    end
    (* On time, the next frame keeps the beat; late by a frame or more, it counts from now: none is skipped to catch up. *)
    ng.Due = if now - g.Due < 1.0 / g.Fps g.Due + 1.0 / g.Fps else now + 1.0 / g.Fps end
    ng.Times = list.TakeLast(list.Max(3, math.Div(math.Ceil(g.Fps), 1) + 1), list.Append(now, g.Times))
  else
    ng.Want = missing
  end
  r.Ahead = dict.Drop("$key", aheads)
  s = withGraph(k, x, ng, withRun(k, r, state))
  if ng.Playing asked(k, key, math.Mod(want, g.Frames) + 1, width, s) else s end
end

defn asked(k, key, frame, width, state)
  (** The state with a frame of the animation of a key asked of the session of buffer k, at a width, unless a question or a cell keeps it busy: the next
      tick asks again. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r.Session) or value.IsSome(r.Task) or asking(r)
    return state
  end
  one = r.Session
  r.Framing = {Task: fiber.Spawn(() -> nb.Scene(one, key, width, frame = frame)), Key: key, Frame: frame, Width: width}
  (* The fiber writes its question now, so that the session draws the frame while this one draws the frame before. *)
  sys.Sleep(0)
  withRun(k, r, state)
end

defn toggled(k, key, state)
  (** The animation of a key in buffer k played from the frame it shows, or paused there. *)
  x = animOf(k, key, state)
  if value.IsMissing(x)
    return state
  end
  g = x.Graph
  g.Playing = not g.Playing
  g.Want = missing
  g.Times = []
  g.Due = sys.Now() + 1.0 / g.Fps
  advanced(k, key, withGraph(k, x, g, state))
end

defn sought(k, key, frame, state)
  (** The animation of a key in buffer k paused, and asked to show a frame. *)
  x = animOf(k, key, state)
  if value.IsMissing(x)
    return state
  end
  g = x.Graph
  g.Playing = false
  g.Times = []
  g.Want = if frame == g.Frame missing else frame end
  advanced(k, key, withGraph(k, x, g, state))
end

defn barMouse(key, action, point, state)
  (** A press, a move or a release of the mouse on the block of an animation: a press on its bar gives it the keys, and on ▶ plays or pauses it, on its
      track goes to the frame under the point, as a single pointer does (WCAG 2.5.7); a move with the button held drags it. A press on its graph or its
      lines does nothing. *)
  k = state.Current
  x = animOf(k, key, state)
  if value.IsMissing(x)
    return state
  end
  r = runOf(state.Buffers[k])
  if action == "up"
    r.Drag = missing
    return withRun(k, r, state)
  end
  if action == "move" and dict.GetOr("Drag", missing, r) != "bar $key"
    return state
  end
  p = BarPlaces(point.Width, x.Graph.Frames, state.Cell)
  s = state
  if action == "down"
    top = barTop(x, state.Cell)
    if point.Y < top or point.Y >= top + state.Cell.Height or point.X > p.Track + p.Wide + 6
      return state
    end
    s = barFocusedOn(k, key, state)
    if point.X < p.Track - 6
      return toggled(k, key, s)
    end
  end
  f = list.Max(0.0, list.Min(1.0, (point.X - p.Track - 4) / list.Max(1, p.Wide - 8)))
  s = sought(k, key, 1 + math.Div(math.Round(f * (x.Graph.Frames - 1)), 1), s)
  r = runOf(s.Buffers[k])
  r.Drag = "bar $key"
  withRun(k, r, s)
end

(** The rows of the band while an animation's bar has the keys. *)
BarHints() = [{Key: "Space", Name: "play, pause", Group: false}, {Key: "← →", Name: "a frame", Group: false}, {Key: "PgUp PgDn", Name: "ten frames", Group: false},
  {Key: "Home End", Name: "the first, the last", Group: false}, {Key: "C-g", Name: "leave", Group: false}]

(** The keys of an animation's bar that has them, as WAI-ARIA's slider pattern has them: Space plays or pauses, the arrows go a frame back or on, the
    pages ten, Home and End to the first frame and the last, Tab and S-Tab stay, as the bar is the only control of its cell, and C-g leaves. *)
BarKeys() = {"space": st -> barKeyed(0, st), "right": barStep(1), "up": barStep(1), "left": barStep(-1), "down": barStep(-1), "pageup": barStep(10),
  "pagedown": barStep(-10), "home": barStep(-1000), "end": barStep(1000), "tab": st -> st, "S-tab": st -> st, "C-g": commands.Unfocused}

(** The command that moves the bar that has the keys by some frames. *)
barStep(by) = state -> barKeyed(by, state)

defn barKeyed(by, state)
  (** The animation whose bar has the keys played or paused, for 0, or moved by some frames from the one shown or asked for, within its first and
      its last. *)
  f = commands.FocusOf(state)
  k = f.Buffer
  x = if k <= value.Len(state.Buffers) animOf(k, f.Bar, state) else missing end
  if value.IsMissing(x)
    return commands.Unfocused(state)
  end
  if by == 0
    return toggled(k, f.Bar, state)
  end
  from = if value.IsSome(x.Graph.Want) x.Graph.Want else x.Graph.Frame end
  sought(k, f.Bar, list.Max(1, list.Min(x.Graph.Frames, from + by)), state)
end

defn barFocusedOn(k, key, state)
  (** The state with the keys on the bar of the animation of a key in buffer k, drawn with its ring, and the control that had them without. *)
  s = commands.Unfocused(state)
  s.Focus = {Keys: BarKeys(), Hints: BarHints(), Leave: st -> barDrawn(k, key, st), Buffer: k, Bar: key}
  barDrawn(k, key, s)
end

defn barDrawn(k, key, state)
  (** The state with the block of the animation of a key in buffer k drawn again, with its ring or without. *)
  x = if k <= value.Len(state.Buffers) animOf(k, key, state) else missing end
  if value.IsMissing(x) state else withGraph(k, x, x.Graph, state) end
end

(* ---- 3D graphs: a scene with a View turns, by a drag on the graph or by the arrows after C-c e f. Each view is asked of the session, cells.Scene
   with the view, one question at a time, the latest view winning: the session projects the surface, as for the page, and only the places of its
   points cross; the code is never changed. Its state is in its graph, {View, Code, Aim}: the view shown, the code's, and the latest one asked for,
   which the next question asks while it differs from the one shown. A graph of `*repl*` turns too, with the session of the file it belongs to. *)

(** Is a graph of a block a 3D graph, which turns? *)
isTurning(graph) = value.IsSome(graph) and dict.Has("Code", graph)

(** An angle as the line of a view writes it, with a true minus: -62.5 is −62.5, 20.0 is 20. *)
degrees(x) = "$(if x < 0 "−" else "" end)$(if math.Abs(x) == math.Floor(math.Abs(x)) "$(math.Div(math.Abs(x), 1))" else str.Decimals(1, math.Abs(x)) end)°"

defn ViewWords(graph)
  (** What the line under a 3D graph says: the view asked for last, and its code's while it differs.

        ViewWords({Aim: [-62.5, 20.0], Code: [-37.5, 30.0]}) --> "view −62.5°, 20° (code −37.5°, 30°)" *)
  aim = "view $(degrees(graph.Aim[1])), $(degrees(graph.Aim[2]))"
  if value.Equal(graph.Aim, graph.Code) aim else "$aim (code $(degrees(graph.Code[1])), $(degrees(graph.Code[2])))" end
end

defn ViewItems(graph, focused, top, under, cell, th)
  (** What draws the line under a 3D graph, under pixels down its block: its view in muted ink, and a ring of 2 pixels in the accent color around the
      graph, top pixels down, while it has the keys.

        value.Len(ViewItems({Aim: [0.0, 90.0], Code: [0.0, 90.0], Scene: {Width: 300, Height: 200}}, true, 4, 214, {Width: 8, Height: 19}, {Muted: 3, Accent: 4})) --> 5 *)
  out = [{Kind: "text", X: 2 * cell.Width, Y: under, Text: ViewWords(graph), Color: th.Muted, Font: "code"}]
  if not focused
    return out
  end
  left = 2 * cell.Width - 3
  wide = graph.Scene.Width + 6
  high = graph.Scene.Height + 6
  y = top - 3
  list.Concat(out, [{Kind: "rect", X: left, Y: y, Width: wide, Height: 2, Color: th.Accent}, {Kind: "rect", X: left, Y: y + high - 2, Width: wide, Height: 2, Color: th.Accent},
    {Kind: "rect", X: left, Y: y, Width: 2, Height: high, Color: th.Accent}, {Kind: "rect", X: left + wide - 2, Y: y, Width: 2, Height: high, Color: th.Accent}])
end

(** The block of buffer k that shows the 3D graph of a key, or missing. *)
turnOf(k, key, state) = if k < 1 or k > value.Len(state.Buffers) missing else list.FindFirst(x -> isTurning(dict.GetOr("Graph", missing, x)) and x.Graph.Key == key, text.BlocksOf(state.Buffers[k])) end

defn ownerFor(k, state)
  (** The buffer whose run has the session that draws the graphs of buffer k: itself, or for `*repl*` the file it belongs to; 0 for none. *)
  if value.IsSome(runOf(state.Buffers[k]))
    return k
  end
  p = replOf(state.Buffers[k])
  if value.IsMissing(p) 0 else indexOf(p.Owner, state) end
end

defn regraphed(k, key, graph, state)
  (** The state with the block of buffer k that shows the 3D graph of a key drawn again with this graph, its lines as they were. *)
  x = turnOf(k, key, state)
  if value.IsMissing(x)
    return state
  end
  made = dict.Merge(x, resultBlock(k, dict.GetOr("Cell", 0, x), x.Line, x.Lines, graph, state))
  s = state
  s.Buffers[k] = text.WithBlocks([if isTurning(dict.GetOr("Graph", missing, y)) and y.Graph.Key == key made else y end for y in text.BlocksOf(state.Buffers[k])], state.Buffers[k])
  s
end

(** The view [az, el] with el within -90 and 90, and az within -180 and 180, the turn kept. *)
clampedView(v) = [v[1] - 360.0 * math.Floor((v[1] + 180.0) / 360.0), list.Max(-90.0, list.Min(90.0, v[2]))]

defn turnedTo(k, key, aimed, state)
  (** The state with the 3D graph of a key in buffer k aimed at a view, its line saying so at once, and the view asked of the session if it is free. *)
  x = turnOf(k, key, state)
  if value.IsMissing(x)
    return state
  end
  g = x.Graph
  g.Aim = clampedView(aimed)
  turnAsked(k, key, regraphed(k, key, g, state))
end

defn turnAsked(k, key, state)
  (** The state with the view aimed at by the 3D graph of a key in buffer k asked of the session, unless it is the one shown, or a question or a cell
      keeps the session busy: a tick asks again. *)
  x = turnOf(k, key, state)
  o = ownerFor(k, state)
  if value.IsMissing(x) or o == 0 or value.Equal(x.Graph.Aim, x.Graph.View)
    return state
  end
  r = runOf(state.Buffers[o])
  if value.IsMissing(r) or value.IsMissing(r.Session) or value.IsSome(r.Task) or asking(r)
    return state
  end
  one = r.Session
  aim = x.Graph.Aim
  width = x.Graph.Scene.Width
  r.Turning = {Task: fiber.Spawn(() -> nb.Scene(one, key, width, view = aim)), Buffer: k, Key: key, View: aim}
  (* The fiber writes its question now, so that the session projects while this one draws. *)
  sys.Sleep(0)
  withRun(o, r, state)
end

defn turnLanded(o, state)
  (** The state once the view asked of the session of buffer o came: drawn in its graph, which asks its latest view next if it moved since. A scene
      that can't come, or isn't sane, leaves the graph as it was, aimed back at what it shows, and says why. *)
  r = runOf(state.Buffers[o])
  t = dict.GetOr("Turning", missing, r)
  if value.IsMissing(t)
    return state
  end
  got = fiber.Wait(t.Task, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  r.Turning = missing
  s = withRun(o, r, state)
  x = turnOf(t.Buffer, t.Key, s)
  if value.IsMissing(x)
    return s
  end
  scene = if result.IsOk(got) got.Value else got end
  why = if result.IsErr(scene) scene.Error.Message else SceneFault(scene.Value) end
  g = x.Graph
  if value.IsSome(why)
    g.Aim = g.View
    return commands.Say("This graph doesn't turn: its view can't be drawn, as $why.", regraphed(t.Buffer, t.Key, g, s))
  end
  g = dict.Merge(g, Prepared(scene.Value, commands.Home(s)))
  g.View = t.View
  turnAsked(t.Buffer, t.Key, regraphed(t.Buffer, t.Key, g, s))
end

defn turnPending(k, state)
  (** The state with the 3D graphs of buffer k that aim at a view they don't show asked again, once the session is free. *)
  s = state
  for x in text.BlocksOf(state.Buffers[k])
    g = dict.GetOr("Graph", missing, x)
    if isTurning(g) and not value.Equal(g.Aim, g.View)
      s = turnAsked(k, g.Key, s)
    end
  end
  s
end

defn aiming(k, state)
  (** Does a 3D graph of buffer k aim at a view it doesn't show, with a session to ask? *)
  o = ownerFor(k, state)
  r = if o == 0 missing else runOf(state.Buffers[o]) end
  if value.IsMissing(r) or value.IsMissing(r.Session)
    return false
  end
  list.Any([isTurning(dict.GetOr("Graph", missing, x)) and not value.Equal(x.Graph.Aim, x.Graph.View) for x in text.BlocksOf(state.Buffers[k])])
end

defn turnMouse(key, action, point, state)
  (** A press, a move or a release of the mouse on the block of a 3D graph: a press on the graph gives it the keys and starts a drag that turns it, 0.5°
      a pixel, as if the hand held it: to the right, its front goes right, and down, its top comes toward you; a release ends the drag. *)
  k = state.Current
  x = turnOf(k, key, state)
  if value.IsMissing(x)
    return state
  end
  g = x.Graph
  if action == "down"
    top = value.Len(x.Lines) * state.Cell.Height + 4
    left = 2 * state.Cell.Width
    if point.Y < top or point.Y >= top + g.Scene.Height or point.X < left or point.X >= left + g.Scene.Width
      return state
    end
    s = turnFocusedOn(k, key, state)
    g = turnOf(k, key, s).Graph
    g.Drag = {X: point.X, Y: point.Y, View: g.Aim}
    return regraphed(k, key, g, s)
  end
  drag = dict.GetOr("Drag", missing, g)
  if value.IsMissing(drag)
    return state
  end
  if action == "up"
    g.Drag = missing
    return regraphed(k, key, g, state)
  end
  turnedTo(k, key, [drag.View[1] - 0.5 * (point.X - drag.X), drag.View[2] + 0.5 * (point.Y - drag.Y)], state)
end

(** Does the 3D graph of a block in buffer k have the keys? *)
turnFocused(k, graph, state) = isTurning(graph) and value.IsSome(commands.FocusOf(state)) and dict.GetOr("Turn", missing, commands.FocusOf(state)) == graph.Key and dict.GetOr("Buffer", 0, commands.FocusOf(state)) == k

(** The rows of the band while a 3D graph has the keys. *)
TurnHints() = [{Key: "← →", Name: "the eye round", Group: false}, {Key: "↑ ↓", Name: "the eye higher, lower", Group: false}, {Key: "Home", Name: "the view of the code", Group: false},
  {Key: "C-g", Name: "leave", Group: false}]

(** The keys of a 3D graph that has them: the arrows move the eye 10°, Right and Left round the graph, Up and Down higher and lower, as az and el
    grow and shrink; Home goes back to the view of the code; Tab and S-Tab stay, as the graph is the only control of its cell, and C-g leaves. *)
TurnKeys() = {"right": turnStep(10.0, 0.0), "left": turnStep(-10.0, 0.0), "up": turnStep(0.0, 10.0), "down": turnStep(0.0, -10.0), "home": turnHome, "tab": st -> st,
  "S-tab": st -> st, "C-g": commands.Unfocused}

(** The command that moves the eye of the 3D graph that has the keys by some degrees. *)
turnStep(az, el) = state -> turnKeyed(az, el, state)

defn turnKeyed(az, el, state)
  (** The 3D graph that has the keys aimed some degrees from the view it aims at. *)
  f = commands.FocusOf(state)
  x = turnOf(f.Buffer, f.Turn, state)
  if value.IsMissing(x)
    return commands.Unfocused(state)
  end
  turnedTo(f.Buffer, f.Turn, [x.Graph.Aim[1] + az, x.Graph.Aim[2] + el], state)
end

defn turnHome(state)
  (** The 3D graph that has the keys aimed back at the view of its code. *)
  f = commands.FocusOf(state)
  x = turnOf(f.Buffer, f.Turn, state)
  if value.IsMissing(x) commands.Unfocused(state) else turnedTo(f.Buffer, f.Turn, x.Graph.Code, state) end
end

defn turnFocusedOn(k, key, state)
  (** The state with the keys on the 3D graph of a key in buffer k, drawn with its ring, and the control that had them without. *)
  s = commands.Unfocused(state)
  s.Focus = {Keys: TurnKeys(), Hints: TurnHints(), Leave: st -> turnDrawn(k, key, st), Buffer: k, Turn: key}
  turnDrawn(k, key, s)
end

defn turnDrawn(k, key, state)
  (** The state with the block of the 3D graph of a key in buffer k drawn again, with its ring or without. *)
  x = turnOf(k, key, state)
  if value.IsMissing(x) state else regraphed(k, key, x.Graph, state) end
end

(* ---- Tables: a frame, a matrix, a list of maps or structs or a struct that a cell shows is drawn as a table, thin borders, its header in the strong font,
   numbers on the right of their column, their decimal points in a line, texts on the left, in the code font, the ink of the theme on its paper. It shows
   20 rows at most and scrolls inside its block, by the wheel over it or by the keys once it has them: its rows come from the session a screen at a time,
   cells.Rows, sorted and filtered there, so that a table of a million rows costs a screen. Its state is in its block, {Key, Kind, Columns, Count, Total,
   First, Rows, Positions, Top, Row, Column, Left, Sort, Filter, Draft, Selected, Widths, Stale, Find, Fixed}: the rows fetched from First with their
   positions in the value, the first row shown, the cell of the cursor, the first column shown, the sort and the filter, a filter being typed, the row
   chosen, the widths of the columns, whether the rows shown must be asked, a position whose place is asked, and whether it can be asked at all. A row
   chosen marks its point on the graphs of its cell that have as many points, and a click on such a point chooses its row. *)

(** The most rows a table shows at once: past them it scrolls. *)
TableRows() = 20

(** The most characters of a cell that a table draws: a longer text ends with …. *)
CellColumns() = 40

(** The rows a table asks of the session at a time, around those it shows. *)
pageRows = 100

(** Is the text of a cell a number, as cells.Rows writes one: 12, -0.833, 1e-7, nan or inf? *)
isNumberWords(t) = value.IsSome(str.Number(t)) or t in ["nan", "inf", "-inf"]

(** The characters of a number before its decimal point, and from it: 2 and 3 for 12.50. *)
splitNumber(t) = (at -> if value.IsMissing(at) [value.Len(t), 0] else [at - 1, value.Len(t) - at + 1] end)(str.Find(".", t))

(** A cell's text cut to the characters a table draws. *)
cutCell(t) = if value.Len(t) <= CellColumns() t else "$(str.Join("", list.Take(CellColumns() - 1, str.Chars(t))))…" end

defn IsTableValue(v)
  (** Does a value that a run shows draw as a table: a table of cells.Run, or a matrix, an array of more than one row?

        IsTableValue({Kind: "array", Shape: [1, 4], Rows: [["1", "2", "3", "4"]]}) --> false *)
  value.IsSome(v) and (v.Kind == "table" or (v.Kind == "array" and dict.Has("Shape", v) and value.Len(v.Shape) == 2 and v.Shape[1] > 1))
end

defn TableOf(v)
  (** The state of a table that a run showed, its first rows as the run gave them: a matrix's first rows, cut at 10 columns, are asked again whole at
      once. A table without a key, from a Cesia before them, shows the rows it came with and nothing more.

        TableOf({Kind: "table", Columns: ["a"], Rows: [["1"]], Count: 1, Key: 3}).Count --> 1 *)
  matrix = v.Kind == "array"
  columns = if matrix ["$j" for j in 1..list.Min(256, v.Shape[2])] else v.Columns end
  count = if matrix v.Shape[1] else v.Count end
  rows = v.Rows
  t = {Key: dict.GetOr("Key", missing, v), Kind: v.Kind, Columns: columns, Count: count, Total: count, First: 1, Rows: rows, Positions: [j for j in 1..value.Len(rows)],
    Top: 1, Row: 1, Column: 1, Left: 1, Sort: missing, Filter: "", Draft: missing, Selected: missing, Widths: [], Stale: matrix and (count > value.Len(rows) or v.Shape[2] > 10),
    Find: missing, Fixed: value.IsMissing(dict.GetOr("Key", missing, v)), Prefix: false}
  measured(t)
end

defn measured(t)
  (** The table with the widths of its columns grown to hold the rows it has: for each, {Whole, Fraction, Text}, the characters of its numbers before
      their decimal point and from it, and of its texts. Widths only grow, so that the columns don't jump as the table scrolls. Each cell is read once
      here: Wholes gives, for each row and column, the characters of its number before its decimal point, or -1 for a text, and Numeric whether a
      column holds numbers alone, so that a draw only places them. *)
  out = t
  n = value.Len(t.Columns)
  whole = [if j <= value.Len(t.Widths) t.Widths[j].Whole else 0 end for j in 1..n]
  fraction = [if j <= value.Len(t.Widths) t.Widths[j].Fraction else 0 end for j in 1..n]
  texts = [if j <= value.Len(t.Widths) t.Widths[j].Text else 0 end for j in 1..n]
  numeric = list.Fill(value.Len(t.Rows) > 0, n)
  wholes = []
  rows = t.Rows
  for k in 1..value.Len(rows)
    r = rows[k]
    line = list.Fill(-1, n)
    for j in 1..list.Min(n, value.Len(r))
      x = r[j]
      size = value.Len(x)
      if size > CellColumns()
        (* A cell is drawn at most CellColumns() characters wide, the last one …. *)
        x = cutCell(x)
        size = CellColumns()
        rows[k][j] = x
      end
      b = if size == 0 0 else str.Byte(1, x) end
      (* A number starts with a digit, a sign, a point, or is nan or inf: the others are texts without a parse. *)
      at = if (b >= 48 and b <= 57) or b == 45 or b == 43 or b == 46 or b == 105 or b == 110 (if isNumberWords(x) splitNumber(x)[1] else -1 end) else -1 end
      if at >= 0
        line[j] = at
        whole[j] = list.Max(whole[j], at)
        fraction[j] = list.Max(fraction[j], size - at)
      else
        texts[j] = list.Max(texts[j], size)
        numeric[j] = numeric[j] and size == 0
      end
    end
    wholes = list.Append(line, wholes)
  end
  out.Widths = [{Whole: whole[j], Fraction: fraction[j], Text: texts[j]} for j in 1..n]
  out.Rows = rows
  out.Wholes = wholes
  out.Numeric = numeric
  out
end

(** The rows a table shows: at most TableRows(), none for a table with none. *)
shownRows(t) = list.Max(0, list.Min(TableRows(), t.Count))

(** The rows of the block of a table: its header, the rows it shows and its note. *)
TableHeight(t) = shownRows(t) + 2

(** The row fetched at a place of the table, from 1, or missing when it isn't fetched. *)
rowAt(q, t) = if q >= t.First and q < t.First + value.Len(t.Rows) t.Rows[q - t.First + 1] else missing end

(** The position in the value of the row at a place of the table, or missing when it isn't fetched. *)
positionAt(q, t) = if q >= t.First and q < t.First + value.Len(t.Positions) t.Positions[q - t.First + 1] else missing end

defn TableLayout(t, width, cell, look)
  (** The places of the columns of a table drawn width pixels wide, from its column Left: each {Column, X, Width} in pixels from the left of the block, the
      width as its widest number or text, at most CellColumns() characters, or its header in the strong font, with a character of room each side. *)
  x = 2 * cell.Width
  out = []
  for j in t.Left..value.Len(t.Columns)
    w = t.Widths[j]
    chars = list.Min(CellColumns(), list.Max(w.Whole + w.Fraction, w.Text))
    head = headWidth(j, t, look) + (if value.IsSome(t.Sort) and t.Sort.Column == t.Columns[j] 2 * cell.Width else 0 end)
    wide = list.Max(chars * cell.Width, head) + 2 * cell.Width
    if value.Len(out) > 0 and x + wide > width
      return out
    end
    out = list.Append({Column: j, X: x, Width: wide}, out)
    x = x + wide
  end
  out
end

(** The width of the header of column j in the strong font: as the block measured it once, or the look measures it. *)
headWidth(j, t, look) = if j <= value.Len(dict.GetOr("Heads", [], t)) t.Heads[j] else look.Width(t.Columns[j], "strong") end

defn NoteWords(t)
  (** What the line under a table says: its rows, those it shows when it scrolls, those that hold the words of its filter, and its sort; or the filter
      being typed.

        NoteWords({Count: 1000, Total: 1000, Top: 21, Sort: {Column: "x", Descending: true}, Filter: "", Draft: missing}) --> "rows 21–40 of 1000 · by x, decreasing" *)
  if value.IsSome(t.Draft)
    return "filter: $(t.Draft)▏"
  end
  rows = if t.Count > TableRows() "rows $(t.Top)–$(list.Min(t.Count, t.Top + TableRows() - 1)) of $(t.Count)" else "$(t.Count) rows" end
  held = if t.Filter == "" rows else "$rows holding \"$(t.Filter)\", of $(t.Total)" end
  if value.IsMissing(t.Sort) held else "$held · by $(t.Sort.Column), $(if t.Sort.Descending "decreasing" else "increasing" end)" end
end

defn TableItems(t, focused, width, top, cell, th, look)
  (** What draws a table top pixels down its block: its paper, its header in the strong font, the sorted column marked ↑ or ↓, each row shown in the code
      font, a number on the right of its column, its decimal point under those of the others, a text on the left, a row not yet fetched blank; the row
      chosen in reverse, the cell of the cursor in a box of the accent color while the table has the keys, and the table in a ring of it; its frame and
      the rule under its header in ink, the lines between rows and columns in the color of lines; and the line under it.

        value.Len(TableItems({Columns: ["a"], Rows: [["1"]], First: 1, Positions: [1], Count: 1, Total: 1, Top: 1, Row: 1, Column: 1, Left: 1, Sort: missing, Filter: "", Draft: missing, Selected: missing, Widths: [{Whole: 1, Fraction: 0, Text: 0}], Wholes: [[1]], Numeric: [true]}, false, 800, 0, {Width: 8, Height: 19}, {Ink: 1, Line: 2, Muted: 3, Accent: 4, Code: 5, Faint: 6}, {Width: (w, f) -> 8 * value.Len(w)})) --> 9 *)
  cols = TableLayout(t, width, cell, look)
  h = shownRows(t)
  ch = cell.Height
  left = 2 * cell.Width
  right = if value.Len(cols) == 0 left + 4 * cell.Width else list.Last(cols).X + list.Last(cols).Width end
  bottom = top + (h + 1) * ch
  out = [{Kind: "rect", X: left, Y: top, Width: right - left, Height: bottom - top, Color: th.Code}]
  for c in cols
    j = c.Column
    name = t.Columns[j]
    sorted = value.IsSome(t.Sort) and t.Sort.Column == name
    arrow = if sorted 2 * cell.Width else 0 end
    wide = headWidth(j, t, look)
    x = if t.Numeric[j] c.X + c.Width - cell.Width - arrow - wide else c.X + cell.Width end
    out = list.Append({Kind: "text", X: x, Y: top, Text: name, Color: th.Ink, Font: "strong"}, out)
    if sorted
      out = list.Append({Kind: "text", X: x + wide + math.Div(cell.Width, 2), Y: top, Text: if t.Sort.Descending "↓" else "↑" end, Color: th.Ink, Font: "code"}, out)
    end
  end
  for k in 1..h
    q = t.Top + k - 1
    y = top + k * ch
    row = rowAt(q, t)
    wholes = if value.IsMissing(row) [] else t.Wholes[q - t.First + 1] end
    lit = value.IsSome(t.Selected) and t.Selected == q
    if lit
      out = list.Append({Kind: "rect", X: left, Y: y, Width: right - left, Height: ch, Color: th.Ink}, out)
    end
    for c in cols
      j = c.Column
      words = if value.IsMissing(row) or j > value.Len(row) "" else row[j] end
      w = t.Widths[j]
      whole = if j <= value.Len(wholes) wholes[j] else -1 end
      x = if whole >= 0 c.X + c.Width - cell.Width - (w.Fraction + whole) * cell.Width else c.X + cell.Width end
      if words != ""
        out = list.Append({Kind: "text", X: x, Y: y, Text: words, Color: if lit th.Code else th.Ink end, Font: "code"}, out)
      end
      if focused and q == t.Row and j == t.Column
        out = list.Concat(out, edged(c.X + 1, y + 1, c.Width - 1, ch - 1, th.Accent))
        out = list.Concat(out, edged(c.X + 2, y + 2, c.Width - 3, ch - 3, th.Accent))
      end
    end
  end
  (* The lines: between the rows and the columns in the color of lines, then the frame and the rule under the header in ink, over them. *)
  for k in 2..h
    out = list.Append({Kind: "rect", X: left, Y: top + k * ch, Width: right - left, Height: 1, Color: th.Line}, out)
  end
  for c in list.Skip(1, cols)
    out = list.Append({Kind: "rect", X: c.X, Y: top, Width: 1, Height: bottom - top, Color: th.Line}, out)
  end
  out = list.Concat(out, edged(left, top, right - left + 1, bottom - top + 1, th.Ink))
  out = list.Append({Kind: "rect", X: left, Y: top + ch, Width: right - left, Height: 1, Color: th.Ink}, out)
  more = if value.Len(cols) > 0 and (t.Left > 1 or list.Last(cols).Column < value.Len(t.Columns)) " · columns $(t.Left)–$(list.Last(cols).Column) of $(value.Len(t.Columns))" else "" end
  out = list.Append({Kind: "text", X: left, Y: bottom + 1, Text: "$(NoteWords(t))$more", Color: if value.IsSome(t.Draft) th.Ink else th.Faint end, Font: "code"}, out)
  if focused
    out = list.Concat(out, edged(left - 3, top - 3, right - left + 7, bottom - top + 7, th.Accent))
    out = list.Concat(out, edged(left - 2, top - 2, right - left + 5, bottom - top + 5, th.Accent))
  end
  out
end

(* -- The table of a block, found and drawn again. *)

(** The block of buffer k that shows the table of a key, or missing. *)
tableBlock(k, key, state) = if k < 1 or k > value.Len(state.Buffers) missing else list.FindFirst(x -> value.IsSome(dict.GetOr("Table", missing, x)) and value.Equal(x.Table.Key, key), text.BlocksOf(state.Buffers[k])) end

(** Does the table of a block in buffer k have the keys? *)
tableFocused(k, table, state) = value.IsSome(table) and value.IsSome(commands.FocusOf(state)) and value.Equal(dict.GetOr("Table", missing, commands.FocusOf(state)), table.Key) and dict.GetOr("Buffer", 0, commands.FocusOf(state)) == k

defn withTable(k, t, state)
  (** The state with the table of a key in buffer k drawn again as t, its lines as they were. *)
  x = tableBlock(k, t.Key, state)
  if value.IsMissing(x) state else rebuilt(k, x, x.Graph, state, table = t) end
end

defn scrolledTo(t, q)
  (** The table with its first row shown moved so that the row at place q shows. *)
  out = t
  h = shownRows(t)
  if q < t.Top
    out.Top = q
  else if q > t.Top + h - 1
    out.Top = q - h + 1
  end
  out.Top = list.Max(1, list.Min(out.Top, t.Count - h + 1))
  out
end

defn wantsRows(t)
  (** Must the table ask its session for rows: the rows it shows aren't all fetched, or, once it scrolled, are within 10 rows of the end of those
      fetched, or a place is asked for a position? Never one that has no key, and never at its first screen, which the run gave: a table that is not
      scrolled asks nothing. *)
  if t.Fixed
    return false
  end
  if t.Stale or value.IsSome(t.Find)
    return true
  end
  last = list.Min(t.Count, t.Top + TableRows() - 1)
  have = t.First + value.Len(t.Rows) - 1
  t.Count > 0 and (t.Top < t.First or last > have or (t.Top > 1 and have < t.Count and last > have - 10) or (t.First > 1 and t.Top < t.First + 10))
end

(* -- Rows asked of the session, one question at a time, as a scene: {Task, Buffer, Key, First, Sort, Filter, Find}. *)

defn paged(k, state)
  (** The state at a tick for buffer k: the rows a table asked, once they came, put in it, if it still sorts and filters as it asked; then the next table
      that needs rows asks them, unless the session is busy. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r)
    return state
  end
  p = dict.GetOr("Paging", missing, r)
  s = state
  if value.IsSome(p)
    got = fiber.Wait(p.Task, timeout = 0)
    if result.IsErr(got) and got.Error.Kind == "timeout"
      return state
    end
    r.Paging = missing
    s = withRun(k, r, state)
    answer = if result.IsOk(got) got.Value else got end
    x = tableBlock(p.Buffer, p.Key, s)
    if value.IsSome(x)
      t = landedRows(x.Table, p, answer)
      s = marking(p.Buffer, x.Cell, t, withTable(p.Buffer, t, s))
    end
  end
  asksRows(k, s)
end

defn landedRows(t, p, answer)
  (** The table once the rows it asked came: put in place when it still sorts and filters as it asked, with the place of the position it looked for; a
      session that can't give them, as one that ended or a table it no longer keeps, leaves it with what it has, and asks no more. *)
  out = t
  if result.IsErr(answer) or RowsFault(answer.Value, t) != missing
    out.Fixed = true
    out.Stale = false
    out.Find = missing
    return out
  end
  if not (value.Equal(t.Sort, p.Sort) and t.Filter == p.Filter)
    return out
  end
  a = answer.Value
  out.First = p.First
  out.Rows = a.Rows
  out.Positions = a.Positions
  out.Count = a.Count
  out.Total = a.Total
  out.Columns = if value.Len(a.Columns) == value.Len(t.Columns) t.Columns else a.Columns end
  out.Stale = false
  if value.IsSome(p.Find) and value.Equal(t.Find, p.Find)
    out.Find = missing
    found = dict.GetOr("Found", missing, a)
    if value.IsSome(found)
      out.Row = found
      out.Selected = found
      out = scrolledTo(out, found)
      out.Stale = not (found >= out.First and found < out.First + value.Len(out.Rows))
    else
      out.Selected = missing
    end
  end
  out.Top = list.Max(1, list.Min(out.Top, out.Count - shownRows(out) + 1))
  out.Row = list.Max(1, list.Min(out.Row, out.Count))
  measured(out)
end

defn RowsFault(a, t)
  (** What is wrong with rows that the session sent for a table, or missing: they are input, checked before anything is made of them. At most 1000 rows
      and 256 columns, each a text of at most 200 characters, as many as its columns, a position for each from 1 to its total, and counts that agree.

        RowsFault({Columns: ["a"], Rows: [["1"]], Count: 1, Total: 1, Positions: [1]}, {}) --> missing *)
  if not (value.IsDict(a) and value.IsArray(dict.GetOr("Columns", missing, a)) and value.IsArray(dict.GetOr("Rows", missing, a)) and value.IsArray(dict.GetOr("Positions", missing, a)))
    return "they are no rows"
  end
  n = value.Len(a.Columns)
  if n > 256 or value.Len(a.Rows) > 1000 or value.Len(a.Positions) != value.Len(a.Rows) or not list.All([value.IsText(c) and value.Len(c) <= 200 for c in a.Columns])
    return "they have more than 1000 rows or 256 columns, or not a position each"
  end
  if not (value.IsInt(dict.GetOr("Count", missing, a)) and value.IsInt(dict.GetOr("Total", missing, a)) and a.Count >= 0 and a.Count <= a.Total)
    return "their counts are no counts"
  end
  for row in a.Rows
    if not (value.IsArray(row) and value.Len(row) == n and list.All([value.IsText(x) and value.Len(x) <= 200 for x in row]))
      return "a row is not a text of at most 200 characters for each column"
    end
  end
  if not list.All([value.IsInt(q) and q >= 1 and q <= a.Total for q in a.Positions])
    return "a position is out of the table"
  end
  missing
end

defn asksRows(k, state)
  (** The state with the rows of the first table of buffer k that needs them asked of its session: around the rows it shows, 100 at a time, sorted and
      filtered as it is, unless a cell runs or another question waits. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Session) or value.IsSome(r.Task) or asking(r)
    return state
  end
  x = list.FindFirst(b -> value.IsSome(dict.GetOr("Table", missing, b)) and wantsRows(b.Table), text.BlocksOf(state.Buffers[k]))
  if value.IsMissing(x)
    return state
  end
  t = x.Table
  first = list.Max(1, list.Min(t.Top - 40, t.Count - pageRows + 1))
  one = r.Session
  key = t.Key
  sort = t.Sort
  filter = if t.Filter == "" missing else t.Filter end
  find = t.Find
  last = first + pageRows - 1
  task = if value.IsSome(find) fiber.Spawn(() -> nb.Rows(one, key, first, last, sort = sort, filter = filter, find = find)) else fiber.Spawn(() -> nb.Rows(one, key, first, last, sort = sort, filter = filter)) end
  r.Paging = {Task: task, Buffer: k, Key: key, First: first, Sort: sort, Filter: t.Filter, Find: find}
  (* The fiber writes its question now, so that the session reads the rows while this one draws. *)
  sys.Sleep(0)
  withRun(k, r, state)
end

(* -- The keys of a table: C-c e f, Tab or a click gives them; the arrows move the cursor a cell, the pages a screen, Home and End to the first row and
   the last; s sorts by the column of the cursor, increasing, then decreasing, then as given; / types a filter, its words in any column, Enter keeps it
   and Escape takes it back; M-w copies the cell, C-u M-w the row, apart by tabs, and C-c e c the whole table as CSV; Escape or C-g leaves. *)

(** The rows of the band while a table has the keys. *)
TableHints() = [{Key: "← → ↑ ↓", Name: "a cell", Group: false}, {Key: "PgUp PgDn", Name: "a screen", Group: false}, {Key: "s", Name: "sort by the column", Group: false},
  {Key: "/", Name: "filter", Group: false}, {Key: "M-w", Name: "copy the cell, C-u the row", Group: false}, {Key: "C-c e c", Name: "copy as CSV", Group: false},
  {Key: "C-g", Name: "leave", Group: false}]

(** The rows of the band while a filter is typed. *)
FilterHints() = [{Key: "Enter", Name: "keep the filter", Group: false}, {Key: "Escape", Name: "take it back", Group: false}]

(** The command that does f to the table that has the keys, with its state. *)
onTable(f) = state -> tableKeyed(f, state)

defn tableKeyed(f, state)
  (** The table that has the keys changed by f, a function of the table and the state that gives a table or a state; the prefix of C-u ends with the
      key after it. *)
  focus = commands.FocusOf(state)
  x = tableBlock(focus.Buffer, focus.Table, state)
  if value.IsMissing(x)
    return commands.Unfocused(state)
  end
  t = x.Table
  got = f(t, state)
  if dict.Has("Buffers", got)
    return got
  end
  out = got
  out.Prefix = got.Prefix and not t.Prefix
  tableChosen(focus.Buffer, out, state)
end

(** The keys of a table that has the keys. *)
TableKeys() = {"up": onTable((t, s) -> movedCell(-1, 0, t)), "down": onTable((t, s) -> movedCell(1, 0, t)), "left": onTable((t, s) -> movedCell(0, -1, t)),
  "right": onTable((t, s) -> movedCell(0, 1, t)), "pageup": onTable((t, s) -> screened(-TableRows(), t)), "pagedown": onTable((t, s) -> screened(TableRows(), t)),
  "home": onTable((t, s) -> movedCell(-t.Count, 0, t)), "end": onTable((t, s) -> movedCell(t.Count, 0, t)), "s": onTable((t, s) -> if t.Fixed unsorted(s) else sortedBy(t) end),
  "/": onTable((t, s) -> if t.Fixed unsorted(s) else typing(t, s) end), "M-w": onTable((t, s) -> copiedCell(t, s)), "C-u": onTable((t, s) -> dict.Put("Prefix", true, t)),
  "tab": st -> controlTabbed(1, st), "S-tab": st -> controlTabbed(-1, st), "C-g": commands.Unfocused, "escape": commands.Unfocused}

(** The keys of a table while its filter is typed: what is typed goes in it. *)
FilterKeys() = {"enter": onTable((t, s) -> filterKept(t, s)), "escape": onTable((t, s) -> filterTakenBack(t, s)), "C-g": onTable((t, s) -> filterTakenBack(t, s)),
  "backspace": onTable((t, s) -> filterErased(t))}

(** What a table that its session no longer gives says to s and /. *)
unsorted(state) = commands.Say("This table is no longer in the session, which keeps the last 64: C-c e e runs its cell again.", state)

defn screened(rows, t)
  (** The table moved a screen of rows, its cursor with it, where it was on the screen. *)
  out = t
  out.Top = list.Max(1, list.Min(t.Count - shownRows(t) + 1, t.Top + rows))
  movedCell(rows, 0, out)
end

defn movedCell(rows, columns, t)
  (** The table with its cursor moved some rows and some columns, within its cells, its row chosen and shown, and its columns shown from one that holds
      the cursor's. *)
  out = t
  out.Row = list.Max(1, list.Min(t.Count, t.Row + rows))
  out.Column = list.Max(1, list.Min(value.Len(t.Columns), t.Column + columns))
  out.Selected = if t.Count == 0 missing else out.Row end
  if out.Column < out.Left
    out.Left = out.Column
  end
  scrolledTo(out, out.Row)
end

defn sortedBy(t)
  (** The table sorted by the column of its cursor: increasing, again decreasing, again as given; its chosen row looked for in the new order. *)
  out = t
  name = t.Columns[t.Column]
  out.Sort = if value.IsMissing(t.Sort) or t.Sort.Column != name {Column: name, Descending: false} else if not t.Sort.Descending {Column: name, Descending: true} else missing end
  reordered(out, t)
end

defn reordered(out, t)
  (** A table whose sort or filter changed: its rows asked again, and the place of its chosen row looked for, by its position, or the first row shown. *)
  o = out
  o.Stale = true
  o.Rows = []
  o.Positions = []
  o.First = 1
  chosen = if value.IsSome(t.Selected) positionAt(t.Selected, t) else missing end
  o.Find = chosen
  if value.IsMissing(chosen)
    o.Top = 1
    o.Row = 1
    o.Selected = missing
  end
  o
end

defn typing(t, state)
  (** The state with the filter of the table that has the keys being typed: what is typed goes in it, Enter keeps it, Escape takes it back. *)
  out = t
  out.Draft = t.Filter
  f = commands.FocusOf(state)
  f.Keys = FilterKeys()
  f.Hints = FilterHints()
  f.Typed = (words, st) -> onTable((tt, ss) -> filterTyped(words, tt))(st)
  f.Before = t.Filter
  s = state
  s.Focus = f
  tableChosen(f.Buffer, out, s)
end

defn filterTyped(words, t)
  (** The table with words typed at the end of its filter, which applies at once: the session filters it, the latest words winning. *)
  out = t
  out.Draft = "$(t.Draft)$(str.Replace("\n", " ", str.Replace("\t", " ", words)))"
  filtered(out, t)
end

defn filterErased(t)
  (** The table with the last character of its filter erased. *)
  out = t
  cs = str.Chars(t.Draft)
  out.Draft = str.Join("", list.Take(list.Max(0, value.Len(cs) - 1), cs))
  filtered(out, t)
end

defn filtered(out, t)
  (** A table whose filter is the one typed. *)
  o = out
  o.Filter = str.Trim(o.Draft)
  if o.Filter == t.Filter o else reordered(o, t) end
end

defn filterKept(t, state)
  (** Enter in a filter: it stays, and the keys move in the table again. *)
  out = t
  out.Draft = missing
  tableFocusedOn(commands.FocusOf(state).Buffer, out, state)
end

defn filterTakenBack(t, state)
  (** Escape in a filter: the filter before it was typed comes back, and the keys move in the table again. *)
  out = t
  out.Draft = missing
  before = dict.GetOr("Before", "", commands.FocusOf(state))
  out.Filter = before
  out = if before == t.Filter out else reordered(out, t) end
  tableFocusedOn(commands.FocusOf(state).Buffer, out, state)
end

defn copiedCell(t, state)
  (** M-w: the text of the cell of the cursor in the clipboard; after C-u, its row, its cells apart by tabs. *)
  row = rowAt(t.Row, t)
  if value.IsMissing(row)
    return commands.Say("This row isn't here yet.", state)
  end
  whole = t.Prefix
  t.Prefix = false
  if whole
    return commands.Say("Copied row $(t.Row).", commands.ToClipboard(str.Join("\t", [str.Replace("\n", " ", str.Replace("\t", " ", x)) for x in row]), withTable(commands.FocusOf(state).Buffer, t, state)))
  end
  commands.Say("Copied the cell.", commands.ToClipboard(if t.Column <= value.Len(row) row[t.Column] else "" end, withTable(commands.FocusOf(state).Buffer, t, state)))
end

defn tableFocusedOn(k, t, state)
  (** The state with the keys on a table of buffer k, drawn with its ring, and the control that had them without. *)
  s = commands.Unfocused(state)
  r = runOf(s.Buffers[k])
  if value.IsSome(r)
    r.LastTable = t.Key
    s = withRun(k, r, s)
  end
  s.Focus = {Keys: TableKeys(), Hints: TableHints(), Leave: st -> tableDrawn(k, t.Key, st), Buffer: k, Table: t.Key}
  withTable(k, t, s)
end

defn tableDrawn(k, key, state)
  (** The state with the block of the table of a key in buffer k drawn again, with its ring or without; a filter being typed is kept. *)
  x = tableBlock(k, key, state)
  if value.IsMissing(x)
    return state
  end
  t = x.Table
  t.Draft = missing
  withTable(k, t, state)
end

defn tableChosen(k, t, state)
  (** The state with a table of buffer k as t, its columns shown from one that holds the cursor's, and the row chosen marked on the graphs of its cell. *)
  x = tableBlock(k, t.Key, state)
  if value.IsMissing(x)
    return state
  end
  out = t
  look = dict.GetOr("Look", missing, state)
  if value.IsSome(look)
    width = view.LayoutOf(state).Code.Width - view.Gutter - 8
    while out.Left < out.Column and list.All([c.Column != out.Column for c in TableLayout(out, width, state.Cell, look)])
      out.Left = out.Left + 1
    end
  end
  marking(k, x.Cell, out, withTable(k, out, state))
end

(* -- The mouse and the wheel. *)

defn tableMouse(key, action, point, state)
  (** A press of the mouse on a table: it gives the table the keys, and on a row puts the cursor in the cell under the point and chooses the row; on the
      header it sorts by the column under the point, as s does. Moves and releases do nothing. *)
  k = state.Current
  x = tableBlock(k, key, state)
  if action != "down" or value.IsMissing(x)
    return state
  end
  t = x.Table
  top = dict.GetOr("Under", 0, x)
  width = point.Width
  cols = if value.IsSome(dict.GetOr("Look", missing, state)) TableLayout(t, width, state.Cell, state.Look) else [] end
  hit = list.FindFirst(c -> point.X >= c.X and point.X < c.X + c.Width, cols)
  row = math.Div(point.Y - top, state.Cell.Height)
  s = if tableFocused(k, t, state) state else tableFocusedOn(k, t, state) end
  if value.IsMissing(hit) or row < 0 or row > shownRows(t)
    return s
  end
  t = tableBlock(k, key, s).Table
  t.Column = hit.Column
  if row == 0
    return tableChosen(k, sortedBy(t), s)
  end
  tableChosen(k, movedCell(t.Top + row - 1 - t.Row, 0, t), s)
end

defn tableWheel(key, amount, state)
  (** The wheel over a table: it scrolls three rows a notch, as the screen does, and gives missing at its first or its last row, where the wheel moves the
      screen. *)
  k = state.Current
  x = tableBlock(k, key, state)
  if value.IsMissing(x)
    return missing
  end
  t = x.Table
  rows = math.Div(math.Round(0.0 - amount * 3.0), 1)
  top = list.Max(1, list.Min(t.Count - shownRows(t) + 1, t.Top + rows))
  if top == t.Top
    return if (rows < 0 and t.Top > 1) or (rows > 0 and t.Top < t.Count - shownRows(t) + 1) state else missing end
  end
  t.Top = top
  withTable(k, t, state)
end

(* -- A row and its point: the graphs of the cell of a table, of as many points as its rows, show the point of the row chosen, which the session draws,
   cells.Scene with the mark, one question at a time; a click on such a point chooses its row. *)

(** The graphs of cell i of buffer k that can show a mark: neither an animation nor a 3D graph. *)
markable(k, i, state) = [x for x in partsOf(k, i, state) if value.IsSome(dict.GetOr("Graph", missing, x)) and not isAnimation(x.Graph) and not isTurning(x.Graph)]

defn marking(k, i, t, state)
  (** The state with the row chosen in a table of cell i of buffer k wanted on the graphs of the cell, by its position and the rows of the table: each
      asks its scene with the mark, unless it has shown that it holds no layer of as many points. *)
  p = if value.IsSome(t.Selected) positionAt(t.Selected, t) else missing end
  if value.IsSome(t.Selected) and value.IsMissing(p)
    (* The row chosen isn't fetched yet: its mark waits for it. *)
    return state
  end
  want = if value.IsMissing(p) missing else [p, t.Total] end
  s = state
  for x in markable(k, i, state)
    g = x.Graph
    if not (value.IsSome(want) and want[2] in dict.GetOr("Unlinked", [], g)) and not value.Equal(dict.GetOr("Wants", missing, g), want)
      g.Wants = want
      s = rebuilt(k, x, g, s)
    end
  end
  s
end

defn marked(k, state)
  (** The state at a tick for buffer k: the scene that a 2D graph asked, once it came, drawn in its graph, with the places of its points and, when it
      asked them, their values and its axes; or, when its mark marks nothing, the graph left as it was and known to hold no layer of as many points; then
      the next graph whose view differs from the one it wants asks its scene, unless the session is busy. A scene that asked only the points of what the
      graph shows keeps the shapes it has, which sdl drew. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r)
    return state
  end
  m = dict.GetOr("Marking", missing, r)
  s = state
  if value.IsSome(m)
    got = fiber.Wait(m.Task, timeout = 0)
    if result.IsErr(got) and got.Error.Kind == "timeout"
      return state
    end
    r.Marking = missing
    s = withRun(k, r, state)
    scene = if result.IsOk(got) got.Value else got end
    x = list.FindFirst(b -> dict.GetOr("Cell", 0, b) == m.Cell and value.IsSome(dict.GetOr("Graph", missing, b)) and value.Equal(b.Graph.Key, m.Key), text.BlocksOf(s.Buffers[k]))
    if value.IsSome(x)
      s = viewLanded(k, x, m, scene, s)
    end
  end
  asksView(k, s)
end

defn viewLanded(k, x, m, scene, state)
  (** The state with the scene that the 2D graph of block x asked, m, put in it: see marked. *)
  g = x.Graph
  points = dict.GetOr("Points", false, m)
  zoom = dict.GetOr("Zoom", missing, m)
  why = if result.IsErr(scene) scene.Error.Message else SceneFault(scene.Value) end
  if value.IsMissing(why) and (value.IsSome(m.Mark) or points)
    why = PointsFault(dict.GetOr("Points", [], scene.Value), full = points)
  end
  if value.IsMissing(why) and points and dict.Has("Axes", scene.Value)
    (* A grid of graphs, or a graph std/plot gives no axes, has no values to show: no fault. *)
    why = AxesFault(scene.Value.Axes)
  end
  linked = value.IsMissing(why) and (value.IsMissing(m.Mark) or (if points list.Any([dict.GetOr("Count", -1, p) == m.Mark[2] for p in scene.Value.Points]) else value.Len(dict.GetOr("Points", [], scene.Value)) > 0 end))
  if value.IsSome(why) or not linked
    (* A scene that can't come, or no layer of as many points: the graph stays as it is, and isn't asked that mark again, nor these ranges or points
       when the scene can't come. *)
    if value.IsSome(m.Mark) and not value.Equal(m.Mark, dict.GetOr("Mark", missing, g))
      g.Unlinked = list.Append(m.Mark[2], dict.GetOr("Unlinked", [], g))
    end
    g.Wants = dict.GetOr("Mark", missing, g)
    s = state
    if value.IsSome(why)
      g.Zoom = dict.GetOr("Shown", missing, g)
      g.Pointed = dict.GetOr("Pointed", false, g) or points
      s = if value.IsSome(zoom) or points commands.Say("This graph shows no values: its scene can't be drawn, as $why.", state) else state end
    end
    return rebuilt(k, x, g, s)
  end
  same = value.Equal(m.Mark, dict.GetOr("Mark", missing, g)) and value.Equal(zoom, dict.GetOr("Shown", missing, g)) and m.Width == dict.GetOr("Asked", m.Width, g)
  (* Only the points of what the graph shows: its shapes stay, so that sdl draws them from what it made. *)
  ng = if same g else dict.Merge(g, Prepared(scene.Value, commands.Home(state))) end
  ng.Mark = m.Mark
  ng.Shown = zoom
  ng.Asked = m.Width
  ng.Points = dict.GetOr("Points", [], scene.Value)
  ng = if points pointed(ng, scene.Value) else dict.Put("Near", NearOf(ng.Points), ng) end
  if not same
    ng.Hover = missing
  end
  rebuilt(k, x, ng, state)
end

defn pointed(g, scene)
  (** The graph with the points and the axes of a scene asked with points = true: in buckets, for the point under the mouse, and its own ranges, those of
      the first scene, which no zoom asked. *)
  out = g
  out.Pointed = true
  out.Points = dict.GetOr("Points", [], scene)
  out.Axes = dict.GetOr("Axes", missing, scene)
  out.Near = NearOf(out.Points)
  if value.IsSome(out.Axes) and value.IsMissing(dict.GetOr("Own", missing, g)) and value.IsMissing(dict.GetOr("Shown", missing, out))
    out.Own = limitsIn(out.Axes)
  end
  out
end

(** The most points of all the layers of a graph that Cemacs keeps. *)
mostPoints = 1000000

defn PointsFault(points, full = false)
  (** What is wrong with the places of the points of a marked scene, or missing: they are input. At most 64 layers, each {At, Xs, Ys}, at most 100,000
      positions from 1, a place on the screen for each, and 1,000,000 points in all; with full, as for the mouse, each layer has too its number, its
      kind, its label, a text of at most 200 characters or missing, its count of points, and Values, {X, Y}, a finite number for each of its points.

        PointsFault([{Layer: 1, Kind: "line", At: [1, 2], Xs: [10.0, 20.0], Ys: [5.0, 6.0]}]) --> missing
        PointsFault([{At: [1, 2], Xs: [10.0], Ys: [5.0, 6.0]}]) --> "a layer has not a place on the screen for each of its points"
        PointsFault([{Layer: 1, Kind: "line", Label: missing, Count: 2, At: [1, 2], Xs: [10.0, 20.0], Ys: [5.0, 6.0], Values: {X: [1.0, 2.0], Y: [3.0, 1.0 / 0.0]}}], full = true) --> "a layer has not a finite value for each of its points" *)
  if not value.IsArray(points) or value.Len(points) > 64
    return "its points are no list of layers"
  end
  total = 0
  for p in points
    at = if value.IsDict(p) dict.GetOr("At", missing, p) else missing end
    if not (value.IsArray(at) and value.Len(at) <= 100000 and (value.Len(at) == 0 or (col.Kind(at) == "int" and list.Min(at) >= 1) or list.All([value.IsInt(q) and q >= 1 for q in at])))
      return "a layer has no positions of its points"
    end
    n = value.Len(at)
    if n > 0 and not (places(dict.GetOr("Xs", missing, p), n) and places(dict.GetOr("Ys", missing, p), n))
      return "a layer has not a place on the screen for each of its points"
    end
    total = total + n
    if total > mostPoints
      return "its points are more than $mostPoints"
    end
    if full
      label = dict.GetOr("Label", missing, p)
      if not (value.IsInt(dict.GetOr("Layer", missing, p)) and dict.GetOr("Kind", missing, p) in ["line", "points", "text"] and (value.IsMissing(label) or (value.IsText(label) and value.Len(label) <= 200)))
        return "a layer has no number, kind or label"
      end
      count = dict.GetOr("Count", missing, p)
      if not (value.IsInt(count) and count >= 0 and count <= 1000000000 and (n == 0 or list.Max(at) <= count))
        return "a layer has no count of its points"
      end
      vs = dict.GetOr("Values", missing, p)
      if not (value.IsDict(vs) and finite(dict.GetOr("X", missing, vs), n) and finite(dict.GetOr("Y", missing, vs), n))
        return "a layer has not a finite value for each of its points"
      end
    end
  end
  missing
end

defn finite(xs, n)
  (** Is a value n finite numbers: checked by whole arrays when JSON gave numbers alone, where x - x is 0 for each finite x and NaN for any other. *)
  if not value.IsArray(xs) or value.Len(xs) != n
    return false
  end
  if n == 0
    return true
  end
  if col.Kind(xs) in ["float", "int"]
    return list.Sum(xs - xs) == 0
  end
  list.All([value.IsNumber(x) and x - x == 0 for x in xs])
end

defn AxesFault(axes)
  (** What is wrong with the axes of a scene asked with its points, or missing: they are input. X and Y, or for a polar graph Center and Y, each axis
      {Scale, Low, High, From, To}: a scale std/plot gives, finite ranges that aren't empty, above 0 on a log axis, and pixels from -1,000,000 to
      1,000,000.

        AxesFault({X: {Scale: "linear", Low: 0.0, High: 1.0, From: 10.0, To: 300.0}, Y: {Scale: "log", Low: 1.0, High: 100.0, From: 200.0, To: 10.0}}) --> missing
        AxesFault({Center: [100.0, 100.0], Y: {Scale: "linear", Low: 90.0, High: 0.0, From: 0.0, To: 0.0}}) --> "an axis is no scale, range and pixels" *)
  if not value.IsDict(axes)
    return "its axes are no axes"
  end
  polar = dict.Has("Center", axes)
  if polar and not places(axes.Center, 2)
    return "its center is no place"
  end
  for a in if polar [dict.GetOr("Y", missing, axes)] else [dict.GetOr("X", missing, axes), dict.GetOr("Y", missing, axes)] end
    if not (value.IsDict(a) and dict.GetOr("Scale", missing, a) in ["linear", "log", "names"] and finite([dict.GetOr("Low", missing, a), dict.GetOr("High", missing, a)], 2) and places([dict.GetOr("From", missing, a), dict.GetOr("To", missing, a)], 2) and a.Low != a.High and a.From != a.To and (a.Scale != "log" or (a.Low > 0 and a.High > 0)))
      return "an axis is no scale, range and pixels"
    end
  end
  missing
end

defn asksView(k, state)
  (** The state with the scene of the first 2D graph of buffer k that wants another view than the one it shows asked of the session: its mark, its
      ranges and, once it shows values, its points, at the width it was asked at; unless a cell runs or another question waits. One question at a time,
      the latest view winning: a zoom of many notches asks once more when its scene comes. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Session) or value.IsSome(r.Task) or asking(r)
    return state
  end
  x = list.FindFirst(b -> dict.GetOr("Cell", 0, b) > 0 and isFlat(dict.GetOr("Graph", missing, b)) and wantsView(b.Graph), text.BlocksOf(state.Buffers[k]))
  if value.IsMissing(x)
    return state
  end
  one = r.Session
  g = x.Graph
  key = g.Key
  mark = if dict.Has("Wants", g) g.Wants else dict.GetOr("Mark", missing, g) end
  zoom = dict.GetOr("Zoom", missing, g)
  points = dict.GetOr("Live", false, g)
  xlim = if value.IsMissing(zoom) missing else dict.GetOr("X", missing, zoom) end
  ylim = if value.IsMissing(zoom) missing else dict.GetOr("Y", missing, zoom) end
  width = dict.GetOr("Asked", g.Scene.Width, g)
  task = fiber.Spawn(() -> nb.Scene(one, key, width, mark = mark, xlim = xlim, ylim = ylim, points = points))
  r.Marking = {Task: task, Cell: x.Cell, Key: key, Mark: mark, Zoom: zoom, Points: points, Width: width}
  sys.Sleep(0)
  withRun(k, r, state)
end

(** Does a 2D graph want another view than the one it shows: another mark, other ranges, or its points? *)
wantsView(g) = (dict.Has("Wants", g) and not value.Equal(g.Wants, dict.GetOr("Mark", missing, g))) or (dict.GetOr("Live", false, g) and not dict.GetOr("Pointed", false, g)) or
  not value.Equal(dict.GetOr("Zoom", missing, g), dict.GetOr("Shown", missing, g))

defn rowOfPoint(k, i, count, at, state)
  (** The state with the row of a point chosen, at position at of a layer of count points: in the table of cell i of buffer k of as many rows, which
      shows it, if there is one. *)
  table = list.FindFirst(b -> value.IsSome(dict.GetOr("Table", missing, b)) and b.Table.Total == count, partsOf(k, i, state))
  if value.IsMissing(table)
    return state
  end
  t = table.Table
  if value.IsMissing(t.Sort) and t.Filter == ""
    t = movedCell(at - t.Row, 0, t)
  else
    t.Find = at
  end
  tableChosen(k, t, state)
end

(* ---- 2D graphs with the mouse and the keys. A graph that is neither an animation nor a 3D graph shows the values of its points: once the mouse comes
   over it or it has the keys, its scene is asked again once with points = true, which gives the places and the values of the points of its lines, points
   and texts and how its axes meet the pixels, and its shapes stay those drawn; its points are kept in buckets of 32 by 32 pixels, so that the one nearest
   the mouse is found among few, with no question. The mouse over it shows the point nearest, within 12 pixels: a thin cross and its values in a box; a
   click pins that box, or unpins it, and gives it the keys; then the arrows go from point to point, Space pins, the wheel zooms about the mouse, a drag
   moves the view, 0 goes back to its own ranges, M-w copies the values and C-c e s saves it as SVG. Without the keys, the wheel moves the screen, as
   before. Its state is in its graph, {Live, Pointed, Points, Axes, Near, Own, Hover, Pins, Spot, Zoom, Shown, Press}: whether its points are wanted and
   came, its points, its axes and their buckets, its own ranges, the point under the mouse, the points pinned, the point of the keys, the ranges wanted
   and those shown, missing for its own, and a press of the mouse on it. *)

(** Is a graph of a block one of 2D, which shows the values of its points: neither an animation nor a 3D graph? *)
isFlat(graph) = value.IsSome(graph) and not isAnimation(graph) and not isTurning(graph)

(** The block of a cell of buffer k that shows the 2D graph of a key, or missing. *)
flatOf(k, key, state) = if k < 1 or k > value.Len(state.Buffers) missing else list.FindFirst(x -> dict.GetOr("Cell", 0, x) > 0 and isFlat(dict.GetOr("Graph", missing, x)) and value.Equal(x.Graph.Key, key), text.BlocksOf(state.Buffers[k])) end

(** The most pixels from the mouse to the point it shows. *)
pointReach = 12.0

(** The side of a bucket of points, in pixels. *)
bucketSide = 32.0

(** The most points pinned on a graph: past them, the first pinned goes. *)
MostPins() = 50

defn NearOf(points)
  (** The points of a graph in buckets of 32 by 32 pixels, for the one nearest the mouse: {X, Y, Layer, J, Buckets}, the places of all, the layer of each
      among the Points and its place in it, and for each bucket "column:row" the points in it, by their place in X.

        NearOf([{At: [1, 2], Xs: [10.0, 50.0], Ys: [10.0, 10.0]}]).Buckets["1:0"] --> [2] *)
  n = value.Len(points)
  xs = list.Flatten([p.Xs for p in points])
  ys = list.Flatten([p.Ys for p in points])
  if value.Len(xs) == 0
    return {X: [], Y: [], Layer: [], J: [], Buckets: {}}
  end
  bx = math.Floor(xs / bucketSide)
  by = math.Floor(ys / bucketSide)
  groups = col.Groups([bx * 4194304.0 + by])
  parts = col.Split(groups, [j for j in 1..value.Len(xs)])
  buckets = {}
  for b in 1..groups.Count
    f = groups.Firsts[b]
    buckets["$(math.Div(bx[f], 1)):$(math.Div(by[f], 1))"] = parts[b]
  end
  {X: xs * 1.0, Y: ys * 1.0, Layer: list.Flatten([list.Fill(i, value.Len(points[i].At)) for i in 1..n]), J: list.Flatten([[j for j in 1..value.Len(points[i].At)] for i in 1..n if value.Len(points[i].At) > 0]), Buckets: buckets}
end

defn NearestIn(near, x, y)
  (** The point nearest a place, x and y pixels from the top left of a graph, within 12 pixels, {Layer, J}, or missing: only the points of the buckets
      that the circle of 12 pixels about it touches are measured, at most four.

        NearestIn(NearOf([{At: [1, 2], Xs: [10.0, 50.0], Ys: [10.0, 10.0]}]), 45, 12) --> {Layer: 1, J: 2} *)
  cands = []
  for a in math.Div(math.Floor((x - pointReach) / bucketSide), 1)..math.Div(math.Floor((x + pointReach) / bucketSide), 1)
    for b in math.Div(math.Floor((y - pointReach) / bucketSide), 1)..math.Div(math.Floor((y + pointReach) / bucketSide), 1)
      cands = list.Concat(cands, dict.GetOr("$a:$b", [], near.Buckets))
    end
  end
  if value.Len(cands) == 0
    return missing
  end
  dx = col.Pick(cands, near.X) - x
  dy = col.Pick(cands, near.Y) - y
  d = dx * dx + dy * dy
  least = list.Min(d)
  if least > pointReach * pointReach
    return missing
  end
  f = cands[col.Positions(d == least)[1]]
  {Layer: near.Layer[f], J: near.J[f]}
end

(** The point of a graph under a place of its block, {Layer, J}, or missing: none before its points came. *)
nearestAt(g, x, y) = if value.IsMissing(dict.GetOr("Near", missing, g)) missing else NearestIn(g.Near, x, y) end

(** A point of a graph as it is pinned, from layer i of its Points and its place j there: {Layer, At, Count, Label, X, Y}, the layer of the graph, its
    position in it, its count of points, its label, and its values. *)
pointOf(g, i, j) = (p -> {Layer: p.Layer, At: p.At[j], Count: p.Count, Label: dict.GetOr("Label", missing, p), X: p.Values.X[j], Y: p.Values.Y[j]})(g.Points[i])

defn NumberWords(x)
  (** A value of a point as its box writes it, as std/plot writes the box of a mark: at most 6 significant digits, an integer as it is.

        NumberWords(128.27000001) --> "128.27"
        NumberWords(8.0) --> "8"
        NumberWords(-0.8333333) --> "-0.833333" *)
  if value.IsInt(x) or not (x - x == 0.0)
    return "$x"
  end
  big = math.Abs(x)
  if big != 0.0 and (big >= 1e9 or big < 1e-4)
    return "$x"
  end
  d = if big == 0.0 0 else list.Max(0, list.Min(10, 5 - math.Div(math.Floor(math.Log(big) / math.Log(10.0)), 1))) end
  t = str.Decimals(d, x)
  while d > 0 and str.EndsWith("0", t)
    t = str.ByteSlice(1, str.ByteLength(t) - 1, t)
  end
  if str.EndsWith(".", t) str.ByteSlice(1, str.ByteLength(t) - 1, t) else t end
end

(** The words of the box of a point: its values, after its label when the graph has more than one layer of points. *)
pointWords(g, q) = "$(if value.Len(dict.GetOr("Points", [], g)) > 1 and value.IsText(q.Label) "$(fitted(q.Label, 30 * 8, {Width: 8})): " else "" end)x = $(NumberWords(q.X))  y = $(NumberWords(q.Y))"

(** The scale of a value on an axis of a scene: its logarithm on a log axis. *)
scaled(a, v) = if a.Scale == "log" math.Log(v) / math.Log(10.0) else v * 1.0 end

(** A value on an axis from its place on the scale. *)
unscaled(a, t) = if a.Scale == "log" 10.0 ^ t else t end

(** The pixel of a value along an axis of a scene, from its range low to high. *)
pixelAlong(a, low, high, v) = a.From + (scaled(a, v) - scaled(a, low)) / (scaled(a, high) - scaled(a, low)) * (a.To - a.From)

defn placeOf(axes, x, y)
  (** The place of the values of a point in the pixels of a graph, [px, py], by its axes, or missing when it is outside the plot: on a log axis a value
      at 0 or below has none. *)
  if dict.Has("Center", axes)
    a = axes.Y
    r = a.From + (y - a.Low) / (a.High - a.Low) * (a.To - a.From)
    if not (r - r == 0.0) or r < -0.5 or r > a.To + 0.5
      return missing
    end
    t = x * math.Pi / 180.0
    return [axes.Center[1] + r * math.Sin(t), axes.Center[2] - r * math.Cos(t)]
  end
  if (axes.X.Scale == "log" and x <= 0) or (axes.Y.Scale == "log" and y <= 0)
    return missing
  end
  px = pixelAlong(axes.X, axes.X.Low, axes.X.High, x)
  py = pixelAlong(axes.Y, axes.Y.Low, axes.Y.High, y)
  inside = (v, a) -> v - v == 0.0 and v >= list.Min(a.From, a.To) - 0.5 and v <= list.Max(a.From, a.To) + 0.5
  if inside(px, axes.X) and inside(py, axes.Y) [px, py] else missing end
end

defn plotBox(axes, scene)
  (** The rectangle of the plot of a scene, [x, y, width, height] in its pixels, from its axes, or the whole scene without them. *)
  if value.IsMissing(axes)
    return [0.0, 0.0, scene.Width * 1.0, scene.Height * 1.0]
  end
  if dict.Has("Center", axes)
    return [axes.Center[1] - axes.Y.To, axes.Center[2] - axes.Y.To, 2.0 * axes.Y.To, 2.0 * axes.Y.To]
  end
  [list.Min(axes.X.From, axes.X.To), list.Min(axes.Y.From, axes.Y.To), math.Abs(axes.X.To - axes.X.From), math.Abs(axes.Y.To - axes.Y.From)]
end

defn shownPoints(g, focused)
  (** The points a 2D graph shows the values of, each {Q, Place, Keyed}, its point, its place in the pixels of the graph and whether the keys chose it:
      each point pinned, the point of the keys while it has them and the point under the mouse, once each, but the one that the mark of a row of a table
      rings, whose values the session drew. *)
  axes = dict.GetOr("Axes", missing, g)
  if value.IsMissing(axes) or not dict.GetOr("Pointed", false, g)
    return []
  end
  out = []
  seen = []
  spot = if focused dict.GetOr("Spot", missing, g) else missing end
  hover = dict.GetOr("Hover", missing, g)
  n = value.Len(g.Points)
  ones = list.Concat([{Q: q, Keyed: false} for q in dict.GetOr("Pins", [], g)],
    [{Q: pointOf(g, w.Layer, w.J), Keyed: w.Keyed} for w in [dict.Merge(spotted(g, spot), {Keyed: true}), dict.Merge(if value.IsSome(hover) hover else {} end, {Keyed: false})] if dict.Has("J", w) and w.Layer <= n and w.J <= value.Len(g.Points[w.Layer].At)])
  mark = dict.GetOr("Mark", missing, g)
  for one in ones
    q = one.Q
    id = [q.Layer, q.At]
    ringed = value.IsSome(mark) and q.Count == mark[2] and q.At == mark[1]
    if not (id in seen) and not ringed
      place = placeOf(axes, q.X, q.Y)
      if value.IsSome(place)
        out = list.Append({Q: q, Place: place, Keyed: one.Keyed}, out)
      end
    end
    (* The point of the keys that is pinned shows once, in the color of the keys. *)
    if one.Keyed and id in seen
      out = [if value.Equal([o.Q.Layer, o.Q.At], id) dict.Put("Keyed", true, o) else o end for o in out]
    end
    seen = list.Append(id, seen)
  end
  out
end

defn spotted(g, spot)
  (** The point of the keys of a graph, {Layer, J} in its Points, from its layer there and its position, or {} when it has none. *)
  if value.IsMissing(spot) or spot.Layer > value.Len(g.Points) or value.Len(g.Points[spot.Layer].At) == 0
    return {}
  end
  {Layer: spot.Layer, J: placeNear(g.Points[spot.Layer].At, spot.At)}
end

defn placeNear(ats, at)
  (** The place in increasing positions of the one nearest a position, by halves.

        placeNear([1, 4, 9], 5) --> 2 *)
  low = 1
  high = value.Len(ats)
  while high - low > 1
    mid = math.Div(low + high, 2)
    if ats[mid] <= at
      low = mid
    else
      high = mid
    end
  end
  if math.Abs(ats[high] - at) < math.Abs(ats[low] - at) high else low end
end

defn GraphOverlay(graph, focused, top, cell, th)
  (** What draws over a 2D graph, top pixels down its block, without changing the shapes of the graph, so that sdl draws it from what it made: at each
      point whose values it shows, see shownPoints, a thin cross, and its values in a box beside it, inside the plot, as std/plot draws the box of a mark,
      the text in the font of the graph at 12 pixels, a graph of texts alone; the cross and the box of the point of the keys in the accent color; and a
      ring in that color round the graph while it has the keys.

        value.Len(GraphOverlay({Scene: {Width: 300, Height: 200}}, true, 4, {Width: 8, Height: 19}, {Ink: 1, Code: 2, Accent: 3})) --> 8 *)
  left = 2 * cell.Width
  out = []
  texts = []
  box = plotBox(dict.GetOr("Axes", missing, graph), graph.Scene)
  for one in shownPoints(graph, focused)
    px = math.Div(math.Floor(one.Place[1]), 1)
    py = math.Div(math.Floor(one.Place[2]), 1)
    words = pointWords(graph, one.Q)
    (* The font of the graph is JetBrains Mono, whose characters are 0.6 em wide: 7.2 pixels at 12. *)
    wide = math.Div(math.Ceil(value.Len(words) * 7.2), 1) + 8
    high = 22
    bx = if px + 10 + wide <= box[1] + box[3] px + 10 else list.Max(math.Div(math.Floor(box[1]), 1), px - 10 - wide) end
    by = if py - 10 - high >= box[2] py - 10 - high else list.Min(math.Div(math.Floor(box[2] + box[4]), 1) - high, py + 10) end
    edge = if one.Keyed th.Accent else th.Ink end
    out = list.Concat(out, [{Kind: "rect", X: left + px - 6, Y: top + py, Width: 13, Height: 1, Color: edge}, {Kind: "rect", X: left + px, Y: top + py - 6, Width: 1, Height: 13, Color: edge},
      {Kind: "box", X: left + bx, Y: top + by, Width: wide, Height: high, Color: th.Code, Radius: 0, Alpha: 235}])
    out = list.Concat(out, edged(left + bx, top + by, wide, high, edge))
    texts = list.Append({Kind: "text", X: bx + 4.0, Y: by + 3.0 + 12.24, Text: words, Size: 12, Color: th.Ink, Anchor: "start", Angle: 0, Width: value.Len(words) * 7.2, Clip: missing}, texts)
  end
  if value.Len(texts) > 0
    out = list.Append({Kind: "graph", X: left, Y: top, Width: graph.Scene.Width, Height: graph.Scene.Height, Items: texts, Font: graph.Font, Fallback: dict.GetOr("Fallback", missing, graph)}, out)
  end
  if not focused
    return out
  end
  wide = graph.Scene.Width + 6
  high = graph.Scene.Height + 6
  list.Concat(out, list.Concat(edged(left - 3, top - 3, wide, high, th.Accent), edged(left - 2, top - 2, wide - 2, high - 2, th.Accent)))
end

(* -- The mouse. *)

defn graphHover(k, key, point, state)
  (** The mouse over the 2D graph of a key in buffer k, at a point of its block, or gone from it, missing: the point nearest, within 12 pixels, shows
      its cross and its values; the first time, the graph asks its points. A move that shows the same point changes nothing. *)
  x = flatOf(k, key, state)
  if value.IsMissing(x)
    return state
  end
  g = x.Graph
  if value.IsMissing(point)
    if value.IsMissing(dict.GetOr("Hover", missing, g))
      return state
    end
    g.Hover = missing
    return rebuilt(k, x, g, state)
  end
  if not dict.GetOr("Live", false, g)
    g.Live = true
    return asksView(k, rebuilt(k, x, g, state))
  end
  if not dict.GetOr("Pointed", false, g)
    return state
  end
  near = nearestAt(g, point.X - 2 * state.Cell.Width, point.Y - dict.GetOr("Under", 0, x))
  if value.Equal(near, dict.GetOr("Hover", missing, g))
    return state
  end
  g.Hover = near
  rebuilt(k, x, g, state)
end

defn graphMouse(k, key, action, point, state)
  (** A press, a move or a release of the mouse on the block of the 2D graph of a key in buffer k. A press on the graph gives it the keys; a release
      where it was pressed is a click: on a point, within 12 pixels, it pins its values, or unpins them, makes it the point of the keys and chooses its
      row in a table of the cell of as many rows. A drag moves the view, once the graph had the keys before the press, but a polar graph's. A press on
      the lines above the graph gives missing: it goes to the text. *)
  x = flatOf(k, key, state)
  if value.IsMissing(x)
    return if action == "down" missing else state end
  end
  g = x.Graph
  px = point.X - 2 * state.Cell.Width
  py = point.Y - dict.GetOr("Under", 0, x)
  if action == "down"
    if px < 0 or py < 0 or px >= g.Scene.Width or py >= g.Scene.Height
      return missing
    end
    had = graphFocused(k, g, state)
    s = if had state else graphFocusedOn(k, key, state) end
    y = flatOf(k, key, s)
    h = y.Graph
    pans = had and pannable(h)
    h.Press = {X: px, Y: py, Moved: false, Pans: pans, From: if pans limitsOf(h) else missing end}
    return rebuilt(k, y, h, s)
  end
  press = dict.GetOr("Press", missing, g)
  if value.IsMissing(press)
    return state
  end
  if action == "move"
    if not press.Moved and math.Abs(px - press.X) <= 4 and math.Abs(py - press.Y) <= 4
      return state
    end
    g.Press = dict.Put("Moved", true, press)
    if press.Pans
      g.Zoom = panned(g, press.From, px - press.X, py - press.Y)
      return asksView(k, rebuilt(k, x, g, state))
    end
    return rebuilt(k, x, g, state)
  end
  g.Press = missing
  s = rebuilt(k, x, g, state)
  if press.Moved s else clicked(k, key, px, py, s) end
end

defn clicked(k, key, px, py, state)
  (** A click on the 2D graph of a key in buffer k: the point under it, within 12 pixels, pinned, or unpinned when it was, and the point of the keys,
      once its values came; and its row chosen in a table of its cell, as soon as the places of its points came, as the scene of a mark gives them. *)
  x = flatOf(k, key, state)
  g = x.Graph
  near = nearestAt(g, px, py)
  if value.IsMissing(near)
    return state
  end
  p = g.Points[near.Layer]
  at = p.At[near.J]
  mark = dict.GetOr("Mark", missing, g)
  count = dict.GetOr("Count", if value.IsMissing(mark) 0 - 1 else mark[2] end, p)
  s = state
  if dict.GetOr("Pointed", false, g)
    g.Pins = pinToggled(pointOf(g, near.Layer, near.J), dict.GetOr("Pins", [], g))
    g.Spot = {Layer: near.Layer, At: at}
    s = rebuilt(k, x, g, state)
  end
  rowOfPoint(k, x.Cell, count, at, s)
end

defn pinToggled(q, pins)
  (** The pins with a point, or without it when it was one: at most MostPins(), the first pinned going first. *)
  if list.Any([p.Layer == q.Layer and p.At == q.At for p in pins])
    return [p for p in pins if not (p.Layer == q.Layer and p.At == q.At)]
  end
  list.TakeLast(MostPins(), list.Append(q, pins))
end

defn graphWheel(k, key, amount, point, state)
  (** The wheel over the 2D graph of a key in buffer k: while the graph has the keys, it zooms the view about the mouse, a notch up 20 % nearer; else,
      and over a graph that can't zoom, as a grid of graphs, it gives missing, and the wheel moves the screen. Each notch changes the ranges wanted, and
      their scene is asked once the one before came. *)
  x = flatOf(k, key, state)
  if value.IsMissing(x) or not graphFocused(k, x.Graph, state)
    return missing
  end
  g = x.Graph
  if not dict.GetOr("Pointed", false, g)
    (* The axes are asked: the wheel waits for them, and doesn't move the screen under a graph that has the keys. *)
    return state
  end
  if value.IsMissing(dict.GetOr("Axes", missing, g))
    return missing
  end
  zoom = zoomedAt(g, 0.8 ^ list.Max(-5.0, list.Min(5.0, amount)), point.X - 2 * state.Cell.Width, point.Y - dict.GetOr("Under", 0, x))
  if value.Equal(zoom, dict.GetOr("Zoom", missing, g))
    return state
  end
  g.Zoom = zoom
  asksView(k, rebuilt(k, x, g, state))
end

(* -- Zoom and move: the ranges of the axes wanted, {X, Y}, each [low, high] or missing for its own, computed on the scale of each axis, logarithms on a
   log axis, from the pixels of the scene shown. *)

(** Can a drag move the view of a graph: one with axes that isn't polar? *)
pannable(g) = value.IsSome(dict.GetOr("Axes", missing, g)) and not dict.Has("Center", g.Axes)

(** The ranges of the axes of a scene, {X, Y}, as Axes gives them: the ones a zoom starts from. *)
limitsIn(axes) = if dict.Has("Center", axes) {X: missing, Y: [axes.Y.Low, axes.Y.High]} else {X: [axes.X.Low, axes.X.High], Y: [axes.Y.Low, axes.Y.High]} end

(** The ranges a graph wants, {X, Y}: those of its last zoom, or of the scene it shows. *)
limitsOf(g) = if value.IsSome(dict.GetOr("Zoom", missing, g)) dict.Merge(limitsIn(g.Axes), dict.Dict([{Key: k, Value: g.Zoom[k]} for k in dict.Keys(g.Zoom) if value.IsSome(g.Zoom[k])])) else limitsIn(g.Axes) end

defn ranged(a, lim, own, t0, t1)
  (** A range of an axis from its new ends on its scale, [low, high], or lim when it would zoom past a millionth of the axis's own range or a million
      times it, or isn't finite: the view stays within what a graph can draw. *)
  span = math.Abs(scaled(a, own[2]) - scaled(a, own[1]))
  w = math.Abs(t1 - t0)
  low = unscaled(a, t0)
  high = unscaled(a, t1)
  if not (w - w == 0.0 and low - low == 0.0 and high - high == 0.0) or w < span * 1e-6 or w > span * 1e6 or low == high
    return lim
  end
  [low, high]
end

defn zoomedAlong(a, lim, own, p, f)
  (** The range lim of an axis zoomed by a factor f about pixel p along it: the value under p stays there. *)
  t0 = scaled(a, lim[1])
  t1 = scaled(a, lim[2])
  tp = t0 + (p - a.From) / (a.To - a.From) * (t1 - t0)
  ranged(a, lim, own, tp - (tp - t0) * f, tp + (t1 - tp) * f)
end

defn movedAlong(a, lim, own, d)
  (** The range lim of an axis moved by d pixels along it, as a drag moves what is under the mouse. *)
  t0 = scaled(a, lim[1])
  t1 = scaled(a, lim[2])
  shift = d * (t1 - t0) / (a.To - a.From)
  ranged(a, lim, own, t0 - shift, t1 - shift)
end

defn zoomedAt(g, f, px, py)
  (** The ranges of a graph zoomed by a factor f about a place of its pixels: each range shrinks to f of itself, the value under the place staying under
      it; an axis of the names of bars keeps its own. A polar graph zooms the distance from its center alone. *)
  a = g.Axes
  lim = limitsOf(g)
  own = dict.GetOr("Own", limitsIn(a), g)
  if dict.Has("Center", a)
    return {X: missing, Y: zoomedAlong(a.Y, lim.Y, own.Y, math.Sqrt((px - a.Center[1]) * (px - a.Center[1]) + (py - a.Center[2]) * (py - a.Center[2])), f)}
  end
  {X: if a.X.Scale == "names" missing else zoomedAlong(a.X, lim.X, own.X, px, f) end, Y: if a.Y.Scale == "names" missing else zoomedAlong(a.Y, lim.Y, own.Y, py, f) end}
end

defn panned(g, from, dx, dy)
  (** The ranges of a graph moved by a drag of dx and dy pixels from the ranges it had at the press, from. *)
  a = g.Axes
  own = dict.GetOr("Own", limitsIn(a), g)
  {X: if a.X.Scale == "names" missing else movedAlong(a.X, from.X, own.X, dx) end, Y: if a.Y.Scale == "names" missing else movedAlong(a.Y, from.Y, own.Y, dy) end}
end

(* -- The keys: C-c e f, Tab or a click gives them; the arrows go from point to point, Left and Right along a layer, Up and Down to the layer before and
   after; Space pins; 0 goes back to its own ranges; M-w copies the values; C-c e s saves the graph as SVG; Escape unpins all, or leaves; C-g leaves. *)

(** Does the 2D graph of a block in buffer k have the keys? *)
graphFocused(k, graph, state) = isFlat(graph) and value.IsSome(commands.FocusOf(state)) and value.Equal(dict.GetOr("Graph", missing, commands.FocusOf(state)), graph.Key) and dict.GetOr("Buffer", 0, commands.FocusOf(state)) == k

(** The rows of the band while a 2D graph has the keys. *)
GraphHints() = [{Key: "← →", Name: "a point", Group: false}, {Key: "↑ ↓", Name: "a layer", Group: false}, {Key: "Space", Name: "pin, unpin", Group: false},
  {Key: "wheel, drag", Name: "zoom, move", Group: false}, {Key: "0", Name: "its own ranges", Group: false}, {Key: "M-w", Name: "copy x, y", Group: false},
  {Key: "C-c e s", Name: "save as SVG", Group: false}, {Key: "Escape", Name: "unpin, leave", Group: false}, {Key: "C-g", Name: "leave", Group: false}]

(** The keys of a 2D graph that has them. *)
GraphKeys() = {"right": graphStep(1, 0), "left": graphStep(-1, 0), "down": graphStep(0, 1), "up": graphStep(0, -1), "space": onGraph(graphPinned), "0": onGraph(graphOwn),
  "M-w": onGraph(graphCopied), "C-c e s": SaveGraph, "tab": st -> controlTabbed(1, st), "S-tab": st -> controlTabbed(-1, st), "escape": onGraph(graphEscaped),
  "C-g": commands.Unfocused}

(** The command that does f to the 2D graph that has the keys: f of its buffer, its block and the state. *)
onGraph(f) = state -> graphKeyed(f, state)

defn graphKeyed(f, state)
  (** The 2D graph that has the keys changed by f, or the keys left when it is no longer there. *)
  focus = commands.FocusOf(state)
  x = flatOf(focus.Buffer, focus.Graph, state)
  if value.IsMissing(x) commands.Unfocused(state) else f(focus.Buffer, x, state) end
end

(** The command that moves the point of the keys some points along its layer and some layers across. *)
graphStep(along, across) = onGraph((k, x, st) -> spotStepped(k, x, along, across, st))

defn spotStepped(k, x, along, across, state)
  (** The point of the keys of the graph of block x moved: along its layer, within it, or to the layer before or after that has points, at the position
      nearest; the first point of the first such layer when none was chosen. Its row is chosen in a table of the cell of as many rows. *)
  g = x.Graph
  if not dict.GetOr("Pointed", false, g)
    return commands.Say("The points of this graph are on their way.", state)
  end
  layers = [i for i in 1..value.Len(g.Points) if value.Len(g.Points[i].At) > 0]
  if value.Len(layers) == 0
    return commands.Say("This graph has no point of a line, points or texts in sight.", state)
  end
  at = spotted(g, dict.GetOr("Spot", missing, g))
  i = if dict.Has("J", at) at.Layer else layers[1] end
  j = if dict.Has("J", at) at.J else 1 end
  if dict.Has("J", at) and across != 0
    others = if across > 0 [l for l in layers if l > i] else list.Reverse([l for l in layers if l < i]) end
    if value.Len(others) > 0
      next = others[1]
      j = placeNear(g.Points[next].At, g.Points[i].At[j])
      i = next
    end
  else if dict.Has("J", at)
    j = list.Max(1, list.Min(value.Len(g.Points[i].At), j + along))
  end
  q = pointOf(g, i, j)
  g.Spot = {Layer: i, At: q.At}
  rowOfPoint(k, x.Cell, q.Count, q.At, rebuilt(k, x, g, state))
end

defn graphPinned(k, x, state)
  (** Space: the point of the keys pinned, or unpinned when it was. *)
  g = x.Graph
  at = if dict.GetOr("Pointed", false, g) spotted(g, dict.GetOr("Spot", missing, g)) else {} end
  if not dict.Has("J", at)
    return commands.Say("The arrows choose a point first.", state)
  end
  g.Pins = pinToggled(pointOf(g, at.Layer, at.J), dict.GetOr("Pins", [], g))
  rebuilt(k, x, g, state)
end

defn graphOwn(k, x, state)
  (** 0: the graph back to its own ranges. *)
  g = x.Graph
  g.Zoom = missing
  asksView(k, rebuilt(k, x, g, state))
end

defn graphCopied(k, x, state)
  (** M-w: the values of the points pinned, one a line, x and y apart by a tab, in the order they were pinned; without one, those of the point of the
      keys. Numbers alone, as Cesia writes them. *)
  g = x.Graph
  at = if dict.GetOr("Pointed", false, g) spotted(g, dict.GetOr("Spot", missing, g)) else {} end
  pins = dict.GetOr("Pins", [], g)
  qs = if value.Len(pins) > 0 pins else if dict.Has("J", at) [pointOf(g, at.Layer, at.J)] else [] end
  if value.Len(qs) == 0
    return commands.Say("No point to copy: a click or Space pins one, the arrows choose one.", state)
  end
  words = str.Join("\n", ["$(numberText(q.X))\t$(numberText(q.Y))" for q in qs])
  commands.Say(if value.Len(qs) == 1 "Copied x and y." else "Copied $(value.Len(qs)) points." end, commands.ToClipboard(words, state))
end

(** A value as the copy writes it: a number as Cesia writes it, and nothing for anything else, which the check of the points never lets through. *)
numberText(v) = if value.IsNumber(v) "$v" else "" end

defn graphEscaped(k, x, state)
  (** Escape: the pins taken away, or, with none, the keys left. *)
  g = x.Graph
  if value.Len(dict.GetOr("Pins", [], g)) == 0
    return commands.Unfocused(state)
  end
  g.Pins = []
  commands.Say("Unpinned.", rebuilt(k, x, g, state))
end

defn graphFocusedOn(k, key, state)
  (** The state with the keys on the 2D graph of a key in buffer k, drawn with its ring, its points asked if they never were, and the control that had
      them without. *)
  s = commands.Unfocused(state)
  s.Focus = {Keys: GraphKeys(), Hints: GraphHints(), Leave: st -> graphDrawn(k, key, st), Buffer: k, Graph: key}
  x = flatOf(k, key, s)
  if value.IsMissing(x)
    return s
  end
  g = x.Graph
  g.Live = true
  asksView(k, rebuilt(k, x, g, s))
end

defn graphDrawn(k, key, state)
  (** The state with the block of the 2D graph of a key in buffer k drawn again, with its ring or without. *)
  x = flatOf(k, key, state)
  if value.IsMissing(x) state else rebuilt(k, x, x.Graph, state) end
end

defn controlTabbed(by, state)
  (** Tab and S-Tab: the keys to the next table or 2D graph of the cell, or the one before, round. *)
  f = commands.FocusOf(state)
  k = f.Buffer
  x = if dict.Has("Table", f) tableBlock(k, f.Table, state) else flatOf(k, f.Graph, state) end
  if value.IsMissing(x)
    return commands.Unfocused(state)
  end
  all = [b for b in partsOf(k, x.Cell, state) if value.IsSome(dict.GetOr("Table", missing, b)) or isFlat(dict.GetOr("Graph", missing, b))]
  at = orFirst(list.FindFirst(j -> dict.GetOr("Part", 1, all[j]) == dict.GetOr("Part", 1, x), 1..value.Len(all)))
  next = all[math.Mod(at - 1 + by + value.Len(all), value.Len(all)) + 1]
  if value.IsSome(dict.GetOr("Table", missing, next)) tableFocusedOn(k, next.Table, state) else graphFocusedOn(k, next.Graph.Key, state) end
end

(* -- C-c e s: the graph as SVG, beside the file. *)

(** The most bytes of an SVG that C-c e s writes. *)
MostSvg() = 64000000

defn SvgPath(path, title, i, nth)
  (** The path of the SVG of graph nth of cell i of a file of cells, beside it: the file's name, then the title of the cell in small letters and digits,
      apart by -, the accents of Latin letters taken off, or cell and its number for a cell without one; -2, -3 after it for the graphs after the
      first. Nothing that a session sends is in it.

        SvgPath("notes/sun.ce", "Day", 2, 1) --> "notes/sun-day.svg"
        SvgPath("sun.ce", "Élévation du soleil", 3, 2) --> "sun-elevation-du-soleil-2.svg"
        SvgPath("sun.ce", "../..", 4, 1) --> "sun-cell4.svg" *)
  words = slug(if value.IsText(title) title else "" end)
  name = if words == "" "cell$i" else words end
  "$(str.Slice(1, value.Len(path) - 3, path))-$name$(if nth > 1 "-$nth" else "" end).svg"
end

(** The Latin letters with accents, and the letters they are written with in a name. *)
plainLetters = {"à": "a", "á": "a", "â": "a", "ã": "a", "ä": "a", "å": "a", "æ": "ae", "ç": "c", "è": "e", "é": "e", "ê": "e", "ë": "e", "ì": "i", "í": "i",
  "î": "i", "ï": "i", "ñ": "n", "ò": "o", "ó": "o", "ô": "o", "õ": "o", "ö": "o", "ø": "o", "œ": "oe", "ù": "u", "ú": "u", "û": "u", "ü": "u", "ý": "y", "ÿ": "y"}

defn slug(title)
  (** A title as a name of a file: its letters a to z, without accents, in small letters, and its digits, the others as one -, none at the ends, at most
      40 characters. *)
  out = ""
  gap = false
  for c in str.Chars(str.Fold(title))
    plain = dict.GetOr(c, c, plainLetters)
    b = if str.ByteLength(plain) >= 1 str.Byte(1, plain) else 0 end
    ok = str.ByteLength(plain) <= 2 and list.All([(x >= 97 and x <= 122) or (x >= 48 and x <= 57) for x in str.Bytes(plain)])
    if ok and b > 0
      out = if gap and out != "" "$out-$plain" else "$out$plain" end
      gap = false
    else
      gap = true
    end
    if value.Len(out) >= 40
      return str.Slice(1, 40, out)
    end
  end
  out
end

defn SaveGraph(state)
  (** C-c e s while a 2D graph has the keys: its SVG, as plot.Save writes it, beside the file of the cells, see SvgPath; a file or a link there already is
      asked about first, as the page of C-c e h is. The SVG is the graph as its code draws it, at its own size and ranges, as the code would save it,
      which a zoom doesn't change. *)
  f = commands.FocusOf(state)
  k = f.Buffer
  x = flatOf(k, f.Graph, state)
  if value.IsMissing(x)
    return commands.Say("No graph has the keys.", commands.Unfocused(state))
  end
  b = state.Buffers[k]
  r = runOf(b)
  flats = [y for y in partsOf(k, x.Cell, state) if isFlat(dict.GetOr("Graph", missing, y))]
  nth = orFirst(list.FindFirst(j -> value.Equal(flats[j].Graph.Key, f.Graph), 1..value.Len(flats)))
  title = if x.Cell <= value.Len(r.Cells) dict.GetOr("Title", "", r.Cells[x.Cell]) else "" end
  path = SvgPath(b.Path, title, x.Cell, nth)
  key = f.Graph
  if sys.Exists(path) or result.IsOk(sys.ReadLink(path))
    return commands.Confirm("$(list.Last(str.Split("/", path))) exists. Replace it? (y or n) ", (yes, s) -> if yes == "y" svgAsked(k, key, path, s) else commands.Say("Nothing done.", s) end, state)
  end
  svgAsked(k, key, path, state)
end

defn svgAsked(k, key, path, state)
  (** The SVG of the graph of a key asked of the session of buffer k, for a path: a tick asks it once the session is free, and writes it. *)
  r = runOf(state.Buffers[k])
  if value.IsMissing(r) or value.IsMissing(r.Session)
    return commands.Say("No session holds this graph: C-c e e runs its cell again.", state)
  end
  if value.IsSome(dict.GetOr("Saving", missing, r))
    return commands.Say("A graph is being saved.", state)
  end
  r.Saving = {Key: key, Path: path}
  commands.Say("Saving $(list.Last(str.Split("/", path)))…", withRun(k, r, state))
end

defn svgSaved(k, state)
  (** The state at a tick for buffer k: the SVG of a graph asked of the session once it is free, then written beside the file once it came, as the page
      is written, and said. An SVG that is no text starting <svg, or past MostSvg() bytes, isn't written. *)
  r = runOf(state.Buffers[k])
  c = if value.IsMissing(r) missing else dict.GetOr("Saving", missing, r) end
  if value.IsMissing(c)
    return state
  end
  if not dict.Has("Task", c)
    if value.IsMissing(r.Session) or value.IsSome(r.Task) or asking(r)
      return state
    end
    one = r.Session
    key = c.Key
    c.Task = fiber.Spawn(() -> nb.Svg(one, key))
    r.Saving = c
    sys.Sleep(0)
    return withRun(k, r, state)
  end
  got = fiber.Wait(c.Task, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  r.Saving = missing
  s = withRun(k, r, state)
  svg = if result.IsOk(got) got.Value else got end
  if result.IsErr(svg)
    return commands.Say("The graph isn't saved: $(svg.Error.Message)", s)
  end
  if not (value.IsText(svg.Value) and str.StartsWith("<svg", svg.Value) and str.ByteLength(svg.Value) <= MostSvg())
    return commands.Say("The graph isn't saved: the session sent no SVG of at most $(MostSvg()) bytes.", s)
  end
  wrote = files.Replace(c.Path, svg.Value)
  commands.Say(if result.IsErr(wrote) and wrote.Error.Kind != "saved" "Can't write $(c.Path): $(wrote.Error.Message)" else "Wrote $(c.Path)." end, s)
end

(* -- C-c e c: the whole table as CSV, its rows asked of the session 1000 at a time, sorted and filtered as it shows them. *)

(** The most rows that C-c e c copies: past them, the first ones, and it says so. *)
CopyRows() = 100000

defn CopyTable(state)
  (** C-c e c: the whole table that has the keys, or had them last, or the first of the cell of the cursor, in the clipboard as CSV, std/csv's: its header,
      then its rows as it shows them, sorted and filtered, at most CopyRows(). The rows come from the session, 1000 at a time, while the editor goes on. *)
  focus = commands.FocusOf(state)
  k = if value.IsSome(focus) and dict.Has("Table", focus) focus.Buffer else state.Current end
  if not IsCells(state.Buffers[k])
    return commands.Say("C-c e c copies a table that a cell shows.", state)
  end
  r = runOf(state.Buffers[k])
  key = if value.IsSome(focus) and dict.Has("Table", focus) focus.Table else if value.IsSome(r) dict.GetOr("LastTable", missing, r) else missing end
  x = if value.IsSome(key) tableBlock(k, key, state) else missing end
  if value.IsMissing(x) and value.IsSome(r) and value.Len(r.Cells) > 0
    i = CellAt(state.Buffers[k].Cursor.Line, r.Cells)
    x = list.FindFirst(b -> value.IsSome(dict.GetOr("Table", missing, b)), partsOf(k, i, state))
  end
  if value.IsMissing(x)
    return commands.Say("No table here: C-c e c copies a table that a cell shows, the one with the keys.", state)
  end
  t = x.Table
  s = if value.IsSome(focus) and dict.Has("Table", focus) tableFocusedOn(k, t, state) else state end
  if t.Fixed or value.IsMissing(r) or value.IsMissing(r.Session)
    return commands.Say("Copied $(value.Len(t.Rows)) rows as CSV.", commands.ToClipboard(csv.Text(list.Prepend(t.Columns, t.Rows)), s))
  end
  if value.IsSome(dict.GetOr("Copying", missing, r))
    return commands.Say("A table is being copied.", s)
  end
  r = runOf(s.Buffers[k])
  r.Copying = {Key: t.Key, Sort: t.Sort, Filter: t.Filter, Count: list.Min(t.Count, CopyRows()), All: t.Count, Columns: t.Columns}
  commands.Say("Copying the table…", withRun(k, r, s))
end

defn copying(k, state)
  (** The state at a tick for buffer k: the copy of a table asked of the session in one fiber, which asks its rows 1000 at a time and holds the session
      meanwhile; once done, its CSV in the clipboard. *)
  r = runOf(state.Buffers[k])
  c = if value.IsMissing(r) missing else dict.GetOr("Copying", missing, r) end
  if value.IsMissing(c)
    return state
  end
  if not dict.Has("Task", c)
    if value.IsMissing(r.Session) or value.IsSome(r.Task) or asking(r)
      return state
    end
    one = r.Session
    c.Task = fiber.Spawn(() -> rowsOf(one, c))
    r.Copying = c
    sys.Sleep(0)
    return withRun(k, r, state)
  end
  got = fiber.Wait(c.Task, timeout = 0)
  if result.IsErr(got) and got.Error.Kind == "timeout"
    return state
  end
  r.Copying = missing
  s = withRun(k, r, state)
  rows = if result.IsOk(got) got.Value else got end
  if result.IsErr(rows)
    return commands.Say("The table isn't copied: $(rows.Error.Message)", s)
  end
  cut = if c.All > c.Count ", the first $(c.Count) of $(c.All)" else "" end
  commands.Say("Copied $(value.Len(rows.Value)) rows as CSV$cut.", commands.ToClipboard(csv.Text(list.Prepend(c.Columns, rows.Value)), s))
end

defn rowsOf(session, c)
  (** The rows of a table as it shows them, asked of the session 1000 at a time, in an Ok, or an Err. *)
  out = []
  filter = if c.Filter == "" missing else c.Filter end
  first = 1
  while first <= c.Count
    got = nb.Rows(session, c.Key, first, list.Min(c.Count, first + 999), sort = c.Sort, filter = filter)?
    if value.Len(got.Rows) == 0 or RowsFault(got, {}) != missing
      return result.Ok(out)
    end
    out = list.Concat(out, got.Rows)
    first = first + value.Len(got.Rows)
  end
  result.Ok(out)
end

(* ---- The hooks. *)

defn tick(state)
  (** The state at a tick: the results of each buffer's cells, its stops and its page, the frames of its animations, the views of its 3D graphs, the
      answers of `*repl*`, the rows of a viewer, and the blocks moved back under their cells once the text rests. *)
  s = state
  for k in 1..value.Len(s.Buffers)
    if value.IsSome(runOf(s.Buffers[k]))
      s = svgSaved(k, copying(k, marked(k, paged(k, turnLanded(k, played(k, exported(k, stopped(k, next(k, pendingSet(k, setAnswered(k, taken(k, varied(k, s)))))))))))))
    end
    if value.IsSome(replOf(s.Buffers[k]))
      s = answered(k, s)
    end
    s = turnPending(k, s)
  end
  s = viewing(s)
  k = s.Current
  s = widened(k, s)
  if k <= value.Len(s.Buffers) and (commands.Still(s) >= 0.5 or not dict.Has("CellsSeen", s.Buffers[k])) rested(k, moved(k, s)) else s end
end

defn rested(k, state)
  (** The state once buffer k rests: its cells read again if its text changed since, so that its sliders are drawn from its text, before any run, and
      the results that a slider's number no longer matches say so. Once for each version of the text; a buffer that is no file of Cesia pays nothing. *)
  b = state.Buffers[k]
  if dict.GetOr("CellsSeen", -1, b) == b.Version or lists.IsList(b) or value.IsMissing(b.Path) or not str.EndsWith(".ce", b.Path)
    return state
  end
  r = runOf(b)
  if value.IsSome(r) and value.IsSome(r.Task)
    return state
  end
  s = state
  s.Buffers[k].CellsSeen = b.Version
  if value.IsMissing(r) and not IsCells(b)
    return s
  end
  restaled(k, fresh(k, s))
end

defn busy(b)
  (** Does a buffer wait for its cells, a slider's Set, its stop, its page or its prompt? *)
  r = runOf(b)
  p = replOf(b)
  (value.IsSome(r) and (value.IsSome(r.Task) or value.IsSome(r.Stopping) or value.IsSome(r.Html) or asking(r))) or (value.IsSome(p) and value.IsSome(p.Task))
end

(** Do the cells need ticks: a cell runs, a slider's Set, a stop, a page, a frame or a view is waited for, a graph waits for the width of its pane,
    an animation plays on the screen, or a 3D graph waits to be asked its view? The sliders are drawn again from the text at rest at the ticks the check of a file of Cesia asks for, as the results
    are put back under their cells. A still animation takes no tick. *)
Moving(state) = list.Any([busy(b) or tableWaits(b) for b in state.Buffers]) or value.IsSome(stale(state.Buffers[state.Current], state)) or list.Any([playing(k, state) or aiming(k, state) for k in 1..value.Len(state.Buffers)])

defn tableWaits(b)
  (** Does a buffer with a session have a table that waits for rows, a graph that waits for its mark, its ranges or its points, or a copy or an SVG that
      waits to start? *)
  r = runOf(b)
  if value.IsMissing(r) or value.IsMissing(r.Session)
    return false
  end
  value.IsSome(dict.GetOr("Copying", missing, r)) or list.Any([(value.IsSome(dict.GetOr("Table", missing, x)) and wantsRows(x.Table)) or
    (dict.GetOr("Cell", 0, x) > 0 and isFlat(dict.GetOr("Graph", missing, x)) and wantsView(x.Graph)) for x in text.BlocksOf(b)]) or value.IsSome(dict.GetOr("Saving", missing, r))
end

defn Hooked(config)
  (** A config with the hooks of the cells over those it has, as the check's: at each tick, its Idle then the cells'; it moves while either needs. *)
  c = config
  idle = dict.GetOr("Idle", s -> s, config)
  saved = dict.GetOr("Saved", s -> s, config)
  moving = dict.GetOr("Moving", s -> false, config)
  c.Idle = s -> tick(idle(s))
  c.Saved = saved
  c.Moving = s -> moving(s) or Moving(s)
  c
end
