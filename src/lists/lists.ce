(** Lists: a buffer of rows that an app gives, as the buffer list does. A list is a buffer of text, so moves, selection and copy work in it as in a file, and its
    List field says what each line stands for: {Name, Rows, Keys, Free, Filter, Items, Parts, Back, Shown}. Rows is the rows {Words, Item}, or a function that
    gives them from the state, Keys the keys of the list, Free missing or the keys that need no row, Filter what was typed, Items the item of each line shown,
    Parts their colors, Back the buffer to go back to, and Shown, for fixed rows, what the last filter showed. A row may give Parts, [role, words] each with a
    role of color.ce, whose words joined are its Words. Everything here is pure: commands opens and runs lists. *)

defn Of(b)
  (** The list of a buffer, or missing for a buffer of text. A buffer from before this field has none, and reading a field it lacks would panic. *)
  match b
    {List: l} -> l
    else -> missing
  end
end

(** Is this buffer a list? *)
IsList(b) = not IsMissing(Of(b))

defn Matches(filter, words)
  (** Does the filter match the words? Its characters must come in the words in order, side by side or not, and case doesn't count.

        Matches("cmd", "commands.ce") --> true *)
  wanted = Chars(Lower(filter))
  k = 1
  for c in Chars(Lower(words))
    if k <= Len(wanted) and c == wanted[k]
      k += 1
    end
  end
  k > Len(wanted)
end

defn keyOf(row)
  (** What the filter reads in a row: its Key when it has one, as a file name beside its size, else its words. *)
  match row
    {Key: k} -> k
    else -> row.Words
  end
end

defn Filtered(filter, rows)
  (** The rows whose words, or keys, the filter matches, in their order. An empty filter keeps them all at once, and one character is a native search. *)
  if filter == ""
    rows
  else if Len(filter) == 1
    Filter(r -> Contains(Lower(filter), Lower(keyOf(r))), rows)
  else
    Filter(r -> Matches(filter, keyOf(r)), rows)
  end
end

defn PartsOf(row)
  (** The colored parts of a row, or missing for a row of one plain color. *)
  match row
    {Parts: p} -> p
    else -> missing
  end
end

defn PartsAt(line, b)
  (** The colored parts of a line of a list, or missing: for a plain row, or a list from before this field. *)
  match Of(b)
    {Parts: all} -> if line <= Len(all) all[line] else missing end
    else -> missing
  end
end

defn ShownOf(l)
  (** What a list of fixed rows showed last, {Filter, Rows}, or missing: for a list whose rows a function makes, or one from before this field. *)
  match l
    {Shown: shown} -> shown
    else -> missing
  end
end

defn FreeKeys(l)
  (** The keys of a list that take only the state: none for a list without any, or from before this field. *)
  match l
    {Free: f} -> if IsMissing(f) Dict() else f() end
    else -> Dict()
  end
end

Words(rows) = Join("\n", Map(r -> r.Words, rows))   (** The text of the rows, one per line. *)

defn LineOf(item, items, line)
  (** The line of an item among the items shown, or else the line given, brought inside them. *)
  for k in 1:Len(items)
    if items[k] == item
      return k
    end
  end
  Max(1, Min(line, Len(items)))
end

defn ItemAt(b)
  (** The item under the cursor of a list, or missing when no row is left. *)
  l = Of(b)
  line = b.Cursor.Line
  if IsMissing(l) or line > Len(l.Items) missing else l.Items[line] end
end
