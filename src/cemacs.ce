(** Cemacs: the editor with its apps. bin/cemacs and cesia do dev run this file, and C-c f c opens it. An app lives in a folder of src/ and brings its keys:
    add its use here and its keys to Keys. Loading this file opens the window, so no test uses it. *)
use src/buffers
use src/check
use src/emacs
use core/editor
use src/folders
use src/help
use src/output
use src/project
use std/dict
use std/io

(** Every key of the editor: the Emacs keys, then the keys of each app, and ? after the first key of every pair, which lists it. For a key in two, the later
    one wins. *)
Keys() = help.WithHelp(dict.Merge(dict.Merge(dict.Merge(dict.Merge(dict.Merge(emacs.Keys(), buffers.Keys()), folders.Keys()), project.Keys()), check.Keys()),
  output.Keys()))

(** What the editor runs on: these keys, the other keys and the settings of src/emacs, and the hooks of the check. *)
Config() = check.Hooked(emacs.Config(Keys))

io.Print(editor.Start(Config))
