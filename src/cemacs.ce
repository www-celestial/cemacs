(** Cemacs: the editor with its apps. bin/cemacs and cesia do dev run this file, and C-c c opens it. An app lives in a folder of src/ and brings its keys:
    add its use here and its keys to Keys. Loading this file opens the window, so no test uses it. *)
use buffers
use emacs
use editor
use folders
use help

(** Every key of the editor: the Emacs keys, then the keys of each app, and ? after the first key of every pair, which lists it. For a key in two, the later
    one wins. *)
Keys() = help.WithHelp(Merge(Merge(emacs.Keys(), buffers.Keys()), folders.Keys()))

(** What the editor runs on: these keys, and the other keys and the settings of src/emacs. *)
Config() = emacs.Config(Keys)

Print(editor.Start(Config))
