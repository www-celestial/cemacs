(** Tests of the search of a project, without git: the questions it asks and the edits of a replace. tests/ide-check.ce runs the real git grep. *)
use src/grep
use std/dict
use std/text as str
use std/value

zero = str.FromBytes([0])

isAskedWithTheName() = value.Equal(grep.Answered({Do: "search", Folder: "/p", Text: "x = price + 1", Line: 1, Column: 6}).Ask, {Label: "Search project: ", Answer: "price",
  Then: {Program: "grep", Do: "search"}})
isNoWordsSaid() = grep.Answered({Do: "search", Folder: "/p", Answer: ""}).Say == "No words to search."
isWrongLinesLeftOut() = value.Len(grep.Places("/p", "a.ce:3:5:x\n$(str.Join(zero, ["a.ce", "0", "1", "x"]))\n")) == 0
items = [{Path: "/p/a.ce", Line: 1, Column: 0}, {Path: "/p/a.ce", Line: 2, Column: 4}]
isReplaceAsks() = grep.Answered({Do: "replace", Folder: "/p", Words: "price", Items: items}).Ask.Label == "Replace price with: "

defn isReplaceConfirms()
  a = grep.Answered({Do: "replace", Folder: "/p", Words: "price", Items: items, Answer: "cost", Texts: {"/p/a.ce": "price = 1\nx = Price + price\nprice"}})
  a.Confirm.Label == "Replace 3 places of price in 1 files with cost? (y or n)" and value.Len(a.Confirm.Yes.Edits) == 3 and a.Confirm.Yes.Edits[2].Old == "Price"
end

isReplaceOfNothingSaid() = dict.Has("Say", grep.Answered({Do: "replace", Folder: "/p", Words: "zz", Items: items, Answer: "y", Texts: {"/p/a.ce": "a\nb"}}))
