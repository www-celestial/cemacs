-- Tests of keys.kp: run with kepler test .
use "./keys"

press(key, ctrl, alt, shift) = {kind: "key", key: key, ctrl: ctrl, alt: alt, shift: shift, super: false}
plain(key) = press(key, false, false, false)
with_ctrl(key) = press(key, true, false, false)
with_alt(key) = press(key, false, true, false)
with_shift(key) = press(key, false, false, true)

is_ctrl() = keys.chord(with_ctrl("f")) == "C-f"
is_alt() = keys.chord(with_alt("w")) == "M-w"
is_plain_letter_types() = is_missing(keys.chord(plain("a")))
is_shift_letter_types() = is_missing(keys.chord(with_shift("a")))
is_plain_space_types() = is_missing(keys.chord(plain("space")))
is_ctrl_space() = keys.chord(with_ctrl("space")) == "C-space"
is_enter() = keys.chord(plain("enter")) == "enter"
is_tab() = keys.chord(plain("tab")) == "tab"
is_backspace() = keys.chord(plain("backspace")) == "backspace"
is_shift_move() = keys.chord(with_shift("right")) == "S-right"
is_ctrl_shift_move() = keys.chord(press("right", true, false, true)) == "C-S-right"
is_ctrl_shift_letter() = keys.chord(press("x", true, false, true)) == "C-S-x"
is_ctrl_alt() = keys.chord(press("f", true, true, false)) == "C-M-f"
is_super_missing() = is_missing(keys.chord({kind: "key", key: "f", ctrl: true, alt: false, shift: false, super: true}))
is_function_key() = keys.chord(plain("f5")) == "f5"
is_alt_less_than() = keys.chord(press("<", false, true, true)) == "M-<"
is_alt_less_than_plain() = keys.chord(with_alt("<")) == "M-<"
is_alt_greater_than() = keys.chord(press(">", false, true, true)) == "M->"
is_alt_comma_alias() = keys.chord(press(",", false, true, true)) == "M-S-,"
is_alt_period_alias() = keys.chord(press(".", false, true, true)) == "M-S-."
is_ctrl_question() = keys.chord(press("?", true, false, true)) == "C-?"
is_ctrl_slash() = keys.chord(with_ctrl("/")) == "C-/"
is_ctrl_slash_alias() = keys.chord(press("/", true, false, true)) == "C-S-/"
is_no_shift_for_underscore() = keys.chord(press("_", true, false, true)) == "C-_"
is_upper_letter_lowered() = keys.chord(press("X", true, false, true)) == "C-S-x"

is_pair() = keys.resolved("", "C-x") == {pending: "C-x"}
is_pair_c() = keys.resolved("", "C-c") == {pending: "C-c"}
is_pair_end() = keys.resolved("C-x", "C-s") == {command: "save"}
is_unknown() = keys.resolved("", "C-q") == {unknown: "C-q"}
is_unknown_pair() = keys.resolved("C-x", "C-q") == {unknown: "C-x C-q"}
is_cancel_in_pair() = keys.resolved("C-x", "C-g") == {command: "cancel"}
is_cancel() = keys.resolved("", "C-g") == {command: "cancel"}
is_single() = keys.resolved("", "C-f") == {command: "forward_char"}
is_arrow() = keys.resolved("", "S-right") == {command: "select_forward_char"}
is_chord_then_resolved() = keys.resolved("", keys.chord(press("<", false, true, true))) == {command: "file_start"}
is_alias_resolved() = keys.resolved("", "M-S-,") == {command: "file_start"} and keys.resolved("", "C-S-/") == {command: "redo"}
is_no_pair_after_pair() = keys.resolved("C-x", "C-x") == {unknown: "C-x C-x"}
is_whole_table() = keys.table["C-c C-c"] == "run" and keys.table["C-c C-k"] == "stop" and keys.table["C-c C-o"] == "toggle_output" and keys.table["C-x C-f"] == "open_file" and keys.table["C-x b"] == "next_buffer" and keys.table["C-x k"] == "close_buffer" and keys.table["C-x C-c"] == "quit"
