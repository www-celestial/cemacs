-- Tests of color.kp: run with kepler test .
use "./color"

roles(line) = map(t -> t[1], color.tokens(line, color.first_state).tokens)
joined(tokens) = join("", map(t -> t[2], tokens))
lost(line) = joined(color.tokens(line, color.first_state).tokens) == line

defn comment_first(n)
  if n == 1
    "(* a"
  else
    "b"
  end
end

known_to_ten = color.colored_to(10, n -> "line", color.blank_colors())

is_keyword() = equal(color.tokens("defn f(x)", color.first_state).tokens[1], [color.keyword, "defn"])
is_name_before_paren() = equal(color.tokens("defn f(x)", color.first_state).tokens[3], [color.name, "f"])
is_field_after_dot() = equal(color.tokens("p.x", color.first_state).tokens, [[color.plain, "p."], [color.field, "x"]])
is_field_before_paren() = equal(color.tokens("a.f(1)", color.first_state).tokens[2], [color.field, "f"])
is_plain_word() = equal(color.tokens("count", color.first_state).tokens, [[color.plain, "count"]])
is_keyword_inside_a_name() = equal(color.tokens("ending", color.first_state).tokens, [[color.plain, "ending"]])
is_number() = equal(color.tokens("x = 0x1F + 2.5", color.first_state).tokens[2], [color.number, "0x1F"])
is_float() = equal(color.tokens("x = 2.5", color.first_state).tokens[2], [color.number, "2.5"])
is_text() = color.string in roles("x = \"a\"")
is_text_whole() = equal(color.tokens("x = \"a\"", color.first_state).tokens[2], [color.string, "\"a\""])
is_text_with_escape() = equal(color.tokens("\"a\\\"b\" c", color.first_state).tokens[1], [color.string, "\"a\\\"b\""])
is_interpolation_stays_string() = equal(color.tokens("\"a $$(b) c\"", color.first_state).tokens, [[color.string, "\"a $$(b) c\""]])
is_comment_line() = equal(color.tokens("-- note", color.first_state).tokens, [[color.comment, "-- note"]])
is_comment_after_code() = equal(color.tokens("x -- note", color.first_state).tokens, [[color.plain, "x "], [color.comment, "-- note"]])
is_comment_ends_the_line() = equal(roles("x -- \"a\" if"), [color.plain, color.comment])
is_comment_carries() = color.tokens("(* a", color.first_state).state.comment == 1
is_comment_nests() = color.tokens("(* (* a *)", color.first_state).state.comment == 1
is_comment_closes() = color.tokens("(* a *) x", color.first_state).state.comment == 0
is_comment_continues() = equal(color.tokens("b *) if", {comment: 1, text: false}).tokens, [[color.comment, "b *)"], [color.plain, " "], [color.keyword, "if"]])
is_text_carries() = color.tokens("x = \"one", color.first_state).state.text
is_text_continues() = equal(color.tokens("two\" + y", {comment: 0, text: true}).tokens[1], [color.string, "two\""])
is_text_ends() = not color.tokens("two\"", {comment: 0, text: true}).state.text
is_empty_line() = equal(color.tokens("", color.first_state).tokens, []) and color.tokens("", color.first_state).state.comment == 0
is_nothing_lost() = all(map(lost, ["defn f(x)", "  x = \"a\" -- b", "(* a *) if (* b", "é = 1.5e3 $$(", "\t.. ... ::", "\"\" \"\"\"\""]))
is_broken_code_colors() = lost("x = (* \" $$(")
is_forget_limits() = color.forget_from(5, known_to_ten).known == 5
is_forget_keeps_states() = length(color.forget_from(5, known_to_ten).starts) == 5
is_forget_after_known_changes_nothing() = equal(color.forget_from(20, known_to_ten), known_to_ten)
is_forget_keeps_first() = color.forget_from(0, known_to_ten).known == 1
is_blank() = equal(color.blank_colors(), {starts: [color.first_state], known: 1})
is_colored_to_reaches() = known_to_ten.known == 10 and length(known_to_ten.starts) == 10
is_colored_to_keeps_known() = equal(color.colored_to(3, n -> panic("not read"), known_to_ten), known_to_ten)
is_colored_to_follows_comments() = color.colored_to(3, comment_first, color.blank_colors()).starts[3].comment == 1
