-- Tests of the buffer in text.kp: run with kepler test .
use "./text"
use "./color"
use rope

all_text(b) = rope.text(b.rope)
at(b) = [b.cursor.line, b.cursor.column]
same(a, b) = "$a" == "$b"
typed(words, b) = reduce((acc, c) -> text.insert_words(c, acc), b, chars(words))
at_place(line, column, words) = text.place(line, column, text.of(words, missing))

is_typing() = all_text(text.insert_words("a", text.of("", missing))) == "a" and text.insert_words("a", text.of("", missing)).cursor.column == 1
is_accent_move() = all_text(text.delete_after(text.move_char(1, text.of("éa", missing)))) == "é"
is_accent_delete() = all_text(text.delete_before(at_place(1, 1, "éa"))) == "a"
is_accent_insert() = all_text(text.insert_words("x", at_place(1, 1, "éa"))) == "éxa"
is_start_of_file() = all_text(text.delete_before(text.of("ab", missing))) == "ab" and same(at(text.delete_before(text.of("ab", missing))), [1, 0])
is_start_of_file_version() = text.delete_before(text.of("ab", missing)).version == 0
is_join_lines() = all_text(text.delete_before(at_place(2, 0, "ab\ncd"))) == "abcd" and same(at(text.delete_before(at_place(2, 0, "ab\ncd"))), [1, 2])
is_end_of_last_line() = same(at(text.move_char(1, at_place(2, 2, "ab\ncd"))), [2, 2])
is_start_of_file_move() = same(at(text.move_char(-1, text.of("ab", missing))), [1, 0])
is_move_across_lines() = same(at(text.move_char(1, at_place(1, 2, "ab\ncd"))), [2, 0]) and same(at(text.move_char(-1, at_place(2, 0, "ab\ncd"))), [1, 2])
is_short_line_column() = same(at(text.move_line(1, text.move_line(1, at_place(1, 4, "abcde\nx\nabcde")))), [3, 4])
is_wanted_cleared_by_move() = same(at(text.move_line(1, text.move_char(-1, text.move_line(1, at_place(1, 4, "abcde\nx\nabcde"))))), [3, 0])
is_wanted_cleared_by_edit() = same(at(text.move_line(1, text.insert_words("y", text.move_line(1, at_place(1, 4, "abcde\nx\nabcde"))))), [3, 2])
is_move_line_edges() = same(at(text.move_line(-1, at_place(1, 2, "abc\nd"))), [1, 2]) and same(at(text.move_line(5, at_place(1, 2, "abc\nd"))), [2, 1])
is_indent() = all_text(text.new_line(at_place(1, 3, "  x"))) == "  x\n  " and same(at(text.new_line(at_place(1, 3, "  x"))), [2, 2])
is_new_line_splits() = all_text(text.new_line(at_place(1, 1, "ab"))) == "a\nb" and same(at(text.new_line(at_place(1, 1, "ab"))), [2, 0])
is_cut_line_middle() = all_text(text.cut_line(at_place(1, 1, "abc\nd")).buffer) == "a\nd" and text.cut_line(at_place(1, 1, "abc\nd")).cut == "bc"
is_cut_line_end() = all_text(text.cut_line(at_place(1, 3, "abc\nd")).buffer) == "abcd" and text.cut_line(at_place(1, 3, "abc\nd")).cut == "\n"
is_cut_line_last() = all_text(text.cut_line(at_place(1, 3, "abc")).buffer) == "abc" and text.cut_line(at_place(1, 3, "abc")).cut == ""
is_undo_word() = all_text(text.undo(typed("ab cd", text.of("", missing)))) == "ab "
is_undo_twice() = all_text(text.undo(text.undo(typed("ab cd", text.of("", missing))))) == ""
is_undo_more_than_history() = all_text(text.undo(text.undo(text.undo(typed("ab cd", text.of("", missing)))))) == ""
is_undo_restores_cursor() = same(at(text.undo(typed("ab cd", text.of("", missing)))), [1, 3])
is_undo_clears_star() = not text.is_modified(text.undo(text.insert_words("x", text.mark_saved(missing, text.of("", missing)))))
is_edit_sets_star() = text.is_modified(text.insert_words("x", text.of("", missing))) and not text.is_modified(text.of("", missing))
is_star_after_other_branch() = text.is_modified(text.insert_words("z", text.undo(text.insert_words("y", text.mark_saved(missing, text.insert_words("x", text.of("", missing)))))))
is_redo() = all_text(text.redo(text.undo(typed("ab cd", text.of("", missing))))) == "ab cd"
is_redo_lost() = all_text(text.redo(text.insert_words("z", text.undo(typed("ab", text.of("", missing)))))) == "z"
is_move_ends_step() = all_text(text.undo(typed("c", text.move_char(-1, typed("ab", text.of("", missing)))))) == "ab"
is_new_line_step() = all_text(text.undo(text.new_line(typed("ab", text.of("", missing))))) == "ab"
is_mark_saved() = text.mark_saved(5, text.insert_words("x", text.of("", missing))).disk == 5 and not text.is_modified(text.mark_saved(5, text.insert_words("x", text.of("", missing))))
is_region_none() = text.region(text.of("abc", missing)) == ""
is_region() = text.region(text.move_char(2, text.set_mark(text.of("abcd", missing)))) == "ab"
is_region_backwards() = text.region(text.move_char(-2, text.set_mark(at_place(1, 3, "abcd")))) == text.region(text.move_char(2, text.set_mark(at_place(1, 1, "abcd")))) and text.region(text.move_char(-2, text.set_mark(at_place(1, 3, "abcd")))) == "bc"
is_region_across_lines() = text.region(text.move_line(1, text.set_mark(text.of("ab\ncd", missing)))) == "ab\n"
is_region_accent() = text.region(text.move_char(2, text.set_mark(text.of("éàb", missing)))) == "éà"
is_clear_mark() = text.region(text.clear_mark(text.move_char(2, text.set_mark(text.of("abcd", missing))))) == ""
is_cut_region() = all_text(text.cut_region(text.move_char(2, text.set_mark(text.of("abcd", missing))))) == "cd"
is_cut_region_backwards() = all_text(text.cut_region(text.move_char(-2, text.set_mark(at_place(1, 3, "abcd"))))) == "ad" and same(at(text.cut_region(text.move_char(-2, text.set_mark(at_place(1, 3, "abcd"))))), [1, 1])
is_cut_region_clears_mark() = text.region(text.cut_region(text.move_char(2, text.set_mark(text.of("abcd", missing))))) == ""
is_mark_after_edit_is_valid() = text.region(text.cut_line(text.place(1, 3, text.set_mark(at_place(1, 6, "abcdef")))).buffer) == ""
is_line_edges() = same(at(text.to_line_end(text.of("ab\ncd", missing))), [1, 2]) and same(at(text.to_line_start(at_place(2, 1, "ab\ncd"))), [2, 0])
is_file_edges() = same(at(text.to_file_end(text.of("ab\ncé", missing))), [2, 2]) and same(at(text.to_file_start(at_place(2, 1, "ab\ncd"))), [1, 0])
is_empty_file() = same(at(text.to_file_end(text.of("", missing))), [1, 0]) and all_text(text.delete_after(text.of("", missing))) == ""
is_place_clamped() = same(at(at_place(9, 9, "ab\ncd")), [2, 2]) and same(at(at_place(0, -3, "ab\ncd")), [1, 0])
is_move_word() = same(at(text.move_word(1, text.of("foo bar", missing))), [1, 3]) and same(at(text.move_word(1, at_place(1, 3, "foo bar"))), [1, 7])
is_move_word_back() = same(at(text.move_word(-1, at_place(1, 7, "foo bar"))), [1, 4]) and same(at(text.move_word(-1, at_place(1, 4, "foo bar"))), [1, 0])
is_move_word_accent() = same(at(text.move_word(1, text.of("été_1 x", missing))), [1, 5])
is_move_word_lines() = same(at(text.move_word(1, at_place(1, 3, "ab\ncd"))), [2, 2])
is_move_page() = same(at(text.move_page(1, 3, text.of(join("\n", map(n -> "l", range(1, 10))), missing))), [4, 0]) and same(at(text.move_page(-1, 3, at_place(2, 0, join("\n", map(n -> "l", range(1, 10)))))), [1, 0])
is_move_page_keeps_column() = same(at(text.move_page(1, 2, text.move_line(1, at_place(1, 3, "abcd\nx\nabcd\nabcd")))), [4, 3])
is_colors_forgotten() = text.insert_words("x", text.of("a\nb\nc", missing)).colors.known == 1 and color.colored_to(3, n -> "x", text.of("a", missing).colors).known == 3
is_colors_forgotten_below() = text.insert_words("x", color_to_3(at_place(2, 0, "a\nb\nc"))).colors.known == 2
is_crlf_kept() = all_text(text.insert_words("x", text.of("a\r\nb", missing))) == "xa\r\nb"
is_insert_newlines() = same(at(text.insert_words("x\nyz", text.of("ab", missing))), [2, 2]) and all_text(text.insert_words("x\nyz", text.of("ab", missing))) == "x\nyzab"
is_delete_after_join() = all_text(text.delete_after(at_place(1, 2, "ab\ncd"))) == "abcd"
is_delete_after_last() = all_text(text.delete_after(at_place(1, 2, "ab"))) == "ab"
is_undo_delete() = all_text(text.undo(text.delete_before(at_place(1, 2, "abc")))) == "abc"
is_limit() = text.of("", missing).history.limit == 1000

defn color_to_3(b)
  b.colors = color.colored_to(3, n -> "x", b.colors)
  b
end

crlf = "ab\r\ncd"
long_text = join("\n", map(n -> "x", range(1, 100)))

is_crlf_roundtrip() = all_text(text.of(crlf, missing)) == crlf and all_text(text.undo(text.redo(text.insert_words("z", text.of(crlf, missing))))) == crlf
is_crlf_line_end_type() = all_text(text.insert_words("X", text.to_line_end(text.of(crlf, missing)))) == "abX\r\ncd"
is_crlf_width() = same(at(text.to_line_end(text.of(crlf, missing))), [1, 2]) and same(at(text.move_line(-1, at_place(2, 5, crlf))), [1, 2])
is_crlf_move_char() = same(at(text.move_char(3, text.of(crlf, missing))), [2, 0]) and same(at(text.move_char(-1, at_place(2, 0, crlf))), [1, 2])
is_crlf_delete_before() = all_text(text.delete_before(at_place(2, 0, crlf))) == "abcd" and same(at(text.delete_before(at_place(2, 0, crlf))), [1, 2])
is_crlf_delete_after() = all_text(text.delete_after(at_place(1, 2, crlf))) == "abcd"
is_crlf_new_line() = all_text(text.new_line(at_place(1, 2, "  ab\r\ncd"))) == "  ab\r\n  \r\ncd" or all_text(text.new_line(at_place(1, 4, "  ab\r\ncd"))) == "  ab\r\n  \r\ncd"
is_crlf_new_line_cursor() = same(at(text.new_line(at_place(1, 4, "  ab\r\ncd"))), [2, 2])
is_crlf_new_line_last() = all_text(text.new_line(at_place(2, 2, crlf))) == "ab\r\ncd\r\n"
is_lf_new_line_last() = all_text(text.new_line(at_place(2, 2, "ab\ncd"))) == "ab\ncd\n"
is_crlf_cut_line() = text.cut_line(at_place(1, 2, crlf)).cut == "\r\n" and all_text(text.cut_line(at_place(1, 2, crlf)).buffer) == "abcd"
is_crlf_region() = text.region(text.move_char(1, text.set_mark(at_place(1, 2, crlf)))) == "\r\n" and all_text(text.cut_region(text.move_char(1, text.set_mark(at_place(1, 2, crlf))))) == "abcd"
is_cr_inside_line() = same(at(text.to_line_end(text.of("a\rb\ncd", missing))), [1, 3]) and same(at(text.to_line_end(text.of("ab\r", missing))), [1, 3])
is_undo_keeps_colors() = color_to_60(text.insert_words("y", at_place(50, 0, long_text))).colors.known == 60 and text.undo(color_to_60(text.insert_words("y", at_place(50, 0, long_text)))).colors.known >= 49
is_undo_cursor_far_edit() = same(at(text.undo(text.delete_before(text.move_char(-2, text.insert_words("x", at_place(1, 3, "abc")))))), [1, 2]) and all_text(text.undo(text.delete_before(text.move_char(-2, text.insert_words("x", at_place(1, 3, "abc")))))) == "abcx"
is_redo_cursor() = same(at(text.redo(text.undo(text.delete_before(text.move_char(-2, text.insert_words("x", at_place(1, 3, "abc"))))))), [1, 1])
is_undo_word_cursor() = same(at(text.undo(text.move_char(-1, typed("ab cd", text.of("", missing))))), [1, 3]) and same(at(text.undo(typed("ab cd", text.of("", missing)))), [1, 3]) and same(at(text.undo(text.undo(typed("ab cd", text.of("", missing))))), [1, 0])
is_save_ends_step() = not text.is_modified(text.undo(text.insert_words("c", text.mark_saved(missing, typed("ab", text.of("", missing)))))) and all_text(text.undo(text.insert_words("c", text.mark_saved(missing, typed("ab", text.of("", missing)))))) == "ab"

defn color_to_60(b)
  b.colors = color.colored_to(60, n -> "x", b.colors)
  b
end

defn is_selection_ends()
  b = text.place(1, 3, text.of("abcdef", missing))
  b.mark = {line: 1, column: 1}
  e = text.selection(b)
  e.first.column == 1 and e.last.column == 3 and is_missing(text.selection(text.of("a", missing)))
end

is_line_width() = text.line_width(1, text.of("abc\r\nde", missing)) == 3 and text.line_width(2, text.of("abc\r\nde", missing)) == 2
is_of_editor_fields() = text.of("", missing).free == false and text.of("", missing).origin == ""
